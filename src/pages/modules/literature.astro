    const labels = { olympians: "The Olympians", chthonic: "Underworld", primordial: "Primordial", titans: "The Titans", minor: "Minor Deities" };
    btnsEl.innerHTML = Object.keys(deityCategories).map(k =>
      `<button class="explorer-btn" data-key="${k}" onclick="showDeityCategory('${k}')">${labels[k]}</button>`
    ).join("");
    showDeityCategory("olympians");
  }

  function showDeityCategory(key) {
    const d = deityCategories[key];
    if (!d) return;
    document.getElementById("deity-cat-display").innerHTML =
      `<div style="font-size:13px;font-weight:500;color:var(--color-text-primary);margin-bottom:8px;">${d.title}</div><div style="font-size:12px;color:var(--color-text-secondary);line-height:1.65;">${d.body}</div>`;
    document.querySelectorAll("#deity-cat-btns .explorer-btn").forEach(b =>
      b.classList.toggle("active", b.dataset.key === key)
    );
  }

  /* ════════════════════════════════════
     PART H — OLYMPIANS GRID BUILDER
  ════════════════════════════════════ */
  function buildOlympiansGrid() {
    const gridEl = document.getElementById("olympian-grid");
    if (!gridEl) return;
    gridEl.innerHTML = olympians.map((item, i) =>
      `<div class="elem-card" onclick="showOlympianDetail(${i})">
        <div class="card-icon-small">${item.icon}</div>
        <div class="label-strong">${item.label}</div>
        <div class="card-sub-muted">${item.sub}</div>
      </div>`
    ).join("");
  }

  function showOlympianDetail(index) {
    const item = olympians[index];
    const detailEl = document.getElementById("olympian-detail");
    detailEl.innerHTML = `<div style="font-size:13px;font-weight:500;color:var(--color-text-primary);margin-bottom:8px;">${item.icon} ${item.label}</div><div style="font-size:12px;color:var(--color-text-secondary);line-height:1.65;">${item.detail}</div>`;
    detailEl.classList.add("show");
    document.querySelectorAll("#olympian-grid .elem-card").forEach((c, i) => c.classList.toggle("active", i === index));
  }

  /* ════════════════════════════════════
     PART H — BEYOND OLYMPUS BUILDER
  ════════════════════════════════════ */
  function buildBeyondOlympus() {
    const btnsEl = document.getElementById("beyond-btns");
    const displayEl = document.getElementById("beyond-display");
    if (!btnsEl || !displayEl) return;
    btnsEl.innerHTML = Object.keys(beyondOlympus).map(k =>
      `<button class="explorer-btn" data-key="${k}" onclick="showBeyond('${k}')">${beyondOlympus[k].title.split(" —")[0]}</button>`
    ).join("");
    showBeyond("prometheus");
  }

  function showBeyond(key) {
    const d = beyondOlympus[key];
    if (!d) return;
    document.getElementById("beyond-display").innerHTML =
      `<div style="font-size:13px;font-weight:500;color:var(--color-text-primary);margin-bottom:8px;">${d.title}</div><div style="font-size:12px;color:var(--color-text-secondary);line-height:1.65;">${d.body}</div>`;
    document.querySelectorAll("#beyond-btns .explorer-btn").forEach(b =>
      b.classList.toggle("active", b.dataset.key === key)
    );
  }

  window.addEventListener('DOMContentLoaded', function() {
    // Part A
    showGenre('poetry', document.querySelector('.genre-card'));

    // Part B
    buildElemGrid('form-grid', 'form-detail', poeticForms);
    buildExplorer('device-btns', 'device-display', devices);
    buildScale('poet-scale', poetScale);
    buildBars('poet-bars', poetBars);

    // Part C
    buildPeriodChart('novel-timeline', novelTimeline);
    buildElemGrid('narr-grid', 'narr-detail', narrElements);
    buildExplorer('trad-btns', 'trad-display', traditions);
    updateDistanceSlider(3);

    // Part D
    buildExplorer('playwright-btns', 'playwright-display', playwrights);
    buildScale('play-scale', playScale);
    updateUnitySlider(3);

    // Part E
    buildPeriodChart('movement-timeline', movementsTimeline);
    buildExplorer('movement-btns', 'movement-display', movements);
    buildBars('modernist-bars', modernistBars, 100);

    // Part F
    buildExplorer('canon-btns', 'canon-display', canonMechs);
    buildElemGrid('global-grid', 'global-detail', globalTrad);
    buildScale('canon-scale', canonScale);
    buildBars('nobel-bars', nobelBars);

    // Part G
    buildElemGrid('reading-grid', 'reading-detail', readingTechs);
    buildExplorer('mistake-btns', 'mistake-display', mistakes);
    updateReadingSpeedSlider(2);
    buildReadingTracker();

    // Part H
    buildDeityCategories();
    buildOlympiansGrid();
    buildBeyondOlympus();
    buildScale('myth-theme-scale', mythThemeScale);
    buildBars('myth-word-bars', mythWordBars, 100);
  });
  
</script>
