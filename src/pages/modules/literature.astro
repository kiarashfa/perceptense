  /* ════════════════════════════════════
     CALCULATORS
  ════════════════════════════════════ */
  function calcReadingTime() {
    const words = parseInt(document.getElementById('u-w-130px').value) || 100000;
    const wpm = parseInt(document.getElementById('read-speed').value) || 250;
    const minsPerDay = parseInt(document.getElementById('read-mins').value) || 30;
    const totalMins = words / wpm;
    const days = Math.ceil(totalMins / minsPerDay);
    const hours = (totalMins / 60).toFixed(1);
    const el = document.getElementById('reading-result');
    el.innerHTML = `Total reading time: approximately <strong>${hours} hours</strong> (${Math.round(totalMins).toLocaleString()} minutes).<br>
At ${minsPerDay} minutes per day, you would finish in approximately <strong>${days} days</strong> (${Math.round(days / 7)} weeks).<br>
For context: a standard literary novel (~80,000 words) at 250 WPM takes about 5.3 hours total — roughly 11 days at 30 minutes per day.`;
    el.classList.add('show');
  }

  function applySpeedPreset(val) {
    if (val) document.getElementById('read-speed').value = val;
  }

  function calcCanonTime() {
    const works = parseInt(document.getElementById('u-w-100px').value) || 100;
    const wordLen = parseInt(document.getElementById('u-w-120px').value) || 80000;
    const minsPerDay = parseInt(document.getElementById('canon-mins').value) || 45;
    const wpm = parseInt(document.getElementById('canon-wpm').value) || 250;
    const totalWords = works * wordLen;
    const totalMins = totalWords / wpm;
    const totalHours = (totalMins / 60).toFixed(0);
    const days = Math.ceil(totalMins / minsPerDay);
    const years = (days / 365).toFixed(1);
    const el = document.getElementById('canon-result');
    el.innerHTML = `${works} works at an average of ${wordLen.toLocaleString()} words each = <strong>${totalWords.toLocaleString()} total words</strong>.<br>
At ${wpm} WPM and ${minsPerDay} minutes per day, this would take approximately <strong>${days.toLocaleString()} days</strong> (${years} years).<br>
This is entirely achievable — a committed reader spending 45 minutes a day can read the core Western canon in a decade while living a normal life. Most people underestimate how much they could read if they replaced a small fraction of screen time with books.`;
    el.classList.add('show');
  }

  function applyLenPreset(val) {
    if (val) document.getElementById('u-w-120px').value = val;
  }

  /* ════════════════════════════════════
     READING TRACKER BUILDER
  ════════════════════════════════════ */
  function buildReadingTracker() {
    const el = document.getElementById('reading-tracker');
    if (!el) return;
    const wpm = 250, minsPerDay = 30;
    el.innerHTML = readingList.map(item => {
      const days = Math.ceil(item.words / wpm / minsPerDay);
      const pct = Math.min(100, Math.round(item.words / 500000 * 100));
      return `<div class="tracker-card">
        <div class="item-heading-medium">${item.title}</div>
        <div class="mini-caption">${item.author} · ${item.era} · ~${(item.words/1000).toFixed(0)}k words</div>
        <div class="tracker-bar"><div class="tracker-fill" style="width:${pct}%;"></div></div>
        <div class="micro-caption">~${days} days at 30 min/day</div>
      </div>`;
    }).join('');
  }

