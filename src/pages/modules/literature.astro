  /* ════════════════════════════════════
     GENERIC PERIOD CHART BUILDER
  ════════════════════════════════════ */
  function buildPeriodChart(containerId, items) {
    const el = document.getElementById(containerId);
    if (!el) return;
    const allYears = items.flatMap(i => [i.start, i.end]);
    const minY = Math.min(...allYears);
    const maxY = Math.max(...allYears);
    const range = maxY - minY;
    const axisMarks = [];
    const step = range > 400 ? 100 : 50;
    for (let y = Math.ceil(minY / step) * step; y <= maxY; y += step) {
      axisMarks.push({ year: y, pct: Math.round((y - minY) / range * 100) });
    }
    const axisHtml = `<div class="pc-axis">${axisMarks.map(m => `<span class="axis-tick-small" style="left:${m.pct}%">${m.year}</span>`).join('')}</div>`;
    const rowsHtml = items.map(item => {
      const left = Math.round((item.start - minY) / range * 100);
      const width = Math.round((item.end - item.start) / range * 100);
      return `<div class="data-row-loose">
        <div class="pc-label" style="font-size:10px;">${item.label}</div>
        <div class="period-track">
          <div class="pc-fill" style="left:${left}%; width:${width}%; background:${item.col};">
            <span class="period-label" style="color:${item.tcol};">${item.note}</span>
          </div>
        </div>
      </div>`;
    }).join('');
    el.innerHTML = axisHtml + rowsHtml;
  }

