  function buildExplorer(btnsId, displayId, data) {
    const btnsEl = document.getElementById(btnsId);
    const displayEl = document.getElementById(displayId);
    const keys = Object.keys(data);
    if (!btnsEl || !displayEl || !keys.length) return;
    btnsEl.innerHTML = keys.map(k => `<button class="explorer-btn" data-key="${k}" onclick="showExplorer('${btnsId}','${displayId}','${k}')">${data[k].title.split('(')[0].trim()}</button>`).join('');
    showExplorer(btnsId, displayId, keys[0]);
  }

