function buildEmpireBars() {
  const maxDur = Math.max(...empires.map(e => e.end - e.start));
  const container = document.getElementById('empire-bars');
  let html = '';
  const sorted = [...empires].sort((a,b) => (b.end-b.start)-(a.end-a.start));
  sorted.forEach(emp => {
    const dur = emp.end - emp.start;
    const pct = Math.round((dur / maxDur) * 100);
    html += `<div class="track-row">
      <div class="track-label-padded">${emp.name}</div>
      <div class="track-tall">
        <div class="empire-bar-fill">
          <span class="bv">${dur.toLocaleString()} yrs</span>
        </div>
      </div>
    </div>`;
  });
  container.innerHTML = html;
  container.querySelectorAll('.empire-bar-fill').forEach((bar, i) => {
    const emp = sorted[i];
    const dur = emp.end - emp.start;
    bar.style.width = Math.round((dur / maxDur) * 100) + '%';
    bar.style.background = emp.color;
    const val = bar.querySelector('.bv');
    if (val) val.style.color = emp.textColor;
  });
}

