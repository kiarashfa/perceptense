// === PART H — Depth Calculator ===
function calcDepth() {
  const y = parseInt(document.getElementById('depth-year').value);
  if (isNaN(y) || y < -3000 || y > 2025) {
    document.getElementById('depth-result').innerHTML = '<span class="text-secondary u-fs-12px">Please enter a year between 3000 BC and 2025.</span>';
    return;
  }
  const HISTORY_START = -3000;
  const NOW = 2025;
  const totalHistory = NOW - HISTORY_START; // 5025 years
  const yearsFromStart = y - HISTORY_START;
  const pctOfHistory = Math.round((yearsFromStart / totalHistory) * 100);
  const yearsAgo = NOW - y;
  const generationsAgo = Math.round(yearsAgo / 25);
  const era = getEra(y);
  const s = eraStyles[era];

  // Living memory: ~90 years back from now
  const inLivingMemory = yearsAgo <= 90;
  // Grandparent memory: ~150 years
  const inGrandparentMemory = yearsAgo <= 150;

  let memNote = '';
  if (y > NOW) memNote = 'This is in the future.';
  else if (inLivingMemory) memNote = 'Within living memory: people alive today were alive then.';
  else if (inGrandparentMemory) memNote = 'Within grandparent memory: people alive today had grandparents who were alive then.';
  else if (yearsAgo <= 250) memNote = 'Within 10 generations: close enough that some family records and diaries survive.';
  else if (yearsAgo <= 500) memNote = 'Around 20 generations ago: the late medieval / early modern world.';
  else memNote = 'Deep history: ' + Math.round(generationsAgo) + ' generations ago.';

  // Percentage bar fill
  const barPct = Math.max(2, Math.min(98, pctOfHistory));

  let html = `
  <div class="u-mb-lg">
    <div class="u-fs-11px text-secondary u-mb-xs">Position in recorded history (3000 BC → now)</div>
    <div class="u-bg-background-secondary u-radius-4px u-h-12px u-overflow-hidden u-mb-xs">
      <div class="depth-fill"></div>
    </div>
    <div class="u-fs-11px text-secondary">${pctOfHistory}% of the way through recorded history</div>
  </div>
  <div>
  `;

  const rows = [
    { icon: '📅', label: 'Era', val: `<span class="era-pill era-style-${era}">${s.label}</span>` },
    { icon: '⏳', label: 'Years ago', val: y <= NOW ? yearsAgo.toLocaleString() + ' years' : '—' },
    { icon: '👴', label: 'Generations ago', val: y <= NOW ? '~' + generationsAgo.toLocaleString() + ' generations (at 25 yrs/gen)' : '—' },
    { icon: '🧠', label: 'Memory context', val: memNote },
    { icon: '📜', label: '% of recorded history elapsed', val: pctOfHistory + '%' },
  ];

  rows.forEach(r => {
    html += `<div class="depth-row">
      <div class="depth-icon">${r.icon}</div>
      <div class="depth-label">${r.label}</div>
      <div class="depth-val u-maxw-55-pct u-text-right u-fs-12px">${r.val}</div>
    </div>`;
  });

  html += '</div>';
  const depthResult = document.getElementById('depth-result');
  depthResult.innerHTML = html;
  const depthFill = depthResult.querySelector('.depth-fill');
  if (depthFill) depthFill.style.width = barPct + '%';
}

