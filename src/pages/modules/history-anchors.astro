const eraStyles = [
  null,
  { bg:'#EEEDFE', border:'#AFA9EC', text:'#3C3489', label:'Ancient world' },
  { bg:'#FAECE7', border:'#F0997B', text:'#712B13', label:'Middle Ages' },
  { bg:'#FAEEDA', border:'#EF9F27', text:'#633806', label:'Early Modern' },
  { bg:'#E1F5EE', border:'#5DCAA5', text:'#085041', label:'Enlightenment' },
  { bg:'#EAF3DE', border:'#97C459', text:'#27500A', label:'Long 19th century' },
  { bg:'#FCEBEB', border:'#F09595', text:'#791F1F', label:'Age of catastrophe' },
  { bg:'#E6F1FB', border:'#85B7EB', text:'#0C447C', label:'Modern world' },
];

let anchorCurrentEra = 1;

function getEra(y) {
  if (y < 500) return 1;
  if (y < 1400) return 2;
  if (y < 1700) return 3;
  if (y < 1800) return 4;
  if (y < 1914) return 5;
  if (y < 1945) return 6;
  return 7;
}

function fmtYear(y) {
  if (y === 0) return '1 BC / 1 AD (calendar boundary)';
  return y < 0 ? Math.abs(y) + ' BC' : y + ' AD';
}

function getNearby(y) {
  const before = events.filter(e => e.y <= y).sort((a,b) => b.y-a.y)[0];
  const after  = events.filter(e => e.y >  y).sort((a,b) => a.y-b.y)[0];
  return { before, after };
}

function updateTimeline() {
  const y = parseInt(document.getElementById('hist-slider').value);
  const era = getEra(y);
  const s = eraStyles[era];
  document.getElementById('hist-year-display').textContent = fmtYear(y);
  const badge = document.getElementById('hist-era-badge');
  badge.textContent = s.label;
  badge.style.cssText = `background:${s.bg}; color:${s.text}; border:0.5px solid ${s.border}; display:inline-block; font-size:11px; font-weight:500; padding:2px 9px; border-radius:99px; margin-bottom:10px;`;
  const { before, after } = getNearby(y);
  let nearby = '';
  if (before) nearby += `<div class="u-fs-12px text-secondary u-mb-xs">← Last anchor: <strong class="text-primary">${fmtYear(before.y)}: ${before.name}</strong> (${Math.abs(y-before.y)} years ago)</div>`;
  if (after)  nearby += `<div class="u-fs-12px text-secondary">→ Next anchor: <strong class="text-primary">${fmtYear(after.y)}: ${after.name}</strong> (in ${Math.abs(after.y-y)} years)</div>`;
  document.getElementById('hist-nearby').innerHTML = nearby;

  const exact = events.find(e => e.y === y);
  if (exact) {
    document.getElementById('hist-context').innerHTML = `<strong class="text-primary">${exact.name}</strong><br>${exact.note}`;
  } else {
    const eraContext = [
      '',
      'The ancient world: Egypt, Mesopotamia, Greece, and Rome dominate. Writing, philosophy, democracy, and empire are invented. The Axial Age produces Buddha, Confucius, and Socrates.',
      'The Middle Ages: Christianity and Islam shape civilisation. Feudal Europe, Islamic Golden Age, Mongol conquests, the Black Death. The world is not "dark": it is complex and pluralistic.',
      'The Early Modern period: Printing press, Renaissance, Reformation, global exploration. The medieval world unravels rapidly. Europeans connect all continents for the first time.',
      'The Enlightenment: Reason, science, and individual rights challenge kings and churches. Revolution is in the air. The modern concepts of democracy and human rights are being born.',
      'The Long 19th century: Industry, nationalism, empire. Railways, Darwin, Marx. Europe dominates the globe. Tension building. The gap between rich and poor nations widens dramatically.',
      'The Age of Catastrophe: Two World Wars, the Holocaust, communism vs fascism vs democracy. ~100 million dead in 31 years. The most violent period per decade in recorded history.',
      'The Modern world: Cold War, decolonisation, the World Wide Web, globalisation. The fastest technological change in history. More people lifted from poverty than in all previous centuries combined.',
    ];
    document.getElementById('hist-context').textContent = eraContext[era];
  }
}

function jumpTo(y) {
  document.getElementById('hist-slider').value = y;
  updateTimeline();
}

function buildAnchorList() {
  const container = document.getElementById('anchor-list');
  const s = eraStyles[anchorCurrentEra];
  const eraEvents = events.filter(e => e.era === anchorCurrentEra);
  let tabs = '';
  eraStyles.forEach((era, i) => {
    if (!era) return;
    tabs += `<button class="conc-btn${i===anchorCurrentEra?' active':''}" onclick="showAnchorEra(${i})">${era.label}</button>`;
  });
  let rows = '';
  eraEvents.forEach(e => {
    rows += `<div class="u-display-flex u-gap-md u-p-5px-0 u-bb-0-5px-solid-border-tertiary u-items-baseline is-clickable" onclick="jumpTo(${e.y})" title="Jump to ${fmtYear(e.y)}">
      <span class="u-fs-12px u-fw-500 text-secondary u-minw-64px u-shrink-0 u-font-monospace">${fmtYear(e.y)}</span>
      <span class="u-fs-13px text-primary">${e.name}</span>
    </div>`;
  });
  container.innerHTML = `<div class="button-row-compact">${tabs}</div>
    <div class="u-display-flex u-justify-space-between u-gap-sm u-items-center u-flex-wrap u-mb-sm">
      <div class="panel-title-spaced">${s.label}</div>
      <div class="muted-text-small">${eraEvents.length} anchor events</div>
    </div>
    ${rows}`;
}

function showAnchorEra(era) {
  anchorCurrentEra = era;
  buildAnchorList();
}

function lookupYear() {
  const y = parseInt(document.getElementById('year-lookup').value);
  if (isNaN(y)) return;
  const era = getEra(y);
  const s = eraStyles[era];
  const { before, after } = getNearby(y);
  const exact = events.find(e => e.y === y);
  let html = `<strong>${fmtYear(y)}</strong>: <span class="era-pill era-style-${era}">${s.label}</span><br><br>`;
  if (exact) html += `<strong>This is: ${exact.name}</strong><br>${exact.note}<br><br>`;
  if (before) html += `Most recent anchor before: <strong>${fmtYear(before.y)}: ${before.name}</strong><br><span class="text-secondary u-fs-12px">${before.note}</span><br><br>`;
  if (after)  html += `Next anchor after: <strong>${fmtYear(after.y)}: ${after.name}</strong><br><span class="text-secondary u-fs-12px">${after.note}</span>`;
  document.getElementById('lookup-result').innerHTML = html;
  document.getElementById('hist-slider').value = y;
  updateTimeline();
}

