];

function buildSpeedBars() {
  const maxGap = Math.max(...speedMilestones.map(m => m.gap));
  const container = document.getElementById('speed-bars');
  let html = '';
  speedMilestones.forEach(m => {
    const pct = Math.max(3, Math.round((m.gap / maxGap) * 100));
    html += `<div class="data-row-loose">
      <div class="speed-label">${m.from}<br>→ ${m.to}</div>
      <div class="speed-track">
        <div class="speed-fill">
          <span class="speed-val">${m.gap.toLocaleString()} yrs</span>
        </div>
      </div>
    </div>`;
  });
  container.innerHTML = html;
  container.querySelectorAll('.speed-fill').forEach((bar, i) => {
    const m = speedMilestones[i];
    bar.style.width = Math.max(3, Math.round((m.gap / maxGap) * 100)) + '%';
    bar.style.background = m.color;
    const val = bar.querySelector('.speed-val');
    if (val) val.style.color = m.textColor;
  });
}

