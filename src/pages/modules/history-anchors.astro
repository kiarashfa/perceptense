let quizIdx = 0;
let quizScoreVal = 0;

function startQuiz() {
  quizIdx = 0;
  quizScoreVal = 0;
  document.getElementById('quiz-score').textContent = '0';
  document.getElementById('quiz-total').textContent = '0';
  document.getElementById('quiz-restart').style.display = 'none';
  renderQuizQuestion();
}

function renderQuizQuestion() {
  if (quizIdx >= quizQuestions.length) {
    document.getElementById('quiz-container').innerHTML = `
      <div class="u-fs-15px u-fw-500 text-primary u-mb-sm">Finished! Score: ${quizScoreVal} / ${quizQuestions.length}</div>
      <div class="u-fs-13px text-secondary">${quizScoreVal >= 8 ? 'Excellent calibration.' : quizScoreVal >= 5 ? 'Good, a few surprises in there.' : 'History is full of surprises. Worth reviewing the anchors.'}</div>`;
    document.getElementById('quiz-restart').style.display = 'inline-block';
    return;
  }
  const q = quizQuestions[quizIdx];
  const container = document.getElementById('quiz-container');
  container.innerHTML = `
    <div class="u-fs-12px text-secondary u-mb-sm">Question ${quizIdx+1} of ${quizQuestions.length}</div>
    <div class="u-fs-14px u-fw-500 text-primary u-mb-md">${q.q}</div>
    <button class="quiz-opt" onclick="answerQuiz('a')" id="qopt-a">${q.a}</button>
    <button class="quiz-opt" onclick="answerQuiz('b')" id="qopt-b">${q.b}</button>
    ${q.correct === 'tie' ? `<button class="quiz-opt" onclick="answerQuiz('tie')" id="qopt-tie">They happened at the same time / same year</button>` : ''}
    <div id="quiz-feedback" class="u-display-none u-mt-sm u-fs-12px text-secondary u-lh-1-6 u-bg-background-secondary u-radius-radius-md pad-compact"></div>
  `;
}

function answerQuiz(choice) {
  const q = quizQuestions[quizIdx];
  document.querySelectorAll('.quiz-opt').forEach(b => b.disabled = true);

  const isCorrect = (choice === q.correct);
  if (isCorrect) {
    quizScoreVal++;
    document.getElementById('quiz-score').textContent = quizScoreVal;
  }

  if (q.correct === 'tie') {
    const tieBtn = document.getElementById('qopt-tie');
    if (tieBtn) tieBtn.classList.add('correct');
    ['a','b'].forEach(k => { const b = document.getElementById('qopt-'+k); if(b) b.style.opacity='0.5'; });
    if (choice !== 'tie') { const chosen = document.getElementById('qopt-'+choice); if(chosen) chosen.classList.add('incorrect'); }
  } else {
    document.getElementById('qopt-'+q.correct).classList.add('correct');
    if (choice !== q.correct) {
      document.getElementById('qopt-'+choice).classList.add('incorrect');
    }
  }

  const fb = document.getElementById('quiz-feedback');
  fb.textContent = q.explain;
  fb.style.display = 'block';

  document.getElementById('quiz-total').textContent = quizIdx + 1;

  setTimeout(() => {
    quizIdx++;
    renderQuizQuestion();
  }, 2800);
}

