function buildIranTabs() {
  const tabBar = document.getElementById('iran-tabs');
  let html = '';
  iranEras.forEach((era, i) => {
    html += `<button class="iran-tab${i===0?' active':''}" onclick="showIranEra(${i})">${era.shortName}</button>`;
  });
  tabBar.innerHTML = html;
  showIranEra(0);
}

function showIranEra(idx) {
  document.querySelectorAll('.iran-tab').forEach((b,i) => b.classList.toggle('active', i===idx));
  const era = iranEras[idx];
  const panel = document.getElementById('iran-panel');
  let html = '';

  // Header meta
  html += `<div class="u-display-flex u-gap-sm u-flex-wrap u-items-center u-mb-md">
    <span class="u-fs-12px u-fw-500 text-primary">${era.period}</span>
    <span class="u-fs-11px text-secondary">·</span>
    <span class="u-fs-12px text-secondary">${era.duration}</span>
    <span class="u-fs-11px text-secondary">·</span>
    <span class="u-fs-12px text-secondary">${era.type}</span>
  </div>`;

  // Intro
  html += `<p class="war-body-text u-mb-md">${era.intro}</p>`;

  // Highlight callout
  html += `<div class="u-bg-background-warning u-border-0-5px-solid-border-warning u-radius-radius-md u-p-9px-12px u-mb-13px u-fs-12px text-warning u-lh-1-6">
    <strong>↳ Key fact:</strong> ${era.highlight}
  </div>`;

  // Stats grid
  if (era.stats.length) {
    html += `<div class="war-stat-grid">`;
    era.stats.forEach(s => {
      html += `<div class="sub-card-compact"><div class="war-stat-label">${s.label}</div><div class="war-stat-val">${s.val}</div></div>`;
    });
    html += `</div>`;
  }

  // Geography & Capitals
  html += `<div class="war-section-head">Capitals</div>
    <div class="war-country-list">`;
  era.capitals.forEach(c => { html += `<span class="war-country-pill">${c}</span>`; });
  html += `</div>`;

  html += `<div class="u-display-grid u-gridcols-auto-fit-200px-1fr u-gap-sm u-mb-md">
    <div class="sub-card">
      <div class="mini-card-title">Territory &amp; Geography</div>
      <p class="war-body-text">${era.territory}</p>
    </div>
    <div class="sub-card">
      <div class="mini-card-title">Religion</div>
      <p class="war-body-text">${era.religion}</p>
    </div>
    <div class="sub-card">
      <div class="mini-card-title">Language</div>
      <p class="war-body-text">${era.language}</p>
    </div>
  </div>`;

  // Rulers
  if (era.rulers.length) {
    html += `<div class="war-section-head">Key Rulers &amp; Figures</div>`;
    html += `<div class="u-overflow-x-auto"><table class="profile-table">
      <thead><tr><th>Ruler or Figure</th><th>Why It Matters</th></tr></thead>
      <tbody>`;
    era.rulers.forEach(r => {
      html += `<tr>
        <td class="profile-table-name">${r.name}</td>
        <td class="text-secondary">${r.note}</td>
      </tr>`;
    });
    html += `</tbody></table></div>`;
  }

  // Legacy
  html += `<div class="war-section-head">Legacy &amp; Long-Term Impact</div>
    <p class="war-body-text">${era.legacy}</p>`;

  panel.innerHTML = html;
}

