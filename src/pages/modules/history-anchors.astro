function buildWarTabs() {
  const tabBar = document.getElementById('war-tabs');
  let html = '';
  wars.forEach((w, i) => {
    html += `<button class="war-tab${i===0?' active':''}" onclick="showWar(${i})" id="war-tab-${i}">${w.shortName}</button>`;
  });
  tabBar.innerHTML = html;
  showWar(0);
}

function showWar(idx) {
  document.querySelectorAll('.war-tab').forEach((b,i) => b.classList.toggle('active', i===idx));
  const w = wars[idx];
  const panel = document.getElementById('war-panel');

  // "Others" tab has special layout
  if (w.others) {
    let html = `<p class="war-body-text u-mb-13px">${w.intro}</p>`;
    w.others.forEach(o => {
      html += `<div class="u-p-10px-0 u-bb-0-5px-solid-border-tertiary">
        <div class="u-display-flex u-items-center u-gap-sm u-mb-xs u-flex-wrap">
          <span class="u-fs-13px u-fw-500 text-primary">${o.name}</span>
          <span class="war-other-tag">${o.tag}</span>
        </div>
        <p class="u-fs-12px text-secondary u-m-0 u-lh-1-6">${o.text}</p>
      </div>`;
    });
    panel.innerHTML = html;
    panel.querySelectorAll('.war-other-tag').forEach((tag, i) => {
      const item = w.others[i];
      tag.style.background = item.tagColor;
      tag.style.color = item.tagText;
      tag.style.borderColor = item.tagText + '22';
    });
    return;
  }

  // Standard war layout
  let html = '';

  // Header meta line
  html += `<div class="u-display-flex u-gap-sm u-flex-wrap u-items-center u-mb-md">
    <span class="u-fs-12px u-fw-500 text-primary">${w.years}</span>
    <span class="u-fs-11px text-secondary">·</span>
    <span class="u-fs-12px text-secondary">${w.duration}</span>
    <span class="u-fs-11px text-secondary">·</span>
    <span class="u-fs-12px text-secondary">${w.type}</span>
  </div>`;

  // Intro
  html += `<p class="war-body-text u-mb-md">${w.intro}</p>`;

  // Stats grid
  if (w.stats.length) {
    html += `<div class="war-stat-grid">`;
    w.stats.forEach(s => {
      html += `<div class="sub-card-compact"><div class="war-stat-label">${s.label}</div><div class="war-stat-val">${s.val}</div></div>`;
    });
    html += `</div>`;
  }

  // Theatre
  html += `<div class="war-section-head">Theatre of War</div>
    <p class="war-body-text">${w.theatre}</p>`;

  // Sides
  if (w.sides.length) {
    html += `<div class="war-section-head">Who Fought</div>`;
    w.sides.forEach(side => {
      html += `<div class="u-mb-sm">
        <div class="u-fs-11px u-fw-500 text-secondary u-mb-xs">${side.label}</div>
        <div class="war-country-list">`;
      side.countries.forEach(c => {
        html += `<span class="war-country-pill">${c}</span>`;
      });
      html += `</div></div>`;
    });
  }

  html += `<div class="u-display-grid u-gridcols-auto-fit-200px-1fr u-gap-sm u-mb-md">
    <div class="sub-card">
      <div class="mini-card-title">How It Started</div>
      <p class="war-body-text">${w.cause}</p>
    </div>
    <div class="sub-card">
      <div class="mini-card-title">How It Ended</div>
      <p class="war-body-text">${w.end}</p>
    </div>
    <div class="sub-card">
      <div class="mini-card-title">Legacy &amp; Long-Term Impact</div>
      <p class="war-body-text">${w.legacy}</p>
    </div>
  </div>`;

  // Key figures
  if (w.figures.length) {
    html += `<div class="war-section-head">Key Figures</div>`;
    html += `<div class="u-overflow-x-auto"><table class="profile-table">
      <thead><tr><th>Figure</th><th>Role</th></tr></thead>
      <tbody>`;
    w.figures.forEach(f => {
      html += `<tr>
        <td class="profile-table-name">${f.name}</td>
        <td class="text-secondary">${f.role}</td>
      </tr>`;
    });
    html += `</tbody></table></div>`;
  }

  panel.innerHTML = html;
}

