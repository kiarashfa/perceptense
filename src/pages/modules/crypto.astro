    /* ── DCA Calculator ── */
    window.calcDCA = function() {
      const monthly = parseFloat(document.getElementById('dca-amount').value);
      const years = parseFloat(document.getElementById('dca-years').value);
      const annualReturn = parseFloat(document.getElementById('dca-return').value);
      if (isNaN(monthly) || isNaN(years) || isNaN(annualReturn) || monthly <= 0 || years <= 0) {
        document.getElementById('dca-output').innerHTML = '<span style="color:var(--color-text-danger);">Please enter valid positive numbers.</span>';
        return;
      }
      const r = annualReturn / 100 / 12;
      const n = years * 12;
      let futureValue;
      if (r === 0) {
        futureValue = monthly * n;
      } else {
        futureValue = monthly * (Math.pow(1 + r, n) - 1) / r;
      }
      const totalInvested = monthly * n;
      const gain = futureValue - totalInvested;
      const gainPct = (gain / totalInvested * 100).toFixed(1);
      document.getElementById('dca-output').innerHTML =
        'Total invested: <strong>$' + totalInvested.toLocaleString('en-US', {maximumFractionDigits: 0}) + '</strong> over ' + years + ' years<br>' +
        'Portfolio value at ' + annualReturn + '% annual return: <strong>$' + futureValue.toLocaleString('en-US', {maximumFractionDigits: 0}) + '</strong><br>' +
        'Gain: <strong>$' + gain.toLocaleString('en-US', {maximumFractionDigits: 0}) + '</strong> (' + gainPct + '% return on invested capital)<br>' +
        '<span style="font-size:12px;color:var(--color-text-tertiary);">For comparison at 7% (S&P 500 average): $' + (monthly * (Math.pow(1 + 0.07/12, n) - 1) / (0.07/12)).toLocaleString('en-US', {maximumFractionDigits: 0}) + '</span>';
    };
