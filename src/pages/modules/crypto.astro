    /* ── Impermanent loss calculator (new from alt, with real x*y=k formula) ── */
    window.calcIL = function() {
      const change = parseFloat(document.getElementById('il-change').value);
      const fees = parseFloat(document.getElementById('il-fees').value);
      const output = document.getElementById('il-output');
      if (!isFinite(change) || !isFinite(fees) || change <= -100 || fees < 0) {
        output.textContent = 'Enter a price change above -100% and a non-negative fee percentage.';
        return;
      }
      const ratio = 1 + change / 100;
      const poolVsHold = (2 * Math.sqrt(ratio)) / (1 + ratio);
      const ilPct = (poolVsHold - 1) * 100;
      const afterFees = ilPct + fees;
      const direction = change >= 0 ? 'rose' : 'fell';
      output.innerHTML =
        'If one asset <strong>' + direction + ' by ' + Math.abs(change).toFixed(1) + '%</strong>:<br>' +
        'Pool position is <strong>' + Math.abs(ilPct).toFixed(2) + '% worse</strong> than simply holding, before fees.<br>' +
        'After an estimated ' + fees + '% in trading fees earned: rough net is <strong>' + afterFees.toFixed(2) + '%</strong> vs holding.<br>' +
        '<span style="font-size:12px;color:var(--color-text-tertiary);">Loss is "impermanent" only if the price returns to the original ratio on exit. If it does not, the loss is permanent.</span>';
    };
