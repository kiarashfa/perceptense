      if (firstBtn) firstBtn.click();
    }

    buildExplorer('crypto-basics-btns', 'crypto-basics-panel', cryptoBasics);

    /* ── Consensus Explorer ── */
    const consensusData = {
      pow: {
        title: 'Proof of Work',
        body: 'Miners compete to find a "nonce" — a number — such that hashing the block header produces a result below a target value (starts with enough zeros). This requires trillions of hash computations per second and is the definition of "work." The difficulty adjusts every 2,016 blocks (~2 weeks) to keep block time at ~10 minutes regardless of how much hash rate joins the network. PoW is battle-tested — 15 years without a successful 51% attack on Bitcoin — but consumes ~150 TWh/year of electricity. It is the only consensus mechanism that has run a trillion-dollar network at scale for over a decade.'
      },
      pos: {
        title: 'Proof of Stake',
        body: 'Validators lock up ("stake") cryptocurrency as collateral. They are selected to propose and attest to blocks in proportion to their stake. Dishonest behaviour — signing two conflicting blocks — results in "slashing," where a portion of the stake is destroyed. Ethereum\'s PoS requires 32 ETH to run a validator node (~$80,000 at current prices), creating a high minimum that many users access through staking pools like Lido. PoS uses 99.95% less energy than PoW. The theoretical criticism: it may entrench the wealthy (large stakers earn more), though proponents argue PoW already entrenches industrial miners with cheap electricity.'
