  // DOUBLE SLIT CANVAS
  var canvas = document.getElementById('slit-canvas');
  var ctx = canvas.getContext('2d');
  var slitMode = 'wave';
  var particles = [];
  var patternData = null;

function buildPattern(mode) {
    var W = canvas.width, H = canvas.height;
    patternData = new Array(H).fill(0);
    if (mode === 'wave') {
      // Two-slit interference within a single-slit diffraction envelope.
      // Slit centers match the wall geometry drawn below: H*0.42 and H*0.58.
      var y1 = H * 0.42, y2 = H * 0.58;
      var L = 224;              // effective slit-to-screen distance
      var envWidth = H * 0.18;  // envelope sigma (single-slit diffraction)
      var centerY = (y1 + y2) / 2;
      for (var y = 0; y < H; y++) {
        var d1 = Math.sqrt(Math.pow(y - y1, 2) + L * L);
        var d2 = Math.sqrt(Math.pow(y - y2, 2) + L * L);
        var phase = (d1 - d2) * 1.1;
        var interference = Math.pow(Math.cos(phase / 2), 2);
        var envelope = Math.exp(-Math.pow(y - centerY, 2) / (2 * envWidth * envWidth));
        patternData[y] = interference * envelope * 0.95 + 0.02;
      }
    } else if (mode === 'which') {
      // With which-path info, particles land directly behind their slit:
      // two tight, well-separated bumps centered AT the slit positions.
      var y1 = H * 0.42, y2 = H * 0.58;
      var sigma = H * 0.035;
      var twoSigSq = 2 * sigma * sigma;
      for (var y = 0; y < H; y++) {
        var g1 = Math.exp(-Math.pow(y - y1, 2) / twoSigSq);
        var g2 = Math.exp(-Math.pow(y - y2, 2) / twoSigSq);
        patternData[y] = (g1 + g2) * 0.9 + 0.02;
      }
    } else {
      // Single slit: one diffraction bump centered on the slit at H*0.5
      var yc = H * 0.5;
      var sigma2 = H * 0.07;
      var twoSigSq2 = 2 * sigma2 * sigma2;
      for (var y = 0; y < H; y++) {
        patternData[y] = Math.exp(-Math.pow(y - yc, 2) / twoSigSq2) * 0.9 + 0.02;
      }
    }
    var max = Math.max.apply(null, patternData);
    patternData = patternData.map(function(v) { return v / max; });
  }

  function drawSlit() {
    var W = canvas.width, H = canvas.height;
    // Background
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark' ||
      (document.documentElement.getAttribute('data-theme') === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    var bgColor = isDark ? '#252523' : '#f5f5f4';
    var wallColor = isDark ? '#3a3a38' : '#ccc';
    ctx.fillStyle = bgColor;
    ctx.fillRect(0, 0, W, H);

    // Wall
    var wallX = W * 0.35;
    ctx.fillStyle = wallColor;
    ctx.fillRect(wallX - 4, 0, 8, H);

    // Slits (gaps)
    ctx.fillStyle = bgColor;
    if (slitMode !== 'single') {
      ctx.fillRect(wallX - 4, H * 0.37, 8, H * 0.10); // slit 1
      ctx.fillRect(wallX - 4, H * 0.53, 8, H * 0.10); // slit 2
    } else {
      ctx.fillRect(wallX - 4, H * 0.44, 8, H * 0.12); // one slit
    }

    // Screen on right
    ctx.fillStyle = wallColor;
    ctx.fillRect(W - 8, 0, 8, H);

    // Pattern on screen
    for (var y = 0; y < H; y++) {
      var intensity = patternData[y];
      ctx.fillStyle = 'rgba(83,74,183,' + (intensity * 0.9) + ')';
      ctx.fillRect(W - 8, y, 8, 1);
    }

    // Particles
    particles.forEach(function(p) {
      var alpha = p.life / 60;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(83,74,183,' + alpha + ')';
      ctx.fill();
    });

    // Label
    ctx.font = '11px system-ui';
    ctx.fillStyle = isDark ? 'rgba(168,166,158,0.8)' : 'rgba(95,94,90,0.8)';
    ctx.fillText(slitMode === 'wave' ? 'Interference pattern (both slits, no detector)' :
      slitMode === 'which' ? 'Two bands only (which-path detected)' :
      'Single-slit diffraction pattern', 10, 16);
  }

  window.setSlitMode = function(mode) {
    slitMode = mode;
    buildPattern(mode);
  };
  buildPattern('wave');

  function addParticle() {
    if (Math.random() > 0.3) return;
    var H = canvas.height;
    var wallX = canvas.width * 0.35;
    var targetY;
    // pick y from pattern distribution
    var r = Math.random();
    var cdf = 0;
    var total = patternData.reduce(function(a,b){return a+b;}, 0);
    for (var y = 0; y < H; y++) {
      cdf += patternData[y] / total;
      if (cdf >= r) { targetY = y; break; }
    }
    var startY = H * 0.47 + (Math.random() - 0.5) * H * 0.1;
    particles.push({ x: 10, y: startY, tx: canvas.width - 8, ty: targetY || H/2, life: 60, maxLife: 60 });
  }

  function animateSlit() {
    addParticle();
    particles.forEach(function(p) {
      var t = 1 - p.life / p.maxLife;
      p.x = 10 + t * (p.tx - 10);
      p.y = p.y + (p.ty - p.y) * 0.04 + (Math.random() - 0.5) * 0.5;
      p.life--;
    });
    particles = particles.filter(function(p) { return p.life > 0; });
    drawSlit();
    requestAnimationFrame(animateSlit);
  }
  animateSlit();

