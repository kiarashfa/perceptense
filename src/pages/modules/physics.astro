  // WAVEFUNCTION SVG PATH
  (function() {
    var svg = document.getElementById('spacetime-svg');
    if (!svg) return;
    // Already done as static SVG
  })();

// Draw wavefunction paths
  (function() {
    var svgEl = document.querySelector('svg[viewBox="0 0 500 200"]');
    if (!svgEl) return;
    var W = 500, H = 200;
    var baseline = 165;        // x-axis y-position in SVG coords
    var peakHeight = 120;      // total height of |ψ|² at its peak
    var cx = 250, sigma = 60;
    var pathFill = '', pathLine = '', pathReal = '';
    var points = [];
    for (var x = 30; x <= 470; x += 2) {
      var gauss = Math.exp(-Math.pow(x - cx, 2) / (2 * sigma * sigma));
      var y = baseline - gauss * peakHeight;
      points.push({x: x, y: y, g: gauss});
    }
    pathFill = 'M30,' + baseline;
    points.forEach(function(p) { pathFill += ' L' + p.x + ',' + p.y; });
    pathFill += ' L470,' + baseline + ' Z';

    pathLine = 'M' + points[0].x + ',' + points[0].y;
    points.slice(1).forEach(function(p) { pathLine += ' L' + p.x + ',' + p.y; });

    // Re(ψ) oscillates centered on the *middle* of the |ψ|² envelope,
    // with amplitude = half the envelope height. This keeps the wave
    // strictly between the Gaussian curve (top) and the x-axis (bottom),
    // touching each at its extrema but never crossing them.
    var realPts = [];
    for (var x2 = 30; x2 <= 470; x2 += 2) {
      var gauss2 = Math.exp(-Math.pow(x2 - cx, 2) / (2 * sigma * sigma));
      var envelope = gauss2 * peakHeight;     // Gaussian height at this x
      var center = baseline - envelope / 2;   // middle of the envelope
      var amplitude = envelope / 2;           // half the envelope -> fits inside
      var osc = Math.cos((x2 - cx) * 0.18);
      var y2 = center - amplitude * osc;      // SVG y grows downward
      realPts.push({x: x2, y: y2});
    }
    pathReal = 'M' + realPts[0].x + ',' + realPts[0].y;
    realPts.slice(1).forEach(function(p) { pathReal += ' L' + p.x + ',' + p.y; });

    var fillEl = svgEl.getElementById ? svgEl.getElementById('wf-path') : svgEl.querySelector('#wf-path');
    var lineEl = svgEl.getElementById ? svgEl.getElementById('wf-line') : svgEl.querySelector('#wf-line');
    var realEl = svgEl.getElementById ? svgEl.getElementById('wf-real') : svgEl.querySelector('#wf-real');
    if (fillEl) fillEl.setAttribute('d', pathFill);
    if (lineEl) lineEl.setAttribute('d', pathLine);
    if (realEl) realEl.setAttribute('d', pathReal);
  })();

