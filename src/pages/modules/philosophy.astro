    avicenna: { name:'Ibn Sina (Avicenna)', years:'980–1037 CE', origin:'Afshana, near Bukhara (modern Uzbekistan)', col:'#633806', bg:'#FAEEDA',
      wrote:'The Book of Healing (Kitab al-Shifa) — an encyclopaedia of philosophy and science spanning logic, natural sciences, mathematics, and metaphysics. The Canon of Medicine — the most influential medical textbook in both the Islamic world and medieval Europe. The Book of Salvation.',
