      { name: 'Russia', rank: 164, col: '#D32F2F' },
      { name: 'China', rank: 172, col: '#B71C1C' },
      { name: 'North Korea', rank: 177, col: '#880E4F' },
    ];
    const maxRank = 180;
    const pressChart = document.getElementById('press-chart');
    if (pressChart) {
      pressData.forEach(d => {
        const row = document.createElement('div');
        row.className = 'bar-row';
        row.style.marginBottom = '5px';
        row.innerHTML = `
          <div class="bl" style="width:110px;font-size:12px;">${d.name}</div>
          <div class="bb" style="flex:1;height:18px;background:var(--color-background-secondary);border-radius:3px;position:relative;">
            <div style="width:${(d.rank/maxRank*100)}%;background:${d.col};height:100%;border-radius:3px;display:flex;align-items:center;padding-left:6px;">
              <span style="font-size:10px;color:#fff;font-weight:600;white-space:nowrap;">#${d.rank}</span>
            </div>
          </div>`;
        pressChart.appendChild(row);
      });
    }

    // ────────────────────────────────────────────────────
    // RANGE SLIDER — newspaper jobs
    // ────────────────────────────────────────────────────
    const jobsByYear = {
      2006: 71000, 2007: 68000, 2008: 62000, 2009: 52000,
      2010: 48000, 2011: 45500, 2012: 43000, 2013: 41000,
      2014: 39500, 2015: 38000, 2016: 36000, 2017: 33000,
      2018: 30000, 2019: 28000, 2020: 24000, 2021: 23000,
      2022: 22000, 2023: 21000
    };
    const jobSlider = document.getElementById('u-w-100pct');
    const jobVal = document.getElementById('news-jobs-val');
    const jobOut = document.getElementById('news-jobs-out');
    function updateJobSlider(y) {
      const jobs = jobsByYear[y] || 21000;
      if (jobVal) jobVal.textContent = jobs.toLocaleString();
      if (jobOut) {
        const pct = Math.round((1 - jobs / 71000) * 100);
        jobOut.textContent = `In ${y}, US newspaper newsrooms employed approximately ${jobs.toLocaleString()} people — a ${pct > 0 ? pct + '% reduction' : 'baseline'} from the 2006 peak of 71,000. ${y >= 2020 ? 'The COVID-19 pandemic accelerated layoffs already underway, with dozens of major newspaper chains imposing furloughs and staff cuts in 2020.' : ''} ${y >= 2015 ? 'Local news closures are most concentrated in rural areas and small cities, creating regions where no professional reporter covers city hall, school boards, or local courts.' : 'The decline was initially concentrated at large metropolitan dailies losing classified and display advertising to digital competitors.'}`;
      }
    }
    if (jobSlider) {
      jobSlider.oninput = function() { updateJobSlider(parseInt(this.value)); };
      updateJobSlider(2006);
    }

    // ────────────────────────────────────────────────────
    // MULTI-CARD EXPLORER — advertising theories
    // ────────────────────────────────────────────────────
    const adthData = [
      {
        icon: '📣', name: 'AIDA model', sub: 'Classic hierarchy',
        title: 'AIDA: Awareness, Interest, Desire, Action',
        body: 'The AIDA model, developed by E. St. Elmo Lewis in 1898 and still widely used, describes advertising as moving prospects through four sequential states. Awareness: the consumer must first know the product exists. Interest: the message must engage them enough to want to learn more. Desire: they must want the product for themselves. Action: they must be moved to purchase. The model\'s weakness is the assumption that these stages occur sequentially and consciously. Modern behavioural economics shows that most purchases involve minimal deliberation — the choice is made largely by habits and heuristics, with the AIDA stages either compressed or bypassed entirely. Byron Sharp\'s research suggests "Action" rarely follows from individual ads; it follows from cumulative memory-structure building over years.'
      },
      {
        icon: '🧠', name: 'Emotional advertising', sub: 'Feeling over facts',
        title: 'Emotional advertising and System 1 thinking',
        body: 'Daniel Kahneman\'s System 1 (fast, intuitive) and System 2 (slow, rational) framework illuminates why most effective advertising works emotionally. System 1 processes most consumer choices; System 2 is rarely engaged in routine purchases. Emotional advertising — which builds positive feeling associations with a brand — is more effective than rational advertising for low-involvement purchases (FMCG, beverages, snacks) but less effective for high-involvement, considered purchases (cars, mortgages, medical devices). Les Binet and Peter Field\'s IPA Databank analysis of 1,400 UK advertising campaigns found that the most effective long-term campaigns were predominantly emotional, while the most effective short-term sales activation campaigns were rational. Best practice uses both in combination.'
      },
      {
        icon: '🔁', name: 'Mere exposure', sub: 'Familiarity breeds preference',
        title: 'Mere exposure effect',
        body: 'Robert Zajonc\'s 1968 experiments showed that repeated exposure to a stimulus — a Chinese character, a photograph, a musical phrase — reliably increased liking for it, even when subjects could not consciously recognise having seen it before. The implication for advertising: even ads that are not consciously registered, not recalled, and produce no explicit attitude change may be silently increasing brand preference through accumulated familiarity. This is why brand-building advertising continues even when no conscious "persuasion" is measurable. It also explains why newer brands must advertise heavily to achieve the familiarity advantage that established brands maintain simply by existing in consumers\' environments.'
      },
      {
        icon: '🏷️', name: 'Byron Sharp', sub: 'How Brands Grow',
        title: 'Byron Sharp\'s market-based evidence',
        body: 'Sharp\'s How Brands Grow (2010) challenged advertising mythology with empirical data from large-scale consumer panel research. Key findings: loyalty programs are largely ineffective because brand penetration (reaching more buyers) matters far more than loyalty depth. Light buyers of a category are more valuable targets than heavy loyal users, because most heavy users are already at ceiling. Distinctive brand assets (colours, logos, sounds, jingles) create memory retrieval cues that work without conscious processing. All brands in a category have broadly similar demographic profiles — the idea that some brands uniquely own a demographic is largely mythological. Sharp\'s work is influential among practitioners but contested by brand strategists who argue he underweights category-specific dynamics.'
      },
      {
        icon: '🎯', name: 'Targeting', sub: 'Right person, right time',
        title: 'Demographic to behavioural targeting',
        body: 'Early advertising targeting was demographic (women 18–34, ABC1 households) because that was the available data. TV and radio audiences were measured by surveys; newspaper circulation by audited figures. Digital advertising introduced behavioural targeting: buying based on what people had previously searched, browsed, or purchased. This raised a fundamental question about whether targeting improves or reduces effectiveness. Research by Nico Neumann and others suggests that demographic targeting is far less accurate than assumed (53–87% of impressions miss their intended target) and that broad reach often outperforms precision targeting for brand building. Precision targeting does, however, outperform for conversion-stage advertising where the goal is to reach people already in the consideration set.'
      },
    ];
    const adthGrid = document.getElementById('adth-grid');
    const adthDetail = document.getElementById('adth-detail');
    if (adthGrid && adthDetail) {
      adthData.forEach(d => {
        const card = document.createElement('div');
        card.className = 'elem-card';
        card.innerHTML = `<div class="elem-icon">${d.icon}</div><div class="elem-name">${d.name}</div><div class="elem-sub">${d.sub}</div>`;
        card.onclick = function() {
          document.querySelectorAll('#adth-grid .elem-card').forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          adthDetail.classList.add('show');
          adthDetail.innerHTML = `<h4>${d.title}</h4><p>${d.body}</p>`;
          adthDetail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };
        adthGrid.appendChild(card);
      });
    }

    // ────────────────────────────────────────────────────
    // CALCULATOR — ad reach
    // ────────────────────────────────────────────────────
    window.runAdCalc = function() {
      const budget = parseFloat(document.getElementById('calc-budget').value);
      const cpm = parseFloat(document.getElementById('calc-cpm').value);
      const ctr = parseFloat(document.getElementById('calc-ctr').value) / 100;
      const conv = parseFloat(document.getElementById('calc-conv').value) / 100;
      const result = document.getElementById('calc-result');
      if (!budget || !cpm || !ctr || !conv || cpm <= 0) {
        result.innerHTML = '<em style="color:var(--color-text-warning);">Please enter valid numbers in all fields.</em>';
        return;
      }
      const impressions = (budget / cpm) * 1000;
      const clicks = impressions * ctr;
      const conversions = clicks * conv;
      const cpc = budget / clicks;
      const cpa = budget / conversions;
      result.innerHTML = `
        <strong>Results for $${budget.toLocaleString()} budget at $${cpm} CPM:</strong><br><br>
        Total impressions: <strong>${Math.round(impressions).toLocaleString()}</strong><br>
        Expected clicks (at ${(ctr*100).toFixed(2)}% CTR): <strong>${Math.round(clicks).toLocaleString()}</strong><br>
        Expected conversions (at ${(conv*100).toFixed(2)}% rate): <strong>${Math.round(conversions).toLocaleString()}</strong><br>
        Effective cost per click: <strong>$${cpc.toFixed(2)}</strong><br>
        Cost per acquisition: <strong>$${cpa.toFixed(2)}</strong><br><br>
        <em style="color:var(--color-text-tertiary);font-size:12px;">Note: Industry average CTR for display ads is 0.1%; for search ads, 3–5%. Conversion rates vary from 0.5% (e-commerce) to 5%+ (lead gen landing pages). These are illustrative projections, not guarantees.</em>
      `;
    };

    // ────────────────────────────────────────────────────
    // RANGE SLIDER — ad strategy (rational to emotional)
    // ────────────────────────────────────────────────────
    window.updateAdStrat = function(v) {
      const el = document.getElementById('adstrat-val');
      const out = document.getElementById('adstrat-out');
      if (el) el.textContent = v;
      const messages = [
        { max: 15, text: 'Pure rational — product features, specifications, and price comparisons. Effective for high-involvement purchases: mortgages, cars, B2B software, medical devices. Examples: pharmaceutical ads listing clinical evidence, insurance comparison charts, technical spec sheets. Risk: easily outcompeted on a single dimension and vulnerable to competitors who match the stated claim.' },
        { max: 30, text: 'Rational-leaning — product benefits (not just features) framed rationally. Examples: Apple Mac vs PC "Get a Mac" campaign, Dyson demonstrating suction power claims. Effective for considered consumer purchases where genuine product differentiation exists. Byron Sharp would argue this is often wasted effort if the brand already has strong mental availability.' },
        { max: 50, text: 'Balanced — combines rational product messaging with emotional brand associations. Often the most flexible and effective approach for established brands. Examples: John Lewis Christmas ads (emotional) combined with product catalogue inserts (rational); car advertising combining safety data with aspirational lifestyle imagery. Les Binet and Peter Field\'s IPA research shows this combination outperforms pure strategies for long-term profit growth.' },
        { max: 70, text: 'Emotional-leaning — primarily builds feeling associations with the brand, with rational product claims secondary. Examples: Guinness ads emphasising masculine camaraderie, Dove Real Beauty, Nike athlete stories. Works because brand choice is often an emotional and identity signal, not a rational optimisation. Most effective for categories with low functional differentiation (soft drinks, beer, insurance).' },
        { max: 85, text: 'Strongly emotional — product is almost absent; advertising sells an identity or belonging. Examples: Red Bull and extreme sports, Patagonia and environmental activism, Supreme\'s scarcity marketing. The brand becomes a cultural object rather than a product category. Risk: expensive to maintain, requires consistent cultural credibility, and can alienate potential buyers who don\'t share the identity.' },
        { max: 100, text: 'Pure emotional / identity — no product rational whatsoever. Examples: Marlboro\'s cowboy era (pure masculine identity), perfume advertising (aspiration without any product claim), luxury goods (exclusivity as the only message). This strategy is only viable for brands with very high awareness and strong distinctive assets — it is not available to new or small brands.' },
      ];
      const msg = messages.find(m => parseInt(v) <= m.max);
      if (out && msg) out.textContent = msg.text;
    };
    updateAdStrat(50);

    // ────────────────────────────────────────────────────
    // PLATFORM CARDS
    // ────────────────────────────────────────────────────
    const platData = [
      { name: 'Facebook / Meta', stat: '3.07B', statLabel: 'monthly active users', body: 'World\'s largest social network, dominant among 35+ demographics. Revenue model: behavioural targeting advertising. Feed is primarily algorithmic, optimising for engagement. Average user sees 5–15% of their friends\' posts. Advertising CPMs are high due to targeting precision. Declining teenage usage in Western markets since 2012.' },
      { name: 'YouTube', stat: '2.5B', statLabel: 'logged-in monthly users', body: 'Second-largest search engine after Google. Watch time: 1 billion hours per day. Revenue split: YouTube keeps 45%, creators receive 55% of ad revenue. Recommendation algorithm accounts for 70% of viewing time. Long-form video (8–20 min) optimised for mid-roll ads. Increasingly competitive with Netflix for evening viewing.' },
      { name: 'Instagram', stat: '2.0B', statLabel: 'monthly active users', body: 'Visual platform, dominant for fashion, beauty, travel, food. Purchased by Facebook for $1 billion in 2012 in what is now studied as the most underpriced acquisition in tech history. Reels (short video) introduced to compete with TikTok, now drives 50% of time spent. Highest CPM rates among social platforms for certain luxury consumer segments.' },
      { name: 'TikTok', stat: '1.5B', statLabel: 'monthly active users', body: 'ByteDance-owned short-video platform. Differentiated by recommendation algorithm that serves content from non-followed accounts, making viral reach available to new creators. Average US user spends 95 minutes per day on the app — more than any other platform. Under US legislative threat since 2020 over data privacy and foreign ownership concerns. Dominant platform for Gen Z in Western markets.' },
      { name: 'X (Twitter)', stat: '550M', statLabel: 'monthly active users', body: 'Acquired by Elon Musk for $44 billion in 2022 at a price analysts consider dramatically overpaid. Advertisers reduced spend following content moderation changes; estimated revenue fell from $4.4B (2022) to $2.5B (2023). Disproportionate influence relative to size: 80% of content is produced by 20% of users, who skew toward journalists, politicians, and activists.' },
      { name: 'LinkedIn', stat: '1.0B', statLabel: 'registered members', body: 'Professional network owned by Microsoft since 2016. Dominant platform for B2B advertising, with highest CPMs of any social platform due to professional demographic targeting. Revenue: $15 billion in FY2023. Unusually high-quality feed for long-form professional content; less optimised for emotional engagement than consumer platforms, which correlates with lower but more productive user engagement.' },
    ];
    const platGrid = document.getElementById('plat-grid');
    if (platGrid) {
      platData.forEach(d => {
        const c = document.createElement('div');
        c.className = 'plat-card';
        c.innerHTML = `<div class="plat-name">${d.name}</div><div class="plat-stat">${d.stat}</div><div class="plat-stat-label">${d.statLabel}</div><div class="plat-body">${d.body}</div>`;
        platGrid.appendChild(c);
      });
    }

    // ────────────────────────────────────────────────────
    // COMPARISON SCALE — platform openness
    // ────────────────────────────────────────────────────
    const platScaleData = [
      { name: 'RSS / Podcasts', pct: 5 },
      { name: 'Email newsletters', pct: 8 },
      { name: 'X / Twitter', pct: 30 },
      { name: 'LinkedIn', pct: 45 },
      { name: 'YouTube', pct: 55 },
      { name: 'Facebook', pct: 72 },
      { name: 'Instagram', pct: 80 },
      { name: 'TikTok', pct: 90 },
    ];
    const platScale = document.getElementById('plat-scale');
    if (platScale) {
      platScaleData.forEach(d => {
        const row = document.createElement('div');
        row.className = 'cscale-row';
        const name = document.createElement('div');
        name.className = 'cscale-name';
        name.textContent = d.name;
        const track = document.createElement('div');
        track.className = 'cscale-track';
        const dot = document.createElement('div');
        dot.className = 'cscale-dot';
        dot.style.left = d.pct + '%';
        track.appendChild(dot);
        row.appendChild(name);
        row.appendChild(track);
        platScale.appendChild(row);
      });
    }

    // ────────────────────────────────────────────────────
    // RANGE SLIDER — influencer tiers
    // ────────────────────────────────────────────────────
    const inflTiers = [
      { label: 'Nano (1K–10K)', followers: '1K–10K', er: '4–8%', cpm: '$10–$50', fit: 'Hyper-local or niche products. Highest trust and engagement rates. Low cost. Best for: local businesses, specialist products, community-focused brands.', example: 'A local gym, craft brewery, or independent bookshop.' },
      { label: 'Micro (10K–100K)', followers: '10K–100K', er: '2–4%', cpm: '$50–$250', fit: 'Strong niche authority. Audiences actively follow for specific content (fitness, finance, cooking). Recommended for most direct-response campaigns. Best ROI tier per dollar spent according to most agency research.', example: 'A DTC protein brand partnering with 50 fitness micro-influencers outperforms one mega-influencer deal.' },
      { label: 'Mid-tier (100K–500K)', followers: '100K–500K', er: '1–3%', cpm: '$250–$1,000', fit: 'Established creators with professional production. Good balance of reach and authenticity. Suitable for product launches requiring broad niche awareness. Increasingly professionalised with manager representation.', example: 'YouTube finance channel, travel blogger with photography-quality content.' },
      { label: 'Macro (500K–1M)', followers: '500K–1M', er: '0.5–1.5%', cpm: '$1,000–$5,000', fit: 'Broad reach, declining engagement rates relative to micro tier. Brand safety concerns increase. Useful for brand awareness campaigns. Audience often less niche-defined. Requires careful alignment with brand values due to public scrutiny.', example: 'Lifestyle influencers, mainstream YouTubers, reality TV personalities.' },
      { label: 'Mega (1M+)', followers: '1M+', er: '0.2–1%', cpm: '$5,000+', fit: 'Celebrity-level reach. Very low engagement rates but massive absolute numbers. Suitable for mass-market consumer brands. Very high cost, lowest ROI per impression. Used mainly for brand-building, not conversion. High PR risk — any scandal directly impacts brand.', example: 'Major celebrities, A-list YouTube creators. Comparable to TV endorsement economics.' },
    ];
    const inflSlider = document.getElementById('infl-slider');
    const inflVal = document.getElementById('infl-val');
    const inflOut = document.getElementById('infl-out');
    window.updateInfluencer = function(v) {
      const t = inflTiers[parseInt(v) - 1];
      if (inflVal) inflVal.textContent = t.followers;
      if (inflOut) inflOut.innerHTML = `<strong>${t.label}</strong> — Followers: ${t.followers} | Typical engagement rate: ${t.er} | Typical CPM: ${t.cpm}<br><br>${t.fit}<br><br><em style="color:var(--color-text-tertiary);font-size:12px;">${t.example}</em>`;
    };
    if (inflSlider) {
      inflSlider.oninput = function() { updateInfluencer(this.value); };
      updateInfluencer(3);
    }

    // ────────────────────────────────────────────────────
    // EXPLORER PANEL — types of media bias
    // ────────────────────────────────────────────────────
    const biasData = {
      'Partisan bias': {
        title: 'Partisan / ideological bias',
        body: 'The most-discussed form: editorial positions, story selection, and framing that systematically favours one political ideology or party. Partisan bias is easiest to detect but often overstated as an explanation for differences in coverage. AllSides and Ad Fontes Media both produce media bias ratings by having analysts of different political perspectives independently rate articles. The consistent finding: most mainstream outlets are more centrist than consumers perceive them to be. Confirmation bias means readers of all political orientations rate the same outlets as biased against their side — the "hostile media effect" documented since 1985.',
        tags: ['Ideological', 'Detectable', 'Often overstated']
      },
      'Commercial bias': {
        title: 'Commercial / advertiser bias',
        body: 'Media dependent on advertising revenue systematically undercovers stories that threaten major advertisers. A study by Frank Hütten (2019) found German newspapers with high automotive advertising dependency published systematically less critical coverage of the Volkswagen emissions scandal. In the US, Ben Bagdikian\'s 1983 book The Media Monopoly documented systematic underreporting of consumer safety issues in products advertised in magazines. This bias is structural, not requiring any explicit instruction from advertisers: editors learn through experience which stories cause advertiser calls, and route around them.',
        tags: ['Structural', 'Systematic', 'Hard to detect']
      },
      'Access bias': {
        title: 'Access / source bias',
        body: 'Journalists who anger their primary sources lose access to those sources. White House correspondents, defence reporters, and corporate journalists all face this tension. The result is a bias toward "official" framings of events, and a systematic underrepresentation of perspectives that do not come with institutional press offices. Gans\'s 1979 analysis of CBS and Newsweek found that 70–85% of all sources were official governmental or corporate voices. The structure of beat journalism — where a reporter builds relationships in one domain over years — is excellent for access and terrible for independence. It is not corruption; it is an incentive structure.',
        tags: ['Source dependency', 'Beat journalism', 'Institutional']
      },
      'Structural / negativity bias': {
        title: 'Structural bias — negativity, novelty, simplification',
        body: 'Several systematic distortions arise not from ideology or money but from the structural requirements of journalism. Negativity: bad events are more newsworthy than equivalent good events, creating a systematically darker picture of reality than statistics support. Novelty: journalism covers events, not trends, so slow-moving causal processes (inequality, climate, long-term institutional decay) are underreported relative to sudden events. Simplification: journalists must explain complex issues to general audiences on tight deadlines, producing accounts that systematically strip out complexity, causation, and uncertainty. These biases are the hardest to correct because they are inseparable from what journalism is.',
        tags: ['Structural', 'Innate to format', 'Universal']
      },
      'Ownership bias': {
        title: 'Ownership and proprietorial bias',
        body: 'The opinions and interests of media owners directly shape editorial decisions in some outlets. Rupert Murdoch\'s direct involvement in editorial decisions at his newspapers is documented in the Leveson Inquiry and in Andrew Neil\'s memoir. The Sunday Times was blocked from investigating BSKYB (in which Murdoch had a direct financial interest) according to its former editor. The BBC\'s founding charter explicitly insulates it from proprietorial influence — its independence is institutional rather than dependent on owner restraint. But even without direct intervention, the culture of a newsroom is set by ownership, and what owners approve of — and what they would find embarrassing — shapes editorial choices from below.',
        tags: ['Proprietorial', 'Direct and indirect', 'BBC exception']
      },
    };
    const biasBtns = document.getElementById('bias-btns');
    const biasPanel = document.getElementById('bias-panel');
    if (biasBtns && biasPanel) {
      Object.keys(biasData).forEach((k, i) => {
        const b = document.createElement('button');
        b.className = 'exp-btn' + (i === 0 ? ' active' : '');
        b.textContent = k;
        b.onclick = function() {
          document.querySelectorAll('#bias-btns .exp-btn').forEach(x => x.classList.remove('active'));
          b.classList.add('active');
          const d = biasData[k];
          biasPanel.innerHTML = `<h4>${d.title}</h4><p>${d.body}</p><div class="exp-meta">${d.tags.map(t=>`<span class="exp-tag">${t}</span>`).join('')}</div>`;
        };
        biasBtns.appendChild(b);
      });
      // show first
      const first = Object.keys(biasData)[0];
      const d = biasData[first];
      biasPanel.innerHTML = `<h4>${d.title}</h4><p>${d.body}</p><div class="exp-meta">${d.tags.map(t=>`<span class="exp-tag">${t}</span>`).join('')}</div>`;
    }

  }); // end DOMContentLoaded
  
</script>
