        <div style="font-size:10px; color:var(--color-text-secondary); margin-bottom:2px;">Durability</div>${bar(f.dura[0],f.dura[1])}
        <div style="font-size:10px; color:var(--color-text-secondary); margin-top:3px;">Washability</div>${bar(f.washed[0],f.washed[1])}
      </div>
      <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:8px 10px;">
        <div style="font-size:10px; color:var(--color-text-secondary); margin-bottom:2px;">Eco score</div>${bar(f.eco[0],f.eco[1])}
        <div style="font-size:10px; color:var(--color-text-secondary); margin-top:3px;">Affordability</div>${bar(f.cost[0],f.cost[1])}
      </div>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
      <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:8px 10px;"><div style="font-size:10px; color:var(--color-text-secondary); margin-bottom:3px;">Overview</div><div style="font-size:11px; color:var(--color-text-primary); line-height:1.5;">${f.summary}</div></div>
      <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:8px 10px;"><div style="font-size:10px; color:var(--color-text-secondary); margin-bottom:3px;">Types &amp; grades</div><div style="font-size:11px; color:var(--color-text-primary); line-height:1.5;">${f.types}</div></div>
      <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:8px 10px;"><div style="font-size:10px; color:var(--color-text-secondary); margin-bottom:3px;">Care</div><div style="font-size:11px; color:var(--color-text-primary); line-height:1.5;">${f.care}</div></div>
