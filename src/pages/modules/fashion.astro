function updateFromOptions() {
  const cat = document.getElementById('size-cat').value;
  const data = sizeData[cat];
  const fromSel = document.getElementById('size-from');
  const prev = fromSel.value;
  const allSystems = ['eu','uk','us','it','fr'];
  const available = data.systems || allSystems;
  fromSel.innerHTML = allSystems.map(s =>
    available.includes(s)
      ? `<option value="${s}"${s===prev?' selected':''}>${s.toUpperCase()}</option>`
      : `<option value="${s}" disabled>${s.toUpperCase()} (n/a)</option>`
  ).join('');
  convertSize();
}

