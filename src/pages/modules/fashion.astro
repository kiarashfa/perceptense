const watchOrder = ['patek','rolex','ap','vc','jlc','omega','iwc','cartier','seiko','casio','panerai','smart'];

function showWatch(key) {
  // Update active tab
  document.querySelectorAll('.watch-tab').forEach(t => {
    t.classList.remove('active');
    if (t.getAttribute('onclick') && t.getAttribute('onclick').includes(`'${key}'`)) t.classList.add('active');
  });

  const w = watches[key];
  const isSmart = key === 'smart';
  const idx = watchOrder.indexOf(key);
  const prevKey = idx > 0 ? watchOrder[idx - 1] : null;
  const nextKey = idx < watchOrder.length - 1 ? watchOrder[idx + 1] : null;

  const modelsHtml = w.models.map(m => `
    <div style="border-bottom:0.5px solid var(--color-border-tertiary); padding:7px 0;">
      <div style="display:flex; align-items:baseline; gap:8px; margin-bottom:2px; flex-wrap:wrap;">
        <div style="font-size:12px; font-weight:500; color:var(--color-text-primary);">${m.name}</div>
        <div style="font-size:10px; color:var(--color-text-tertiary);">${m.ref}</div>
      </div>
      <div style="font-size:11px; color:var(--color-text-secondary); line-height:1.5;">${m.desc}</div>
    </div>`).join('');

  const navHtml = `
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px; padding-top:8px; border-top:0.5px solid var(--color-border-tertiary);">
      ${prevKey ? `<button onclick="showWatch('${prevKey}')" style="font-size:11px; padding:3px 9px;">← ${watches[prevKey].name}</button>` : '<span></span>'}
      ${nextKey ? `<button onclick="showWatch('${nextKey}')" style="font-size:11px; padding:3px 9px;">${watches[nextKey].name} →</button>` : '<span></span>'}
    </div>`;

  document.getElementById('watch-display').innerHTML = `
    <div style="display:flex; align-items:baseline; gap:10px; margin-bottom:10px; flex-wrap:wrap;">
      <div style="font-size:15px; font-weight:500; color:var(--color-text-primary);">${w.name}</div>
      <div style="font-size:11px; font-weight:500; background:${w.tierBg}; color:${w.tierCol}; border-radius:99px; padding:2px 9px;">${w.tier}</div>
    </div>
    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:7px; margin-bottom:10px;">
      <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:8px 10px;">
        <div style="font-size:10px; color:var(--color-text-secondary); margin-bottom:2px;">Founded</div>
        <div style="font-size:12px; color:var(--color-text-primary); line-height:1.4;">${w.founded} · ${w.founders}</div>
      </div>
      <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:8px 10px;">
        <div style="font-size:10px; color:var(--color-text-secondary); margin-bottom:2px;">HQ &amp; Made in</div>
        <div style="font-size:12px; color:var(--color-text-primary); line-height:1.4;">${w.hq}<br><span style="color:var(--color-text-secondary);">Made in: ${w.madein}</span></div>
      </div>
