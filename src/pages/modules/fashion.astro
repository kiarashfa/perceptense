const perfumeOrder = ['chanel5','dior','guerlain','creed','byredo','mfk','hermes','lv'];

function showPerfume(key) {
  document.querySelectorAll('.perfume-tab').forEach(t => {
    t.classList.remove('active');
    if (t.getAttribute('onclick') && t.getAttribute('onclick').includes(`'${key}'`)) t.classList.add('active');
  });
  const p = perfumes[key];
  const idx = perfumeOrder.indexOf(key);
  const prevKey = idx > 0 ? perfumeOrder[idx - 1] : null;
  const nextKey = idx < perfumeOrder.length - 1 ? perfumeOrder[idx + 1] : null;

  const navHtml = `
    <div class="watch-nav-row">
      ${prevKey ? `<button onclick="showPerfume('${prevKey}')" class="tab-button-narrow">← ${perfumes[prevKey].name}</button>` : '<span></span>'}
      ${nextKey ? `<button onclick="showPerfume('${nextKey}')" class="tab-button-narrow">${perfumes[nextKey].name} →</button>` : '<span></span>'}
    </div>`;

  document.getElementById('perfume-display').innerHTML = `
    <div class="header-row-spaced">
      <div class="title-medium">${p.name}</div>
      <div class="perfume-pill" style="background:${p.tierBg}; color:${p.tierCol};">${p.family}</div>
    </div>
    <div class="perfume-meta-grid">
      <div class="sub-card-compact">
        <div class="micro-label">House &amp; Country</div>
        <div class="body-compact">${p.house} · ${p.country}</div>
      </div>
      <div class="sub-card-compact">
        <div class="micro-label">Year / Nose</div>
        <div class="body-compact">${p.year} · ${p.nose}</div>
      </div>
      <div class="sub-card-compact">
        <div class="micro-label">Concentration</div>
        <div class="body-compact">${p.concentration}</div>
      </div>
      <div class="sub-card-compact">
        <div class="micro-label">Fragrance family</div>
        <div class="body-compact">${p.family}</div>
      </div>
    </div>
    <div class="perfume-about-block">${p.about}</div>
    <div class="perfume-notes-label">Notes structure</div>
    <div class="perfume-notes-block">${p.notes}</div>
    <div class="perfume-two-col">
      <div class="sub-card-compact">
        <div class="micro-label">Best occasions</div>
        <div class="perfume-meta-val-sm">${p.occasions}</div>
      </div>
      <div class="sub-card-compact">
        <div class="micro-label">Key nuance</div>
        <div class="perfume-meta-val-sm">${p.nuance}</div>
      </div>
    </div>
    ${navHtml}`;
}
