      <!-- Concentration tiers -->
      <div class="section-kicker">Concentration — what the terms on the bottle mean</div>
      <div class="concentration-grid">
        <div class="scent-panel-indigo">
          <div class="scent-title-indigo">Eau de Cologne (EDC)</div>
          <div class="scent-desc-indigo">2–4% concentration. Lightest. Lasts 1–2 hours. Best for hot weather or a quick refresh. Splash-on tradition.</div>
        </div>
        <div class="scent-panel-blue">
          <div class="scent-title-blue">Eau de Toilette (EDT)</div>
          <div class="scent-desc-blue">5–15% concentration. The most common type. Lasts 3–5 hours. Suitable for daytime and everyday wear.</div>
        </div>
        <div class="scent-panel-teal">
          <div class="scent-title-teal">Eau de Parfum (EDP)</div>
          <div class="scent-desc-teal">15–20% concentration. Richer, longer-lasting (5–8 hours). More expensive. Works well for evenings and cooler weather.</div>
        </div>
      </div>
