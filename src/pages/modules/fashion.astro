function convertSize() {
  const cat = document.getElementById('size-cat').value;
  const from = document.getElementById('size-from').value;
  const val = parseFloat(document.getElementById('size-val').value);
  if (isNaN(val)) return;
  const data = sizeData[cat];
  if (!data) return;

  // Map system key to column index based on headers
  const systemToCol = {};
  ['eu','uk','us','it','fr'].forEach(s => {
    data.headers.forEach((h,i) => {
      const hl = h.toLowerCase();
      if (hl.startsWith(s)) systemToCol[s] = i;
    });
  });
  // shirt special case
  if (cat === 'shirt') { systemToCol['eu'] = 0; systemToCol['uk'] = 1; }

  const colIdx = systemToCol[from];
  if (colIdx === undefined) {
    document.getElementById('size-result').innerHTML = `${from.toUpperCase()} sizing is not available for this category.`;
    return;
  }

  const match = data.rows.find(r => {
    const cell = r[colIdx];
    if (!cell) return false;
    if (cell.includes('–')) {
      const [lo, hi] = cell.split('–').map(Number);
      return val >= lo && val <= hi;
    }
    return parseFloat(cell) === val;
  });

  if (!match) {
    document.getElementById('size-result').innerHTML = `Size ${val} (${from.toUpperCase()}) not found for ${cat.replace('-',' ')}. Check the full table above.`;
    return;
  }

  let html = `<strong>${from.toUpperCase()} ${val}</strong> → `;
  const parts = [];
  data.headers.forEach((h,i) => {
    if (i === colIdx) return;
    if (match[i]) parts.push(`<strong>${h}:</strong> ${match[i]}`);
  });
  html += parts.join(' &nbsp;·&nbsp; ');
  document.getElementById('size-result').innerHTML = html;
}

