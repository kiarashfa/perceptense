function showEra(key) {
  const e = eras[key];
  document.getElementById('era-display').innerHTML = `
    <div style="font-size:13px; font-weight:500; color:var(--color-text-primary); margin-bottom:8px;">${e.title}</div>
    <div style="display:flex; flex-direction:column; gap:0;">
      ${e.events.map(ev => `
        <div style="display:flex; gap:10px; padding:6px 0; border-bottom:0.5px solid var(--color-border-tertiary);">
          <div style="font-size:11px; font-weight:600; color:var(--accent); width:40px; flex-shrink:0; padding-top:1px;">${ev.y}</div>
          <div style="font-size:12px; color:var(--color-text-primary); line-height:1.5;">${ev.e}</div>
        </div>`).join('')}
    </div>
    <div style="margin-top:8px; font-size:11px; color:var(--color-text-secondary); line-height:1.6;"><strong style="color:var(--color-text-primary);">Key shift:</strong> ${e.note}</div>`;
}

