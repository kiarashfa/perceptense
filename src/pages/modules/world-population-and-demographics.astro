</ModuleLayout>

<script is:inline>

    /* --- Live counter --- */
    const startTime = Date.now();
    const BIRTHS_PER_SEC = 4.46;
    const DEATHS_PER_SEC = 1.97;
    function updateCounter() {
      const elapsed = (Date.now() - startTime) / 1000;
      document.getElementById('births-count').textContent = Math.floor(elapsed * BIRTHS_PER_SEC).toLocaleString();
      document.getElementById('deaths-count').textContent = Math.floor(elapsed * DEATHS_PER_SEC).toLocaleString();
      document.getElementById('net-count').textContent = Math.floor(elapsed * (BIRTHS_PER_SEC - DEATHS_PER_SEC)).toLocaleString();
    }
    updateCounter();
    setInterval(updateCounter, 500);

    /* --- Age dot grid --- */
    (function buildDotGrid() {
      const grid = document.getElementById('age-dot-grid');
      const colors = {young: '#97C459', working: 'var(--accent)', old: '#f09595'};
      const counts = {young: 26, working: 65, old: 9};
      let html = '';
      for (let i = 0; i < counts.young; i++)   html += `<div class="dot" style="background:${colors.young}" title="0–14 years"></div>`;
      for (let i = 0; i < counts.working; i++) html += `<div class="dot" style="background:${colors.working}" title="15–64 years"></div>`;
      for (let i = 0; i < counts.old; i++)     html += `<div class="dot" style="background:${colors.old}" title="65+ years"></div>`;
      grid.innerHTML = html;
    })();

    /* --- Tab switcher --- */
    function switchTab(tabGroupId, panelGroupId, clickedBtn) {
      const tabBtns   = document.getElementById(tabGroupId).querySelectorAll('.tab-btn');
      const panels    = document.getElementById(panelGroupId).querySelectorAll('.elem-detail-panel');
      const targetId  = clickedBtn.dataset.tab;
      tabBtns.forEach(b => b.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      clickedBtn.classList.add('active');
      const target = document.getElementById(targetId);
      if (target) target.classList.add('active');
    }

    /* --- Billion calculator --- */
    function updateBillionCalc() {
      const rate = parseFloat(document.getElementById('u-mb-12px').value);
      document.getElementById('card-title').textContent = rate.toFixed(1) + '%';
      const currentPop = 8.2e9;
      const targetPop  = 9.2e9;
      const years = Math.log(targetPop / currentPop) / Math.log(1 + rate / 100);
      const calYear = 2025 + Math.round(years);
      const net80M  = 80e6;
      document.getElementById('billion-result').innerHTML =
        `At <strong>${rate.toFixed(1)}%</strong> annual growth, the world would reach 9.2 billion in about <strong>${Math.round(years)} years</strong> (around <strong>${calYear}</strong>).<br>` +
        `<span style="font-size:12px; color:var(--color-text-secondary);">Current UN medium projection assumes we hit 9B around 2037 (~0.9%/yr growth).</span>`;
    }
    updateBillionCalc();

    /* --- Lifetime births calculator --- */
    function updateLifetimeBirths() {
      const birthYear = parseInt(document.getElementById('u-w-100px').value);
      const currentYear = new Date().getFullYear();
      if (isNaN(birthYear) || birthYear < 1920 || birthYear > currentYear) {
        document.getElementById('lifetime-births-result').textContent = `Please enter a year between 1920 and ${currentYear}.`;
        return;
      }
      // Approximate annual births over time (rising from ~90M in 1950 to ~140M now)
      // Simplified linear model anchored on known data points
      function annualBirths(yr) {
        if (yr < 1950) return 80e6;
        if (yr < 1970) return 110e6 + (yr - 1950) * 0.5e6;
        if (yr < 1990) return 130e6;
        if (yr < 2010) return 135e6;
        return 140e6;
      }
      let totalBirths = 0;
      for (let y = birthYear; y < currentYear; y++) totalBirths += annualBirths(y);
      const ageyrs = currentYear - birthYear;
      const fmt = n => (n / 1e9).toFixed(2);
      document.getElementById('lifetime-births-result').innerHTML =
        `You've been alive for <strong>${ageyrs} years</strong>. In that time, roughly <strong>${fmt(totalBirths)} billion</strong> babies were born worldwide.<br>` +
        `<span style="font-size:12px; color:var(--color-text-secondary);">That's ${Math.round(totalBirths / 8.2e9 * 100)}% of today's entire living population born since your birth year.</span>`;
    }
    updateLifetimeBirths();

    /* --- Country compare --- */
    const COUNTRY_DATA = {
      japan:      { name: 'Japan',       pop: '125M',  fertility: '1.2',  lifeExp: '84',  medianAge: '49', urbanPct: '92%', growth: '-0.5%' },
      india:      { name: 'India',       pop: '1.44B', fertility: '2.0',  lifeExp: '70',  medianAge: '29', urbanPct: '36%', growth: '+0.8%' },
      usa:        { name: 'USA',         pop: '340M',  fertility: '1.7',  lifeExp: '78',  medianAge: '38', urbanPct: '83%', growth: '+0.5%' },
      nigeria:    { name: 'Nigeria',     pop: '230M',  fertility: '5.1',  lifeExp: '55',  medianAge: '18', urbanPct: '54%', growth: '+2.5%' },
      china:      { name: 'China',       pop: '1.41B', fertility: '1.0',  lifeExp: '78',  medianAge: '39', urbanPct: '65%', growth: '-0.1%' },
      germany:    { name: 'Germany',     pop: '84M',   fertility: '1.4',  lifeExp: '81',  medianAge: '45', urbanPct: '77%', growth: '+0.1%' },
      brazil:     { name: 'Brazil',      pop: '216M',  fertility: '1.7',  lifeExp: '74',  medianAge: '35', urbanPct: '87%', growth: '+0.6%' },
      southkorea: { name: 'South Korea', pop: '52M',   fertility: '0.72', lifeExp: '83',  medianAge: '44', urbanPct: '82%', growth: '-0.2%' },
    };
    function updateCountryCompare() {
      const aKey = document.getElementById('country-a').value;
      const bKey = document.getElementById('country-b').value;
      const a = COUNTRY_DATA[aKey];
      const b = COUNTRY_DATA[bKey];
      const metrics = [
        { label: 'Population',      ka: 'pop',       unit: '' },
        { label: 'Fertility rate',   ka: 'fertility', unit: ' children/woman' },
        { label: 'Life expectancy',  ka: 'lifeExp',   unit: ' yrs' },
        { label: 'Median age',       ka: 'medianAge', unit: ' yrs' },
        { label: 'Urban population', ka: 'urbanPct',  unit: '' },
        { label: 'Annual growth',    ka: 'growth',    unit: '' },
      ];
      let html = '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">';
      html += `<div style="font-size:11px;color:var(--color-text-tertiary);padding-bottom:4px;border-bottom:0.5px solid var(--color-border-tertiary);"></div>`;
      html += `<div style="font-size:12px;font-weight:600;color:var(--color-text-primary);padding-bottom:4px;border-bottom:0.5px solid var(--color-border-tertiary);">${a.name}</div>`;
      html += `<div style="font-size:12px;font-weight:600;color:var(--color-text-primary);padding-bottom:4px;border-bottom:0.5px solid var(--color-border-tertiary);">${b.name}</div>`;
      metrics.forEach(m => {
        html += `<div style="font-size:11px;color:var(--color-text-secondary);padding:5px 0;border-bottom:0.5px solid var(--color-border-tertiary);">${m.label}</div>`;
        html += `<div style="font-size:13px;font-weight:500;color:var(--color-text-primary);padding:5px 0;border-bottom:0.5px solid var(--color-border-tertiary);">${a[m.ka]}${m.unit}</div>`;
        html += `<div style="font-size:13px;font-weight:500;color:var(--color-text-primary);padding:5px 0;border-bottom:0.5px solid var(--color-border-tertiary);">${b[m.ka]}${m.unit}</div>`;
      });
      html += '</div>';
      document.getElementById('country-compare-output').innerHTML = html;
    }
    updateCountryCompare();
  
</script>
