      }
    };

    window.showBiome = function(key, btn) {
      const d = BIOMES[key];
      document.querySelectorAll('#biome-btns button').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('biome-panel').innerHTML =
        '<div class="exp-meta">' + d.meta + '</div>' +
        '<div class="exp-title">' + d.title + '</div>' +
        '<div class="exp-body">' + d.body + '</div>' +
        '<span class="exp-stat">' + d.stat + '</span>';
    };

    /* ════ Q&A toggle ════ */
    window.toggleQA = function(btn) {
      const ans = btn.nextElementSibling;
      const isShown = ans.classList.toggle('show');
      btn.textContent = isShown ? 'hide' : 'show answer';
    };

  }); // end DOMContentLoaded
  
</script>
