    window.showComm = function(key, btn) {
      const d = COMMS[key];
      document.querySelectorAll('#comm-btns button').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('comm-panel').innerHTML =
        '<div class="exp-meta">' + d.meta + '</div>' +
        '<div class="exp-title">' + d.title + '</div>' +
        '<div class="exp-body">' + d.body + '</div>' +
        '<span class="exp-stat">' + d.stat + '</span>';
    };

    /* ════ PART F — Trophic energy calculator ════ */
    window.calculateEnergy = function() {
      const base = Number(document.getElementById('energyInput').value);
      const eff  = Number(document.getElementById('efficiencyInput').value) / 100;
      const out  = document.getElementById('energyOutput');
      if (!isFinite(base) || !isFinite(eff) || base <= 0 || eff <= 0 || eff > 0.5) {
        out.textContent = 'Enter a positive starting amount and an efficiency from 1% to 50%. Most food-web examples use around 10%.';
        return;
      }
      const herb = base * eff;
      const meso = herb * eff;
      const apex = meso * eff;
      out.innerHTML =
        base.toLocaleString() + ' units at the producer level becomes ~' +
        Math.round(herb).toLocaleString() + ' for herbivores, ~' +
        Math.round(meso).toLocaleString() + ' for mid-level predators, and ~' +
        Math.round(apex).toLocaleString() + ' for apex predators. ' +
        'That ' + (eff * 100).toFixed(0) + '% efficiency means apex predators get ' +
        (eff * eff * eff * 100).toFixed(2) + '% of original energy — ' +
        'explaining why large top predators need enormous territories and are always rare.';
    };
    calculateEnergy();

    /* ════ PART F — Biome Explorer ════ */
    const BIOMES = {
      rainforest: {
