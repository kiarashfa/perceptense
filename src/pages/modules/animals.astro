    /* ════ PART D — Body mass slider ════ */
    window.updateMass = function() {
      const exponent = Number(document.getElementById('massSlider').value);
      const kg = Math.pow(10, exponent);
      const display = kg < 1 ? Math.round(kg * 1000) + ' g'
        : kg >= 1000 ? Math.round(kg).toLocaleString() + ' kg'
        : Number(kg.toFixed(1)).toLocaleString() + ' kg';
      const relativeTotal  = Math.pow(kg / 10, 0.75);
      const relativePerKg  = Math.pow(kg / 10, -0.25);
      document.getElementById('massValue').textContent = display;
      document.getElementById('massOutput').textContent =
        'Using Kleiber\'s law (BMR scales as mass^0.75), this animal uses about ' + relativeTotal.toFixed(2) +
        ' times the total resting energy of a 10 kg animal, but about ' + relativePerKg.toFixed(2) +
        ' times the energy per kilogram. Tiny animals burn hot per gram; large animals are fuel-efficient per kilogram but expensive in absolute terms. This is why a shrew must eat nearly continuously, while a python can wait months between meals.';
    };
    updateMass();

    /* ════ PART D — Metabolic rate calculator ════ */
    window.calcMeta = function() {
      const mass = parseFloat(document.getElementById('meta-mass').value);
      const type = document.getElementById('meta-type').value;
      if (isNaN(mass) || mass <= 0 || mass > 10000) {
        document.getElementById('meta-output').innerHTML = '<span style="color:var(--color-text-danger);">Please enter a valid mass (0.001–10000 kg).</span>';
        return;
      }
      const mammalBMR = 70 * Math.pow(mass, 0.75);
      let bmr, label;
      if (type === 'mammal')  { bmr = mammalBMR;       label = 'Mammal'; }
      else if (type === 'bird')    { bmr = mammalBMR * 1.5;  label = 'Bird'; }
      else if (type === 'reptile') { bmr = mammalBMR * 0.1;  label = 'Reptile'; }
      else                         { bmr = mammalBMR * 0.08; label = 'Insect'; }
      const active     = bmr * 2.2;
      const reptileBMR = mammalBMR * 0.1;
      const ratio      = (bmr / reptileBMR).toFixed(1);
      const lines = [
        '<strong>' + label + ' · ' + mass + ' kg</strong>',
        'Resting metabolic rate: ~<strong>' + Math.round(bmr).toLocaleString() + ' kcal/day</strong>',
        'Active metabolic rate (est. ×2.2): ~<strong>' + Math.round(active).toLocaleString() + ' kcal/day</strong>'
      ];
      if (type === 'mammal' || type === 'bird') {
        lines.push('A reptile of the same mass needs only ~<strong>' + Math.round(reptileBMR).toLocaleString() + ' kcal/day</strong> — about ' + (1 / (bmr / mammalBMR) * 10).toFixed(0) + 'x less than this animal, explaining why a Komodo dragon can survive on ~12 large meals per year.');
      } else {
        lines.push('An equivalent mammal needs about ' + ratio + 'x more energy per day, explaining why reptiles and insects can survive months in dormancy while mammals cannot.');
      }
      document.getElementById('meta-output').innerHTML = lines.join('<br>');
    };
    calcMeta();

    /* ════ PART D — R/K slider ════ */
    const RK_POINTS = [
      { v: 0,  name: 'Ocean sunfish (Mola mola)',        note: 'Up to 300 million eggs per year — the most of any vertebrate. No parental care. Larvae survive through sheer numbers; first-year mortality exceeds 99.9%. A pure bet-hedging strategy.' },
      { v: 10, name: 'Cod (Gadus morhua)',               note: '~9 million eggs per spawning, no care. Classic r-strategy has made cod populations vulnerable to collapse when overfished — the population cannot rebuild fast enough against fishing mortality.' },
      { v: 22, name: 'Sea turtle (Chelonia mydas)',      note: '~110 eggs per nest, 7 nests per season, no post-hatching care. Long-lived (80+ years) and slow to mature — a K-trait mixed with high reproductive output. The combination makes populations vulnerable: remove adults faster than they mature and the population collapses.' },
      { v: 33, name: 'Salmon (Oncorhynchus)',            note: '2,000–10,000 eggs guarded in a gravel nest (redd). Female guards until she dies. Transitional: high egg count but genuine parental investment. Pacific salmon die after spawning, decomposing and fertilising the entire river ecosystem.' },
      { v: 44, name: 'Rabbit (Oryctolagus cuniculus)',   note: 'Up to 12 litters of 4–12 kits per year. Gestation 28–31 days; kits are rapidly independent. A mammalian r-strategist — populations can explode in weeks given food and safety, which is why rabbit introductions are so ecologically destructive.' },
      { v: 56, name: 'Lion (Panthera leo)',              note: 'Litters of 2–4 cubs, weaned at 6 months, dependent 2 years. Communal pride structure allows allomothering — other females nurse cubs. 80% first-year cub mortality in the wild, offset by multiple breeding females in a pride.' },
      { v: 67, name: 'Wolf (Canis lupus)',               note: 'One litter per year of 4–6 pups; the entire pack invests 2 years in each cohort. Pack members regurgitate food for pups and guard them — extreme cooperative breeding unusual in Carnivora.' },
      { v: 80, name: 'African elephant',                 note: 'Single calf, 22-month gestation — the longest of any land mammal. Interbirth interval 4–5 years. Calves remain in the matriarchal family for life, learning foraging knowledge and social information that is passed across generations.' },
      { v: 91, name: 'Chimpanzee (Pan troglodytes)',     note: 'Single offspring, 3-year nursing, 7-year dependency. Females have only 4–5 offspring per lifetime. Extensive social learning: offspring acquire tool use, foraging strategies, and social rules from mothers and group members over years.' },
      { v: 100, name: 'Human (Homo sapiens)',            note: 'Singletons (mostly), 9-month gestation, ~180+ months of dependency — the most extreme K-strategy in primates. Human childhood is the evolutionary cost of a large, slow-maturing brain. Extended childhood also allows cultural transmission of accumulated knowledge across generations.' }
    ];

    window.updateRK = function(val) {
      const v = parseInt(val);
      let closest = RK_POINTS[0];
      let minDist = Math.abs(RK_POINTS[0].v - v);
      RK_POINTS.forEach(function(p) {
        const d = Math.abs(p.v - v);
        if (d < minDist) { minDist = d; closest = p; }
      });
      document.getElementById('rk-output').textContent = closest.name;
      document.getElementById('rk-note').textContent   = closest.note;
    };
    updateRK(50);

    /* ════ PART E — Intelligence scale ════ */
    const INTEL = [
      { name: 'Tick (questing)',         pct: 5  },
