        stat: 'Sharks detect electrical fields of 5 nV/cm — equivalent to a battery in the ocean 1,000 km away'
      },
      magneto: {
        title: 'Magnetoreception',
        meta: 'Birds, sea turtles, salmon, bees, some mammals',
