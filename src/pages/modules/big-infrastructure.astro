      btn.classList.add('active');
      document.getElementById('asp-' + type).classList.add('active');
    }

    /* === BUILDING EXPERIENCE SLIDERS === */
    var expData = {
      light: {
        vals: [
          { threshold: 30, label: 'Low', note: 'Predominantly artificial lighting with little or no daylight. Associated with disrupted circadian rhythms, poorer sleep quality (~40 min less per night), lower mood, and reduced alertness. Common in deep-plan offices and basement workspaces.' },
          { threshold: 60, label: 'Moderate', note: 'Some daylight access, supplemented by artificial lighting. Better than fully artificial environments. Workers in mixed-light offices sleep an average of 20 minutes more per night than fully artificial environments. Morning sunlight exposure remains limited.' },
          { threshold: 101, label: 'High', note: 'Plentiful natural daylight throughout the working day. Studies show up to 18% higher productivity, 46 more minutes of sleep per night, and measurably better mood compared to windowless environments. Hospital patients in sunny rooms leave ~1 day earlier on average.' }
        ]
      },
      ceiling: {
        vals: [
          { threshold: 30, label: 'Low (~2.1 m)', note: 'Very low ceilings create a sense of enclosure that primes the brain for detail-oriented, focused work. Suitable for individual workstations, exam rooms, and tasks requiring intense concentration. Can feel oppressive over long periods.' },
          { threshold: 60, label: 'Standard (~2.4–2.7 m)', note: 'Standard residential and office ceiling height. Neutral effect on cognition. Well-suited to most working and living activities. The global "default" ceiling height in post-war construction.' },
          { threshold: 101, label: 'High (~4 m+)', note: 'High ceilings measurably activate abstract, associative, and creative thinking modes. Better for brainstorming, creative work, and browsing activities. Research found participants in high-ceilinged rooms showed better performance on abstract and relational tasks.' }
        ]
      },
      green: {
        vals: [
          { threshold: 25, label: 'None', note: 'No greenery, views of concrete or blank walls. Highest levels of measured stress hormones. Attention fatigue sets in faster. This environment is associated with higher rates of reported dissatisfaction in workplace surveys.' },
          { threshold: 55, label: 'Some', note: 'Potted plants or partial views of greenery. Even modest greenery produces measurable reductions in cortisol levels within minutes. Indoor plants are associated with ~15% lower absenteeism in some studies, though effect sizes vary.' },
          { threshold: 101, label: 'High', note: 'Views of parks, trees, or abundant indoor planting. Strong evidence for stress recovery (natural views reduce stress hormones within 5 minutes). Workers with tree views are absent ~1 fewer day per year. Post-surgery patients with garden views required fewer pain medications.' }
        ]
      },
      acoustic: {
        vals: [
          { threshold: 25, label: 'Poor', note: 'High reverberation, background noise, poor speech intelligibility. The most common complaint in open-plan offices. Cognitive tasks requiring reading and writing suffer most. Background speech is more disruptive than background noise of equivalent loudness because the brain involuntarily processes language.' },
          { threshold: 55, label: 'Moderate', note: 'Some acoustic treatment present. Speech remains intermittently distracting. Common in offices with partial acoustic panels or soft furnishings. Significant improvement over untreated open plans, but not optimal for sustained deep work.' },
          { threshold: 101, label: 'Good', note: 'Well-controlled acoustics with appropriate reverberation time for the space type. Short reverberation (~0.4–0.6 s) for offices and classrooms; longer (~1.8–2.0 s) for concert halls. Good acoustics in classrooms measurably improve reading test scores for children. Concert hall acoustics can cost $2–5M to achieve correctly.' }
        ]
      }
    };

    function updateExp(key, val) {
      val = parseInt(val);
      var data = expData[key];
      var chosen = data.vals[data.vals.length - 1];
      for (var i = 0; i < data.vals.length; i++) {
        if (val < data.vals[i].threshold) { chosen = data.vals[i]; break; }
      }
      document.getElementById(key + '-val').textContent = chosen.label;
      document.getElementById(key + '-note').textContent = chosen.note;
    }

    /* === URBAN PLANNING ZONE EXPLORER === */
