    /* === FREIGHT CALCULATOR === */
    var calcCurrentMode = 'sea';
    var calcModes = {
      sea:  { rateMin: 0.05, rateMax: 0.15, label: 'Sea freight', note: 'Sea freight is priced per tonne-km. The enormous scale of container ships (up to ~175,000 t capacity) is what makes this so cheap. Typical routes: Asia-Europe ≈ $0.05–0.10/tonne-km.' },
      air:  { rateMin: 4,    rateMax: 8,    label: 'Air freight',  note: 'Air freight is 50–100× more expensive than sea per tonne-km. It is only rational for time-critical, high-value, or perishable goods, pharmaceuticals, semiconductors, cut flowers, live seafood.' },
      road: { rateMin: 0.08, rateMax: 0.25, label: 'Road freight', note: 'Road freight (HGV) costs more per tonne-km than sea but less than air. It dominates for inland and short-haul distribution where sea routes don\'t reach. EU road limit: 26t payload per truck.' }
    };

    function setMode(mode) {
      calcCurrentMode = mode;
      document.querySelectorAll('.calc-mode-btn').forEach(function(b) { b.classList.remove('active'); });
      event.target.classList.add('active');
      calcFreight();
    }

    function calcFreight() {
      var weight = parseFloat(document.getElementById('calc-weight').value) || 0;
      var dist   = parseFloat(document.getElementById('calc-dist').value)   || 0;
      var m = calcModes[calcCurrentMode];
      if (weight <= 0 || dist <= 0) return;
      var low  = weight * dist * m.rateMin;
      var high = weight * dist * m.rateMax;
      var perTonneLow  = dist * m.rateMin;
      var perTonneHigh = dist * m.rateMax;
      document.getElementById('calc-total').textContent = '$' + formatMoney(low) + ' – $' + formatMoney(high);
      document.getElementById('calc-total-label').textContent = 'estimated cost (' + m.label + ')';
      document.getElementById('calc-per-tonne').textContent = '$' + formatMoney(perTonneLow) + ' – $' + formatMoney(perTonneHigh);
      document.getElementById('calc-note').textContent = m.note;
    }

    function formatMoney(n) {
      if (n >= 1e9) return (n/1e9).toFixed(2) + 'B';
      if (n >= 1e6) return (n/1e6).toFixed(1) + 'M';
      if (n >= 1e3) return (n/1e3).toFixed(0) + 'K';
      return n.toFixed(0);
    }

    // init
    calcFreight();

    /* === AIRPORTS & STATIONS HUB SWITCHER === */
    function switchHub(type, btn) {
      document.querySelectorAll('.hub-tab').forEach(function(t) { t.classList.remove('active'); });
      document.querySelectorAll('.hub-panel').forEach(function(p) { p.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('hub-' + type).classList.add('active');
    }

    /* === ARCHITECTURE STYLE EXPLORER === */
    function switchArchStyle(type, btn) {
      document.querySelectorAll('.arch-style-tab').forEach(function(t) { t.classList.remove('active'); });
