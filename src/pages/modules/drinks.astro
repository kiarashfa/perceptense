        <text x="545" y="56" text-anchor="middle" font-size="9"  fill="#534AB7" font-family="system-ui">Often mix</text>
        <text x="545" y="65" text-anchor="middle" font-size="9"  fill="#534AB7" font-family="system-ui">varieties/vintages</text>
        <text x="636" y="41" text-anchor="middle" font-size="11" font-weight="500" fill="#712B13" font-family="system-ui">Bottle</text>
