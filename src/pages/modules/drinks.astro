function showWine(key) {
  const w = wines[key];
  // Colour indicator
  const typeColor = w.type === 'Red' ? '#7A1E1E' : w.type === 'White' ? '#C9A84C' : w.type === 'Pink' ? '#E8A0A0' : w.type === 'Sparkling' ? '#E8D090' : '#888';
  const typeBg    = w.type === 'Red' ? '#FCEBEB' : w.type === 'White' ? '#FAEEDA' : w.type === 'Pink' ? '#FCF0F0' : w.type === 'Sparkling' ? '#F9F6E8' : 'var(--color-background-secondary)';

  const barDims = [
    { label:'Body',    val:w.profile.body,    col:'#A32D2D' },
    { label:'Tannin',  val:w.profile.tannin,  col:'#712B13' },
    { label:'Acidity', val:w.profile.acidity, col:'#27500A' },
    { label:'Fruit',   val:w.profile.fruit,   col:'#633806' },
    { label:'Oak',     val:w.profile.oak,     col:'#854F0B' },
  ];
  const profileHtml = barDims.map(b => `
    <div class="taste-bar-row">
      <div class="taste-bar-label">${b.label}</div>
      <div class="taste-bar-track">
        <div class="taste-bar-fill" style="width:${b.val * 20}%; background:${b.col};"></div>
      </div>
      <div style="font-size:10px; color:var(--color-text-tertiary); width:16px; text-align:right; flex-shrink:0;">${b.val}/5</div>
    </div>`).join('');

  document.getElementById('wine-display').innerHTML = `
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px; flex-wrap:wrap;">
      <div style="width:12px; height:12px; border-radius:50%; background:${w.col}; flex-shrink:0;"></div>
      <div style="font-size:15px; font-weight:500; color:var(--color-text-primary);">${w.name}</div>
      <div style="font-size:11px; font-weight:500; background:${typeBg}; color:${typeColor}; border-radius:99px; padding:2px 9px;">${w.type}</div>
      <div style="font-size:11px; color:var(--color-text-secondary);">Serve at ${w.temp} · ABV ${w.abv}</div>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
      <div>
        <div style="font-size:11px; color:var(--color-text-secondary); margin-bottom:6px;">Tasting profile</div>
        <div style="background:var(--color-background-primary); border-radius:var(--border-radius-md); padding:10px;">${profileHtml}</div>
      </div>
      <div>
        <div style="background:var(--color-background-primary); border-radius:var(--border-radius-md); padding:10px 11px; margin-bottom:8px;">
          <div style="font-size:11px; color:var(--color-text-secondary); margin-bottom:3px;">Flavours</div>
          <div style="font-size:12px; color:var(--color-text-primary); line-height:1.5;">${w.flavours}</div>
        </div>
        <div style="background:var(--color-background-primary); border-radius:var(--border-radius-md); padding:10px 11px;">
          <div style="font-size:11px; color:var(--color-text-secondary); margin-bottom:3px;">Key regions</div>
          <div style="font-size:12px; color:var(--color-text-primary); line-height:1.5;">${w.regions}</div>
        </div>
      </div>
    </div>
    <div style="background:var(--color-background-primary); border-radius:var(--border-radius-md); padding:9px 11px; font-size:12px; color:var(--color-text-secondary); line-height:1.5;">${w.notes}</div>`;

  // Update active button state
  document.querySelectorAll('.wine-btn').forEach(b => {
    b.classList.remove('active');
    if (b.getAttribute('onclick') === `showWine('${key}')`) b.classList.add('active');
  });
}

