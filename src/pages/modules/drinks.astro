function updateCoffee() {
  const idx = parseInt(document.getElementById('u-flex-1').value);
  const d = coffeeDrinks[idx];
  document.getElementById('coffee-drink-name').textContent = d.name;
  document.getElementById('coffee-drink-desc').textContent = d.desc;
  const bar = document.getElementById('coffee-drink-bar');
  bar.innerHTML = '';
  const add = (w, col) => {
    if (!w) return;
    const div = document.createElement('div');
    div.style.cssText = `flex:${w}; background:${col};`;
    bar.appendChild(div);
  };
  add(d.shots,      '#3C2415');
  add(d.water,      '#B8D4E8');
  add(d.steamedMilk,'#D4A679');
  add(d.foam,       '#F5E6D3');
}
document.getElementById('u-flex-1').addEventListener('input', updateCoffee);

/* ══════════════════════════════════════
   ABV UNITS CALCULATOR
══════════════════════════════════════ */
function calcUnits() {
  const vol = parseFloat(document.getElementById('u-w-100pct').value);
  const abv = parseFloat(document.getElementById('calc-abv').value);
  const res = document.getElementById('calc-result');
  if (isNaN(vol) || isNaN(abv) || vol <= 0 || abv <= 0) {
    res.style.display = 'block';
    res.textContent = 'Please enter valid values.';
    return;
  }
  const pureAlcoholMl = vol * (abv / 100);
  const ukUnits = pureAlcoholMl / 10;
  const usStandardDrinks = pureAlcoholMl / 17.7;
  res.style.display = 'block';
  res.innerHTML = `<strong style="color:var(--color-text-primary);">${vol} ml at ${abv}% ABV</strong> contains <strong style="color:var(--color-text-primary);">${pureAlcoholMl.toFixed(1)} ml of pure alcohol.</strong><br>
    That is <strong style="color:var(--color-text-primary);">${ukUnits.toFixed(1)} UK units</strong> (recommended max: 14 units/week, no more than 3–4 in one day).<br>
    And <strong style="color:var(--color-text-primary);">${usStandardDrinks.toFixed(1)} US standard drinks</strong> (recommended max: 2/day for men, 1/day for women).<br>
    <span style="font-size:11px; color:var(--color-text-tertiary);">Example: a 750 ml bottle of 13% wine = 9.75 UK units = 5.5 US standard drinks.</span>`;
}

