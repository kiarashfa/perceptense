      if (m === 0) msg = 'New appointment: performance is unpredictable. Teams often improve simply through regression to the mean after a bad run.';
      else if (m <= 6) msg = `${m} months: the "new manager effect" is observable, typically 0.15–0.25 additional points per game. Research suggests this is partly real (new instructions, fresh motivation) and partly regression to mean (managers tend to be sacked after below-average form).`;
