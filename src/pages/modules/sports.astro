          <rect x="20" y="100" width="100" height="140" rx="3" fill="none" stroke="var(--color-border-tertiary)" stroke-width="0.8"/>
          <rect x="380" y="100" width="100" height="140" rx="3" fill="none" stroke="var(--color-border-tertiary)" stroke-width="0.8"/>
          <!-- Goal boxes -->
          <rect x="20" y="135" width="40" height="70" rx="2" fill="none" stroke="var(--color-border-tertiary)" stroke-width="0.8"/>
          <rect x="460" y="135" width="40" height="70" rx="2" fill="none" stroke="var(--color-border-tertiary)" stroke-width="0.8"/>
          <!-- Pitch fill -->
          <rect x="20" y="10" width="480" height="320" rx="6" fill="var(--accent-bg)" opacity="0.4"/>
