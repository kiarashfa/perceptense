      };
      if (i === 0) { btn.classList.add('active'); fPanel.innerHTML = `<div class="ep-title">${formations[key].title}</div><div class="ep-body">${formations[key].body}</div>`; }
      fBtns.appendChild(btn);
    });

    // ─── PPDA chart ───
    const ppdaData = [
      { name: 'Liverpool 2019–20', val: 6.2, cls: 'sp-red' },
      { name: 'Man City 2022–23', val: 7.8, cls: 'sp-lightblue' },
