    function updateTraining() {
      const w = parseInt(trainingSlider.value);
      const baseVO2 = 38;
      let gain, note;
      if (w === 0) { gain = 0; note = 'Starting point for a moderately active adult (38 ml/kg/min baseline).'; }
      else if (w <= 8) { gain = Math.round(w * 0.45); note = 'Early gains are rapid as the body adapts to aerobic stimulus. Mitochondrial density increases and cardiac stroke volume rises.'; }
      else if (w <= 24) { gain = Math.round(3.6 + (w - 8) * 0.2); note = 'Gains slow as the body approaches its trained plateau. Consistency matters more than intensity at this stage.'; }
      else if (w <= 40) { gain = Math.round(6.8 + (w - 24) * 0.08); note = 'Marginal improvements require periodised training and recovery. Overtraining risk increases.'; }
      else { gain = Math.round(8.1 + (w - 40) * 0.03); note = 'Near-plateau territory. Elite gains now require altitude training, heat adaptation, or other marginal interventions.'; }
      const newVO2 = baseVO2 + gain;
      trainingOut.textContent = `After ${w} weeks of structured aerobic training: estimated VO₂ max ≈ ${newVO2} ml/kg/min (gain of +${gain}). ${note}`;
    }
    trainingSlider.addEventListener('input', updateTraining);
    updateTraining();

    // ─── Tactics timeline ───
    const tacticsEras = [
      { label: '2-3-5 / Pyramid', start: 1863, end: 1925, cls: 'sp-green' },
      { label: 'WM (Herbert Chapman)', start: 1925, end: 1953, cls: 'sp-blue' },
      { label: 'Catenaccio / 4-3-3', start: 1950, end: 1970, cls: 'sp-red' },
      { label: 'Total Football', start: 1965, end: 1978, cls: 'sp-amber' },
      { label: '4-4-2 era', start: 1970, end: 2005, cls: 'sp-purple' },
      { label: 'Pressing revolution', start: 2005, end: 2015, cls: 'sp-cyan' },
      { label: 'Positional / xG era', start: 2012, end: 2024, cls: 'sp-teal' },
    ];
    const minY = 1863, maxY = 2024, span = maxY - minY;
    const ttEl = document.getElementById('tactics-timeline');
    let html = tacticsEras.map(e => {
      const left = ((e.start - minY) / span) * 100;
      const width = ((e.end - e.start) / span) * 100;
      return `<div class="value-row">
