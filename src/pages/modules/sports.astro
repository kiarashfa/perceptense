    const ppdaEl = document.getElementById('ppda-chart');
    ppdaEl.innerHTML = ppdaData.map(d => barRow(d.name, d.val, 20, d.cls, '')).join('');

    // ─── xG calculator ───
    window.calcXG = function() {
      const dist = parseFloat(document.getElementById('xg-distance').value);
      const angle = parseFloat(document.getElementById('xg-angle').value);
      const type = document.getElementById('xg-type').value;
      if (isNaN(dist) || isNaN(angle) || dist < 3 || dist > 40 || angle < 0 || angle > 70) {
        document.getElementById('xg-out').textContent = 'Please enter valid values: distance 3–40m, angle 0–70°.';
        return;
      }
      let base = Math.exp(-0.14 * dist - 0.025 * angle);
      if (type === 'head') base *= 0.45;
      if (type === 'volley') base *= 0.6;
      base = Math.min(0.95, Math.max(0.01, base));
      const xg = base.toFixed(3);
      let quality;
      if (base >= 0.4) quality = 'big chance (goalkeeper save required)';
      else if (base >= 0.2) quality = 'good chance';
      else if (base >= 0.1) quality = 'decent opportunity';
      else if (base >= 0.05) quality = 'difficult chance';
      else quality = 'long-shot attempt';
      document.getElementById('xg-out').textContent = `Estimated xG: ${xg}: classified as a ${quality}. In an average match, a team accumulating 10 such shots would expect ${(base * 10).toFixed(1)} goals. Note: this is a simplified model; full xG models incorporate shot pressure, assist type, goalkeeper positioning, and historical sample sizes of 100,000+ shots.`;
