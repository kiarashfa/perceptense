          <circle cx="60" cy="170" r="14" fill="var(--accent)" opacity="0.9"/>
          <text x="60" y="174" text-anchor="middle" font-size="9" class="pos-label-accent" font-weight="700">GK</text>
          <!-- Defenders -->
          <circle cx="130" cy="110" r="13" fill="var(--accent)" opacity="0.8"/>
          <text x="130" y="114" text-anchor="middle" font-size="9" class="pos-label-accent" font-weight="700">LB</text>
          <circle cx="155" cy="155" r="13" fill="var(--accent)" opacity="0.8"/>
          <text x="155" y="159" text-anchor="middle" font-size="9" class="pos-label-accent" font-weight="700">CB</text>
          <circle cx="155" cy="185" r="13" fill="var(--accent)" opacity="0.8"/>
          <text x="155" y="189" text-anchor="middle" font-size="9" class="pos-label-accent" font-weight="700">CB</text>
          <circle cx="130" cy="230" r="13" fill="var(--accent)" opacity="0.8"/>
          <text x="130" y="234" text-anchor="middle" font-size="9" class="pos-label-accent" font-weight="700">RB</text>
          <!-- Midfielders -->
          <circle cx="240" cy="145" r="13" fill="#2563EB" opacity="0.85"/>
