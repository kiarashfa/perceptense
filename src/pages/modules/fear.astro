  var sitPhobias = [
    { icon: 'fa-solid fa-mountain', label: 'Acrophobia', sub: 'heights', title: 'Acrophobia — fear of heights', body: 'Affects ~5% at clinical severity; up to 30% report significant discomfort. Important to distinguish acrophobia from visual height intolerance (VHI), a milder form affecting ~28% of people. The mechanism involves a conflict between visual input (the edge is far below) and proprioceptive balance information (the body feels unstable). Many people experience the disturbing "high places illusion" — an urge to jump that is not suicidal but represents the brain computing escape options. VR treatment achieves near-equivalent results to real-height exposure, making it highly practical for this phobia.' },
    { icon: 'fa-solid fa-door-closed', label: 'Claustrophobia', sub: 'enclosed spaces', title: 'Claustrophobia — fear of enclosed spaces', body: 'Prevalence ~2–4% of adults. Research distinguishes two subtypes: suffocation fear (the enclosed space will run out of air) and restriction fear (the person will be physically trapped). These respond to somewhat different treatment protocols. MRI scanners are a major clinical problem: 1–15% of patients require sedation for routine MRI due to claustrophobia. Open MRI scanners were developed partly in response to this. A person can intellectually know the scan is safe and still feel trapped because the body is responding to perceived escape distance, not to the radiology manual.' },
    { icon: 'fa-solid fa-city', label: 'Agoraphobia', sub: 'escape unavailable', title: 'Agoraphobia — fear of escape being unavailable', body: 'Often mischaracterised as simply "fear of open spaces." The DSM-5 definition is more precise: fear of situations where escape would be difficult or help unavailable during a panic attack. Agoraphobia is closely linked to panic disorder; ~50% of people with panic disorder develop agoraphobia. The condition can shrink life through a widening map of avoidance. In severe cases, a person becomes housebound not because the outside is hated, but because the outside feels like a stage on which panic could trap them. Approximately 1.7% of the global population meets full criteria.' },
    { icon: 'fa-solid fa-plane', label: 'Aerophobia', sub: 'flying', title: 'Aerophobia — fear of flying', body: 'Fear of flying is rarely one fear. It can combine heights, turbulence, enclosed space, loss of control, and mistrust of machinery. Approximately 25% of adults report significant fear; ~6% meet phobia criteria. Commercially, aviation is extremely safe — the fatal accident rate per billion passenger-kilometres is 0.02, roughly 95 times safer than driving. Statistics alone often fail as treatment because the passenger cannot steer, stop, or step out. Treatment works better when it targets the person\'s actual fear stack rather than repeating that planes are statistically safe.' },
    { icon: 'fa-solid fa-water', label: 'Aquaphobia', sub: 'water and deep sea', title: 'Aquaphobia and thalassophobia', body: 'Aquaphobia is fear of water itself: pools, lakes, bathing, swimming. Thalassophobia is specifically fear of deep open water — the ocean, where the bottom is not visible. The ocean amplifies fear by removing footing, visibility, and speed. Thalassophobia has its own distinctive signature: gazing downward into deep water activates amygdala responses even in otherwise non-phobic individuals, suggesting near-prepared status. Treatment often starts with control and predictability: shallow water, clear boundaries, a trusted person nearby, and gradually longer contact.' },
    { icon: 'fa-solid fa-cloud-bolt', label: 'Nyctophobia', sub: 'darkness and storms', title: 'Nyctophobia and astraphobia', body: 'Fear of darkness is universal in young children (peak 3–8 years) and typically remits by adolescence in safe environments. Nyctophobia is not really fear of darkness as a substance — it is fear of degraded information. In darkness, the brain has less visual evidence and fills the gap with prediction and imagination. Astraphobia (thunderstorms) affects ~2% of adults and is much more common in dogs (~17% of the canine population). Thunder is difficult for the nervous system because it is loud, sudden, and uncontrollable — the phobic pattern is avoidance far beyond practical caution.' },
    { icon: 'fa-solid fa-fire', label: 'Pyrophobia', sub: 'fire and snow', title: 'Pyrophobia and chionophobia', body: 'Pyrophobia is one of the clearest trauma-induced situational phobias. Unlike snakes or spiders, fire has no prepared-learning basis; almost all cases involve direct conditioning from a house fire, burn injury, or witnessing severe fire damage. Chionophobia (fear of snow) seems less obvious until you connect it to crashes, falls, avalanches, isolation, whiteout conditions, or being trapped during blizzards. Both phobias show the same principle: a natural force becomes a threat category that spreads into ordinary life well beyond rational caution.' }
  ];
  buildElemGrid('sit-phobia-grid', 'sit-phobia-detail', sitPhobias, true);

  /* ════════════════════════════════════════════════════
     PART F — Control scale
  ════════════════════════════════════════════════════ */
  var controlItems = [
    { name: 'Taking the stairs', pos: 18 },
    { name: 'Standing on a balcony', pos: 42 },
    { name: 'MRI scanner', pos: 76 },
    { name: 'Turbulent flight', pos: 84 },
    { name: 'Crowded train tunnel', pos: 91 }
  ];
  var controlScaleEl = document.getElementById('control-scale');
  controlItems.forEach(function(item) {
    var row = document.createElement('div');
    row.className = 'cscale-row';
    row.innerHTML = '<div class="cscale-name">' + item.name + '</div>' +
      '<div class="cscale-track"><div class="cscale-dot" style="left:' + item.pos + '%"></div></div>';
    controlScaleEl.appendChild(row);
  });

  /* ════════════════════════════════════════════════════
     PART G — Social/body/existential phobias (elem-card with FA icons)
  ════════════════════════════════════════════════════ */
  var existentialItems = {
    social: {
      icon: 'fa-solid fa-comments', label: 'Social anxiety', sub: 'judgement',
      title: 'Social anxiety disorder — fear of evaluation',
      body: 'The most prevalent anxiety disorder globally, with ~12% lifetime prevalence in the US. Social anxiety disorder is not introversion. It involves intense fear of situations where one might be scrutinised and judged negatively, accompanied by physiological anxiety (blushing, trembling, voice changes) the person fears will be noticed and judged. The cruel loop is self-monitoring: the more a person checks how they are appearing, the less attention remains for the actual conversation, which then makes awkwardness more likely. CBT with exposure achieves strong outcomes; SSRIs are effective for the interaction subtype.'
    },
    death: {
      icon: 'fa-solid fa-hourglass-end', label: 'Thanatophobia', sub: 'death',
      title: 'Thanatophobia — fear of death',
      body: 'Death anxiety is not a rare pathology — it is a background condition of being an animal that can imagine its own nonexistence. Terror management theory places it at the centre of human psychology: mortality awareness drives much of culture, religion, and politics. Clinical thanatophobia, when death fear produces compulsive checking, avoidance of life events, or panic over ordinary bodily sensations, affects ~3–4% of adults. Paradoxically, it peaks in middle age, not old age: elderly adults typically show reduced death anxiety, likely because they have completed more of their personal projects and have more acceptance.'
    },
    illness: {
      icon: 'fa-solid fa-notes-medical', label: 'Nosophobia', sub: 'illness',
      title: 'Nosophobia, hypochondria, and cyberchondria',
      body: 'Illness anxiety is powered by reassurance that expires quickly. A symptom is Googled, a frightening diagnosis appears, checking reduces fear briefly, then the uncertainty returns stronger. Nosophobia focuses on a specific disease — often cancer, dementia, heart disease, or infection. Each reassurance temporarily reduces anxiety but strengthens the disorder by confirming that checking is necessary. Cyberchondria — using internet symptom searches — dramatically worsened health anxiety after ~2005; Google searches on symptom combinations reliably return cancer as a top result.'
    },
    blood: {
      icon: 'fa-solid fa-syringe', label: 'Hemophobia', sub: 'blood and needles',
      title: 'Hemophobia and trypanophobia — blood and needles',
      body: 'Blood-injection-injury (BII) phobia is the only phobia with a distinctive two-phase physiological response: initial increase in heart rate and blood pressure followed by a drop, often causing fainting (vasovagal syncope). This is why standard exposure therapy is ineffective — it increases arousal, which triggers fainting. The treatment of choice is applied tension: tensing large muscle groups to maintain blood pressure during exposure. Trypanophobia (needles specifically) affects ~10% of the population, with significant implications for vaccine uptake. Research by Neil Schmitt found trypanophobia is a significant predictor of COVID-19 vaccine hesitancy.'
    },
    alone: {
      icon: 'fa-solid fa-user-slash', label: 'Autophobia', sub: 'being alone',
      title: 'Autophobia and athazagoraphobia — alone and forgotten',
      body: 'Autophobia is fear of being alone; athazagoraphobia is fear of being forgotten or ignored. Both connect to attachment theory: people with anxious attachment (roughly 20% of adults) have hyperactivated attachment systems that treat perceived social exclusion as a life-threatening threat. The digital age both alleviated these fears through constant connectivity and amplified them through social media — which provides constant metrics of social attention (likes, views, follows), creating new opportunities for perceived rejection to be quantified and made visible. Research by Jean Twenge links social media use in teenagers to increased loneliness from ~2012 onwards.'
    },
    touch: {
      icon: 'fa-solid fa-hand', label: 'Haphephobia', sub: 'being touched',
      title: 'Haphephobia — fear of being touched',
      body: 'Fear of physical touch affects approximately 1–2% of the population at clinical severity. It is often comorbid with social anxiety, OCD, or trauma histories where touch was associated with boundary violation. Unlike most phobias, haphephobia is notable for combining two opposing impulses: a desire for physical connection and closeness, and an intense aversion to the sudden or unexpected physical contact that initiates it. Clinical referrals for haphephobia increased markedly following the COVID-19 pandemic, which introduced new cultural norms around touch avoidance that, for some individuals, became consolidated as a phobic pattern.'
    },
    modern: {
      icon: 'fa-solid fa-mobile-screen', label: 'Modern phobias', sub: 'phones, tech, FOMO',
      title: 'Modern phobias — nomophobia, technophobia, and FOMO',
      body: 'Nomophobia (no-mobile-phobia) sounds comic until you notice what the phone now contains: maps, money, loved ones, memory, status, emergency access, and distraction. Survey studies find 66–77% of smartphone users report anxiety when their phone is unavailable or out of charge. Technophobia names fear or avoidance of technology, especially when tools feel humiliating, opaque, or socially mandatory. FOMO is not a formal phobia, but it uses similar machinery: imagined exclusion plus compulsive checking. Modern fears often attach to access and information, not objects.'
    },
    rare: {
      icon: 'fa-solid fa-shapes', label: 'Rare phobias', sub: 'unusual objects',
      title: 'Rare and unusual phobias',
      body: 'Lists of unusual phobias can become comedy: xanthophobia (yellow), pogonophobia (beards), omphalophobia (belly buttons). But the useful question is never "is the object weird?" — it is "what does the fear make impossible?" A rare fear that blocks school, work, care, travel, or ordinary movement deserves the same seriousness as a famous one. All of these, however bizarre, follow the same basic conditioning and maintenance pathways as common phobias — they respond to the same treatment principles. The rarest documented phobia is arguably genuphobia (fear of knees), with fewer than 100 documented clinical cases globally.'
    }
  };

  var existGrid = document.getElementById('existential-grid');
  var existDetail = document.getElementById('existential-detail');
  var activeExist = null;
  var existKeys = Object.keys(existentialItems);

  existKeys.forEach(function(k, i) {
    var d = existentialItems[k];
    var card = document.createElement('div');
    card.className = 'elem-card';
    card.innerHTML = '<div class="elem-card-icon"><i class="' + d.icon + '"></i></div>' +
      '<div class="elem-card-label">' + d.label + '</div>' +
      '<div class="elem-card-sub">' + d.sub + '</div>';
    card.onclick = function() {
      if (activeExist === i) { card.classList.remove('active'); existDetail.classList.remove('show'); existDetail.innerHTML = ''; activeExist = null; return; }
      existGrid.querySelectorAll('.elem-card').forEach(function(c) { c.classList.remove('active'); });
      card.classList.add('active');
      activeExist = i;
      existDetail.innerHTML = '<div class="elem-detail-title">' + d.title + '</div><div style="font-size:13px;color:var(--color-text-primary);line-height:1.6;">' + d.body + '</div>';
      existDetail.classList.add('show');
    };
    existGrid.appendChild(card);
  });
  // Auto-open first card
  existGrid.querySelector('.elem-card').click();

  /* ════════════════════════════════════════════════════
     PART G — Phobia distribution bar
  ════════════════════════════════════════════════════ */
  var distData = [
    { label: 'Animal', pct: 29, col: '#9B3030' },
    { label: 'Situational', pct: 22, col: '#C04040' },
    { label: 'Social anxiety', pct: 18, col: '#D06060' },
    { label: 'Natural environment', pct: 14, col: '#C08080' },
    { label: 'Blood/injection', pct: 10, col: '#D09090' },
    { label: 'Other', pct: 7, col: '#DDAAAA' }
  ];
  var distBarEl = document.getElementById('phobia-dist-bar');
  var distLegendEl = document.getElementById('phobia-dist-legend');
  distData.forEach(function(d) {
    var seg = document.createElement('div');
    seg.className = 'dist-seg';
    seg.style.width = d.pct + '%';
    seg.style.background = d.col;
    seg.style.color = '#fff';
    seg.textContent = d.pct >= 10 ? d.pct + '%' : '';
    seg.title = d.label + ': ' + d.pct + '%';
    distBarEl.appendChild(seg);
    var li = document.createElement('div');
    li.className = 'dist-legend-item';
    li.innerHTML = '<div class="dist-legend-dot" style="background:' + d.col + ';"></div>' + d.label + ' (' + d.pct + '%)';
    distLegendEl.appendChild(li);
  });

  /* ════════════════════════════════════════════════════
     PART G — Avoidance cost calculator (from alt)
  ════════════════════════════════════════════════════ */
  window.calcAvoidance = function() {
    var mins   = Number(document.getElementById('avoidMinutes').value);
    var days   = Number(document.getElementById('avoidDays').value);
    var months = Number(document.getElementById('avoidMonths').value);
    var out    = document.getElementById('avoid-output');
    if (!isFinite(mins) || !isFinite(days) || !isFinite(months) || mins < 0 || days < 0 || days > 7 || months <= 0) {
      out.textContent = 'Enter realistic non-negative numbers. Days per week must be between 0 and 7.';
      return;
    }
    var totalMins  = mins * days * 4.345 * months;
    var hours      = totalMins / 60;
    var daysTotal  = hours / 24;
    var workdays   = hours / 8;
    out.innerHTML = '<strong>Estimated cost: ' + hours.toFixed(1) + ' hours</strong><br><br>' +
      'That is about ' + daysTotal.toFixed(1) + ' full days, or ' + workdays.toFixed(1) + ' eight-hour workdays, spent avoiding, checking, planning around fear, or recovering from it.<br><br>' +
      '<span style="font-size:11px;color:var(--color-text-tertiary);">The number is not meant to shame. It makes the invisible cost visible enough to compare with the effort of getting help or practising exposure — which for many phobias requires fewer hours total than one year of avoidance.</span>';
  };
  // Run on load with defaults
  calcAvoidance();

  /* ════════════════════════════════════════════════════
     PART G — Exposure therapy planner (from ver2)
  ════════════════════════════════════════════════════ */
  window.calcExposure = function() {
    var pType = document.getElementById('calc-phobia-type').value;
    var sev   = parseInt(document.getElementById('calc-severity').value) || 6;
    var fmt   = document.getElementById('calc-format').value;
    if (sev < 1 || sev > 10) { document.getElementById('calc-output').innerHTML = 'Please enter a severity between 1 and 10.'; return; }
    var baseData = {
      animal:  { sessions: 1,  hrs: 3,   rate: 90 },
      blood:   { sessions: 2,  hrs: 2.5, rate: 85 },
      heights: { sessions: 3,  hrs: 2,   rate: 80 },
      flying:  { sessions: 4,  hrs: 3,   rate: 88 },
      social:  { sessions: 12, hrs: 1,   rate: 70 },
      other:   { sessions: 4,  hrs: 2,   rate: 75 }
    };
    var base = baseData[pType];
    var sevMult = 0.8 + (sev / 10) * 0.8;
    var sessions, totalHrs, rate, fmtNote;
    if (fmt === 'ost') {
      sessions = pType === 'social' ? 4 : 1;
      totalHrs = sessions * base.hrs;
      rate = base.rate;
      fmtNote = 'One-session treatment: a single intensive exposure session. Best evidence for animal and blood/injection phobias.';
    } else if (fmt === 'weekly') {
      sessions = Math.round(base.sessions * sevMult);
      if (pType === 'social') sessions = Math.round(12 * sevMult);
      totalHrs = sessions * base.hrs;
      rate = base.rate - 5;
      fmtNote = 'Weekly CBT sessions: standard outpatient therapy. Good for complex phobias with significant avoidance or comorbid anxiety.';
    } else {
      sessions = Math.max(2, Math.round(base.sessions * sevMult * 0.8));
      totalHrs = sessions * 1.5;
      rate = base.rate - 2;
      fmtNote = 'Virtual reality exposure therapy: comparable outcomes to in-vivo for heights, flying, and social phobia.';
    }
    var typeNames = { animal: 'Animal phobia', blood: 'Blood/injection phobia', heights: 'Acrophobia', flying: 'Aerophobia', social: 'Social anxiety disorder', other: 'Specific phobia' };
    document.getElementById('calc-output').innerHTML =
      '<strong>' + typeNames[pType] + ' · Severity ' + sev + '/10</strong><br><br>' +
      'Estimated sessions: <strong>' + sessions + '</strong><br>' +
      'Total treatment hours: <strong>' + totalHrs.toFixed(1) + ' hours</strong><br>' +
      'Expected clinical response: <strong>' + rate + '%</strong><br><br>' +
      '<em>' + fmtNote + '</em><br><br>' +
      '<span style="font-size:11px;color:var(--color-text-tertiary);">Estimates are based on published trial averages. Actual treatment varies with comorbidities, therapist experience, and patient engagement.</span>';
  };

  /* ════════════════════════════════════════════════════
     Q&A toggle
  ════════════════════════════════════════════════════ */
  window.toggleQA = function(btn) {
    var ans     = btn.nextElementSibling;
    var showing = ans.classList.contains('show');
    ans.classList.toggle('show', !showing);
    btn.textContent = showing ? 'show answer' : 'hide';
  };

  /* ════════════════════════════════════════════════════
     SHARED HELPERS
  ════════════════════════════════════════════════════ */
  function buildTimeline(axisId, rowsId, items, minY, maxY, marks) {
    var axis = document.getElementById(axisId);
    var rows = document.getElementById(rowsId);
    var range = maxY - minY;
    if (axis) {
      axis.innerHTML = marks.map(function(y) {
        var left = ((y - minY) / range * 100).toFixed(1);
        return '<span class="pc-axis-mark" style="left:' + left + '%">' + y + '</span>';
      }).join('');
    }
    if (rows) {
      rows.innerHTML = items.map(function(item) {
        var left  = ((item.start - minY) / range * 100).toFixed(1);
        var width = ((item.end   - item.start) / range * 100).toFixed(1);
        var bg = item.bg || item.col || '#ccc';
        var col = item.col || 'var(--color-text-primary)';
        var label = item.text || (item.start + '–' + item.end);
        return '<div class="pc-row"><div class="pc-label">' + item.label + '</div>' +
          '<div class="pc-track"><div class="pc-fill" style="left:' + left + '%;width:' + width + '%;background:' + bg + ';">' +
          '<span class="pc-fill-label" style="color:' + col + ';">' + label + '</span></div></div></div>';
      }).join('');
    }
  }

  function buildElemGrid(gridId, detailId, data, autoOpenFirst) {
    var grid   = document.getElementById(gridId);
    var detail = document.getElementById(detailId);
    var activeIdx = null;

    function openIdx(i) {
      var p = data[i];
      grid.querySelectorAll('.elem-card').forEach(function(c) { c.classList.remove('active'); });
      grid.querySelectorAll('.elem-card')[i].classList.add('active');
      activeIdx = i;
      detail.innerHTML = '<div class="elem-detail-title">' + p.title + '</div><div style="font-size:13px;color:var(--color-text-primary);line-height:1.6;">' + p.body + '</div>';
      detail.classList.add('show');
    }

    data.forEach(function(p, i) {
      var card = document.createElement('div');
      card.className = 'elem-card';
      // icon may be emoji (string) or FA class — detect by presence of 'fa-'
      var iconHtml = p.icon.indexOf('fa-') !== -1
        ? '<div class="elem-card-icon"><i class="' + p.icon + '"></i></div>'
        : '<div class="elem-card-icon">' + p.icon + '</div>';
      card.innerHTML = iconHtml +
        '<div class="elem-card-label">' + p.label + '</div>' +
        '<div class="elem-card-sub">' + p.sub + '</div>';
      card.onclick = function() {
        if (activeIdx === i) {
          card.classList.remove('active');
          detail.classList.remove('show');
          detail.innerHTML = '';
          activeIdx = null;
          return;
        }
        openIdx(i);
      };
      grid.appendChild(card);
    });

    if (autoOpenFirst) { openIdx(0); }
  }

}); // end DOMContentLoaded
  
</script>
