/* ===== CALCULATOR: PPV ===== */
function calcPPV() {
  const prev = parseFloat(document.getElementById('prev-inp').value) / 100;
  const sens = parseFloat(document.getElementById('sens-inp').value) / 100;
  const spec = parseFloat(document.getElementById('spec-inp').value) / 100;
  if (isNaN(prev) || isNaN(sens) || isNaN(spec)) { document.getElementById('ppv-out').textContent = 'Please enter valid numbers.'; return; }
  const pop = 100000;
  const truePos = Math.round(pop * prev * sens);
  const falsePos = Math.round(pop * (1 - prev) * (1 - spec));
  const ppv = truePos / (truePos + falsePos);
  const npv = Math.round(pop * (1 - prev) * spec) / (Math.round(pop * (1 - prev) * spec) + Math.round(pop * prev * (1 - sens)));
  document.getElementById('ppv-out').innerHTML =
    `In a population of 100,000 with ${(prev*100).toFixed(1)}% prevalence:<br>
    True positives: ${truePos.toLocaleString()} | False positives: ${falsePos.toLocaleString()}<br>
    <strong>Positive predictive value (PPV): ${(ppv*100).toFixed(1)}%</strong> — if you test positive, this is the probability you actually have the disease.<br>
    Negative predictive value (NPV): ${(npv*100).toFixed(1)}%<br>
    ${ppv < 0.5 ? '<em>More than half of positive test results are false positives. This is the base-rate problem in action.</em>' : ''}`;
}

/* ===== RISK SLIDER ===== */
function updateRisk(v) {
  document.getElementById('risk-val').textContent = v + '%';
  const base = parseFloat(v);
  const rrr = 30; // 30% relative risk reduction (typical statin)
  const arr = (base * rrr / 100).toFixed(2);
  const nnt = Math.round(100 / parseFloat(arr));
  document.getElementById('risk-output').innerHTML =
    `With a drug that produces a <strong>30% relative risk reduction</strong> (typical of statins):<br>
    Your annual absolute risk falls from <strong>${base}%</strong> to <strong>${(base - parseFloat(arr)).toFixed(2)}%</strong><br>
    Absolute risk reduction: <strong>${arr}%</strong> per year<br>
    Number needed to treat (NNT): <strong>${nnt}</strong> — you need to treat ${nnt} people for one year to prevent one event.<br>
    <em>Drug companies typically report "reduces risk by 30%" — technically true, but ${arr}% absolute reduction and NNT ${nnt} is what matters for your decision.</em>`;
}
updateRisk(5);

/* ===== CPR SLIDER ===== */
function updateCPR(v) {
  const q = parseInt(v);
  let survival, quality;
  if (q < 10) { survival = 5; quality = 'No bystander CPR'; }
  else if (q < 40) { survival = 8; quality = 'Minimal CPR (too shallow, too slow)'; }
  else if (q < 65) { survival = 12; quality = 'Partial CPR — some benefit'; }
  else if (q < 85) { survival = 18; quality = 'Good CPR — correct rate and depth'; }
  else { survival = 25; quality = 'Optimal CPR (100–120/min, 5–6 cm depth)'; }
  document.getElementById('cpr-output').innerHTML =
    `<strong>CPR quality: ${quality}</strong><br>Estimated survival rate for out-of-hospital cardiac arrest: ~<strong>${survival}%</strong><br>
    <em>With a defibrillator used within 3 minutes, survival can reach 50–70%. Every minute without defibrillation reduces survival by ~10%.</em>`;
}
updateCPR(60);

/* ===== CALORIE CALCULATOR ===== */
function calcCalories() {
  const sex = document.getElementById('msj-sex').value;
  const age = parseFloat(document.getElementById('msj-age').value);
  const wt = parseFloat(document.getElementById('msj-weight').value);
  const ht = parseFloat(document.getElementById('msj-height').value);
  const act = parseFloat(document.getElementById('msj-activity').value);
  if (isNaN(age) || isNaN(wt) || isNaN(ht)) { document.getElementById('cal-out').textContent = 'Please enter valid numbers.'; return; }
  const rmr = sex === 'm' ? (10 * wt + 6.25 * ht - 5 * age + 5) : (10 * wt + 6.25 * ht - 5 * age - 161);
  const tdee = Math.round(rmr * act);
  const deficit = Math.round(tdee - 500);
  const surplus = Math.round(tdee + 300);
  document.getElementById('cal-out').innerHTML =
    `Resting metabolic rate (RMR): ~<strong>${Math.round(rmr)} kcal/day</strong><br>
    Total daily energy expenditure (TDEE): ~<strong>${tdee} kcal/day</strong><br>
    To lose ~0.5 kg/week: ~${deficit} kcal/day | To gain ~0.3 kg/week: ~${surplus} kcal/day<br>
    <em>Individual variation is ±15%. These are starting estimates to be adjusted based on real-world weight trends over 2–4 weeks.</em>`;
}

/* ===== CHARTS ===== */
function buildBarChart(containerId, data, maxVal, colorFn, fgFn) {
  const container = document.getElementById(containerId);
  if (!container) return;
  container.innerHTML = '';
  data.forEach(item => {
    const pct = (item.val / maxVal) * 100;
    const row = document.createElement('div');
    row.className = 'bar-row';
    row.innerHTML = `<div class="bl">${item.label}</div>
      <div class="bb" style="width:${Math.max(pct * 0.65, 2)}%;background:${colorFn(item)};max-width:62%;">
        <span class="bv" style="color:${fgFn ? fgFn(item) : '#fff'};">${item.display}</span>
      </div>`;
    container.appendChild(row);
  });
}

