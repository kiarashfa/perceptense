/* ===== EVIDENCE PYRAMID ===== */
(function buildEvidencePyramid() {
  const el = document.getElementById('evidence-pyramid');
  if (!el) return;
  const levels = [
    { label: 'Systematic review / Meta-analysis', width: 98, bg: 'var(--accent)', note: 'Synthesises all available trials' },
    { label: 'Randomised Controlled Trial (RCT)', width: 84, bg: '#5aaca5', note: 'Gold standard for causation' },
    { label: 'Cohort study', width: 70, bg: '#88bab5', note: 'Follows groups over time' },
    { label: 'Case-control study', width: 56, bg: '#a9c9c6', note: 'Compares cases to controls' },
    { label: 'Cross-sectional survey', width: 42, bg: '#c3d8d6', note: 'Snapshot in time' },
    { label: 'Case report / Case series', width: 28, bg: '#ddeae9', note: 'Single patient observations' },
    { label: 'Expert opinion / Anecdote', width: 14, bg: '#eef4f4', note: 'Weakest evidence' }
  ];
  levels.forEach((lv, i) => {
    const row = document.createElement('div');
    row.className = 'ev-level';
    row.innerHTML = `<div class="ev-bar-label text-secondary">${i === 0 ? 'Strongest' : i === levels.length-1 ? 'Weakest' : ''}</div>
      <div style="flex:1;">
        <div class="fill-bar" style="width:${lv.width}%;background:${i < 2 ? lv.bg : 'var(--color-background-secondary)'};border:0.5px solid var(--color-border-tertiary);">
          <span style="font-size:11px;font-weight:500;color:${i < 2 ? '#1a1a18' : 'var(--color-text-secondary)'};">${lv.label}</span>
        </div>
        <div style="font-size:10px;color:var(--color-text-tertiary);margin-left:4px;">${lv.note}</div>
      </div>`;
    el.appendChild(row);
  });
})();

/* ===== TIMELINE: Drug Development ===== */
(function buildDrugTimeline() {
  const el = document.getElementById('drug-timeline');
  if (!el) return;
  const phases = [
    { label: 'Discovery', start: 0, end: 3, bg: 'var(--accent)', col: '#1a1a18' },
    { label: 'Preclinical', start: 3, end: 6, bg: '#5aaca5', col: '#1a1a18' },
    { label: 'Phase I (safety, n~80)', start: 6, end: 8, bg: '#ef9f27', col: '#1a1a18' },
    { label: 'Phase II (efficacy, n~300)', start: 8, end: 10, bg: '#e08020', col: '#1a1a18' },
    { label: 'Phase III (large RCT, n~10k)', start: 10, end: 13, bg: '#ba5918', col: '#fff' },
    { label: 'Regulatory review', start: 13, end: 14.5, bg: '#8565C1', col: '#fff' },
    { label: 'Post-market (Phase IV)', start: 14.5, end: 17, bg: '#6c4faa', col: '#fff' }
  ];
  const min = 0, max = 17;
  const track = document.createElement('div');
  track.className = 'tl-track';
  track.style.height = '34px';
  phases.forEach(p => {
    const left = ((p.start - min) / (max - min)) * 100;
    const width = ((p.end - p.start) / (max - min)) * 100;
    const bar = document.createElement('div');
    bar.className = 'tl-bar';
    bar.style.cssText = `left:${left}%;width:${width}%;background:${p.bg};color:${p.col};font-size:9px;`;
    bar.textContent = p.label;
    track.appendChild(bar);
  });
  el.appendChild(track);
  const axis = document.createElement('div');
  axis.className = 'tl-axis';
  axis.innerHTML = '<span>Year 0</span><span>Year 5</span><span>Year 10</span><span>Year 15+</span>';
  el.appendChild(axis);
})();

