    /* ── Unit economics calculator ── */
    window.calcUnitEcon = function() {
      var arpu = parseFloat(document.getElementById('ue-arpu').value);
      var margin = parseFloat(document.getElementById('ue-margin').value) / 100;
      var churn = parseFloat(document.getElementById('ue-churn').value) / 100;
      var cac = parseFloat(document.getElementById('ue-cac').value);
      var out = document.getElementById('ue-output');
      if (isNaN(arpu) || isNaN(margin) || isNaN(churn) || isNaN(cac) || arpu <= 0 || margin <= 0 || churn <= 0 || cac < 0) {
        out.innerHTML = '<span style="color:var(--color-text-danger);">Enter positive revenue, margin, and churn values.</span>';
        return;
      }
      var monthlyGP = arpu * margin;
      var ltv = monthlyGP / churn;
      var payback = cac / monthlyGP;
      var ratio = cac > 0 ? (ltv / cac).toFixed(1) : '∞';
      var signal = '';
      if (cac > 0) {
        var r = parseFloat(ratio);
        if (r < 1) signal = 'Destroying value with every acquisition.';
        else if (r < 3) signal = 'Below venture benchmark — improve churn or reduce CAC.';
        else if (r < 5) signal = 'Healthy — meets the standard 3x venture rule of thumb.';
        else signal = 'Excellent — efficient economics with strong retention.';
      }
      out.innerHTML =
        'Gross-profit LTV: <strong>$' + Math.round(ltv).toLocaleString('en-US') + '</strong> &nbsp;|&nbsp; ' +
        'CAC payback: <strong>' + payback.toFixed(1) + ' months</strong> &nbsp;|&nbsp; ' +
        'LTV:CAC: <strong>' + ratio + 'x</strong><br><br>' +
        signal;
    };

    /* ── Funnel stage slider ── */
    var FUNNEL_STAGES = [
      { name: 'Awareness', text: 'Question: do the right people know the category and the brand exist? Useful measures include reach, share of search, unaided awareness, and cost per qualified visit. Most B2B buying decisions begin with a search query long before any sales contact — if you are not findable at the awareness stage, the rest of the funnel does not exist.' },
      { name: 'Interest', text: 'Question: does the promise create curiosity? Message clarity, landing page relevance, social proof, and problem-fit matter more than hard closing at this stage. A prospect who visits but does not convert is signalling a gap in how the problem is framed, not necessarily a gap in the product.' },
      { name: 'Consideration', text: 'Question: why this offer rather than the obvious alternatives? Comparison pages, demos, reviews, guarantees, and pricing architecture do heavy work here. The mistake is spending all marketing budget on awareness while ignoring the friction that loses already-interested prospects.' },
      { name: 'Purchase', text: 'Question: what friction prevents commitment? Checkout steps, procurement hurdles, payment terms, trust signals, and sales cycle length can quietly destroy demand that marketing already created. In B2B, the average buying committee has 6–10 stakeholders; a single blocker can stall a sale indefinitely.' },
      { name: 'Retention', text: 'Question: does the product keep solving the problem after the first transaction? Churn, repeat purchase rate, net revenue retention, and support quality become the central metrics. This stage is where most SaaS businesses actually make or lose money — acquiring a customer who churns in 3 months is often worse than not acquiring them at all.' },
      { name: 'Advocacy', text: 'Question: will customers bring others? Referrals, reviews, case studies, community, and visible product identity make acquisition cheaper and brand memory stronger. Net Promoter Score (NPS), for all its flaws, captures the advocacy question simply: would you recommend this to a colleague? Dropbox built its first 4 million users entirely through a referral programme — advocacy made paid marketing unnecessary.' }
    ];
    window.updateFunnel = function(val) {
      var idx = parseInt(val, 10);
      document.getElementById('funnel-stage').textContent = FUNNEL_STAGES[idx].name;
      document.getElementById('funnel-num').textContent = idx + 1;
      document.getElementById('funnel-output').textContent = FUNNEL_STAGES[idx].text;
    };
    updateFunnel(0);

    /* ── Span of control slider ── */
    window.updateSpan = function(val) {
      var span = parseInt(val, 10);
      document.getElementById('span-val').textContent = span;
      var text;
      if (span <= 5) {
        text = 'A span of ' + span + ' allows close coaching — useful for new hires, complex or high-risk work, or rapid skill development. It is expensive in management headcount and creates tall hierarchies with many approval layers if applied across the whole organisation.';
      } else if (span <= 9) {
        text = 'A span of ' + span + ' is the classic middle zone for knowledge work: enough bandwidth for weekly one-on-ones without creating unnecessary hierarchy. Most tech companies and professional services firms operate in this range.';
      } else if (span <= 14) {
        text = 'A span of ' + span + ' requires experienced, self-directed employees, clear goals, and strong operational routines. The manager shifts from coach to system designer — setting context, measuring outcomes, removing blockers rather than directing daily work.';
      } else {
        text = 'A span of ' + span + ' is thin supervision. It works in highly standardised, process-driven operations with strong controls and low task ambiguity. In knowledge work it typically means management overload is hidden until performance drops — the manager has too many reports to catch problems early.';
      }
      document.getElementById('span-output').textContent = text;
    };
    updateSpan(7);

    /* Trigger initial calculator runs */
    showMBA('origin', document.querySelector('#mba-btns button'));
    showStrategy('cost', document.querySelector('#strategy-btns button'));
    calcRatios();
    calcDilution();
    calcUnitEcon();

  });
  
</script>
