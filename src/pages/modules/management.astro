    /* ── Financial ratios calculator ── */
    window.calcRatios = function() {
      var ni = parseFloat(document.getElementById('r-netinc').value);
      var rev = parseFloat(document.getElementById('r-rev').value);
      var assets = parseFloat(document.getElementById('r-assets').value);
      var equity = parseFloat(document.getElementById('r-equity').value);
      var ca = parseFloat(document.getElementById('r-currassets').value);
      var cl = parseFloat(document.getElementById('r-currliab').value);
      if ([ni, rev, assets, equity, ca, cl].some(isNaN) || rev <= 0 || assets <= 0 || equity <= 0 || cl <= 0) {
        document.getElementById('r-output').innerHTML = '<span style="color:var(--color-text-danger);">Please enter valid positive numbers in all fields.</span>';
        return;
      }
      var npm = (ni / rev * 100).toFixed(1);
      var roa = (ni / assets * 100).toFixed(1);
      var roe = (ni / equity * 100).toFixed(1);
      var cr  = (ca / cl).toFixed(2);
      var signals = [];
      if (parseFloat(npm) < 0) signals.push('Net margin is negative — the company is losing money on operations.');
      else if (parseFloat(npm) < 5) signals.push('Net margin under 5% — typical for retail/logistics, thin for technology.');
      else if (parseFloat(npm) > 20) signals.push('Net margin above 20% — excellent, typical of software or pharma.');
      if (parseFloat(roe) > 25) signals.push('ROE above 25% — strong, but check whether it is boosted by high leverage.');
      if (parseFloat(cr) < 1) signals.push('Current ratio below 1.0 — short-term liquidity risk: current liabilities exceed current assets.');
      else if (parseFloat(cr) > 3) signals.push('Current ratio above 3.0 — may indicate inefficient use of working capital.');
      document.getElementById('r-output').innerHTML =
        '<span style="font-weight:500; color:var(--color-text-primary);">Net Profit Margin:</span> ' + npm + '% &nbsp;|&nbsp; ' +
        '<span style="font-weight:500; color:var(--color-text-primary);">Return on Assets (ROA):</span> ' + roa + '% &nbsp;|&nbsp; ' +
        '<span style="font-weight:500; color:var(--color-text-primary);">Return on Equity (ROE):</span> ' + roe + '%<br>' +
        '<span style="font-weight:500; color:var(--color-text-primary);">Current Ratio:</span> ' + cr + 'x' +
        (signals.length ? '<br><br>' + signals.join('<br>') : '');
    };

    /* ── LTV:CAC slider ── */
    window.updateLtvCac = function(val) {
      var ratio = (val / 10).toFixed(1);
      document.getElementById('ltvcac-val').textContent = ratio + 'x';
      var r = parseFloat(ratio);
      var signal, color;
      if (r < 1) { signal = 'Destroying value with every customer acquired.'; color = 'var(--color-text-danger)'; }
      else if (r < 2) { signal = 'Below investment-grade. Unsustainable without dramatic improvement.'; color = 'var(--color-text-danger)'; }
      else if (r < 3) { signal = 'Marginal. Investors want to see improvement trajectory.'; color = 'var(--color-text-warning)'; }
      else if (r < 5) { signal = 'Healthy. Typical benchmark for venture-backed B2B SaaS.'; color = 'var(--color-text-success)'; }
      else if (r < 8) { signal = 'Strong. Efficient customer acquisition relative to value created.'; color = 'var(--color-text-success)'; }
      else { signal = 'Exceptional. May also indicate under-investment in growth — could acquire more customers.'; color = 'var(--color-text-info)'; }
      document.getElementById('ltvcac-signal').textContent = signal;
      document.getElementById('ltvcac-signal').style.color = color;
    };
