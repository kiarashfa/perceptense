    function showPhase(key) {
      const p = phaseData[key];
      document.querySelectorAll('[onclick^="showPhase"]').forEach(b => b.classList.remove('active'));
      document.querySelector(`[onclick="showPhase('${key}')"]`).classList.add('active');
      document.getElementById('phase-display').innerHTML = `
        <div style="margin-bottom:8px;"><span class="pill ${p.pill}">${p.pillLabel}</span></div>
        <div style="font-size:14px;font-weight:500;color:var(--color-text-primary);margin-bottom:10px;">${p.name}</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px;">
          <div class="sub-card"><div class="detail-label-spaced">Hormonally</div><div style="font-size:12px;color:var(--color-text-primary);line-height:1.6;">${p.hormones}</div></div>
          <div class="sub-card"><div class="detail-label-spaced">In the body</div><div style="font-size:12px;color:var(--color-text-primary);line-height:1.6;">${p.body}</div></div>
        </div>
        <div class="sub-card" style="margin-bottom:8px;"><div class="detail-label-spaced">How it tends to feel</div><div style="font-size:12px;color:var(--color-text-primary);line-height:1.6;">${p.feel}</div></div>
        <div class="info-block" style="margin-top:8px;margin-bottom:0;font-size:12px;">${p.note}</div>`;
    }

    /* ============================================================
       MENSTRUATION: SYMPTOMS EXPLORER
       ============================================================ */
    const symptomData = {
      cramps: {
        title: 'Cramps (dysmenorrhoea)',
        content: 'Caused by prostaglandins, hormone-like compounds that make the uterus contract to expel the lining. Higher prostaglandin levels mean stronger, more painful contractions. Primary dysmenorrhoea is pain from this normal mechanism, typically peaking in the first 1–2 days of flow. Secondary dysmenorrhoea is pain from an underlying condition: endometriosis (around 10% of people with a uterus), adenomyosis, fibroids, or pelvic inflammatory disease. <strong>What helps:</strong> NSAIDs (ibuprofen, naproxen) work better than paracetamol because they directly reduce prostaglandins, and they are most effective when started at the first sign of cramps rather than after pain is established. Heat (hot water bottle, warm bath), gentle exercise, and orgasm all reduce cramps. Hormonal contraception can largely eliminate them. <strong>Red flag:</strong> Pain severe enough to miss school or work, pain that worsens over years, pain with sex, or pain unresponsive to NSAIDs warrants investigation. Endometriosis takes an average of 7–10 years to diagnose; pushing back against "period pain is normal" framing matters.'
      },
      flow: {
        title: 'Flow patterns',
        content: '<strong>Normal range:</strong> 30–80 ml total per period, lasting 3–7 days. People typically overestimate their flow. A standard tampon holds about 5 ml when fully saturated; a super tampon about 12 ml; a menstrual cup typically 20–30 ml. <strong>Heavy menstrual bleeding (menorrhagia):</strong> consistently over 80 ml, or soaking through a pad or tampon every 1–2 hours, or passing clots larger than a 10-cent coin. Causes include fibroids, adenomyosis, copper IUDs, thyroid disorders, bleeding disorders (von Willebrand disease is under-diagnosed in menstruating people), and hormonal imbalances. Can cause iron-deficiency anaemia. <strong>Light flow:</strong> very light periods can be normal for some people, but a sudden reduction warrants investigation. Hormonal contraception, perimenopause, weight changes, PCOS, and stress can all cause it. <strong>Spotting between periods:</strong> occasional spotting is usually benign (often around ovulation), but persistent intermenstrual bleeding should be evaluated.'
      },
      mood: {
        title: 'Mood and cognition',
        content: 'Mood and cognitive shifts across the cycle are biologically real, though their magnitude varies enormously between individuals. <strong>Follicular phase:</strong> rising oestrogen is associated for many with improved mood, energy, confidence, and verbal fluency. <strong>Around ovulation:</strong> often peak mood and libido. <strong>Luteal phase:</strong> progesterone has anxiolytic effects early in the phase via the GABA system, but the late luteal drop in progesterone and oestrogen is associated with irritability, low mood, anxiety, and reduced stress tolerance for many. <strong>Important context:</strong> the research is not as clean as cycle-tracking apps imply. Studies that follow people prospectively find that around 75% experience some premenstrual mood change, but the pattern and severity differ enormously. Existing mood disorders (depression, anxiety, bipolar disorder) can worsen premenstrually, sometimes called premenstrual exacerbation. Hormonal contraception, by suppressing the cyclical swing, can stabilise mood for some and worsen it for others. Tracking is the only reliable way to know your own pattern.'
      },
      breast: {
        title: 'Breast changes',
        content: '<strong>Cyclical tenderness (cyclical mastalgia):</strong> breast fullness, soreness, and lumpy texture in the luteal phase, driven by progesterone and water retention. Affects most menstruating people to some degree. Resolves with the start of the next period. <strong>Management:</strong> well-fitting bras (often a size up in the luteal phase), reduced caffeine, evening primrose oil (mixed evidence but commonly tried), NSAIDs for severe pain. <strong>Lumps:</strong> cyclical lumpiness (fibrocystic breast changes) is common and benign. A lump that does not change with the cycle, is hard, fixed, or accompanied by skin or nipple changes, warrants prompt clinical evaluation. Self-examination is best done in the first week after a period when tissue is least lumpy and tender, making any persistent abnormality easier to detect.'
      },
      gut: {
        title: 'Gut and digestion',
        content: 'Hormones interact extensively with the gut. <strong>Around the period:</strong> rising prostaglandins (the same compounds that cause uterine cramps) also affect the bowel, often causing looser stools, increased bowel frequency, or genuine diarrhoea on day 1–2 of bleeding. This is so common it has a nickname (period poops) but is rarely discussed clinically. <strong>Luteal phase:</strong> progesterone slows gut motility, often causing bloating, constipation, and water retention in the days before a period. The bloating is real and measurable: abdominal circumference can increase by several centimetres. <strong>People with IBS:</strong> tend to experience marked worsening of symptoms perimenstrually. <strong>People with inflammatory bowel disease:</strong> often have cycle-linked flares. <strong>What helps:</strong> hydration, fibre, magnesium, regular meals, reduced caffeine and alcohol in the luteal phase. The bloating resolves on its own once the period starts.'
      },
      skin: {
        title: 'Skin and hair',
        content: '<strong>Premenstrual acne:</strong> the late luteal drop in oestrogen leaves androgens (testosterone) relatively unopposed, increasing sebum production. Breakouts typically appear on the chin, jaw, and around the mouth in the week before a period. <strong>Mid-cycle glow:</strong> peak oestrogen in the follicular phase is associated with brighter, more hydrated skin and often a notable improvement in complexion, the so-called ovulation glow. <strong>Hair:</strong> oestrogen prolongs the hair growth phase, so hair can feel thicker and shinier mid-cycle and shed slightly more in the late luteal phase. <strong>Skin sensitivity:</strong> skin is most reactive premenstrually; patch-test new products earlier in the cycle. <strong>Hormonal acne treatment:</strong> combined hormonal contraception (especially with anti-androgenic progestins like drospirenone) often dramatically improves cyclical acne. Spironolactone is another effective option for adults.'
      },
      sleep: {
        title: 'Sleep and energy',
        content: '<strong>Body temperature:</strong> rises by 0.3–0.5°C after ovulation and stays elevated through the luteal phase, which can disrupt sleep, particularly the deep stages. <strong>Premenstrual insomnia:</strong> common in the days before a period. Falling asleep is fine; staying asleep is harder. The progesterone drop appears to play a role. <strong>Energy:</strong> typically highest in the follicular phase, peaking around ovulation, then declining through the luteal phase. Many athletes and high-performers schedule demanding work and training accordingly when they can. <strong>Iron and fatigue:</strong> heavy bleeding can cause iron-deficiency anaemia, manifesting as fatigue, breathlessness, and pallor. A blood test (ferritin and full blood count) is straightforward and worth requesting if energy has dropped persistently. <strong>What helps:</strong> consistent sleep schedule, cool bedroom in the luteal phase, magnesium (modest evidence), reducing caffeine and alcohol in the late luteal phase.'
      },
      warning: {
        title: 'Warning signs — when to see a clinician',
        content: 'Most period experiences are within the normal range, but several patterns deserve clinical attention rather than endurance. <strong>Pain:</strong> severe enough to require missing school, work, or activities; not responsive to NSAIDs taken correctly; getting progressively worse year on year; pain with sex; pain with bowel movements during periods. Possible causes: endometriosis, adenomyosis, fibroids, PID. <strong>Bleeding:</strong> soaking through a pad or tampon every hour for several hours; periods lasting more than 7 days; large clots (golf ball or larger) repeatedly; bleeding between periods; bleeding after sex; bleeding after menopause. <strong>Absence:</strong> no period for 3+ months outside of pregnancy, breastfeeding, or known cause. <strong>Mood:</strong> mood symptoms that affect work, relationships, or safety. PMDD is treatable. <strong>Symptoms suggesting anaemia:</strong> persistent fatigue, breathlessness, dizziness, pale skin. <strong>The wider point:</strong> medicine has historically under-investigated menstrual symptoms. If you feel dismissed, ask for a referral to a gynaecologist, request a transvaginal ultrasound, or seek a second opinion. Endometriosis, adenomyosis, and PCOS together affect well over 15% of people with a uterus and are routinely diagnosed late.'
      }
    };

    function showSymptom(key) {
      const s = symptomData[key];
      document.querySelectorAll('[onclick^="showSymptom"]').forEach(b => b.classList.remove('active'));
