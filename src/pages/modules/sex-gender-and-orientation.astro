    <!-- N-3: The Four Phases Explorer -->
    <div class="content-panel">
      <div class="panel-title-spaced">Explore each phase — what is happening hormonally and what it feels like</div>
      <div class="button-row">
        <button class="exp-btn showgender-control" onclick="showPhase('menstrual')">Menstrual (1–5)</button>
