    <h2 class="sec" id="part-i-q-and-a">Part I · Q&A</h2>

    <div class="qa">
      <p class="qa-q">1. Someone says the flight from Tokyo to Los Angeles is about 9 hours. Does that make sense?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">Yes, broadly — Tokyo to LA is ~8,800 km. At ~900 km/h that's about 9.8 hours of air time. Real flights are typically 10–11 hours westbound (headwinds) and 9–10 hours eastbound. So "about 9 hours" is a slight underestimate but in the right ballpark.</div>
    </div>

    <div class="qa">
      <p class="qa-q">2. How many times bigger is the USA than Japan?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">About 26 times bigger. USA = 9.8M km², Japan = 378,000 km². 9,800,000 ÷ 378,000 ≈ 26. Japan would fit inside the USA 26 times over — and yet Japan's population (~124M) is about 36% of the USA's (~340M), packed into a tiny area.</div>
    </div>

    <div class="qa">
      <p class="qa-q">3. A building has 50 floors. Roughly how tall is it in metres?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">About 150 m. One floor ≈ 3 m. 50 × 3 = 150 m. For context, the Eiffel Tower (330 m) is about the height of a 110-floor building. Most city skyscrapers you see are in the 150–400 m range.</div>
    </div>

    <div class="qa">
      <p class="qa-q">4. Paris to Rome by road is about 1,400 km. At 120 km/h on a motorway, how long would the drive take?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">About 11–12 hours of pure driving (1,400 ÷ 120 ≈ 11.7 hours). In reality, with stops, borders, and traffic it'd be closer to 14–15 hours. That's why most people fly — the same journey takes just over 2 hours by air.</div>
    </div>

    <div class="qa">
      <p class="qa-q">5. Is Europe larger or smaller than the USA in area?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">Slightly larger — and this surprises most people. Europe (all countries combined) is about 10.5M km². The USA is 9.8M km². Europe is about 7% bigger. But Europe has ~750 million people vs the USA's ~340 million — more than twice as many people packed into slightly the same space, spread across 44 countries.</div>
    </div>

    <div class="qa">
      <p class="qa-q">6. The Pacific Ocean is larger than all land on Earth combined — true or false?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">True. The Pacific covers ~165 million km². All of Earth's land surface adds up to about 150 million km². The Pacific alone is 10% larger than all continents and islands combined. This is why early explorers crossing it could go weeks without sighting land.</div>
    </div>

    <div class="qa">
      <p class="qa-q">7. Name a major world city at roughly the same latitude as London (51.5°N).</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">Warsaw (52.2°N), Berlin (52.5°N), Amsterdam (52.4°N), and Brussels (50.9°N) are all close. Calgary in Canada is at 51°N. The surprise: most of Canada's major cities (Toronto at 43.7°N, Vancouver at 49.3°N) are actually south of London. London's mild climate despite its northerly latitude is thanks to the Gulf Stream warming the North Atlantic.</div>
    </div>

  

  

  
</ModuleLayout>

<script is:inline>

  /* ── Flight time calculator ── */
  var CITIES = {
    LON: { name: 'London',        lat: 51.5,  lon: -0.1  },
    PAR: { name: 'Paris',         lat: 48.9,  lon:  2.3  },
    BER: { name: 'Berlin',        lat: 52.5,  lon: 13.4  },
    MAD: { name: 'Madrid',        lat: 40.4,  lon: -3.7  },
    ROM: { name: 'Rome',          lat: 41.9,  lon: 12.5  },
    IST: { name: 'Istanbul',      lat: 41.0,  lon: 29.0  },
    NYC: { name: 'New York',      lat: 40.7,  lon:-74.0  },
    LAX: { name: 'Los Angeles',   lat: 34.1,  lon:-118.2 },
    TYO: { name: 'Tokyo',         lat: 35.7,  lon:139.7  },
    SYD: { name: 'Sydney',        lat:-33.9,  lon:151.2  },
    DXB: { name: 'Dubai',         lat: 25.2,  lon: 55.3  },
    SIN: { name: 'Singapore',     lat:  1.3,  lon:103.8  },
    JNB: { name: 'Johannesburg',  lat:-26.2,  lon: 28.0  },
    MEX: { name: 'Mexico City',   lat: 19.4,  lon:-99.1  },
    SCL: { name: 'Santiago',      lat:-33.5,  lon:-70.6  }
  };

  function haversine(a, b) {
    var R = 6371, dLat = (b.lat - a.lat) * Math.PI / 180;
    var dLon = (b.lon - a.lon) * Math.PI / 180;
    var x = Math.sin(dLat/2) * Math.sin(dLat/2) +
            Math.cos(a.lat * Math.PI/180) * Math.cos(b.lat * Math.PI/180) *
            Math.sin(dLon/2) * Math.sin(dLon/2);
    return R * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1-x));
  }

  function calcFlight() {
    var fromKey = document.getElementById('fc-from').value;
    var toKey   = document.getElementById('fc-to').value;
    var el = document.getElementById('fc-result');
    if (fromKey === toKey) { el.innerHTML = 'Choose two different cities.'; return; }
    var a = CITIES[fromKey], b = CITIES[toKey];
    var dist = Math.round(haversine(a, b) / 50) * 50;
    var rawHrs = dist / 900;
    // Add overhead: ~30min for short haul, proportionally less for long haul
    var overhead = Math.max(0.5, 1.2 - dist / 20000);
    var adjusted = rawHrs + overhead;
    var low = (adjusted - 0.5).toFixed(1), high = (adjusted + 0.5).toFixed(1);
    el.innerHTML = '<strong>' + a.name + ' → ' + b.name + '</strong><br>' +
      'Great-circle distance: ~' + dist.toLocaleString() + ' km<br>' +
      'Estimated flight time: ~' + parseFloat(low).toFixed(1) + '–' + parseFloat(high).toFixed(1) + ' hours' +
      '<span class="u-fs-11px text-tertiary"> (based on 900 km/h cruise + taxi/climb overhead)</span>';
  }

  // Init flight calculator
  calcFlight();

  /* ── Height estimator ── */
  function calcHeight() {
    var floors = parseInt(document.getElementById('hest-floors').value, 10);
    var out = document.getElementById('hest-out');
    if (!floors || floors < 1) { out.textContent = 'Enter a floor count above'; return; }
    var m = floors * 3;
    var comparisons = [];
    if (m < 30)       comparisons.push('shorter than a typical 10-storey building (30 m)');
    else if (m < 96)  comparisons.push('comparable to Big Ben (' + 96 + ' m)');
    else if (m < 200) comparisons.push('in the range of a typical skyscraper');
    else if (m < 330) comparisons.push('shorter than the Eiffel Tower (330 m)');
    else if (m < 828) comparisons.push('between the Eiffel Tower and Burj Khalifa');
    else               comparisons.push('taller than the Burj Khalifa (828 m) — nothing built reaches that!');
    out.innerHTML = '<strong>' + floors + ' floors ≈ ' + m.toLocaleString() + ' m</strong> — ' + comparisons[0];
  }

  /* ── Which is bigger? quiz ── */
  var QUIZ_QUESTIONS = [
    { a: 'Brazil',       aKm: 8.5,   b: 'Australia',    bKm: 7.7,   ans: 'a', note: 'Brazil (8.5M km²) is larger than Australia (7.7M km²), though both are massive. Australia is an entire continent yet Brazil beats it.' },
    { a: 'India',        aKm: 3.3,   b: 'Europe (EU)',   bKm: 4.2,   ans: 'b', note: 'The EU (27 countries, ~4.2M km²) is larger than India (3.3M km²). Yet India has 1.4 billion people vs the EU\'s 450 million.' },
    { a: 'Saudi Arabia', aKm: 2.15,  b: 'Mexico',        bKm: 2.0,   ans: 'a', note: 'Saudi Arabia (2.15M km²) narrowly edges Mexico (2.0M km²). Both are roughly the same size as Western Europe.' },
    { a: 'Kazakhstan',   aKm: 2.72,  b: 'Argentina',     bKm: 2.78,  ans: 'b', note: 'Argentina (2.78M km²) just edges Kazakhstan (2.72M km²) — they\'re almost identical in size, which surprises most people.' },
    { a: 'DR Congo',     aKm: 2.34,  b: 'Greenland',     bKm: 2.17,  ans: 'a', note: 'DR Congo (2.34M km²) is larger than Greenland (2.17M km²). Greenland looks enormous on Mercator maps but is smaller than several African countries.' },
    { a: 'Sweden',       aKm: 0.45,  b: 'Spain',         bKm: 0.51,  ans: 'b', note: 'Spain (0.51M km²) is larger than Sweden (0.45M km²). Both are roughly the same order of magnitude as France.' },
    { a: 'Pakistan',     aKm: 0.88,  b: 'Turkey',        bKm: 0.78,  ans: 'a', note: 'Pakistan (0.88M km²) is larger than Turkey (0.78M km²). Pakistan is often underestimated — it\'s the 33rd largest country.' },
    { a: 'Germany',      aKm: 0.357, b: 'Japan',          bKm: 0.378, ans: 'b', note: 'Japan (378k km²) is slightly larger than Germany (357k km²) — they\'re almost identical, often cited as comparable countries.' }
  ];

  var quizIdx = 0, quizScore = 0, quizAnswered = false;
  var quizOrder = [];

  function shuffleQuiz() {
    quizOrder = QUIZ_QUESTIONS.map(function(_, i){ return i; });
    for (var i = quizOrder.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = quizOrder[i]; quizOrder[i] = quizOrder[j]; quizOrder[j] = tmp;
    }
  }

  function renderQuizDots() {
    var dots = document.getElementById('quiz-dots');
    dots.innerHTML = '';
    for (var i = 0; i < QUIZ_QUESTIONS.length; i++) {
      var d = document.createElement('div');
      d.className = 'quiz-dot';
      if (i < quizIdx) d.className += quizOrder[i] !== undefined ? ' got-right' : ' got-wrong';
      dots.appendChild(d);
    }
    // Recompute dots based on history
    dots.innerHTML = '';
    for (var i = 0; i < QUIZ_QUESTIONS.length; i++) {
      var d = document.createElement('div');
      d.className = 'quiz-dot' + (quizHistory[i] === true ? ' got-right' : quizHistory[i] === false ? ' got-wrong' : '');
      dots.appendChild(d);
    }
  }

  var quizHistory = new Array(QUIZ_QUESTIONS.length).fill(null);

  function loadQuizQuestion() {
    if (quizIdx >= QUIZ_QUESTIONS.length) { showQuizEnd(); return; }
    quizAnswered = false;
    var q = QUIZ_QUESTIONS[quizOrder[quizIdx]];
    document.getElementById('qname-a').textContent = q.a;
    document.getElementById('qhint-a').textContent = q.aKm + 'M km²?';
    document.getElementById('qname-b').textContent = q.b;
    document.getElementById('qhint-b').textContent = q.bKm + 'M km²?';
    document.getElementById('qopt-a').className = 'quiz-opt';
    document.getElementById('qopt-b').className = 'quiz-opt';
    document.getElementById('quiz-feedback').textContent = '';
    document.getElementById('quiz-next-btn').style.display = 'none';
    document.getElementById('quiz-restart-btn').style.display = 'none';
    document.getElementById('quiz-progress').textContent = (quizIdx + 1) + ' / ' + QUIZ_QUESTIONS.length;
    document.getElementById('quiz-score-label').textContent = 'Score: ' + quizScore + '/' + quizIdx;
    renderQuizDots();
  }

  function quizAnswer(choice) {
    if (quizAnswered) return;
    quizAnswered = true;
    var q = QUIZ_QUESTIONS[quizOrder[quizIdx]];
    var correct = choice === q.ans;
    if (correct) quizScore++;
    quizHistory[quizIdx] = correct;
    document.getElementById('qopt-' + choice).className = 'quiz-opt ' + (correct ? 'correct' : 'wrong');
    document.getElementById('qopt-' + (choice === 'a' ? 'b' : 'a')).className = 'quiz-opt ' + (correct ? '' : 'correct');
    document.getElementById('quiz-feedback').innerHTML = (correct ? '✓ Correct! ' : '✗ Not quite. ') + q.note;
    document.getElementById('quiz-score-label').textContent = 'Score: ' + quizScore + '/' + (quizIdx + 1);
    renderQuizDots();
    document.getElementById('quiz-next-btn').style.display = quizIdx < QUIZ_QUESTIONS.length - 1 ? 'inline-block' : 'none';
    if (quizIdx === QUIZ_QUESTIONS.length - 1) {
      setTimeout(showQuizEnd, 800);
    }
  }

  function quizNext() {
    quizIdx++;
    loadQuizQuestion();
  }

  function showQuizEnd() {
    document.getElementById('quiz-feedback').innerHTML = 'Finished! Score: <strong>' + quizScore + ' / ' + QUIZ_QUESTIONS.length + '</strong>. ' +
      (quizScore >= 6 ? 'Excellent spatial sense.' : quizScore >= 4 ? 'Good — geography is tricky.' : 'Geography is genuinely counterintuitive. Try again!');
    document.getElementById('quiz-next-btn').style.display = 'none';
    document.getElementById('quiz-restart-btn').style.display = 'inline-block';
    renderQuizDots();
  }

  function quizRestart() {
    quizIdx = 0; quizScore = 0; quizHistory = new Array(QUIZ_QUESTIONS.length).fill(null);
    shuffleQuiz();
    loadQuizQuestion();
  }

  // Init quiz
  shuffleQuiz();
  loadQuizQuestion();

  /* ── Population density dot panels ── */
  var DENSITY_DATA = [
    { label: 'Bangladesh',   density: 1325, color: '#E8503A' },
    { label: 'Netherlands',  density: 518,  color: '#E8503A' },
    { label: 'UK',           density: 275,  color: '#E87C3A' },
    { label: 'India',        density: 464,  color: '#E87C3A' },
    { label: 'Germany',      density: 235,  color: '#E8A427' },
    { label: 'France',       density: 119,  color: '#E8C027' },
    { label: 'USA',          density: 36,   color: '#85B7EB' },
    { label: 'Russia',       density: 9,    color: '#378ADD' },
    { label: 'Australia',    density: 3,    color: '#185FA5' },
    { label: 'Mongolia',     density: 2,    color: '#0C447C' }
  ];

  (function buildDensityPanel() {
    var container = document.getElementById('density-panel');
    var maxDots = 70; // dots to represent max (Bangladesh)
    var maxDensity = 1325;

    DENSITY_DATA.forEach(function(d) {
      var row = document.createElement('div');
      row.className = 'density-row';

      var lbl = document.createElement('div');
      lbl.className = 'dn-label';
      lbl.textContent = d.label;

      var dotsWrap = document.createElement('div');
      dotsWrap.className = 'dn-dots';

      var numDots = Math.max(1, Math.round((d.density / maxDensity) * maxDots));
      for (var i = 0; i < numDots; i++) {
        var dot = document.createElement('div');
        dot.className = 'dn-dot';
        dot.style.background = d.color;
        dotsWrap.appendChild(dot);
      }

      var val = document.createElement('div');
      val.className = 'dn-val';
      val.textContent = d.density.toLocaleString() + ' /km²';

      row.appendChild(lbl);
      row.appendChild(dotsWrap);
      row.appendChild(val);
      container.appendChild(row);
    });
  })();
  
</script>
