    { name: 'Persian Shamsi', emoji: '🌸', color: CAL_COLORS.shamsi, date: shamsi.day + ' ' + shamsi.monthName + ' ' + shamsi.year + ' SH', note: 'Solar Hijri calendar' },
    { name: 'Hebrew', emoji: '✡', color: CAL_COLORS.hebrew, date: hebrew.day + ' ' + hebrew.monthName + ' ' + hebrew.year + ' AM', note: 'Lunisolar calendar (approximate)' },
    { name: 'Chinese', emoji: '🐉', color: CAL_COLORS.chinese, date: 'Year ' + chinese.year + ' -- Year of the ' + chinese.animal, note: chinese.element + ' ' + chinese.animal + ' (approximate)' }
  ];

  var grid = document.getElementById('cal-dates-grid');
  grid.innerHTML = rows.map(function(r) {
    return '<div class="sub-card-roomy" style="border-left: 3px solid ' + r.color + '">' +
      '<div class="u-fs-11px text-secondary u-mb-xs">' + r.emoji + ' ' + r.name + '</div>' +
