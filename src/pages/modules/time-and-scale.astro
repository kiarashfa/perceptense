    return;
  }
  // Proportional model: cumulative "felt time" = sum of 1/age for each year
  // = ln(age) - ln(1) = ln(age). Normalise to age 18 = 1 adult unit.
  const feltTotal = Math.log(age);
  const feltAt18  = Math.log(18);
  const feltAt80  = Math.log(80);
  const pctOfFeltLife = (feltTotal / feltAt80 * 100).toFixed(1);
  const firstDecadeShare = (Math.log(10) / feltAt80 * 100).toFixed(1);
  const lines = [];
  lines.push('At age <strong>' + age + '</strong>, you have experienced roughly <strong>' + pctOfFeltLife + '% of your felt lifetime</strong> (vs ' + (age/80*100).toFixed(1) + '% of your calendar lifetime).');
  lines.push('');
  lines.push('· Your first 10 years account for <strong>' + firstDecadeShare + '%</strong> of your total felt lifespan — more than any subsequent decade.');
  lines.push('· Your first 18 years account for <strong>' + (Math.log(18)/feltAt80*100).toFixed(1) + '%</strong> of felt life — even though they\'re only 22.5% of an 80-year calendar life.');
  if (age >= 20) {
    const decadesFelt = [];
    for (let d = 10; d <= Math.min(age, 80); d += 10) {
      const share = ((Math.log(d) - Math.log(d-10)) / feltAt80 * 100).toFixed(1);
      decadesFelt.push('Ages ' + (d-10) + '–' + d + ': <strong>' + share + '%</strong> of felt life');
    }
    lines.push('');
    lines.push('Felt weight of each decade: ' + decadesFelt.join(' · '));
  }
  document.getElementById('felt-age-output').innerHTML = lines.join('<br>');
}
calcFeltAge();

/* ─── Part H: Estimation Game ───────────────────── */
const GAME_QUESTIONS = [
  {
    q: 'How long is 1 million seconds?',
    opts: ['About 28 hours', 'About 11.5 days', 'About 3 months', 'About 1 year'],
    ans: 1,
    explain: '1,000,000 ÷ 86,400 sec/day = 11.57 days. A million seconds is less than two weeks — much shorter than most people expect.'
  },
  {
    q: 'The Roman Empire fell in 476 CE. How many years ago was that?',
    opts: ['About 800 years', 'About 1,000 years', 'About 1,550 years', 'About 2,000 years'],
    ans: 2,
    explain: '2025 − 476 = 1,549 years. The fall of Rome is closer to us in time than the founding of Rome (753 BCE) is to its fall.'
  },
  {
    q: 'A 45-year-old has lived for approximately how many days?',
    opts: ['~8,000 days', '~16,400 days', '~24,000 days', '~36,500 days'],
    ans: 1,
    explain: '45 × 365.25 ≈ 16,436 days. Most people dramatically underestimate their age in days — you\'ve probably lived over 10,000 days by your late 20s.'
  },
  {
    q: 'How long ago did the last woolly mammoths go extinct?',
    opts: ['~10,000 years ago', '~4,000 years ago', '~1,500 years ago', '~500 years ago'],
    ans: 1,
    explain: 'The last isolated population of woolly mammoths survived on Wrangel Island, Russia, until ~4,000 years ago — while the Egyptian pyramids were already being built. They didn\'t die with the dinosaurs.'
  },
  {
    q: 'Cleopatra lived closer in time to which event?',
    opts: ['The building of the Great Pyramid', 'The Moon landing (1969)'],
    ans: 1,
    explain: 'Cleopatra lived ~30 BCE. The Great Pyramid was built ~2560 BCE — about 2,530 years before her. The Moon landing was 1969 CE — about 2,000 years after her. She is literally closer in time to us than to the pyramids.'
  },
  {
    q: 'If a human lifetime is 80 years, how many lifetimes ago was the signing of the Magna Carta (1215 CE)?',
    opts: ['About 5 lifetimes', 'About 10 lifetimes', 'About 20 lifetimes', 'About 50 lifetimes'],
    ans: 1,
    explain: '2025 − 1215 = 810 years. 810 ÷ 80 = ~10 lifetimes. Almost every major event before the 20th century happened within 20–25 lifetimes of today.'
  },
  {
    q: 'How long does light take to travel from the Sun to Earth?',
    opts: ['About 1 second', 'About 8 minutes', 'About 1 hour', 'About 8 hours'],
    ans: 1,
    explain: 'The Sun is ~150 million km away. Light travels at ~300,000 km/s. 150,000,000 ÷ 300,000 = 500 seconds = 8 minutes 20 seconds. When you look at the Sun, you\'re seeing it as it was 8 minutes ago.'
  },
  {
    q: 'The Industrial Revolution started ~1760. What fraction of recorded history (5,500 years) does that represent?',
    opts: ['The last 50%', 'The last 20%', 'The last 5%', 'The last 1%'],
    ans: 2,
    explain: '2025 − 1760 = 265 years. 265 ÷ 5,500 = 4.8% — less than 5% of recorded human history. Every machine, factory, train, plane, computer, internet: all crammed into the last ~5% of civilised time.'
  }
];

let gameAnswered = new Array(GAME_QUESTIONS.length).fill(false);
let gameCorrect = 0;
let gameTotal = 0;

function renderGame() {
  const container = document.getElementById('game-container');
  let html = '';
  GAME_QUESTIONS.forEach(function(q, qi) {
    html += '<div class="game-card" id="gcard-' + qi + '">';
    html += '<div class="game-q">' + (qi+1) + '. ' + q.q + '</div>';
    html += '<div class="game-opts">';
    q.opts.forEach(function(opt, oi) {
      html += '<button class="game-opt" id="gopt-' + qi + '-' + oi + '" onclick="answerGame(' + qi + ',' + oi + ')">' + opt + '</button>';
    });
    html += '</div>';
    html += '<div class="game-feedback" id="gfb-' + qi + '"></div>';
    html += '</div>';
  });
  container.innerHTML = html;
  updateGameScore();
}

function answerGame(qi, oi) {
  if (gameAnswered[qi]) return;
  gameAnswered[qi] = true;
  gameTotal++;
  const q = GAME_QUESTIONS[qi];
  const isCorrect = oi === q.ans;
  if (isCorrect) gameCorrect++;
  // Disable all buttons for this question and colour them
  for (let i = 0; i < q.opts.length; i++) {
    const btn = document.getElementById('gopt-' + qi + '-' + i);
    btn.disabled = true;
    if (i === q.ans) btn.classList.add('correct');
    else if (i === oi && !isCorrect) btn.classList.add('wrong');
  }
  const fb = document.getElementById('gfb-' + qi);
  fb.innerHTML = (isCorrect ? '✓ Correct. ' : '✗ Not quite. ') + q.explain;
  fb.style.color = isCorrect ? 'var(--color-text-success)' : 'var(--color-text-danger)';
  updateGameScore();
}

function updateGameScore() {
  document.getElementById('game-score').textContent = gameCorrect + ' / ' + gameTotal + (gameTotal === GAME_QUESTIONS.length ? (gameCorrect === GAME_QUESTIONS.length ? ' — Perfect! 🎯' : gameCorrect >= 6 ? ' — Great!' : gameCorrect >= 4 ? ' — Decent calibration' : ' — Keep practising') : '');
}

function resetGame() {
  gameAnswered = new Array(GAME_QUESTIONS.length).fill(false);
  gameCorrect = 0;
  gameTotal = 0;
  renderGame();
}

renderGame();
    
</script>
