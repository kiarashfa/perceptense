  lines.push('<strong>' + fmt(n) + '</strong> — here is what that number feels like:');
  lines.push('');
  if (n >= 1) lines.push('· As seconds of time: <strong>' + (n < 60 ? n.toFixed(0)+' seconds' : n < 3600 ? (n/60).toFixed(1)+' minutes' : n < 86400 ? (n/3600).toFixed(1)+' hours' : n < 31536000 ? (n/86400).toFixed(1)+' days' : n < 31536000000 ? (n/31536000).toFixed(1)+' years' : fmt(n/31536000)+' years') + '</strong>');
  if (n >= 1000) lines.push('· As metres: <strong>' + (n < 1000 ? n+'m' : n < 1000000 ? (n/1000).toFixed(1)+'km' : fmt(n/1000)+'km') + '</strong>' + (n/1000 < 40000 ? ' — ' + (n/1000/40000*100).toFixed(3) + '% of Earth\'s circumference' : n/1000 >= 40000 ? ' — ' + Math.round(n/1000/40000) + '× around Earth' : ''));
  if (n >= 1000) lines.push('· As dollars: <strong>$' + fmt(n) + '</strong>' + (n < 1e6 ? ' — a car or short holiday' : n < 1e7 ? ' — a luxury flat in Paris' : n < 1e8 ? ' — a small company' : n < 1e9 ? ' — a large startup' : n < 1e10 ? ' — a modest billionaire' : n < 1e11 ? ' — a very large company profit' : n < 1e12 ? ' — Apple\'s annual profit territory' : ' — approaching Apple\'s market cap'));
  if (n >= 100) lines.push('· As people: <strong>' + fmt(n) + ' people</strong>' + (n < 1000 ? ' — a small village' : n < 100000 ? ' — a small town' : n < 1000000 ? ' — a city district' : n < 10000000 ? ' — a major city' : n < 100000000 ? ' — a large country' : n < 1000000000 ? ' — a very large country' : ' — approaching world population (' + (n/8200000000*100).toFixed(1) + '% of all humans)'));
  if (n >= 1) lines.push('· As kilograms: <strong>' + fmt(n) + ' kg</strong>' + (n < 1 ? '' : n < 5 ? ' — a bag of sugar' : n < 80 ? ' — a person' : n < 1400 ? ' — a car' : n < 26000 ? ' — ' + Math.round(n/1400) + ' cars' : n < 200000 ? ' — ' + Math.round(n/26000) + ' HGV truck loads' : ' — ' + Math.round(n/200000) + ' container ships'));
  document.getElementById('num-output').innerHTML = lines.join('<br>');
}
