            </style>
          </defs>
          <!-- Axis -->
          <line x1="130" y1="140" x2="650" y2="140" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <line x1="130" y1="20" x2="130" y2="140" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <!-- Y axis label -->
          <text x="4" y="30" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">Days in</text>
          <text x="4" y="40" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">one year</text>
