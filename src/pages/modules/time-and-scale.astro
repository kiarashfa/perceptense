  if (!val) return;
  var parts = val.split('-');
  var gy = parseInt(parts[0]), gm = parseInt(parts[1]), gd = parseInt(parts[2]);
  var jd = jdFromGregorian(gy, gm, gd);
  var hijri = hijriFromJD(jd);
  var hebrew = hebrewFromJD(jd);
  var shamsi = shamsiFromGregorian(gy, gm, gd);
