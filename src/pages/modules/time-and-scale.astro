/* ─── Part E: TZ Converter (dual clock) ─────────── */
function convertTimezone() {
  const timeVal = document.getElementById('tz-input-time').value || '12:00';
  const fromOffset = parseInt(document.getElementById('tz-from-city').value);
  const toOffset   = parseInt(document.getElementById('tz-to-city').value);
  const fromLabel  = document.getElementById('tz-from-city').selectedOptions[0].text;
  const toLabel    = document.getElementById('tz-to-city').selectedOptions[0].text;

  const [hh, mm] = timeVal.split(':').map(Number);
  const utcMinutes = hh * 60 + mm - fromOffset;

  function renderClock(el, offset, label) {
    let localMin = ((utcMinutes + offset) % 1440 + 1440) % 1440;
    const dh = Math.floor(localMin / 60);
    const dm = localMin % 60;
    const timeStr = pad2(dh) + ':' + pad2(dm);
    const absolute = utcMinutes + offset;
    let dayTag = '';
    if (absolute < 0) dayTag = '<span class="u-fs-10px u-text-hex-f09595 u-ml-4px">prev day</span>';
    else if (absolute >= 1440) dayTag = '<span class="u-fs-10px u-text-hex-4e99a3 u-ml-4px">next day</span>';
    const isDay = dh >= 6 && dh < 20;
    const cityName = label.replace(/\s*\(.*\)/, '');
    const utcBit   = label.match(/\(([^)]+)\)/)?.[1] || '';
    el.innerHTML =
      '<div class="tz-city">' + cityName + '</div>' +
      '<div class="tz-time">' + timeStr + dayTag + '</div>' +
      '<div class="tz-date-label u-mt-3px">' +
        '<span class="tz-day-night ' + (isDay ? 'tz-day' : 'tz-night') + '"></span>' +
        utcBit +
      '</div>';
  }

  const diffHours = (toOffset - fromOffset) / 60;
  const sign = diffHours >= 0 ? '+' : '−';
  const absH = Math.abs(diffHours);
  const diffStr = absH === Math.floor(absH) ? sign + Math.floor(absH) + 'h' : sign + absH + 'h';

  renderClock(document.getElementById('tz-clock-from'), fromOffset, fromLabel);
  renderClock(document.getElementById('tz-clock-to'),   toOffset,   toLabel);
  document.getElementById('tz-clock-middle').innerHTML =
    '<div class="u-fs-20px text-tertiary">→</div>' +
    '<div class="u-fs-11px u-fw-500 text-secondary u-mt-4px">' + diffStr + '</div>';
}
convertTimezone();

