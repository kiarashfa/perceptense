          <circle cx="95" cy="15" r="3" fill="var(--accent)"/>
          <text x="100" y="13" font-size="8" fill="var(--color-text-secondary)" font-family="var(--font-sans)">Age 5: year = 20% of life</text>
          <circle cx="270" cy="98" r="3" fill="var(--accent)"/>
          <text x="175" y="96" font-size="8" fill="var(--color-text-secondary)" font-family="var(--font-sans)">Age 30: year = 3.3% of life</text>
