---
import ModuleLayout from '../../layouts/ModuleLayout.astro';
import modules from '../../data/modules.json';
import '../../styles/modules/time-and-scale.css';
import '../../styles/icons/time-and-scale.css';

const mod = modules.find((m) => m.id === 7)!;
---

<ModuleLayout mod={mod}>

  
<div class="u-display-flex u-items-center u-gap-14px u-mb-md">
  <i class="fa-solid fa-hourglass-half u-fs-42px u-text-hex-4e99a3 u-shrink-0"></i>
  <h1 class="module-title u-m-0 u-lh-1-05">Module 7: Time & Scale</h1>
</div>
    <p class="module-subtitle">Seconds to centuries — building time intuition</p>

    <!-- ═══════════════════════════════════════════════════ PART A -->
    <h2 class="sec" id="part-a-the-number-scale-feel-the-gaps-between-orders-of-magnitude">Part A · the number scale — feel the gaps between orders of magnitude</h2>

    <div class="u-bg-background-primary u-border-0-5px-solid-border-tertiary u-radius-radius-lg u-p-13px-15px u-mb-lg">
      <div class="u-fs-13px u-fw-500 text-primary u-mb-xs">From 1 to 1 trillion — with real anchors at every step</div>
      <div class="u-fs-11px text-secondary u-mb-md">Each row is 1,000× the one above it. That gap never gets smaller.</div>
      <div class="bar-row"><span class="bl">1</span><div class="bb u-w-0-4-pct u-bg-hex-e6f1fb u-border-0-5px-solid-hex-b5d4f4"><span class="bv u-text-hex-0c447c u-ml-6px u-fs-10px">one</span></div></div>
      <div class="bar-row"><span class="bl">1,000</span><div class="bb u-w-0-8-pct u-bg-hex-b5d4f4"><span class="bv u-text-hex-042c53 u-ml-6px u-fs-10px">one thousand</span></div></div>
      <div class="bar-row"><span class="bl">1 million</span><div class="bb u-w-2-pct u-bg-hex-85b7eb"><span class="bv u-text-hex-042c53 u-fs-10px">11.5 days in seconds</span></div></div>
      <div class="bar-row"><span class="bl">1 billion</span><div class="bb u-w-8-pct u-bg-hex-378add"><span class="bv u-text-hex-fff u-fs-10px">31.7 years in seconds</span></div></div>
      <div class="bar-row"><span class="bl">1 trillion</span><div class="bb u-w-100-pct u-bg-hex-0c447c"><span class="bv u-text-hex-fff">31,700 years in seconds — before end of Ice Age</span></div></div>
      <div class="u-display-grid u-gridcols-auto-fit-140px-1fr u-gap-sm u-mt-md">
        <div class="u-bg-background-secondary u-radius-radius-md u-p-8px-10px">
          <div class="u-fs-11px text-secondary u-mb-2px">Thousand (10³)</div>
          <div class="u-fs-12px u-fw-500 text-primary">~1,000 people</div>
          <div class="u-fs-11px text-secondary">A village. Fits in a small theatre.</div>
        </div>
        <div class="u-bg-background-secondary u-radius-radius-md u-p-8px-10px">
          <div class="u-fs-11px text-secondary u-mb-2px">Million (10⁶)</div>
          <div class="u-fs-12px u-fw-500 text-primary">~1M people</div>
          <div class="u-fs-11px text-secondary">A medium city (e.g. Birmingham, Prague).</div>
        </div>
        <div class="u-bg-background-secondary u-radius-radius-md u-p-8px-10px">
          <div class="u-fs-11px text-secondary u-mb-2px">Billion (10⁹)</div>
          <div class="u-fs-12px u-fw-500 text-primary">~1B people</div>
          <div class="u-fs-11px text-secondary">China or India. ~⅛ of humanity.</div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ PART B -->
    <h2 class="sec" id="part-b-the-cosmic-time-scale">Part B · the cosmic time scale</h2>

    <div class="u-bg-background-primary u-border-0-5px-solid-border-tertiary u-radius-radius-lg u-p-13px-15px u-mb-md">
      <div class="u-fs-13px u-fw-500 text-primary u-mb-xs">How old is everything? (years ago)</div>
      <div class="u-fs-11px text-secondary u-mb-md">Compressed to a single bar. Human history is invisible at this scale.</div>
      <div class="bar-row"><span class="bl">Big Bang</span><div class="bb u-w-100-pct u-bg-hex-26215c"><span class="bv u-text-hex-cecbf6">13.8 billion years ago</span></div></div>
      <div class="bar-row"><span class="bl">Earth formed</span><div class="bb u-w-32-pct u-bg-hex-534ab7"><span class="bv u-text-hex-fff">4.5 billion years ago</span></div></div>
      <div class="bar-row"><span class="bl">First life on Earth</span><div class="bb u-w-28-pct u-bg-hex-7f77dd"><span class="bv u-text-hex-fff">~3.8 billion years ago</span></div></div>
      <div class="bar-row"><span class="bl">Dinosaurs extinct</span><div class="bb u-w-0-48-pct u-bg-hex-afa9ec"><span class="bv u-text-hex-26215c u-ml-4px u-fs-10px">66M yrs</span></div></div>
      <div class="bar-row"><span class="bl">First humans (Homo sapiens)</span><div class="bb u-w-0-022-pct u-bg-hex-cecbf6 u-border-0-5px-solid-hex-afa9ec"><span class="bv u-text-hex-26215c u-ml-4px u-fs-10px">300K yrs</span></div></div>
      <div class="bar-row"><span class="bl">First writing / cities</span><div class="bb u-w-0-00040-pct u-bg-hex-eeedfe u-border-0-5px-solid-hex-cecbf6"><span class="bv u-text-hex-26215c u-ml-4px u-fs-10px">~5,500 yrs</span></div></div>
      <div class="u-fs-12px text-secondary u-mt-md u-lh-1-5">
        If Earth's entire history = 1 year, humans appeared on <strong class="text-primary">December 31st at ~11:25pm</strong>. All of recorded history — Egypt, Rome, the Renaissance, everything — fits in the last <strong class="text-primary">~35 seconds</strong> of that year.
      </div>
    </div>

    <!-- Cosmic Calendar SVG -->
    <div class="u-bg-background-primary u-border-0-5px-solid-border-tertiary u-radius-radius-lg u-p-13px-15px u-mb-lg">
      <div class="u-fs-13px u-fw-500 text-primary u-mb-xs">The Cosmic Calendar — Earth's year as one year</div>
      <div class="u-fs-11px text-secondary u-mb-md">Each month = ~375 million years. Each day = ~12.3 million years. Each second = ~143 years.</div>
      <div class="svg-wrap">
        <svg viewBox="0 0 700 200" xmlns="http://www.w3.org/2000/svg" class="u-w-100-pct u-maxw-700px u-display-block">
          <!-- Month cells -->
          <defs>
            <style is:inline>
              .cc-month { font-size: 9px; fill: var(--color-text-tertiary); font-family: var(--font-sans); }
              .cc-event { font-size: 8.5px; fill: var(--color-text-secondary); font-family: var(--font-sans); }
              .cc-evtbig { font-size: 9.5px; font-weight: 500; fill: var(--color-text-primary); font-family: var(--font-sans); }
            </style>
          </defs>
          <!-- 12 month blocks, 5 rows of 3, but let's do 4 rows of 3 = 12 months -->
          <!-- Row 1: Jan–Apr, Row 2: May–Aug, Row 3: Sep–Dec -->
          <!-- 3 columns × 4 rows = 12 months, each cell ~168px wide, ~48px tall -->
          <!-- Grid lines -->
          <rect x="1" y="1" width="698" height="198" rx="8" fill="none" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <!-- Months: 3 cols × 4 rows -->
          <!-- COL widths: 0,175,350,525,700; ROW heights: 0,50,100,150,200 -->
          <!-- Row 1 -->
          <rect x="1" y="1" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.6"/>
          <rect x="234" y="1" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.4"/>
          <rect x="467" y="1" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.6"/>
          <!-- Row 2 -->
          <rect x="1" y="51" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.4"/>
          <rect x="234" y="51" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.6"/>
          <rect x="467" y="51" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.4"/>
          <!-- Row 3 -->
          <rect x="1" y="101" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.6"/>
          <rect x="234" y="101" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.4"/>
          <rect x="467" y="101" width="232" height="49" rx="0" fill="var(--color-background-secondary)" opacity="0.6"/>
          <!-- Row 4 -->
          <rect x="1" y="151" width="232" height="48" rx="0" fill="var(--color-background-secondary)" opacity="0.4"/>
          <rect x="234" y="151" width="232" height="48" rx="0" fill="var(--color-background-secondary)" opacity="0.6"/>
          <rect x="467" y="151" width="232" height="48" rx="0" fill="var(--accent-bg)" />
          <!-- Grid dividers -->
          <line x1="233" y1="1" x2="233" y2="199" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <line x1="466" y1="1" x2="466" y2="199" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <line x1="1" y1="50" x2="699" y2="50" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <line x1="1" y1="100" x2="699" y2="100" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <line x1="1" y1="150" x2="699" y2="150" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <!-- Month labels -->
          <text x="8" y="13" class="cc-month">January</text>
          <text x="241" y="13" class="cc-month">February</text>
          <text x="474" y="13" class="cc-month">March</text>
          <text x="8" y="63" class="cc-month">April</text>
          <text x="241" y="63" class="cc-month">May</text>
          <text x="474" y="63" class="cc-month">June</text>
          <text x="8" y="113" class="cc-month">July</text>
          <text x="241" y="113" class="cc-month">August</text>
          <text x="474" y="113" class="cc-month">September</text>
          <text x="8" y="163" class="cc-month">October</text>
          <text x="241" y="163" class="cc-month">November</text>
          <text x="474" y="163" class="cc-month">December</text>
          <!-- Key events -->
          <!-- Jan 1: Big Bang -->
          <circle cx="10" cy="24" r="3" fill="#26215C"/>
          <text x="16" y="27" class="cc-evtbig">Jan 1 — Big Bang (13.8B yrs)</text>
          <!-- Sep ~21: Earth forms 4.5B yrs = 4.5/13.8 = 0.326 of year -->
          <!-- 0.326 × 12 months = month 3.9 = ~late March / early April -->
          <!-- Earth: 4.5/13.8 = 32.6% of year. Sep: month 9 = 66.7%. Earth is actually at ~month 4 -->
          <!-- Let's place: Earth formed ~Sep 2 (common Sagan calendar placement) -->
          <circle cx="249" cy="120" r="3" fill="#534AB7"/>
          <text x="256" y="123" class="cc-event">Sep 2 — Earth &amp; Moon form</text>
          <!-- First life ~Sep 21 -->
          <circle cx="249" cy="133" r="3" fill="#7F77DD"/>
          <text x="256" y="136" class="cc-event">Sep 21 — First microbial life</text>
          <!-- Cambrian explosion Nov 15 -->
          <circle cx="474" cy="120" r="3" fill="#AFA9EC"/>
          <text x="481" y="123" class="cc-event">Nov 15 — Cambrian explosion</text>
          <!-- First land plants Dec 1 -->
          <circle cx="474" cy="133" r="3" fill="#85B7EB"/>
          <text x="481" y="136" class="cc-event">Dec 1 — First land plants</text>
          <!-- Dinosaurs Nov 6 → extinct Dec 30 -->
          <circle cx="474" cy="146" r="3" fill="#AFA9EC"/>
          <text x="481" y="149" class="cc-event">Dec 30 — Dinosaurs extinct</text>
          <!-- Humans Dec 31 11:25pm -->
          <rect x="467" y="170" width="231" height="28" rx="4" fill="var(--accent-bg)" stroke="var(--accent-border)" stroke-width="0.5"/>
          <circle cx="475" cy="182" r="3.5" fill="var(--accent)"/>
          <text x="482" y="178" class="cc-evtbig u-fill-hex-4e99a3">Dec 31, 11:25 PM — Homo sapiens</text>
          <text x="482" y="190" class="cc-event">All recorded history = last 35 seconds</text>
        </svg>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ PART C -->
    <h2 class="sec" id="part-c-human-time-from-seconds-to-a-lifetime">Part C · human time — from seconds to a lifetime</h2>

    <div class="u-bg-background-primary u-border-0-5px-solid-border-tertiary u-radius-radius-lg u-p-13px-15px u-mb-lg">
      <div class="u-fs-13px u-fw-500 text-primary u-mb-md">Key time conversions to feel, not just calculate</div>
      <div class="bar-row"><span class="bl">1 minute</span><div class="bb u-w-0-07-pct u-bg-hex-e1f5ee u-border-0-5px-solid-hex-9fe1cb"><span class="bv u-text-hex-085041 u-ml-5px u-fs-10px">60 sec</span></div></div>
      <div class="bar-row"><span class="bl">1 hour</span><div class="bb u-w-0-4-pct u-bg-hex-9fe1cb"><span class="bv u-text-hex-04342c u-ml-4px u-fs-10px">3,600 sec</span></div></div>
      <div class="bar-row"><span class="bl">1 day</span><div class="bb u-w-1-1-pct u-bg-hex-5dcaa5"><span class="bv u-text-hex-04342c u-fs-10px">86,400 sec</span></div></div>
      <div class="bar-row"><span class="bl">1 week</span><div class="bb u-w-7-5-pct u-bg-hex-1d9e75"><span class="bv u-text-hex-fff u-fs-10px">604,800 sec</span></div></div>
      <div class="bar-row"><span class="bl">1 year</span><div class="bb u-w-40-pct u-bg-hex-085041"><span class="bv u-text-hex-9fe1cb">31.5 million sec</span></div></div>
      <div class="bar-row"><span class="bl">80-year lifetime</span><div class="bb u-w-100-pct u-bg-hex-04342c"><span class="bv u-text-hex-5dcaa5">~2.5 billion sec</span></div></div>
      <div class="u-display-grid u-gridcols-auto-fit-200px-1fr u-gap-sm u-mt-md">
        <div class="u-bg-background-secondary u-radius-radius-md u-p-8px-10px">
          <div class="u-fs-12px u-fw-500 text-primary">Your 80-year lifetime</div>
          <div class="u-fs-11px text-secondary u-lh-1-5">~960 months · ~4,170 weeks · ~29,200 days · ~700,800 hours · ~2.5 billion seconds</div>
        </div>
        <div class="u-bg-background-secondary u-radius-radius-md u-p-8px-10px">
          <div class="u-fs-12px u-fw-500 text-primary">The "million-second" rule</div>
          <div class="u-fs-11px text-secondary u-lh-1-5">1M seconds = 11.5 days · 1B seconds = 31.7 years · 1T seconds = 31,700 years</div>
        </div>
      </div>
    </div>

    <!-- Lifetime dot grid -->
    <div class="u-bg-background-primary u-border-0-5px-solid-border-tertiary u-radius-radius-lg u-p-13px-15px u-mb-lg">
      <div class="u-fs-13px u-fw-500 text-primary u-mb-xs">A lifetime in weeks — 4,160 dots</div>
      <div class="u-fs-11px text-secondary u-mb-sm">Each dot = one week of an 80-year life. Each row = one year (52 weeks).</div>
      <div class="u-display-flex u-items-center u-gap-14px u-flex-wrap u-mb-md">
        <div class="u-display-flex u-items-center u-gap-5px u-fs-11px text-secondary"><span class="u-w-8px u-h-8px u-radius-50-pct u-bg-hex-4e99a3 u-display-inline-block"></span> Lived (age slider)</div>
        <div class="u-display-flex u-items-center u-gap-5px u-fs-11px text-secondary"><span class="u-w-8px u-h-8px u-radius-50-pct u-bg-background-tertiary u-border-0-5px-solid-border-tertiary u-display-inline-block"></span> Remaining</div>
        <div class="u-display-flex u-items-center u-gap-5px u-fs-11px text-secondary u-ml-auto">Age: <strong id="dot-age-label" class="text-primary u-minw-28px">30</strong></div>
      </div>
      <input type="range" min="0" max="80" value="30" id="dot-age-slider" oninput="updateDotGrid(this.value)" class="u-mb-md">
      <div id="dot-grid-wrap" class="dot-grid u-maxh-280px u-overflow-hidden"></div>
      <div class="u-fs-11px text-secondary u-mt-sm" id="dot-summary"></div>
    </div>

    <!-- Planet age calc -->
    <div class="content-panel" id="solar-age">
      <div class="u-fs-12px u-fw-600 text-secondary u-transform-uppercase u-ls-0-06em u-mb-md">Your age across the solar system</div>
      <div class="planet-input-row">
        <label for="planetAgeInput">Enter your age:</label>
        <input type="number" id="planetAgeInput" value="30" min="1" max="120" step="1" class="u-w-80px-important" oninput="renderPlanetAges()">
        <span class="u-fs-12px text-tertiary">Earth years</span>
      </div>
      <div class="planet-grid" id="planetAgeGrid"></div>
      <p class="u-fs-11px text-tertiary u-m-10px-0-0">Each planet's year = the time it takes to orbit the Sun. Your biological age doesn't change — only the unit does.</p>
    </div>

    <!-- ═══════════════════════════════════════════════════ PART D -->
    <h2 class="sec" id="part-d-interactive-number-sense-compare-anything">Part D · interactive number sense — compare anything</h2>

    <div class="u-bg-background-primary u-border-0-5px-solid-border-tertiary u-radius-radius-lg u-p-13px-15px u-mb-lg">
      <div class="u-fs-13px u-fw-500 text-primary u-mb-xs">Enter any number and see it in context.</div>
      <div class="u-display-flex u-gap-md u-items-center u-mb-lg u-flex-wrap">
        <input type="number" id="num-input" aria-label="Enter a number to analyze" placeholder="e.g. 500000000" class="u-flex-1 u-minw-160px u-fs-14px" value="1000000000">
        <button onclick="analyzeNumber()" class="u-p-0-18px u-h-36px u-fs-13px">Analyze ↗</button>
      </div>
      <div id="num-output" class="u-fs-13px text-primary u-lh-1-9"></div>
    </div>

    <!-- ═══════════════════════════════════════════════════ PART E (new) — Time Zones -->
    <h2 class="sec" id="part-e-global-time-zones-the-world-s-clocks-right-now">Part E · global time zones — the world's clocks right now</h2>

    <div class="u-bg-background-primary u-border-0-5px-solid-border-tertiary u-radius-radius-lg u-p-13px-15px u-mb-md">
      <div class="u-fs-13px u-fw-500 text-primary u-mb-xs">Live clocks — major world cities</div>
      <div class="u-fs-11px text-secondary u-mb-md">UTC offsets are fixed references. Daylight saving adjustments shown where applicable.</div>
      <div class="tz-clock-grid" id="tz-live-clocks"></div>
      <div class="u-fs-10px text-tertiary u-mt-md">☀ = daytime (6am–8pm local) · ● = night</div>
    </div>

    <!-- TZ world strip SVG -->
    <div class="u-bg-background-primary u-border-0-5px-solid-border-tertiary u-radius-radius-lg u-p-13px-15px u-mb-md">
      <div class="u-fs-13px u-fw-500 text-primary u-mb-xs">The UTC offset spectrum — West to East</div>
      <div class="u-fs-11px text-secondary u-mb-md">The world spans UTC−12 to UTC+14, a total of 26 hours. Yes, two calendar days exist simultaneously.</div>
      <div class="svg-wrap">
        <svg viewBox="0 0 700 110" xmlns="http://www.w3.org/2000/svg" class="u-w-100-pct u-minw-500px u-maxw-700px u-display-block">
          <defs>
            <linearGradient id="tzgrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#26215C"/>
              <stop offset="46%" stop-color="var(--accent)"/>
              <stop offset="100%" stop-color="#085041"/>
            </linearGradient>
          </defs>
          <!-- Offset bar -->
          <rect x="30" y="30" width="640" height="22" rx="4" fill="url(#tzgrad)" opacity="0.85"/>
          <!-- UTC 0 marker -->
          <line x1="30" y1="28" x2="30" y2="54" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
          <!-- Tick marks every 2 hours -->
          <!-- Total span: 26 hours, bar width 640px -->
          <!-- UTC-12 = x=30, UTC+14 = x=670 -->
          <!-- px per hour = 640/26 = 24.6px -->
          <!-- UTC-12: x=30, UTC-10: x=79, ..., UTC0: x=30+12*24.6=325, UTC+14: x=670 -->
          <!-- Key cities: -->
          <!-- LA UTC-8 (or -7 DST): x=30+(12-8)*24.6=30+98.5=128 -->
          <!-- NYC UTC-5 (or -4 DST): x=30+(12-5)*24.6=30+172=202 -->
          <!-- London UTC+0 (or +1 BST): x=325 -->
          <!-- Paris UTC+1 (or +2 CEST): x=349 -->
          <!-- Dubai UTC+4: x=30+16*24.6=424 -->
          <!-- India UTC+5:30: x=30+17.5*24.6=460 -->
          <!-- Singapore UTC+8: x=30+20*24.6=524 -->
          <!-- Tokyo UTC+9: x=30+21*24.6=548 -->
          <!-- Sydney UTC+10/11: x=30+22*24.6=571 -->
          <!-- Axis labels -->
          <text x="30" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">−12</text>
          <text x="79" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">−10</text>
          <text x="128" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">−8</text>
          <text x="177" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">−6</text>
          <text x="226" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">−4</text>
          <text x="275" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">−2</text>
          <text x="325" y="68" font-size="8.5" fill="var(--color-text-secondary)" font-family="var(--font-sans)" font-weight="500" text-anchor="middle">UTC 0</text>
          <text x="374" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">+2</text>
          <text x="423" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">+4</text>
          <text x="472" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">+6</text>
          <text x="522" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">+8</text>
          <text x="571" y="68" font-size="8" fill="var(--color-text-tertiary)" font-family="var(--font-sans)" text-anchor="middle">+10</text>
