/* ─── Part H: Date Converter ─────────────────────── */
function jdFromGregorian(y, m, d) {
  // Julian Day Number from Gregorian date
  var a = Math.floor((14 - m) / 12);
  var yr = y + 4800 - a;
  var mo = m + 12 * a - 3;
  return d + Math.floor((153 * mo + 2) / 5) + 365 * yr + Math.floor(yr / 4) - Math.floor(yr / 100) + Math.floor(yr / 400) - 32045;
}

function gregorianFromJD(jd) {
  var a = jd + 32044;
  var b = Math.floor((4 * a + 3) / 146097);
  var c = a - Math.floor(146097 * b / 4);
  var d = Math.floor((4 * c + 3) / 1461);
  var e = c - Math.floor(1461 * d / 4);
  var m = Math.floor((5 * e + 2) / 153);
  var day   = e - Math.floor((153 * m + 2) / 5) + 1;
  var month = m + 3 - 12 * Math.floor(m / 10);
  var year  = 100 * b + d - 4800 + Math.floor(m / 10);
  return { year: year, month: month, day: day };
}

// Hijri conversion
function hijriFromJD(jd) {
  var l = jd - 1948440 + 10632;
  var n = Math.floor((l - 1) / 10631);
  l = l - 10631 * n + 354;
  var j = Math.floor((10985 - l) / 5316) * Math.floor((50 * l) / 17719) + Math.floor(l / 5670) * Math.floor((43 * l) / 15238);
  l = l - Math.floor((30 - j) / 15) * Math.floor((17719 * j) / 50) - Math.floor(j / 16) * Math.floor((15238 * j) / 43) + 29;
  var month = Math.floor((24 * (l - 1)) / 709);
  var day   = l - Math.floor((709 * month) / 24);
  var year  = 30 * n + j - 30;
  var HIJRI_MONTHS = ['Muharram','Safar','Rabi\' al-Awwal','Rabi\' al-Thani','Jumada al-Awwal','Jumada al-Thani','Rajab','Sha\'ban','Ramadan','Shawwal','Dhu al-Qadah','Dhu al-Hijjah'];
  return { year: year, month: month, day: day, monthName: HIJRI_MONTHS[month - 1] };
}

// Hebrew conversion (simplified Nachum Dershowitz / Edward Reingold algorithm)
function hebrewFromJD(jd) {
  var d = jd - 347996; // days since Hebrew epoch
  // Approximate: average Hebrew year = 365.2468 days
  var approxYear = Math.floor(d / 365.2468) + 1;
  // Find year such that start of year <= jd < start of next year
  var y = approxYear;
  // Hebrew months names
  var HEBREW_MONTHS = ['Nisan','Iyar','Sivan','Tammuz','Av','Elul','Tishrei','Cheshvan','Kislev','Tevet','Shevat','Adar','Adar II'];
  // Simplified: compute approximate month from elapsed days in year
  var yearStart = 347996 + Math.round((y - 1) * 365.2468);
  var dayInYear = jd - yearStart;
  var month = Math.min(Math.floor(dayInYear / 29.5) + 1, 12);
  var day = Math.max(1, dayInYear - Math.floor((month - 1) * 29.5));
  day = Math.min(day, 30);
  return { year: y + 3760, month: month, day: Math.round(day), monthName: HEBREW_MONTHS[month - 1] };
}

// Persian Shamsi (Solar Hijri)
function shamsiFromGregorian(gy, gm, gd) {
  var g_d_no, j_d_no, j_np, i, j, l;
  var g_days_in_month = [31,28,31,30,31,30,31,31,30,31,30,31];
  var j_days_in_month = [31,31,31,31,31,31,30,30,30,30,30,29];
  gy = gy - 1600; gm = gm - 1; gd = gd - 1;
  g_d_no = 365 * gy + Math.floor((gy + 3) / 4) - Math.floor((gy + 99) / 100) + Math.floor((gy + 399) / 400);
  for (i = 0; i < gm; i++) g_d_no += g_days_in_month[i];
  if (gm > 1 && ((gy + 1600) % 4 === 0) && ((gy + 1600) % 100 !== 0 || (gy + 1600) % 400 === 0)) g_d_no++;
  g_d_no += gd;
  j_d_no = g_d_no - 79;
  j_np = Math.floor(j_d_no / 12053); j_d_no %= 12053;
  var jy = 979 + 33 * j_np + 4 * Math.floor(j_d_no / 1461);
  j_d_no %= 1461;
  if (j_d_no >= 366) { jy += Math.floor((j_d_no - 1) / 365); j_d_no = (j_d_no - 1) % 365; }
  for (i = 0; i < 11 && j_d_no >= j_days_in_month[i]; i++) j_d_no -= j_days_in_month[i];
  var jm = i + 1; var jd = j_d_no + 1;
  var SHAMSI_MONTHS = ['Farvardin','Ordibehesht','Khordad','Tir','Mordad','Shahrivar','Mehr','Aban','Azar','Dey','Bahman','Esfand'];
  return { year: jy, month: jm, day: jd, monthName: SHAMSI_MONTHS[jm - 1] };
}

// Chinese approximate (year + zodiac)
function chineseApprox(gy) {
  var ANIMALS = ['Rat','Ox','Tiger','Rabbit','Dragon','Snake','Horse','Goat','Monkey','Rooster','Dog','Pig'];
  var ELEMENTS = ['Wood','Wood','Fire','Fire','Earth','Earth','Metal','Metal','Water','Water'];
  // Chinese New Year is typically in Jan-Feb; approximate by Gregorian year - 2637 for cycle
  var cycleYear = ((gy - 4) % 12 + 12) % 12;
  var elemYear = ((gy - 4) % 10 + 10) % 10;
  var chYear = gy + 2637;
  return { year: chYear, animal: ANIMALS[cycleYear], element: ELEMENTS[elemYear] };
}

var CAL_MONTH_NAMES_GREG = ['January','February','March','April','May','June','July','August','September','October','November','December'];

function renderCalDates() {
  var input = document.getElementById('cal-date-input');
