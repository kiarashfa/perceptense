/* ============================================================
   pH CALCULATOR
   ============================================================ */
function calcPH() {
  const a = parseFloat(document.getElementById('phA').value);
  const b = parseFloat(document.getElementById('phB').value);
  const el = document.getElementById('phResult');
  if (isNaN(a) || isNaN(b) || a < 0 || a > 14 || b < 0 || b > 14) {
    el.style.display = 'block';
    el.innerHTML = 'Please enter valid pH values between 0 and 14.';
    return;
  }
  const diff = Math.abs(a - b);
  const ratio = Math.pow(10, diff);
  const more = a < b ? 'A is more acidic than B' : (a > b ? 'B is more acidic than A' : 'A and B have the same acidity');
  const ratioStr = ratio >= 1000 ? ratio.toLocaleString() : ratio.toPrecision(3);
  let msg;
  if (diff === 0) {
    msg = `<strong>A and B have exactly the same pH (${a})</strong> — identical acidity.`;
  } else {
    msg = `<strong>${more}</strong> by ${diff.toFixed(1)} pH unit${diff !== 1 ? 's' : ''}.<br>
Because pH is logarithmic, that means the more acidic one has <strong>${ratioStr}×</strong> the concentration of H⁺ ions.<br>`;
    if (diff >= 2) msg += `<span style="color:var(--color-text-secondary); font-size:12px;">For reference: vinegar (pH ~2.5) vs blood (pH 7.4) is a difference of ~4.9 units — roughly 80,000×.</span>`;
  }
  el.style.display = 'block';
  el.innerHTML = msg;
}

