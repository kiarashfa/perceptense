          <option value="monet">Monet (19th century French)</option>
          <option value="picasso">Picasso (20th century)</option>
          <option value="basquiat">Basquiat (1980s New York)</option>
          <option value="rothko">Rothko (Abstract Expressionist)</option>
        </select>
      </div>
