  var works = {
    monalisa:{title:'Mona Lisa',meta:'Leonardo da Vinci \u00b7 c.1503\u20131519 \u00b7 Oil on poplar panel \u00b7 77 \u00d7 53 cm \u00b7 Louvre, Paris',
      boxes:[
        {l:'Physical reality',v:'77 \u00d7 53 cm \u2014 smaller than a standard laptop screen. Painted on poplar wood. Viewable behind bulletproof glass since 1974.'},
        {l:'Key technique',v:'Sfumato: no discernible boundary between tones anywhere in the face. Leonardo used hundreds of ultrathin glaze layers, some measured at 1\u20132 micrometres by X-ray fluorescence.'},
        {l:'Counterintuitive fact',v:'Before its theft in 1911, the Mona Lisa was a well-regarded Leonardo but not uniquely famous. The theft made it world news for two years and permanently elevated its celebrity.'},
        {l:'Condition',v:'The sfumato in the flesh passages has survived well. The background has lost glaze layers that once made it a deeper, more atmospheric blue-green.'}
