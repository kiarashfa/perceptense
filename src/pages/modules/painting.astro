  };

  /* MEDIUM EXPLORER */
  var media = {
    fresco:{ title:'Fresco (buon fresco)', sub:'Pigment + water on wet lime plaster — the plaster is the binder',
      boxes:[
        {l:'Origin', v:'Italy 13th c; ancient Minoan antecedents (~1600 BCE). Pompeii frescos from 1st century CE survive intact.'},
        {l:'Working time', v:'4-8 hours per section. Michelangelo divided the Sistine ceiling into ~400 giornate (daily sections).'},
        {l:'Permanence', v:'Essentially permanent: pigment bonds chemically as calcium carbonate forms. Cannot be removed without destroying the wall.'},
        {l:'Key limitation', v:'Cannot correct after drying. Wall-bound — cannot move. Only water-soluble pigments work.'},
        {l:'Defining masterwork', v:'Michelangelo, Sistine Chapel ceiling (1508-1512) — 500 square metres painted largely by one man in 4 years.'}
      ],
      note:'The "secco" technique applies pigment to dry plaster with a binder — used for finishing details but far less durable. Most secco additions to medieval frescos have flaked off while the true fresco remains. The constraint of the giornata — one day, one section — is directly visible in Michelangelo as a decisive, monumental quality.'
    },
    tempera:{ title:'Egg Tempera', sub:'Pigment + egg yolk — dries in minutes on contact with air',
      boxes:[
        {l:'Origin', v:'Dominant European panel medium c.1200-1450; Byzantine icons used it through the 20th century.'},
        {l:'Working time', v:'Minutes — a loaded stroke is fixed within seconds of touching the ground.'},
        {l:'Permanence', v:'Extremely stable. Cennino Cennini (c.1400) recommended it as permanent; 13th-century panels survive in better condition than many 17th-century oil paintings.'},
        {l:'Key limitation', v:'Cannot blend while wet. Tones built by cross-hatching dozens of thin layers. No wet-into-wet transitions.'},
        {l:'Defining masterwork', v:'Botticelli, The Birth of Venus (c.1484) — its crystalline clarity and precise contour line are quintessential tempera qualities.'}
      ],
      note:'Tempera was not replaced by oil because it is inferior — it was replaced because oil allows a different kind of naturalism. Many contemporary painters (Andrew Wyeth most famously) work exclusively in egg tempera for its irreplaceable jewel-like surface quality.'
    },
    oil:{ title:'Oil Paint', sub:'Pigment + drying oil (linseed, walnut, or poppy) — polymerises over months',
      boxes:[
        {l:'Origin', v:'Northern Europe, perfected by Jan van Eyck c.1430. Italian painters adopted it by ~1480.'},
        {l:'Working time', v:'1-14 days touch-dry depending on pigment. Ivory black and alizarin can take 3-4 weeks. Fully cured: 6 months to 2 years.'},
        {l:'Permanence', v:'Good but complex — oil films become brittle over centuries, developing crackle. Some pigments become transparent with age.'},
