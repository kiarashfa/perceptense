    birthofvenus:{title:'The Birth of Venus',meta:'Sandro Botticelli \u00b7 c.1484\u201386 \u00b7 Egg tempera on canvas \u00b7 172.5 \u00d7 278.9 cm \u00b7 Uffizi, Florence',
