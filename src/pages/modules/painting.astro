      look:'Find the single vanishing point \u2014 it is at the gap between the two central figures\' gestures. Every orthogonal line in the architectural perspective leads to this point, which is also the intellectual centre of the painting\'s argument: between Platonic idealism (pointing up) and Aristotelian empiricism (palm down). The entire composition is a philosophical argument made spatial.'
    },
    waterlilies:{title:'Water Lilies (late series)',meta:'Claude Monet \u00b7 c.1914\u20131926 \u00b7 Oil on canvas \u00b7 multiple monumental panels \u00b7 Orangerie, Paris; MoMA, New York',
      boxes:[
        {l:'Physical reality',v:'The Orangerie installation consists of eight canvases in two oval rooms, each canvas up to 6 metres wide. Monet specified the architecture of the rooms.'},
        {l:'Key technique',v:'Dense impasto and very large brushmarks applied with increasingly failing eyesight in Monet\'s last years. The surface dissolves any horizon line, creating spatial ambiguity.'},
        {l:'Counterintuitive fact',v:'The late Water Lilies anticipate Abstract Expressionism by two decades. Pollock and de Kooning acknowledged the Orangerie panels as precursors. Monet was completing them as the first American Abstract Expressionists were being born.'},
        {l:'Completion context',v:'Monet donated the Orangerie panels to the French state as a memorial to soldiers who died in WWI. They were installed in 1927, the year after his death.'}
      ],
      look:'Go to the Orangerie in Paris if you can. Standing inside the oval rooms, the panoramic wrap-around installation creates total immersion in horizontal light and reflected sky \u2014 no ground line, no ceiling line, no entry point for the eye. This is the culmination of Impressionism\'s 60-year project of capturing light, and it anticipates the immersive environments of contemporary installation art.'
    }
  };

  var workBtnsEl = document.getElementById('workBtns');
  var workPanelEl = document.getElementById('workPanel');
  var workNames = {monalisa:'Mona Lisa',nightwatch:'Night Watch',lasmeninas:'Las Meninas',guernica:'Guernica',starrynight:'Starry Night',birthofvenus:'Birth of Venus',schoolofathens:'School of Athens',waterlilies:'Water Lilies'};
  workBtnsEl.innerHTML = Object.keys(workNames).map(function(k){
    return '<button class="work-btn" onclick="showWork(\''+k+'\',this)">'+workNames[k]+'</button>';
  }).join('');

  window.showWork = function(key, btn) {
    document.querySelectorAll('.work-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    var w = works[key];
    var boxHtml = w.boxes.map(function(b){ return '<div class="work-box"><div class="work-box-label">'+b.l+'</div><div class="work-box-val">'+b.v+'</div></div>'; }).join('');
    workPanelEl.innerHTML =
      '<div class="work-title">'+w.title+'</div>'+
      '<div class="work-meta">'+w.meta+'</div>'+
      '<div class="work-grid">'+boxHtml+'</div>'+
      '<div style="font-size:11px;font-weight:600;color:var(--color-text-tertiary);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px">What to actually look at</div>'+
      '<div class="work-look">'+w.look+'</div>';
  };
  showWork('monalisa', workBtnsEl.querySelector('.work-btn'));

  /* AUCTION CHART */
  var auctions = [
    {l:'Salvator Mundi \u2014 da Vinci (attrib.) \u00b7 2017',v:450.3,col:'var(--accent)'},
    {l:'Interchange \u2014 de Kooning \u00b7 2015',v:300.0,col:'#3A6BB0'},
    {l:'The Card Players \u2014 C\u00e9zanne \u00b7 2011',v:259.0,col:'#C85C14'},
    {l:'Nafea Faa Ipoipo \u2014 Gauguin \u00b7 2015',v:210.0,col:'#2C8C6A'},
    {l:'No.6 Violet, Green & Red \u2014 Rothko \u00b7 2014',v:186.0,col:'#8B3A9C'},
    {l:'Nu couch\u00e9 \u2014 Modigliani \u00b7 2015',v:170.4,col:'#C05AA0'},
    {l:'Portrait of Adele Bloch-Bauer II \u2014 Klimt \u00b7 2006',v:150.0,col:'#6B5B00'},
    {l:'Gar\u00e7on \u00e0 la pipe \u2014 Picasso \u00b7 2004',v:104.2,col:'#A09060'}
  ];
  var maxA = Math.max.apply(null, auctions.map(function(d){return d.v;}));
  document.getElementById('auctionChart').innerHTML = auctions.map(function(d){
    return '<div class="bar-row"><div class="bl">'+d.l+'</div><div class="bb" style="width:'+((d.v/maxA)*68).toFixed(1)+'%;background:'+d.col+';opacity:.85"><span class="bv" style="color:#fff">$'+d.v+'m</span></div></div>';
  }).join('');

  /* FORGERY CALCULATOR */
  var forgerArtistData = {
    vermeer:{period:'17th century Dutch',works:34,case:'Han van Meegeren fooled Abraham Bredius \u2014 the world\'s leading Vermeer authority \u2014 in 1937 by solving the paint-aging problem with phenol formaldehyde resin baked at 105\u00b0C.',forensic:'GCMS pigment analysis would immediately find anachronistic synthetic compounds. Modern forgers face chromatographic analysis that can date organic binders to within decades.'},
    rembrandt:{period:'17th century Dutch',works:'~300 authenticated',case:'The Rembrandt Research Project (1968\u20132014) stripped attribution from over 100 previously accepted "Rembrandts" using systematic technical analysis \u2014 most were by followers or collaborators.',forensic:'X-ray fluorescence identifies specific lead white formulations; dendrochronology dates panel supports. The RRP established that Rembrandt\'s studio practice makes attribution genuinely difficult even for real works.'},
    monet:{period:'19th century French',works:'~2,500',case:'More fake Monets exist in circulation than fake Vermeers \u2014 the large output and loose brushwork make replication easier. Many fakes pre-date modern forensic tools and may never be identified.',forensic:'Pigment analysis flags post-1900 synthetic pigments immediately. Canvas and stretcher construction must be period-accurate. Infrared reflectography reveals whether an underdrawing exists (Monet rarely did).'},
    picasso:{period:'20th century',works:'~20,000+',case:'Picasso personally authenticated hundreds of fakes when shown them \u2014 sometimes deliberately. He reportedly said "I can fake a Picasso as well as anyone." The enormous output makes authentication genuinely complex.',forensic:'Synthetic pigments unavailable before specific dates (phthalo blue before 1936) are immediate disqualifiers. The Picasso Administration maintains the authoritative database.'},
    basquiat:{period:'1980s New York',works:'~1,200',case:'In 2022 the FBI seized four suspected Basquiats from a Florida museum acquired for $12m. The estate\'s authentication board dissolved in 2012 \u2014 there is no official body, creating serious market risk.',forensic:'Paint analysis can date materials to within years. Canvas and board materials are precisely datable. Provenance gaps are severe red flags given the small corpus.'},
    rothko:{period:'1950s\u20131970s, New York',works:'~836',case:'The Knoedler gallery scandal (2011): 40 fake Abstract Expressionists including Rothkos sold for $80m total over 15 years. Forger Pei-Shen Qian used correct period pigments but anachronistic canvas support gave him away.',forensic:'Rothko used specific commercially available paints whose batch histories can be traced. A previously unknown Rothko with no exhibition history is immediately suspicious.'}
  };
  var forgerTechData = {
    visual:{name:'Visual inspection',pct:15,note:'A skilled connoisseur eye can catch anachronistic stylistic details or implausible surface aging. But Van Meegeren passed visual inspection by the world\'s best eyes. Professional-level forgeries pass visual inspection at very high rates.'},
    xray:{name:'X-ray and infrared reflectography',pct:48,note:'X-ray reveals underdrawing and earlier compositional stages. Forgers often lack the underpaint layers that characterise original works. Infrared shows carbon-based underdrawing. Significantly improves detection but cannot date materials.'},
    pigment:{name:'Pigment analysis (GCMS)',pct:83,note:'Gas chromatography-mass spectrometry identifies organic binders and pigments to within decades of manufacture. Any synthetic pigment in a supposedly pre-20th-century work is a definitive red flag. High detection rate for most forgeries that cut corners on materials.'},
    full:{name:'Full multi-spectral + dendrochronology',pct:97,note:'Combining XRF, Raman spectroscopy, isotope analysis, pigment dating, canvas thread count and age analysis, and dendrochronology makes successful forgery of historical works nearly impossible. The residual 3% reflects edge cases of period materials reused for contemporary forgeries.'}
  };

  window.calcForgery = function() {
    var artist = document.getElementById('forgerArtist').value;
    var tech = document.getElementById('forgerTech').value;
    var a = forgerArtistData[artist];
    var t = forgerTechData[tech];
    var el = document.getElementById('forgeryResult');
    el.style.display = 'block';
    el.innerHTML =
      '<div style="font-size:13px;font-weight:600;color:var(--color-text-primary);margin-bottom:8px">Detection probability with '+t.name+': '+t.pct+'%</div>'+
      '<div style="background:var(--color-background-primary);border-radius:var(--border-radius-md);height:10px;margin-bottom:12px;overflow:hidden">'+
        '<div style="width:'+t.pct+'%;height:100%;background:var(--accent);border-radius:var(--border-radius-md)"></div>'+
      '</div>'+
      '<div style="margin-bottom:8px;line-height:1.6"><strong>Forensic method:</strong> '+t.note+'</div>'+
      '<div style="margin-bottom:8px;line-height:1.6"><strong>'+artist.charAt(0).toUpperCase()+artist.slice(1)+' specifically ('+a.period+', ~'+a.works+' known works):</strong> '+a.case+'</div>'+
      '<div style="line-height:1.6"><strong>Modern forensic challenge:</strong> '+a.forensic+'</div>';
  };

});
</script>
