  ];

  function buildGenericTabs(tabId, panelId, data) {
    const tabBar = document.getElementById(tabId);
    const panel = document.getElementById(panelId);
    if (!tabBar || !panel) return;
    data.forEach((m, i) => {
      const btn = document.createElement('button');
      btn.className = 'tab-btn' + (i === 0 ? ' active' : '');
      btn.textContent = m.tab;
      btn.onclick = () => {
        tabBar.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        panel.innerHTML = m.content;
      };
      tabBar.appendChild(btn);
    });
    panel.innerHTML = data[0].content;
  }

  buildGenericTabs('galaxy-tabs', 'galaxy-panel', galaxyTypes);

  /* ─────────────────────────────────────────────
     EXOPLANET DETECTION TABS
  ───────────────────────────────────────────── */
  const exoMethods = [
    {
      tab: 'Transit',
      content: `<div class="u-fs-14px u-fw-500 text-primary u-mb-md">Transit method -- watching a star dim</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px;margin-bottom:10px;">
        <div class="sub-card-compact"><div class="muted-text-small">Exoplanets found</div><div class="u-fs-12px u-fw-500 text-primary">~4,100+ (by Kepler and TESS alone)</div></div>
        <div class="sub-card-compact"><div class="muted-text-small">Best for</div><div class="u-fs-12px u-fw-500 text-primary">Large planets close to their star</div></div>
        <div class="sub-card-compact"><div class="muted-text-small">Key mission</div><div class="u-fs-12px u-fw-500 text-primary">Kepler Space Telescope (2009-2018)</div></div>
      </div>
      <div class="muted-copy">When a planet passes in front of its star (from our line of sight), it blocks a tiny fraction of the star's light -- typically 0.01% to 1%. Repeated, periodic dips in brightness reveal the planet's orbital period and size relative to its star. The Kepler mission alone revolutionised our understanding: it found that planets are the rule, not the exception -- the Milky Way likely contains more planets than stars. TESS (Transiting Exoplanet Survey Satellite) continued Kepler's work from 2018. Key limitation: requires orbital plane to be aligned with our line of sight -- only ~10% of orbits qualify.</div>`
    },
    {
      tab: 'Radial velocity',
      content: `<div class="u-fs-14px u-fw-500 text-primary u-mb-md">Radial velocity -- listening to the star wobble</div>
