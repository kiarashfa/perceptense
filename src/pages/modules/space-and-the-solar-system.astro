        <div style="background:var(--color-background-primary);border-radius:var(--border-radius-md);padding:6px 10px;border:0.5px solid var(--color-border-tertiary);"><span style="font-size:11px;color:var(--color-text-secondary);">Region: </span><span style="font-size:12px;font-weight:500;color:var(--color-text-primary);">${d.atm}</span></div>
      </div>
      <div style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;">${d.note}</div>`;
  }
  document.getElementById('u-flex-1').max = distances.length - 1;
  document.getElementById('u-flex-1').addEventListener('input', updateDist);

