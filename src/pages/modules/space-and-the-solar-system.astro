      if (km >= 1e12) return `${(km/1e9).toFixed(1)} billion km`;
      if (km >= 1e9)  return `${(km/1e6).toFixed(0)} million km`;
      if (km >= 1e6)  return `${(km/1e3).toFixed(0)} thousand km`;
      return `${km.toLocaleString()} km`;
    };
