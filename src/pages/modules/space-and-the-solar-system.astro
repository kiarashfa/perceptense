      const btn = document.createElement('button');
      btn.className = 'tab-btn' + (i === 0 ? ' active' : '');
      btn.textContent = m.tab;
      btn.onclick = () => {
        document.querySelectorAll('#spacex-tabs .tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('spacex-panel').innerHTML = m.content;
      };
      tabBar.appendChild(btn);
    });
    panel.innerHTML = spacexMissions[0].content;
  }

  buildSpacexTabs();

  /* ─────────────────────────────────────────────
     GALAXY TYPES TABS
  ───────────────────────────────────────────── */
  const galaxyTypes = [
    {
      tab: 'Spiral',
