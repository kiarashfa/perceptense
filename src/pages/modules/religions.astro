    var meditationTexts = [
      { max: 20,  text: 'Deep samatha (calm-abiding): the meditator focuses on a single object (the breath, a mantra, a visualised image) until the mind becomes completely still. At high levels this produces the jhanas — altered states of profound equanimity and bliss. Many traditions — Hindu yoga, Theravada samatha, Sufi dhikr — share this structure. The goal is a stable, undistracted mind that can then be turned to insight.' },
      { max: 40,  text: 'Samatha-vipassana balance: most classical Theravada practice begins with samatha to stabilise attention, then pivots to vipassana. A calm mind investigates its own experience: noticing that every sensation arises and passes away, that there is no stable "experiencer" underlying experience, that clinging produces suffering. This is the core of the retreat practice popularised in the West by teachers like Mahasi Sayadaw and Jack Kornfield.' },
      { max: 60,  text: "Integrated practice: Zen's shikantaza ('just sitting'), Tibetan dzogchen, and some non-dual Hindu traditions (advaita) blur the samatha/vipassana distinction. The practice is simply resting in open awareness without manipulating experience — neither suppressing thoughts nor following them. This is harder to learn without a teacher but avoids the risk of samatha becoming a pleasant escape from insight." },
      { max: 80,  text: "Vipassana-dominant: intensive insight meditation as taught in the Burmese tradition (Mahasi Sayadaw's noting practice) and popularised by groups like Spirit Rock and Insight Meditation Society. The meditator continuously notes the arising and passing of sensations, emotions, and thoughts to directly experience impermanence. Can produce dramatic insights but also occasionally difficult psychological experiences (the 'dark night of the soul' described in the Visuddhimagga)." },
      { max: 100, text: "Pure inquiry / self-investigation: Ramana Maharshi's 'Who am I?' practice and some Dzogchen pointing-out instructions ask the meditator to look directly for the one who is meditating. The practice is entirely conceptual collapse — not concentration on an object, not systematic noting, but a direct investigation of the sense of 'I.' This is arguably the most direct but also requires significant preparatory groundwork and a reliable teacher." }
    ];
    window.updateMeditationSlider = function(val) {
      val = parseInt(val);
      var txt = meditationTexts.find(function(t){ return val <= t.max; });
      document.getElementById('meditation-output').textContent = txt ? txt.text : '';
    };
    updateMeditationSlider(50);

    /* Polytheism period chart */
    var periods = [
      { label: 'Ancient Egyptian',  start: -3100, end: -332,  col: '#C9A87A', bg: '#F5EDE0', text: '#7a5c2e' },
      { label: 'Ancient Greek',     start: -800,  end: -146,  col: '#5B7FA6', bg: '#E6F1FB', text: '#0c447c' },
      { label: 'Roman religion',    start: -700,  end: 380,   col: '#A67C52', bg: '#faeeda', text: '#633806' },
      { label: 'Norse / Germanic',  start: -200,  end: 1100,  col: '#3C3489', bg: '#EEEDFE', text: '#3C3489' },
      { label: 'Mystery religions', start: -600,  end: 400,   col: '#085041', bg: '#E1F5EE', text: '#085041' }
    ];
    var minY = -3200, maxY = 1200, range = maxY - minY;
    function pct(y){ return ((y - minY) / range * 100).toFixed(1) + '%'; }
    var axis = document.getElementById('polytheism-axis');
    [-3000,-2000,-1000,0,500,1000].forEach(function(y){
      var m = document.createElement('div'); m.className = 'pc-axis-mark'; m.style.left = pct(y);
      m.textContent = y < 0 ? Math.abs(y)+' BCE' : (y === 0 ? '0' : y+' CE'); axis.appendChild(m);
    });
    var pchart = document.getElementById('polytheism-chart');
    periods.forEach(function(p){
      var row = document.createElement('div'); row.className = 'pc-row';
      var lbl = document.createElement('div'); lbl.className = 'pc-label'; lbl.textContent = p.label;
      var track = document.createElement('div'); track.className = 'pc-track';
      var fill = document.createElement('div'); fill.className = 'pc-fill';
      fill.style.left = pct(p.start); fill.style.width = ((p.end - p.start) / range * 100).toFixed(1)+'%';
      fill.style.background = p.bg; fill.style.border = '0.5px solid '+p.col;
      var flbl = document.createElement('span'); flbl.className = 'pc-fill-label'; flbl.style.color = p.text;
      flbl.textContent = (p.end - p.start)+' years'; fill.appendChild(flbl); track.appendChild(fill);
      row.appendChild(lbl); row.appendChild(track); pchart.appendChild(row);
    });

    /* Secularism calculator */
    window.calcSecularism = function() {
      var rel = parseFloat(document.getElementById('calc-religion-important').value);
      var att = parseFloat(document.getElementById('calc-weekly-attend').value);
      var nr  = parseFloat(document.getElementById('calc-no-religion').value);
      var hdi = parseFloat(document.getElementById('calc-hdi').value);
      if (isNaN(rel)||isNaN(att)||isNaN(nr)||isNaN(hdi)) { document.getElementById('secularism-output').textContent = 'Please fill in all four fields with numbers.'; return; }
      var score = ((100-rel)+(100-att)+nr+(hdi*100))/4;
      var label, context;
      if (score >= 75) { label = 'Highly secular'; context = "This profile resembles Sweden, the Czech Republic, or Japan — where institutional religion is minimal but cultural spiritual practices may persist. Norris and Inglehart's existential security theory fits well: high HDI reduces the anxiety that religion typically addresses."; }
      else if (score >= 55) { label = 'Moderately secular'; context = 'This resembles the UK, Germany, or Australia — countries where active religious practice has declined sharply but significant minority participation and "believing without belonging" remain. Religious identity may still shape politics and identity without generating weekly attendance.'; }
      else if (score >= 35) { label = 'Moderately religious'; context = "This resembles the United States, Brazil, or Poland — countries with significant active religious communities alongside a growing secular minority. The U.S. is particularly anomalous: very high HDI but much higher religiosity than comparable European nations, which challenges simple modernisation theories."; }
      else { label = 'Highly religious'; context = "This profile resembles Egypt, Nigeria, or the Philippines — countries where religion is deeply integrated into public life, civic identity, and daily practice. High religiosity here correlates with younger populations, lower HDI, and societies where religion performs crucial social-support functions that secular institutions do not yet provide."; }
      document.getElementById('secularism-output').textContent = 'Secularisation score: '+score.toFixed(0)+'/100 — '+label+'. '+context;
    };

    /* Future of religion slider */
    var futureTexts = [
      { max: 20,  text: 'The strong secularisation thesis: you agree with the early Berger, Comte, and Wilson that modernity dissolves religion as surely as it dissolves feudalism. Education, science, and material security eliminate the functions religion once served. The data: Western Europe and Japan suggest this is possible. But globally, religion is growing — suggesting this may be a specifically European story, not a universal law.' },
      { max: 40,  text: 'Modified secularisation: religion declines in the Global North as existential security increases, but resurges where insecurity is high (Global South), and the U.S. remains anomalous. Perhaps what declines is institutional religion, while private spiritual belief persists. This is closer to the sociological consensus today: differentiation (religion retreating from public institutions) without disappearance.' },
      { max: 60,  text: "Transformation rather than decline: religion changes its forms but does not disappear. The Pentecostal explosion, the growth of 'spiritual but not religious,' AI-generated personalised spiritual guidance — all suggest religion is mutating rather than dying. William James was right: the religious impulse (awe, meaning-seeking, transcendence-hunger) is psychologically near-universal. It will find new containers if the old ones break." },
      { max: 80,  text: "Resilient pluralism: religious diversity grows rather than converges. As global communication accelerates, people encounter more traditions, leading to hybridisation, cafeteria spirituality, and creative synthesis rather than secular homogenisation. Harari's Dataism might become a quasi-religion for tech elites, while traditional religions retain billions of adherents. The future is 50 varieties of meaning-making, not one." },
      { max: 100, text: "Persistent and growing religion: demography favours the religious. The more religious a group, the higher its fertility rate. Secularism correlates with falling birth rates. By 2070 projections, the world's largest Christian population will be in sub-Saharan Africa; Islam will have matched Christianity in numbers. Religion is not declining — secular Western intellectuals are simply experiencing their own bubble as universal." }
    ];
    window.updateFutureSlider = function(val) {
      val = parseInt(val);
      var txt = futureTexts.find(function(t){ return val <= t.max; });
      document.getElementById('future-output').textContent = txt ? txt.text : '';
    };
    updateFutureSlider(50);

  });
  
</script>
