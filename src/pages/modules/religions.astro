        <line x1="300" y1="54" x2="120" y2="100" class="abt-line" stroke-dasharray="4"/><line x1="340" y1="54" x2="340" y2="100" class="abt-line"/><line x1="380" y1="54" x2="560" y2="100" class="abt-line" stroke-dasharray="4"/>
        <rect x="30" y="100" width="160" height="44" rx="8" fill="#3C3489" opacity="0.13" stroke="#3C3489" stroke-width="1"/>
