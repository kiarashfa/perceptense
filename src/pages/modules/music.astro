    function showInstrFamily(family, tabEl) {
      ['string','wind','percussion'].forEach(function(f) {
        document.getElementById('instrPanel-' + f).classList.remove('show');
      });
      document.querySelectorAll('.instr-family-tab').forEach(function(t) { t.classList.remove('active'); });
      document.getElementById('instrPanel-' + family).classList.add('show');
      if (tabEl) tabEl.classList.add('active');
    }

    function showInstrDetail(instr, family) {
      var detail = document.getElementById('instrDetail-' + family);
      var rangeLeft = ((instr.rangeStart / 87) * 100).toFixed(1);
      var rangeWidth = (((instr.rangeEnd - instr.rangeStart) / 87) * 100).toFixed(1);
      detail.innerHTML =
        '<div class="instr-detail-header">'
        + '<div class="instr-detail-big-icon">' + instr.emoji + '</div>'
        + '<div><div class="instr-detail-title">' + instr.name + '</div>'
        + '<div class="instr-detail-subtitle">' + instr.subtitle + ' &nbsp;|&nbsp; ' + instr.origin + '</div></div>'
        + '</div>'
        + '<div class="instr-detail-grid">'
        + '<div class="instr-detail-cell"><div class="instr-detail-cell-label">Family / Classification</div><div class="instr-detail-cell-val">' + instr.family + '</div></div>'
        + '<div class="instr-detail-cell"><div class="instr-detail-cell-label">Inventor / Origin</div><div class="instr-detail-cell-val">' + instr.inventor + '</div></div>'
        + '<div class="instr-detail-cell"><div class="instr-detail-cell-label">Construction</div><div class="instr-detail-cell-val">' + instr.construction + '</div></div>'
        + '<div class="instr-detail-cell"><div class="instr-detail-cell-label">Playing Range</div><div class="instr-detail-cell-val">' + instr.range
        + '<div class="range-bar-wrap"><div class="range-bar-track">'
        + '<div class="range-bar-fill" style="left:' + rangeLeft + '%;width:' + rangeWidth + '%;background:' + instr.rangeColor + ';opacity:0.75;"></div>'
        + '</div><div class="range-bar-poles"><span>A0 (piano low)</span><span>C8 (piano high)</span></div></div>'
        + '</div></div>'
        + '<div class="instr-detail-cell"><div class="instr-detail-cell-label">Key Techniques</div><div class="instr-detail-cell-val">' + instr.technique + '</div></div>'
        + '<div class="instr-detail-cell" style="grid-column:1/-1"><div class="instr-detail-cell-label">Legendary Artists</div><div class="instr-detail-cell-val">' + instr.legendary + '</div></div>'
        + '<div class="instr-detail-cell" style="grid-column:1/-1"><div class="instr-detail-cell-label">Essential Listening</div><div class="instr-detail-cell-val">' + instr.works + '</div></div>'
        + '</div>'
        + '<div class="muted-copy u-mt-md">' + instr.history + '</div>';
      detail.classList.add('show');
    }

    function buildInstrGrid(family) {
      var grid = document.getElementById('instrGrid-' + family);
      var detail = document.getElementById('instrDetail-' + family);
      if (!grid || !detail) return;
      instrData[family].forEach(function(instr, i) {
        var card = document.createElement('div');
        card.className = 'instr-selector-card' + (i === 0 ? ' active' : '');
        card.innerHTML = '<div class="instr-selector-icon">' + instr.emoji + '</div>'
          + '<div class="instr-selector-name">' + instr.name + '</div>'
          + '<div class="instr-selector-origin">' + instr.origin.split(',')[0] + '</div>';
        card.onclick = function() {
          document.querySelectorAll('#instrGrid-' + family + ' .instr-selector-card').forEach(function(c) { c.classList.remove('active'); });
          card.classList.add('active');
          showInstrDetail(instr, family);
        };
        grid.appendChild(card);
      });
      showInstrDetail(instrData[family][0], family);
    }

    function buildRangeChart() {
      var container = document.getElementById('instrRangeChart');
      if (!container) return;
      var allInstrs = [
        { name: 'Piano',            start: 0,  end: 87, color: '#8E44AD' },
        { name: 'Harp',             start: 2,  end: 78, color: '#F39C12' },
        { name: 'Violin',           start: 30, end: 81, color: '#4A90D9' },
        { name: 'Flute',            start: 38, end: 75, color: '#2980B9' },
        { name: 'Marimba (5-oct)',  start: 14, end: 74, color: '#9B59B6' },
        { name: 'Cello',            start: 14, end: 62, color: '#E07B5A' },
        { name: 'Clarinet (Bb)',    start: 24, end: 63, color: '#27AE60' },
        { name: 'Oboe',             start: 33, end: 63, color: '#D35400' },
        { name: 'Trumpet (Bb)',     start: 24, end: 61, color: '#C0392B' },
        { name: 'Alto Sax',         start: 33, end: 60, color: '#E67E22' },
        { name: 'French Horn',      start: 12, end: 52, color: '#8E44AD' },
        { name: 'Guitar',           start: 16, end: 48, color: '#27AE60' },
        { name: 'Double Bass',      start: 6,  end: 42, color: '#555555' },
        { name: 'Timpani (set)',    start: 14, end: 38, color: '#C0392B' }
      ];
      allInstrs.forEach(function(inst) {
        var row = document.createElement('div');
        row.className = 'bar-row';
        var label = document.createElement('div');
        label.className = 'bl';
        label.textContent = inst.name;
        var track = document.createElement('div');
        track.style.cssText = 'flex:1;height:16px;background:var(--color-background-secondary);border-radius:3px;position:relative;min-width:100px;';
        var fill = document.createElement('div');
        var left = (inst.start / 87 * 100).toFixed(1);
        var width = ((inst.end - inst.start) / 87 * 100).toFixed(1);
        fill.style.cssText = 'position:absolute;top:0;height:100%;border-radius:3px;left:' + left + '%;width:' + width + '%;background:' + inst.color + ';opacity:0.75;';
        var semVal = document.createElement('div');
        semVal.className = 'bv';
        semVal.style.cssText = 'font-size:10px;color:var(--color-text-tertiary);width:50px;flex-shrink:0;';
        semVal.textContent = (inst.end - inst.start) + ' st';
        track.appendChild(fill);
        row.appendChild(label);
        row.appendChild(track);
        row.appendChild(semVal);
        container.appendChild(row);
      });
    }

    /* ════════════════════════════════════
       INIT
    ════════════════════════════════════ */
    window.addEventListener('DOMContentLoaded', function() {
      buildFreqBars();
      buildRhythmGrid([1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0]);
      buildComposerGrid();
      showComposer(0, null);
      buildFormExplorer();
      buildOrchDist();
      buildPeriodExplorer();
      buildWorksGrid();
      buildTraditionsExplorer();
      buildPentaSlider();
      buildGenreTimeline();
      buildGenreGrid();
      buildListenGrid();
      calcBPM();
      // Show first composer card as active after grid builds
      const firstCard = document.querySelector('.composer-card');
      if (firstCard) firstCard.classList.add('active');
      // Part G
      buildInstrGrid('string');
      buildInstrGrid('wind');
      buildInstrGrid('percussion');
      buildRangeChart();
    });
  
</script>
