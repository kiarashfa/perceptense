    function buildPentaSlider() {
      const slider = document.getElementById('pentaSlider');
      const output = document.getElementById('pentaOutput');
      if (!slider || !output) return;
      function update() {
        const v = parseInt(slider.value);
        const rem = 100 - v;
        output.innerHTML = 'At ' + v + '% pentatonic use: roughly <strong>' + v + '</strong> of every 100 musical cultures worldwide use pentatonic scales as their primary pitch organisation — approximately <strong>' + Math.round(v * 2000) + '</strong> of the estimated 2,000 distinct musical traditions identified by ethnomusicologists. The remaining <strong>' + rem + '%</strong> includes traditions using heptatonic (7-note), chromatic (12-note), microtonal, or other scale systems. The high prevalence of pentatonic scales is striking because the five pitches are derived from simple frequency ratios (the first five notes of the overtone series), suggesting a possible acoustic basis — though cultural transmission also plays a major role.';
      }
      slider.oninput = update;
      update();
    }

