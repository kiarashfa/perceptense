    function buildGenreTimeline() {
      const container = document.getElementById('genreTimeline');
      if (!container) return;
      const minY = 1860, maxY = 2030;
      const range = maxY - minY;
      genres.forEach(g => {
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; align-items:center; gap:8px; margin-bottom:7px;';
        const label = document.createElement('div');
        label.style.cssText = 'font-size:11px; color:var(--color-text-secondary); width:120px; flex-shrink:0; text-align:right;';
        label.textContent = g.label;
        const track = document.createElement('div');
        track.style.cssText = 'flex:1; height:16px; background:var(--color-background-secondary); border-radius:3px; position:relative; min-width:100px;';
        const fill = document.createElement('div');
        const left = ((g.start - minY) / range) * 100;
        const width = ((g.end - g.start) / range) * 100;
        fill.style.cssText = 'position:absolute; top:0; height:100%; border-radius:3px; display:flex; align-items:center; padding:0 5px; background:' + g.bg + '; left:' + left + '%; width:' + width + '%;';
        fill.innerHTML = '<span style="font-size:9px; font-weight:600; color:' + g.col + '; white-space:nowrap; overflow:hidden;">' + g.start + (g.end < 2025 ? '–' + g.end : '–') + '</span>';
        track.appendChild(fill);
        row.appendChild(label);
        row.appendChild(track);
        container.appendChild(row);
      });
    }

