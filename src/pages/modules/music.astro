              + '<div style="font-size:11px; color:var(--color-text-tertiary);">Key figures: ' + d.ex + '</div>';
            detail.classList.add('show');
          }
        };
        grid.appendChild(card);
      });
    }

    /* ════════════════════════════════════
       BPM CALCULATOR (Part E)
    ════════════════════════════════════ */
    function calcBPM() {
      const bpm = parseInt(document.getElementById('bpmInput').value);
      const out = document.getElementById('bpmOutput');
      if (!bpm || bpm < 20 || bpm > 400) { out.textContent = 'Please enter a BPM between 20 and 400.'; return; }
      let genre = '', feel = '', physio = '';
      if (bpm < 50) { genre = 'Funeral march / extreme Largo'; feel = 'Extremely slow — used for solemnity, grief, or meditative states'; physio = 'Well below resting heart rate (~60–80 BPM); creates a feeling of suspension and weight.'; }
      else if (bpm < 70) { genre = 'Largo / Grave'; feel = 'Very slow — sacred music, slow movements of symphonies'; physio = 'Near resting heart rate. Induces physiological calm; used in music therapy to slow the autonomic nervous system.'; }
      else if (bpm < 90) { genre = 'Andante / walking tempo (blues, slow jazz)'; feel = 'Natural walking pace — feels comfortable and unhurried'; physio = 'Matches resting heart rate. The most "natural" musical tempo — music at this speed feels easiest to absorb.'; }
      else if (bpm < 110) { genre = 'Moderato (most pop ballads, slow rock)'; feel = 'Moderate and relaxed'; physio = 'Slightly above resting heart rate. Creates mild engagement without excitement. Most love songs and ballads live here.'; }
      else if (bpm < 130) { genre = 'Allegretto (funk, 4/4 rock, standard pop)'; feel = 'Brisk and energetic'; physio = 'Common pop tempo (120 BPM is the near-universal default). Aligns with human movement in fast walking. Most easily danced to.'; }
      else if (bpm < 160) { genre = 'Allegro (up-tempo jazz, fast pop, early rock)'; feel = 'Fast and driving'; physio = 'Above comfortable walking pace — starts to require physical response. Most dance music operates in this range.'; }
      else if (bpm < 190) { genre = 'Presto (bebop, drum and bass, fast classical)'; feel = 'Very fast — creates excitement and urgency'; physio = 'Approaches maximum comfortable dance speed. Bebop ballads are often played at 200+ BPM — Charlie Parker\'s "Ko-Ko" is ~300 BPM.'; }
      else { genre = 'Prestissimo / extreme tempo (speed metal, jungle/drum & bass)'; feel = 'Extremely fast — pushing physical limits'; physio = 'Beyond comfortable dance speed. At 200+ BPM, individual beats blur into texture. Death metal can reach 260+ BPM on double kick drums.'; }
      out.innerHTML = '<strong>' + bpm + ' BPM</strong> — ' + genre + '<br><br>' + feel + '<br><br>' + physio
        + '<br><br><span style="font-size:11px; color:var(--color-text-tertiary);">Bar duration: ' + (60000/bpm).toFixed(0) + 'ms per beat · ' + (4*60000/bpm).toFixed(0) + 'ms per 4/4 bar</span>';
    }

    /* ════════════════════════════════════
       LISTENING GUIDE MULTI-CARD (Part F)
    ════════════════════════════════════ */
    const listenCards = [
      { icon:'fa-ear-listen', label:'Follow melody', sub:'Layer 1', detail: { title:'Layer 1: Follow the melody', body:'The first layer of active listening. Pick one instrumental voice — usually the highest — and follow it through the entire piece. Notice how it moves: does it step by step (conjunct motion) or jump (disjunct)? Where does it peak? How does it end? A melody\'s shape carries enormous expressive information. In orchestral music, the melody often passes between instruments — tracking it teaches you orchestration at the same time. Exercises: hum along with a recording; try to predict what the next note will be.' } },
      { icon:'fa-layer-group', label:'Hear texture', sub:'Layer 2', detail: { title:'Layer 2: Hear the texture', body:'Once you can follow the melody, try to hear everything else simultaneously — not as individual lines but as a mass. Is the texture thin (one or two voices) or dense (many voices)? Is there one dominant melody with accompaniment (homophony), or several equal voices (polyphony)? In a Bach fugue, try to hear the total web without fixating on one thread. In a Beethoven symphony, notice how the texture thins and thickens as structural events occur. Textural change is one of the composer\'s most powerful tools and is easily missed when listening passively.' } },
      { icon:'fa-home', label:'Hear tonality', sub:'Layer 3', detail: { title:'Layer 3: Hear harmonic tension and release', body:'The most powerful layer in tonal music. "Home" is the tonic (the key the piece is in). Every departure from home creates tension; every return resolves it. You don\'t need to know the key name — you just need to feel whether the music sounds "away" (tense, unresolved) or "home" (settled, resolved). In a Classical sonata, the exposition goes away; the development goes further away; the recapitulation comes home. Beethoven\'s 5th Symphony finale is one long homecoming. Training this sense transforms the experience of tonal music from succession of moments into a single architectural arc.' } },
      { icon:'fa-clock', label:'Hear structure', sub:'Layer 4', detail: { title:'Layer 4: Hear formal structure', body:'The largest scale of listening. Where is the beginning? Where is the middle crisis? Where is the end? In a sonata form first movement: the seam between exposition and development (where the music begins to feel uncertain and unstable) and the seam between development and recapitulation (the "home" return, often the most dramatic moment in the movement). In a blues: the 12-bar cycle, and where the performer makes unexpected moves within it. In jazz improvisation: the chorus structure, and how the soloist builds tension across choruses. Structural listening requires familiarity — it usually emerges after 3–5 hearings of the same piece.' } },
      { icon:'fa-palette', label:'Hear timbre', sub:'Layer 5', detail: { title:'Layer 5: Hear orchestration and timbre', body:'The colour layer: which instruments are playing, in which combination, in which register? A theme played by solo oboe versus the full string section is the same notes — and a completely different compositional statement. Debussy and Ravel were masters of orchestral colour; their scores reward listening specifically for the timbral dimension. In chamber music, track how the composer uses different instrument combinations within the four-player or five-player ensemble. In jazz, listen to how a soloist changes tone quality (harder, softer, brighter, darker) across a long improvisation — this is as expressive as the notes chosen.' } },
      { icon:'fa-infinity', label:'Multiple hearings', sub:'Practice', detail: { title:'The 10-hearing rule', body:'A piece of complex music does not reveal itself on first hearing. The brain is busy during early hearings simply identifying what is happening — the higher-level structural and textural perception only becomes available once the local events are familiar. A useful rule of thumb: plan 10 complete hearings before judging a complex work. On hearing 1–2: just let it wash over you. Hearing 3–5: follow the melody and try to identify returns of familiar material. Hearing 6–8: try each layer of the framework above. Hearing 9–10: listen freely, with everything available simultaneously. Beethoven\'s late quartets, Mahler\'s symphonies, and Coltrane\'s A Love Supreme typically require more than this before full comprehension arrives.' } }
    ];

    function buildListenGrid() {
      const grid = document.getElementById('listenGrid');
      const detail = document.getElementById('listenDetail');
      if (!grid || !detail) return;
      listenCards.forEach((w) => {
        const card = document.createElement('div');
        card.className = 'mcard';
        card.innerHTML = '<div class="mcard-icon"><i class="fa-solid ' + w.icon + '"></i></div><div class="mcard-label">' + w.label + '</div><div class="mcard-sub">' + w.sub + '</div>';
        card.onclick = () => {
          const isActive = card.classList.contains('active');
          document.querySelectorAll('#listenGrid .mcard').forEach(c => c.classList.remove('active'));
          detail.classList.remove('show');
          if (!isActive) {
            card.classList.add('active');
            const d = w.detail;
            detail.innerHTML = '<div style="font-size:14px; font-weight:600; color:var(--color-text-primary); margin-bottom:8px;">' + d.title + '</div>'
              + '<div style="font-size:12px; color:var(--color-text-secondary); line-height:1.6;">' + d.body + '</div>';
            detail.classList.add('show');
          }
        };
        grid.appendChild(card);
      });
    }


