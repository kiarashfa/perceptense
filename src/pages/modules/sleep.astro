<script is:inline>

    (function() {
      // Expose all functions to window object for onclick handlers
      
      /* ─── Part A: Bedtime calculator ─── */
      window.fmtTime = function(totalMins) {
        const h = Math.floor(((totalMins % 1440) + 1440) % 1440 / 60);
        const m = ((totalMins % 1440) + 1440) % 1440 % 60;
        const period = h >= 12 ? 'pm' : 'am';
        const h12 = h === 0 ? 12 : h > 12 ? h - 12 : h;
        return `${h12}:${String(m).padStart(2, '0')} ${period}`;
      };

      window.calcBedtime = function() {
        const wakeVal = document.getElementById('wake-time').value;
        const cycles  = parseInt(document.getElementById('cycles-wanted').value);
        if (!wakeVal) { document.getElementById('bedtime-result').textContent = 'Please enter a wake time.'; return; }
        const [wh, wm] = wakeVal.split(':').map(Number);
        const wakeMins = wh * 60 + wm;
        const fallAsleepBuffer = 14; // avg minutes to fall asleep
        const cycleMins = 90;

        // asleep time = wake - (cycles × 90); get-into-bed = asleep - 14 min buffer
        const asleepMins   = wakeMins - cycles * cycleMins;
        const inBedMins    = asleepMins - fallAsleepBuffer;
        const sleepHrs     = cycles * cycleMins / 60;

        // Nearby options: ±1 cycle
        const asleepMinus1 = asleepMins + cycleMins; // fewer cycles → later bedtime
        const asleepPlus1  = asleepMins - cycleMins; // more cycles  → earlier bedtime
        const hrsMinus1    = sleepHrs - 1.5;
        const hrsPlus1     = sleepHrs + 1.5;

        document.getElementById('bedtime-result').innerHTML = `
          <strong>To wake at ${window.fmtTime(wakeMins)} after ${cycles} cycles (${sleepHrs} hrs of sleep):</strong><br>
          Get into bed by <strong>${window.fmtTime(inBedMins)}</strong> — you should be asleep by around <strong>${window.fmtTime(asleepMins)}</strong>.<br><br>
          <span style="color:#666; font-size:12px;">
            Nearby cycle-aligned options:<br>
            • ${cycles - 1} cycles (${hrsMinus1} hrs) — get into bed by ${window.fmtTime(asleepMinus1 - fallAsleepBuffer)}<br>
            • ${cycles + 1} cycles (${hrsPlus1} hrs) — get into bed by ${window.fmtTime(asleepPlus1 - fallAsleepBuffer)}
          </span>`;
      };

      /* ─── Part D: Hormone timeline ─── */
      const hormoneData = [
        { hour:6,  label:'6am',        cortisol:'high rising',                 melatonin:'fading',                    adenosine:'low (cleared)',           gh:'low',                     desc:'Cortisol awakening response peaks ~30 min after waking. Melatonin nearly zero. Adenosine cleared by sleep. Body primed to be alert.' },
        { hour:7,  label:'7am',        cortisol:'peak',                        melatonin:'very low',                  adenosine:'low',                     gh:'low',                     desc:'Cortisol at daily peak — highest alertness, best reaction times, peak physical performance window beginning. Melatonin fully suppressed by morning light.' },
        { hour:9,  label:'9am',        cortisol:'high',                        melatonin:'zero',                      adenosine:'building slightly',        gh:'low',                     desc:'Peak cognitive window for most chronotypes. Cortisol still elevated; adenosine beginning to build slowly from the moment of waking.' },
        { hour:12, label:'12pm',       cortisol:'moderate declining',          melatonin:'zero',                      adenosine:'moderate',                 gh:'low',                     desc:'The post-lunch dip: a slight drop in alertness is biological, not purely caused by food. Cortisol declining; adenosine continuing to build. A 20-min nap here (before N3) is highly effective.' },
        { hour:14, label:'2pm',        cortisol:'moderate',                    melatonin:'zero',                      adenosine:'moderate-high',            gh:'low',                     desc:'Afternoon alertness trough for many people. Best time for a brief nap if needed — sleep pressure is sufficient and there is enough day remaining to avoid disrupting night sleep.' },
        { hour:17, label:'5pm',        cortisol:'low',                         melatonin:'zero',                      adenosine:'high',                     gh:'very low',                desc:'Late afternoon: another alertness peak for many evening types. Adenosine building strongly. Testosterone also peaks in late afternoon — physical performance window for athletes.' },
        { hour:19, label:'7pm',        cortisol:'low',                         melatonin:'starting to rise',          adenosine:'high',                     gh:'very low',                desc:'Melatonin begins to rise ~2 hours before natural sleep time. Body temperature starting to drop (a key sleep signal). Avoid bright light here to preserve the melatonin signal.' },
        { hour:21, label:'9pm',        cortisol:'very low',                    melatonin:'rising',                    adenosine:'very high',                gh:'low',                     desc:'Melatonin rising strongly. Adenosine very high — sleep drive is intense. Body temperature dropping. Ideal wind-down window. Avoid screens and bright light.' },
        { hour:22, label:'10pm',       cortisol:'very low',                    melatonin:'high',                      adenosine:'very high',                gh:'beginning to rise',       desc:'Natural sleep onset for most adults. Melatonin near peak. Growth hormone begins to rise in preparation for first N3 cycle. Adenosine about to be cleared by sleep.' },
        { hour:23, label:'11pm',       cortisol:'very low',                    melatonin:'peak',                      adenosine:'clearing as sleep begins',  gh:'rising towards first pulse', desc:'First sleep cycle in progress. Melatonin at peak. Growth hormone building towards its largest pulse in the first N3 stage. Brain entering deep slow-wave sleep — physical repair beginning.' },
        { hour:0,  label:'midnight',   cortisol:'minimal',                     melatonin:'peak',                      adenosine:'clearing',                 gh:'peak pulse (first N3)',   desc:'Growth hormone at daily peak — the first N3 cycle triggers the largest GH pulse of the 24-hour period. Tissue repair, muscle growth, and immune strengthening maximally active.' },
        { hour:2,  label:'2am',        cortisol:'very low',                    melatonin:'high',                      adenosine:'low',                     gh:'moderate',                desc:'Mid-sleep. REM cycles growing longer. Emotional memory processing intensive. The darkest, coldest, most deeply asleep period for most people. Body temperature at its lowest.' },
        { hour:4,  label:'4am',        cortisol:'beginning to rise',           melatonin:'declining',                 adenosine:'very low',                gh:'low',                     desc:'Cortisol begins its pre-dawn rise — the body preparing to wake. Melatonin fading as the internal clock anticipates light. Final long REM cycles occurring.' },
      ];

      window.updateHormones = function() {
        const idx = parseInt(document.getElementById('u-flex-1').value);
        const hours = hormoneData.map(d => d.hour);
        const closestIdx = hours.reduce((best, h, i) => {
          const diff  = Math.abs(h  <= 5 ? h  + 24 - idx : h  - idx);
          const bDiff = Math.abs(hours[best] <= 5 ? hours[best] + 24 - idx : hours[best] - idx);
          return diff < bDiff ? i : best;
        }, 0);
        const d = hormoneData[closestIdx];
        const hourStr = idx === 0 ? '12am (midnight)' : idx < 12 ? `${idx}am` : idx === 12 ? '12pm (noon)' : `${idx-12}pm`;
        document.getElementById('time-out').textContent = hourStr;
        document.getElementById('hormone-display').innerHTML = `
          <div class="hormone-grid">
            <div style="background:#fff; border-radius:8px; padding:7px 9px; border:0.5px solid #e0e0e0;">
              <div style="font-size:10px; color:#666;">Cortisol</div>
              <div style="font-size:12px; font-weight:500; color:#1a1a1a;">${d.cortisol}</div>
            </div>
            <div style="background:#fff; border-radius:8px; padding:7px 9px; border:0.5px solid #e0e0e0;">
              <div style="font-size:10px; color:#666;">Melatonin</div>
              <div style="font-size:12px; font-weight:500; color:#1a1a1a;">${d.melatonin}</div>
            </div>
            <div style="background:#fff; border-radius:8px; padding:7px 9px; border:0.5px solid #e0e0e0;">
              <div style="font-size:10px; color:#666;">Adenosine</div>
              <div style="font-size:12px; font-weight:500; color:#1a1a1a;">${d.adenosine}</div>
            </div>
            <div style="background:#fff; border-radius:8px; padding:7px 9px; border:0.5px solid #e0e0e0;">
              <div style="font-size:10px; color:#666;">Growth hormone</div>
              <div style="font-size:12px; font-weight:500; color:#1a1a1a;">${d.gh}</div>
            </div>
          </div>
          <div style="font-size:13px; color:#1a1a1a; line-height:1.6;">${d.desc}</div>`;
      };
      
      const timeSlider = document.getElementById('u-flex-1');
      if (timeSlider) {
        timeSlider.addEventListener('input', window.updateHormones);
        window.updateHormones();
      }

      /* ─── Part D: Caffeine half-life calculator ─── */
      window.calcCaffeine = function() {
        const cafTimeVal = document.getElementById('caf-time').value;
        const bedTimeVal = document.getElementById('bed-time-caf').value;
        const mg = parseInt(document.getElementById('caf-mg').value);
        if (!cafTimeVal || !bedTimeVal) { 
          document.getElementById('caf-result').textContent = 'Please fill in all fields.'; 
          return; 
        }

        const [ch, cm] = cafTimeVal.split(':').map(Number);
        const [bh, bm] = bedTimeVal.split(':').map(Number);
        let cafMins = ch * 60 + cm;
        let bedMins = bh * 60 + bm;
        // If bedtime is before or equal to coffee time, assume next calendar day
        if (bedMins <= cafMins) bedMins += 1440;
        const hoursToSleep = (bedMins - cafMins) / 60;

        const halfLife = 5.5; // hours (population average)
        const remaining = mg * Math.pow(0.5, hoursToSleep / halfLife);
        const pct = Math.round((remaining / mg) * 100);

        const cafFmt  = window.fmtTime(cafMins);
        const bedFmt  = window.fmtTime(bh * 60 + bm); // original, un-shifted

        let judgement, judgeColor;
        if (pct <= 10)      { judgement = 'Good — very little caffeine remains at bedtime. Sleep quality should not be significantly affected.'; judgeColor = '#27500A'; }
        else if (pct <= 20) { judgement = 'Acceptable — some caffeine remains, but at low levels. Light sleepers may notice slightly longer sleep onset.'; judgeColor = '#633806'; }
        else if (pct <= 35) { judgement = 'Caution — a meaningful amount of caffeine is still active, blocking adenosine receptors. N3 and total sleep time will likely be reduced even if you fall asleep normally.'; judgeColor = '#BA7517'; }
        else                { judgement = 'Problematic — over a third of the caffeine is still active at bedtime. Sleep architecture will be measurably disrupted. Consider your last coffee at least 8–10 hours before bed.'; judgeColor = '#791F1F'; }

        document.getElementById('caf-result').innerHTML = `
          Coffee at <strong>${cafFmt}</strong> (${mg} mg) → bedtime at <strong>${bedFmt}</strong> (${hoursToSleep.toFixed(1)} hrs later)<br>
          Caffeine remaining at bedtime: <strong style="color:${judgeColor};">${Math.round(remaining)} mg (${pct}%)</strong><br>
          <span style="color:${judgeColor}; font-size:12px;">${judgement}</span>`;

        // Decay timeline bars — show at +0, +2, +4, +6, +8 hours from coffee time
        const checkpoints = [0, 2, 4, 6, 8];
        let barsHtml = '<div style="margin-top:10px;"><div style="font-size:11px; color:#666; margin-bottom:6px;">Caffeine decay over time after your coffee:</div>';
        checkpoints.forEach(h => {
          const rem    = mg * Math.pow(0.5, h / halfLife);
          const pctRem = (rem / mg) * 100;
          const absMin = cafMins + h * 60;
          const timeStr = window.fmtTime(absMin);
          const barWidth = Math.max(pctRem, 1);
          const col = pctRem > 50 ? '#D85A30' : pctRem > 30 ? '#C8952A' : pctRem > 15 ? '#97c459' : 'var(--accent)';
          const isBedtime = Math.abs(absMin - (bh * 60 + bm + (bh * 60 + bm <= cafMins ? 1440 : 0))) < 70;
          const marker = isBedtime ? ' ← your bedtime' : '';
          barsHtml += `<div class="control-row-compact">
            <span class="caf-label">${timeStr} (+${h}h)${marker}</span>
            <div class="caf-bar-track"><div class="caf-bar-fill" style="width:${barWidth}%; background:${col};"></div></div>
            <span style="font-size:11px; color:#666; min-width:65px; text-align:right;">${Math.round(rem)} mg (${Math.round(pctRem)}%)</span>
          </div>`;
        });
        barsHtml += '</div>';
        document.getElementById('caf-bars').innerHTML = barsHtml;
      };
      
      // Initialize caffeine calculator
      setTimeout(() => window.calcCaffeine(), 10);

      /* ─── Part E: Sleep deprivation explorer ─── */
      const deprivData = {
        mild: { title:'Mild chronic deprivation — 6 hours/night for 2+ weeks',
          col:'#BA7517', bg:'#FAEEDA',
          effects:[
            ['Cognitive impairment','After 10 days on 6 hrs/night, performance is as impaired as someone who has been awake for 24 hours straight — but the person rates themselves as only "slightly sleepy." The dangerous part: you lose the ability to accurately gauge your own impairment.'],
            ['Memory consolidation','Reduced by ~20–40%. Information studied the night before is less well retained. Learning curves flatten.'],
            ['Emotional regulation','Amygdala reactivity increases significantly — small stressors trigger disproportionate emotional responses. Irritability, reduced empathy, and impaired social judgment are measurable.'],
            ['Physical health','Elevated cortisol → increased blood pressure, insulin resistance, weight gain (ghrelin rises, leptin falls = increased hunger). Immune function reduced: natural killer cell activity drops considerably after one week of 6-hour nights.'],
            ['The illusion of adaptation','After 2 weeks on 6 hours, people report "feeling fine" — but objective tests show continued, worsening impairment. Chronic sleep deprivation impairs the ability to perceive the deprivation itself.']
          ]
        },
        '24': { title:'24 hours without sleep',
          col:'#D85A30', bg:'#FAECE7',
          effects:[
            ['Cognitive performance','Equivalent to a blood alcohol content of approximately 0.10% — legally drunk in most jurisdictions. Reaction time, decision-making, and short-term memory all significantly impaired.'],
            ['Microsleeps','The brain begins forcing 1–30 second episodes of sleep (microsleeps) even when you are trying to stay awake. During a microsleep, you process no information — highly dangerous while driving.'],
            ['Hallucinations','Visual and auditory hallucinations may begin around the 18–24 hour mark in some individuals — the brain attempting to generate REM-like states while awake.'],
            ['Physical effects','Elevated inflammatory markers. Immune suppression. Metabolic dysregulation. Elevated cortisol and heart rate.'],
            ['Mood','Significantly elevated anxiety and emotional reactivity. Difficulty with empathy and reading social cues.']
          ]
        },
        '48': { title:'48 hours without sleep',
          col:'#A32D2D', bg:'#FCEBEB',
          effects:[
            ['Cognitive performance','Severely impaired across all domains. Working memory, attention, and processing speed degraded substantially. Problem-solving and creativity essentially non-functional.'],
            ['Immune system','Natural killer cell activity drops dramatically. Interleukin-6 (an inflammation marker) significantly elevated. Risk of infection greatly increased.'],
            ['Perceptual distortions','More severe hallucinations. Reality-testing impaired — the person may not reliably distinguish hallucinations from perception. Paranoid ideation possible.'],
            ['Physiological stress','Cortisol remains elevated. Blood pressure significantly raised. Tremors and impaired coordination reported.'],
            ['Sleep debt','This amount of sleep debt cannot be fully recovered in one night — recovery requires multiple nights of extended sleep, particularly focused on repaying N3 and REM deficits.']
          ]
        },
        '72': { title:'72 hours without sleep',
          col:'#791F1F', bg:'#FCEBEB',
          effects:[
            ['Psychosis-like symptoms','At this level, hallucinations are near-universal; disorganised thinking resembling acute psychosis appears. The person may be unable to maintain a coherent conversation.'],
            ['Motor impairment','Slurred speech, hand tremors, balance problems. Involuntary micro-sleep episodes become impossible to suppress.'],
            ['Cognitive collapse','Essentially no reliable cognitive function. The brain cannot form coherent new memories. Existing memories may become confused.'],
            ['World record context','Randy Gardner (1964) stayed awake for 264 hours (11 days) under medical supervision — the longest documented case. He recovered after extended sleep with no permanent damage. This is an extreme outlier; most people display psychotic symptoms well before 72 hours.'],
            ['Physiological danger','Core body temperature dysregulation. Extreme immune suppression. Fatal familial insomnia (a genetic prion disease) demonstrates that complete, permanent deprivation of sleep is ultimately fatal.']
          ]
        },
        chronic: { title:'Chronic insufficiency — years of suboptimal sleep',
          col:'#3C3489', bg:'#EEEDFE',
          effects:[
            ['Alzheimer\'s risk','Chronic poor sleep is one of the strongest modifiable risk factors for Alzheimer\'s disease. N3 slow-wave sleep is when the glymphatic system clears amyloid-beta protein. Decades of poor N3 → amyloid accumulation → neurodegeneration. The relationship is bidirectional: Alzheimer\'s also disrupts sleep.'],
            ['Cardiovascular disease','Sleeping less than 6 hours per night consistently is associated with significantly increased risk of heart attack and elevated stroke risk in large-scale epidemiological studies.'],
            ['Metabolic consequences','Chronic short sleep dysregulates insulin and glucose — a key pathway to type 2 diabetes. Leptin/ghrelin imbalance drives increased caloric intake (~300 extra calories/day on sleep-deprived days, per research).'],
            ['Cancer risk','Studies show increased cancer risk with chronic sleep disruption, particularly for breast, colon, and prostate cancers. Immune surveillance (natural killer cells detecting abnormal cells) is compromised by sleep loss.'],
            ['Mental health','Insomnia is the single strongest predictor of depression and anxiety disorders. The relationship is bidirectional but sleep disruption often precedes the psychiatric disorder. Treating sleep often substantially improves mental health outcomes.']
          ]
        }
      };

      window.showDepriv = function(key) {
        const d = deprivData[key];
        let html = `<div style="display:inline-block; background:${d.bg}; color:${d.col}; border-radius:99px; font-size:11px; font-weight:500; padding:2px 10px; margin-bottom:10px;">${d.title}</div>`;
        d.effects.forEach(([title, desc]) => {
          html += `<div style="margin-bottom:8px;"><div style="font-size:13px; font-weight:500; color:var(--color-text-primary, #1a1a1a); margin-bottom:2px;">${title}</div><div style="font-size:12px; color:var(--color-text-secondary, #666); line-height:1.6;">${desc}</div></div>`;
        });
        document.getElementById('depriv-display').innerHTML = html;
      };
      
      setTimeout(() => window.showDepriv('mild'), 10);

      /* ─── Part G: Sleep hygiene checklist ─── */
      const hygieneItems = [
        { text:'I get outdoor/bright light within 60 minutes of waking',  sub:'Anchors your circadian clock; strongest signal for melatonin timing later that night.' },
        { text:'My bedroom stays around 18–19°C (65–67°F)',               sub:'Core temperature must drop ~1°C to initiate and maintain sleep; cool rooms accelerate this.' },
        { text:'I avoid screens (or use blue-light blocking) 1–2 hrs before bed', sub:'Blue light suppresses melatonin; your phone screen is biologically similar to sunrise.' },
        { text:'I keep the same wake time every day, including weekends',  sub:'Consistent wake time is more important than bedtime — it sets the circadian clock.' },
        { text:'I avoid caffeine after 1–2pm',                             sub:'Caffeine half-life is ~5.5 hours; a 3pm coffee still has 25% active at midnight.' },
        { text:'I avoid alcohol within 3 hours of sleep',                  sub:'Alcohol suppresses REM; the rebound REM causes fragmented, emotionally vivid sleep.' },
        { text:'I keep my bedroom dark (blackout or eye mask)',             sub:'Even small amounts of light can disrupt melatonin and sleep depth.' },
        { text:'I don\'t lie awake in bed for more than 20 minutes',       sub:'If you can\'t sleep, get up — lying awake breaks the bed-sleep association (stimulus control).' },
        { text:'I avoid large meals within 2 hours of bed',                sub:'Digestion raises core temperature and can delay sleep onset.' },
        { text:'I have a consistent wind-down routine (30–60 min)',        sub:'The transition from alertness to sleepiness is gradual; a routine signals the brain to downshift.' },
      ];

      let hygienChecks = new Array(hygieneItems.length).fill(false);

      window.renderHygiene = function() {
        const hygieneList = document.getElementById('hygiene-list');
        hygieneList.innerHTML = hygieneItems.map((item, i) => `
          <div class="hygiene-item">
            <div class="hygiene-check${hygienChecks[i] ? ' checked' : ''}" onclick="window.toggleHygiene(${i})"></div>
            <div>
              <div class="hygiene-text" style="${hygienChecks[i] ? 'text-decoration:line-through; color:#999;' : ''}">${item.text}</div>
              <div class="hygiene-sub">${item.sub}</div>
            </div>
          </div>`).join('');
        const score = hygienChecks.filter(Boolean).length;
        document.getElementById('hygiene-score').textContent = score;
        document.getElementById('hygiene-score-fill').style.width = (score / hygieneItems.length * 100) + '%';
        const feedback = document.getElementById('hygiene-feedback');
        if (score === 0) { feedback.style.display = 'none'; return; }
        feedback.style.display = 'block';
        if (score >= 9)       feedback.textContent = 'Excellent sleep hygiene. You\'re applying most of the research-backed interventions. Your sleep architecture is likely in good shape.';
        else if (score >= 7)  feedback.textContent = 'Good sleep hygiene. A few more habits could make a meaningful difference — light exposure and temperature are the highest-leverage items if you haven\'t ticked those.';
        else if (score >= 5)  feedback.textContent = 'Moderate sleep hygiene. There\'s real room to improve. Focus on the highest-impact items first: consistent wake time, morning light, and afternoon caffeine cut-off.';
        else if (score >= 3)  feedback.textContent = 'Several improvements possible. Even adding 2–3 of these habits can noticeably improve sleep quality within a week or two.';
        else                  feedback.textContent = 'Most of these evidence-based habits are not in place. Even starting with consistent wake time and morning light exposure would likely produce noticeable improvements.';
      };

      window.toggleHygiene = function(i) { 
        hygienChecks[i] = !hygienChecks[i]; 
        window.renderHygiene(); 
      };
      
      setTimeout(() => window.renderHygiene(), 10);

      /* ─── Part H: Nap guide ─── */
      const napData = {
        power: {
          title: 'Power nap — 10–20 minutes',
          col: '#27500A', bg: '#EAF3DE',
          body: `<strong>The ideal length for most people.</strong> Stays entirely within N1 and N2 — no N3 deep sleep is entered, so there is no sleep inertia on waking. The benefits are real and immediate: improved alertness, reaction time, and mood for 1–3 hours afterward.<br><br>
          <strong>The 20-minute rule:</strong> Set an alarm for 20 minutes from when you lie down (not when you fall asleep). Some people take 5–10 minutes to fall asleep — that's fine; the point is preventing N3 entry, not maximising sleep time. Getting up promptly when the alarm fires is important — hesitation leads to N3.<br><br>
          <strong>Best time:</strong> 1–3pm (aligned with the natural post-lunch biological dip).<br>
          <strong>NASA research:</strong> A 40-minute nap in sleepy military pilots improved performance by 34% and alertness by 100%.`
        },
        full: {
          title: 'Full cycle nap — 90 minutes',
          col: '#0C447C', bg: '#E6F1FB',
          body: `<strong>A complete 90-minute nap traverses all sleep stages including N3 and REM.</strong> This provides the full benefits: physical repair, memory consolidation, and emotional processing. Waking at the end of a full cycle minimises sleep inertia because you surface naturally from the lightest stage.<br><br>
          <strong>When to use it:</strong> Recovery from sleep debt, after all-nighters, before a long night shift, or when partial sleep deprivation is expected (long flight, overnight event). Not ideal for everyday use — it significantly reduces night sleep pressure.<br><br>
          <strong>The risk:</strong> Waking mid-cycle (e.g., at 45–60 minutes) from N3 produces severe grogginess (sleep inertia) that can last 20–30 minutes. If you take a 90-min nap, commit to the full duration.`
        },
        nappuccino: {
          title: 'The nappuccino (caffeine nap)',
          col: '#633806', bg: '#FAEEDA',
          body: `<strong>The most effective nap strategy for alertness, according to research.</strong><br><br>
          <strong>Method:</strong> Drink a cup of coffee (or espresso) immediately before lying down for a 20-minute power nap. Caffeine takes ~20–30 minutes to reach peak blood concentration — you are asleep before it kicks in. When you wake, the caffeine begins working simultaneously with the sleep-derived adenosine clearance, producing a double alertness boost.<br><br>
          <strong>Why it works better than either alone:</strong> A nap clears some accumulated adenosine. Caffeine blocks adenosine receptors. Doing both at the same time is more effective than either individually. Studies have consistently shown it outperforms a nap alone or caffeine alone on performance metrics.<br><br>
          <strong>Best time:</strong> Early afternoon. Avoid after 2–3pm to protect night sleep.`
        },
        avoid: {
          title: 'When not to nap',
          col: '#791F1F', bg: '#FCEBEB',
          body: `<strong>Napping is not always beneficial — context matters.</strong><br><br>
          <strong>If you have insomnia:</strong> Avoid napping entirely. Napping reduces adenosine (sleep pressure), making it harder to fall asleep at night — which is the core treatment target in CBT-I (sleep restriction builds sleep pressure). Napping undermines the therapy.<br><br>
          <strong>After 3pm:</strong> Even a short nap late in the afternoon significantly reduces sleep pressure, causing later sleep onset and lighter night sleep.<br><br>
          <strong>If you wake feeling worse:</strong> You entered N3. Next time, shorten to 15 minutes or try the nappuccino to reduce the chance of deep sleep entry.<br><br>
          <strong>If it's affecting night sleep:</strong> Track it. Some people (particularly those with naturally lower sleep needs) find any daytime napping disrupts their nights. Individual variation is real.`
        }
      };

      window.showNap = function(key) {
        const d = napData[key];
        document.getElementById('nap-display').innerHTML = `
          <div style="display:inline-block; background:${d.bg}; color:${d.col}; border-radius:99px; font-size:11px; font-weight:500; padding:2px 10px; margin-bottom:8px;">${d.title}</div>
          <div style="font-size:13px; color:var(--color-text-primary, #1a1a1a); line-height:1.7;">${d.body}</div>`;
      };
      
      setTimeout(() => window.showNap('power'), 10);
      
    })();
  
</script>
