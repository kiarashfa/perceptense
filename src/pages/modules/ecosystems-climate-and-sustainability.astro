    html += '<div class="bar-row u-mb-sm"><div class="bl" style="width:200px;font-size:11px;">'+d.label+'</div><div class="bb" style="background:'+d.color+'; width:'+d.val+'%; opacity:0.9; min-width:60px;"><span class="bv" style="color:#fff;">'+d.val+'% of species at risk</span></div></div>';
  });
  el.innerHTML = html;
})();

// ── REWILDING EXPLORER ────────────────────────────────────────────────────────
const rewildData = {
  yellowstone: { title:'Yellowstone wolf reintroduction (1995)', body:'14 wolves reintroduced from Canada in 1995, 17 more in 1996. By 2023, ~100 wolves in the Greater Yellowstone Ecosystem. Effects cascaded through the entire food web: elk avoided riparian valleys (landscape of fear), allowing willows and aspens to regenerate, which allowed beaver populations to recover, which altered stream hydrology, stabilised stream banks, and created wetland habitats for songbirds, amphibians, and fish. River erosion decreased as vegetation stabilised banks. This is the textbook example of a trophic cascade driven by apex predator reintroduction.' },
  knepp: { title:'Knepp Estate, West Sussex (2001)', body:'1,400 hectares of intensively farmed Sussex lowland was progressively rewilded starting 2001 by Charlie Burrell and Isabella Tree. Large herbivores (Exmoor ponies, Tamworth pigs, longhorn cattle, fallow and red deer) introduced as proxies for extinct megafauna. Within 15 years: turtle doves (near-extinct in UK) and peregrine falcons returned, nightingale population became the highest in the UK, purple emperor butterflies colonised from tiny remnant populations. The farm now generates more revenue from eco-tourism and wildlife products than intensive agriculture ever did, with zero subsidy.' },
  pleistocene: { title:'Pleistocene Park, Siberia (1996)', body:'Sergey Zimov\'s long-running experiment in Northeast Siberia: reintroduce large herbivores (bison, musk ox, horses, moose) to recreate the "mammoth steppe" ecosystem that dominated the Arctic until ~10,000 years ago. The hypothesis: large grazing animals compact snow in winter, reducing its insulating effect and allowing permafrost to cool more deeply, slowing thaw. Preliminary data support the hypothesis: plots with grazing animals show permafrost temperatures 2–3°C colder than adjacent ungrazed plots. The long-term goal: slow permafrost carbon release by restoring an ecosystem — radical but grounded in paleontological evidence.' },
  marine: { title:'Sea otters and kelp forests', body:'Sea otters eat sea urchins. When otters were hunted to near-extinction in the 18th–19th centuries along the North Pacific coast, urchin populations exploded and grazed kelp forests down to barren rock ("urchin barrens"). Kelp forest reestablishment after otter reintroduction is the cleanest marine trophic cascade documented. Kelp forests are among the most productive ecosystems on Earth: 50x more productive per unit area than open ocean. They support commercially important fish (rockfish, lingcod), sequester carbon, and buffer coastlines. Current conservation efforts: otter reintroduction to Oregon and California coasts, with kelp forest recovery following within a decade.' }
};

function showRewild(key, btn) {
  document.querySelectorAll('[onclick^="showRewild"]').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const d = rewildData[key];
  document.getElementById('rewild-display').innerHTML = '<strong class="text-primary">'+d.title+'</strong><br>'+d.body;
}
showRewild('yellowstone', document.querySelector('[onclick="showRewild(\'yellowstone\',this)"]'));

