// ── SEA LEVEL RISE CALCULATOR ─────────────────────────────────────────────────
function calcSLR() {
  const temp = parseFloat(document.getElementById('slr-temp').value) || 2;
  const years = parseInt(document.getElementById('slr-years').value) || 75;
  const year = 2025 + years;
  // Simplified model: base rate 3.7mm/yr, accelerating with temperature
  const accelFactor = 1 + (temp - 1) * 0.4;
  const baseRate = 0.0037;
  const projRate = baseRate * accelFactor;
  const projTotal = (projRate * years * 100).toFixed(0);
  const threatPeople = Math.round(projTotal * 6);
  let risk = 'moderate';
  if (projTotal > 80) risk = 'high';
  if (projTotal > 120) risk = 'very high';
  document.getElementById('slr-result').innerHTML = 
    'At <strong>'+temp+'°C warming</strong> by year <strong>'+year+'</strong>:<br>' +
    'Projected sea level rise: <strong>'+projTotal+' cm ('+Math.round(projTotal/100 * 10)/10+' m)</strong><br>' +
    'Approximate additional people exposed to annual flooding: <strong>~'+threatPeople.toLocaleString()+'</strong><br>' +
    'Risk level: <strong style="color:'+(risk==='very high'?'#791F1F':risk==='high'?'#993C1D':'#ef9f27')+'">'+risk.charAt(0).toUpperCase()+risk.slice(1)+'</strong><br>' +
    '<span class="muted-text-small">Model: simplified from IPCC AR6 likely range. Does not account for potential ice sheet instability above 2°C which could add 0.5–1.5m additional rise.</span>';
}
calcSLR();

