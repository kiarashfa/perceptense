// ── BEEF SLIDER ───────────────────────────────────────────────────────────────
function updateBeefSlider(v) {
  v = parseInt(v);
  const kgPerServing = 0.2;
  const co2PerKg = 25; // kgCO2e per kg beef (farm gate)
  const annualKg = v * 52 * kgPerServing;
  const annualCo2 = (annualKg * co2PerKg / 1000).toFixed(1);
  const equiv = v === 0 ? 'This is a plant-rich diet. Annual beef footprint: essentially zero from this source. Average global dietary footprint is ~1.5 tCO2e/yr from all food combined.' :
    v <= 3 ? 'Occasional beef (weekends only). Annual footprint from beef alone: ~'+annualCo2+' tCO2e — comparable to driving a petrol car ~'+Math.round(annualCo2/0.21*1000)+' km.' :
    v <= 7 ? 'Average European consumption level. Annual beef footprint: ~'+annualCo2+' tCO2e — equivalent to ~'+Math.round(annualCo2*4)+' return flights London-Paris.' :
    'High consumption. Annual beef footprint: ~'+annualCo2+' tCO2e — equivalent to ~'+Math.round(annualCo2*200)+' kg of tofu in emissions terms. Switching to chicken or pork from all this beef would save ~60–80% of the footprint.';
  document.getElementById('beef-output').innerHTML = '<div class="slider-output">'+v+'x/week · '+annualCo2+' tCO₂e/yr</div><div class="slider-sub">'+equiv+'</div>';
}
updateBeefSlider(4);

// ── PROTEIN EXPLORER ──────────────────────────────────────────────────────────
const proteinData = {
  plantbased: { title:'Plant-based meat (Impossible, Beyond, etc.)', body:'Uses textured plant protein (pea, soy, wheat) to mimic meat texture and flavour. Land use: ~85–95% less than beef. GHG emissions: 90% less. Water: 80–90% less. Taste has improved dramatically since 2016 (Impossible Burger redesign). Market growth: $6 billion in 2022; projected $35 billion by 2031. The challenge: price premium over conventional meat remains 50–150%, limiting mainstream adoption. Ultra-processed food health concerns are legitimate (high sodium, additives) but minor compared to the environmental differential. Current market share: ~1% of meat market but growing in food service (restaurants, canteens).' },
  cultured: { title:'Cultured (lab-grown) meat', body:'Real animal muscle cells grown in bioreactors without slaughter. Singapore approved the first cultured chicken product for sale in 2020; the US approved in 2023. Current challenge: cost. In 2013, the first lab burger cost €250,000. By 2023, production cost had fallen to ~$5–10/kg for chicken at pilot scale. Commercial viability requires reaching ~$1–2/kg — still 5–10 years away at current trajectories. Energy use: uncertain — early life-cycle analyses suggest cultured meat may use more energy than chicken or pork (though much less than beef). Scalability of growth media (scaffolding, serum) is the primary technical bottleneck.' },
  insects: { title:'Insects', body:'Crickets, mealworms, and black soldier fly larvae convert organic waste to protein at 10–20x the feed efficiency of beef. 2 kg of feed produces 1 kg of cricket protein vs 8+ kg for 1 kg of beef. GHG emissions: ~1% of beef. Water use: ~1% of beef. Already consumed by ~2 billion people globally, primarily in Southeast Asia and Latin America. EU approved insect consumption in 2021. The cultural barrier in Western markets is real but is primarily a disgust response that can shift with normalisation. Most likely first entry: insect protein as an ingredient in processed foods rather than whole insects.' },
  fermentation: { title:'Precision fermentation', body:'Using microorganisms (yeast, bacteria, fungi) programmed via genetic modification to produce specific proteins, fats, or other food molecules. Examples: Perfect Day (whey protein produced by yeast — used in dairy-free ice cream); Motif FoodWorks (hemoglobin for meatier flavour); Nature\'s Fynd (mycoprotein from Yellowstone bacterium). The key advantage over cultured meat: fermentation is a highly mature industrial process (beer, insulin, industrial enzymes all use it); scaling is well understood. Precision fermentation could produce all animal proteins — dairy, egg white, collagen — at a fraction of the land, water, and emissions of conventional animal agriculture.' }
};

function showProtein(key, btn) {
  document.querySelectorAll('[onclick^="showProtein"]').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const d = proteinData[key];
  document.getElementById('protein-display').innerHTML = '<strong class="text-primary">'+d.title+'</strong><br>'+d.body;
}
showProtein('plantbased', document.querySelector('[onclick="showProtein(\'plantbased\',this)"]'));

// ── OCEAN THREATS EXPLORER ────────────────────────────────────────────────────
const oceanData = {
  acid: { title:'Ocean acidification', body:'Oceans absorb ~26% of annual CO2 emissions. CO2 dissolved in water forms carbonic acid, lowering pH. Ocean pH has dropped from 8.2 to 8.1 since the industrial revolution — a 26% increase in acidity (pH is logarithmic). This disrupts calcification: oysters, mussels, sea urchins, and pteropod molluscs (a key food source for salmon and whales) struggle to build shells in more acidic water. Coral reefs dissolve faster than they can build at pH below ~8.1. The Southern Ocean is already too corrosive for pteropods in winter months. Under high emissions, oceanic pH could drop to 7.8 by 2100 — conditions not seen since the Palaeocene–Eocene Thermal Maximum 56 million years ago, which caused major marine extinctions.' },
  plastic: { title:'Plastic pollution', body:'~11 million tonnes of plastic enter the ocean annually. Total plastic in the ocean: estimated 150–200 million tonnes. The "Great Pacific Garbage Patch" is not a solid island but a diffuse concentration zone; most plastic is in micro-fragments too small to see. Microplastics have been found in Mariana Trench sediments, Arctic sea ice, human placentas, blood, and rainwater. Physical entanglement and ingestion kill ~1 million seabirds and 100,000 marine mammals annually. The subtler crisis: microplastics absorb and concentrate persistent organic pollutants (PCBs, DDT) and transfer them up food chains. Single-use plastic legislation has expanded rapidly since China\'s 2018 ban; plastic production is still increasing globally, projected to quadruple by 2050.' },
  fishing: { title:'Overfishing', body:'~34% of global fish stocks are fished at biologically unsustainable levels (FAO 2022), up from 10% in 1974. Fish provide protein to ~3 billion people. Atlantic cod (Grand Banks) collapsed in 1992 after decades of overfishing — the stock has never recovered to commercial levels despite a moratorium. Bycatch: non-target species (turtles, sharks, dolphins, seabirds) caught inadvertently. Global bycatch: ~40% of all marine catch, ~38 million tonnes/year. Illegal, Unreported, and Unregulated (IUU) fishing adds 26–40% to official catch figures. Aquaculture now provides ~50% of fish for human consumption but creates its own problems: disease, escapement of non-native species, and high feed requirements for carnivorous species like salmon.' },
  warming: { title:'Ocean warming and deoxygenation', body:'The ocean has absorbed ~90% of the extra heat from global warming since 1970. This has warmed the upper 2,000m by ~0.5°C on average; surface waters by more. Consequences: thermal stratification (warm water sits on top, reducing mixing of nutrients to surface), coral bleaching, expansion of oxygen-minimum zones, disruption of species distributions. Oxygen-minimum zones (OMZs) — where marine life cannot survive — have expanded by ~2 million km² since 1960, a 30% increase. Warm-water species are moving poleward at ~60 km per decade; cold-water fisheries (cod, herring) are shifting northward. The combination of warming, deoxygenation, and acidification is creating what some researchers call a "deadly trio" for marine ecosystems.' },
  deepsea: { title:'Deep sea mining', body:'The deep sea floor contains vast deposits of polymetallic nodules (containing manganese, nickel, cobalt, copper) and seafloor massive sulphides (copper, zinc, gold). These contain metals critical for battery technology. The International Seabed Authority (ISA), a UN body, manages exploration permits and is developing a commercial mining code. Problem: the deep sea is the least understood ecosystem on Earth. Nodule fields take millions of years to form; sediment plumes from mining could spread hundreds of kilometres; species found nowhere else face extinction. A 2023 study found that the nodule fields themselves host far more species than expected, many found only in specific fields. Major technology companies (Google, BMW, Volvo) have pledged not to use deep-sea mined minerals until more is known about ecological impacts.' }
};

function showOcean(key, btn) {
  document.querySelectorAll('[onclick^="showOcean"]').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const d = oceanData[key];
  document.getElementById('ocean-display').innerHTML = '<strong class="text-primary">'+d.title+'</strong><br>'+d.body;
}
showOcean('acid', document.querySelector('[onclick="showOcean(\'acid\',this)"]'));

