// ── ANTHROPOCENE TIMELINE ─────────────────────────────────────────────────────
(function buildAnthropocene() {
  const el = document.getElementById('anthropocene-timeline');
  if (!el) return;
  const track = document.createElement('div');
  track.className = 'tl-track';
  const min = 1750, max = 2025, range = max - min;
  const bars = [
    { label:'Industrial Rev.', start:1750, end:1850, color:'#633806' },
    { label:'Fossil age begins', start:1850, end:1950, color:'#993C1D' },
    { label:'Great Acceleration', start:1950, end:1980, color:'#791F1F' },
    { label:'Full planetary crisis', start:1980, end:2025, color:'#791F1F' }
  ];
  bars.forEach(b => {
    const bar = document.createElement('div');
    bar.className = 'tl-bar';
    bar.style.left = ((b.start-min)/range*100)+'%';
    bar.style.width = ((b.end-b.start)/range*100)+'%';
    bar.style.background = b.color;
    bar.style.color = '#fff';
    bar.textContent = b.label;
    track.appendChild(bar);
  });
  [1750, 1850, 1950, 1980, 2025].forEach(yr => {
    const tick = document.createElement('div');
    tick.className = 'tl-tick';
    tick.style.left = ((yr-min)/range*100)+'%';
    tick.textContent = yr;
    track.appendChild(tick);
  });
  el.appendChild(track);
})();

// ── Q&A TOGGLE ────────────────────────────────────────────────────────────────
function toggleQA(btn) {
  const ans = btn.nextElementSibling;
  const showing = ans.classList.contains('show');
  ans.classList.toggle('show', !showing);
  btn.textContent = showing ? 'show answer' : 'hide';
}
