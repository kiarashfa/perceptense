// ── CARBON BUDGET SLIDER ──────────────────────────────────────────────────────
function updateBudgetSlider(v) {
  v = parseFloat(v);
  const startBudget = 380;
  const startEmissions = 40;
  let remaining = startBudget;
  let year = 2023;
  let emissions = startEmissions;
  let yearsToZero = 0;
  let html = '';
  if (v === 0) {
    const yearsLeft = Math.round(startBudget / startEmissions);
    html = '<strong class="text-primary">No emission cuts (0% per year)</strong><br>At '+startEmissions+' GtCO2/yr with no reductions, the 1.5°C carbon budget is exhausted in <strong>~'+yearsLeft+' years (around '+(2023+yearsLeft)+')</strong>. Warming will exceed 1.5°C around the early 2030s.';
  } else {
    for (let i = 0; i < 100; i++) {
      const annualEmissions = emissions;
      remaining -= annualEmissions;
      year++;
      emissions = emissions * (1 - v/100);
      if (remaining <= 0 || emissions < 0.5) { yearsToZero = i + 1; break; }
    }
    if (remaining > 0) {
      html = '<strong class="text-primary">'+v+'% annual emission cuts</strong><br>The 1.5°C carbon budget survives through approximately <strong>'+(2023+yearsToZero)+' ('+yearsToZero+' years from 2023)</strong>. Emissions reach near-zero around the same time — this reduction rate is consistent with the Paris 1.5°C pathway.';
    } else {
      html = '<strong class="text-primary">'+v+'% annual emission cuts</strong><br>Budget exhausted in approximately <strong>'+(2023+yearsToZero)+' years</strong>. At this rate, emissions are still significant when the budget runs out. Faster cuts needed.';
    }
  }
  document.getElementById('budget-output').innerHTML = html;
}
updateBudgetSlider(3);

