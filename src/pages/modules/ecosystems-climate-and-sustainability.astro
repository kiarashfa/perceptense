// ── DEGROWTH / GREEN GROWTH EXPLORER ─────────────────────────────────────────
const growthData = {
  greengrowth: { title:'Green growth', body:'The mainstream position in climate economics: economic growth and decarbonisation are compatible through technological substitution and efficiency improvements. Evidence cited: US and EU have decoupled CO2 from GDP growth since ~2005. Solar and wind are now cheaper than fossil fuels without subsidy. EV sales growing 50%+ per year. GDP can grow while emissions fall if the energy system is clean. Limitation: relative decoupling (emissions per unit GDP falling) is not the same as absolute decoupling (total emissions falling fast enough). Material throughput, not just energy, may also hit physical limits. Proponents: IEA, World Bank, most governments, Nicholas Stern, Mariana Mazzucato.' },
  degrowth: { title:'Degrowth', body:'GDP growth in wealthy nations is incompatible with staying within planetary boundaries. The efficiency gains from technology are outweighed by the Jevons Paradox (more efficient cars lead to more driving, not less fuel use). Rich countries should deliberately shrink their economies while improving wellbeing through redistribution, reduced working hours, and public services. Evidence cited: no nation has achieved absolute decoupling of resource use from growth over extended periods. Rich nations\' consumption-based footprints continue growing even when production-based emissions fall. Critics: degrowth in rich nations would devastate poorer nations dependent on export markets; voluntary economic shrinkage is politically impossible; innovation requires economic dynamism.' },
  postg: { title:'Post-growth / Doughnut Economics', body:'Kate Raworth\'s Doughnut Economics (2017) argues the goal should be a "safe and just space" between a social foundation (everyone\'s needs met) and an ecological ceiling (staying within planetary boundaries). Neither requires growth nor demands degrowth explicitly — it replaces GDP as the primary metric. Amsterdam adopted the Doughnut as its official planning framework in 2020. Post-growth research (Tim Jackson\'s "Prosperity Without Growth") argues that wellbeing (health, life satisfaction, social connection) plateaus far below current GDP levels in rich nations, making GDP growth in wealthy countries a poor proxy for human welfare. The framework avoids the ideological battle between growth and degrowth by reframing the question.' }
};

function showGrowth(key, btn) {
  document.querySelectorAll('[onclick^="showGrowth"]').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const d = growthData[key];
  document.getElementById('growth-display').innerHTML = '<strong class="text-primary">'+d.title+'</strong><br>'+d.body;
}
