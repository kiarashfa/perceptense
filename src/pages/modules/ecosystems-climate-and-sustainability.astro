(function buildExtinction() {
  const el = document.getElementById('extinction-chart');
  const data = [
    { label:'Background (fossil record)', val:1, color:'#1D9E75', note:'~1 per million species-years' },
    { label:'1900–1950 estimate', val:14, color:'#ef9f27', note:'~14x background' },
    { label:'1970–2000 estimate', val:100, color:'#993C1D', note:'~100x background' },
    { label:'Current central estimate', val:500, color:'#791F1F', note:'~500x background (range: 100–1000x)' }
  ];
  const maxVal = 500;
  let html = '';
