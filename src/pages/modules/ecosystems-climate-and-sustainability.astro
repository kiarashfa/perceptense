<script is:inline>

// ── ECOLOGICAL ORGANISATION EXPLORER ──────────────────────────────────────────
const ecoData = {
  individual: { title:'Individual organism', body:'The base unit. An individual organism responds to its immediate environment, competes for resources, reproduces, and dies. Ecology at this level asks: what are this organism\'s tolerances, behaviours, and resource requirements? A single Arctic tern has a home range of tens of thousands of kilometres during annual migration. An individual mycorrhizal fungus may be physically connected to hundreds of trees simultaneously through hyphal networks.' },
  population: { title:'Population', body:'All individuals of one species in a defined area. Populations have emergent properties individuals don\'t: birth rate, death rate, age structure, growth trajectory, carrying capacity. The whooping crane population of North America dropped to 21 individuals in 1941 — below the minimum viable population threshold (typically ~500 for long-term survival). Intensive conservation has brought it back to ~800, illustrating how population-level analysis drives conservation planning.' },
  community: { title:'Community', body:'All populations of different species in an area and their interactions. Community ecology asks: which species are here, why are they here together, and what are the consequences of adding or removing a species? Removing a keystone species (like sea otters) can cascade through an entire community. Communities are not static assemblages — they shift with disturbance, succession, and species invasions.' },
  ecosystem: { title:'Ecosystem', body:'The community plus all the abiotic (non-living) factors: soil, water, atmosphere, temperature, nutrients. Ecosystems are defined by energy flow and nutrient cycling. A lake ecosystem includes the water, sediment, dissolved nutrients, bacteria, algae, invertebrates, fish, and birds — and the fluxes of energy and matter between them. The unit of analysis for productivity, decomposition, and nutrient cycling.' },
  biome: { title:'Biome', body:'A large-scale ecosystem type with characteristic climate, vegetation structure, and animal communities — but not necessarily the same species on different continents. The tropical rainforest biome appears in Amazonia, the Congo, and Southeast Asia with entirely different species but structurally similar stratified canopies, nutrient cycling patterns, and biodiversity density. Climate primarily determines which biome type exists in a given region.' },
  biosphere: { title:'Biosphere', body:'The sum of all ecosystems on Earth — the thin shell of life from the deepest ocean trenches (11 km down) to the upper atmosphere where bacteria have been found at 10 km altitude. The biosphere actively regulates Earth\'s atmosphere and climate: the oxygen you\'re breathing was produced almost entirely by photosynthesis over 2.5 billion years. James Lovelock\'s Gaia hypothesis argued the biosphere functions as a self-regulating system; modern Earth system science accepts the regulatory mechanisms while rejecting the teleological framing.' }
};

function showEco(key, btn) {
  document.querySelectorAll('.eco-tab').forEach(b => {
    if (b.getAttribute('onclick') && b.getAttribute('onclick').includes('showEco')) b.classList.remove('active');
  });
  btn.classList.add('active');
  const d = ecoData[key];
