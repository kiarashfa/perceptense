showEco('individual', document.querySelector('[onclick="showEco(\'individual\',this)"]'));

// ── SPECIES INTERACTIONS ───────────────────────────────────────────────────────
const interactData = {
  mutualism: { body:'Both species benefit. The most important mutualism on Earth: mycorrhizal fungi and plant roots. ~90% of plant species depend on mycorrhizal networks; the fungi receive sugar from photosynthesis, while dramatically extending the plant\'s effective root area and phosphorus uptake. Pollinators and flowering plants are another mutualism that underpins ~35% of global food production. Mutualisms are common, often obligate (neither can survive without the other), and are especially prevalent in nutrient-poor environments.' },
  commensalism: { body:'One species benefits; the other is unaffected. Barnacles attaching to whale skin gain mobility and access to food-rich water; the whale is unharmed. Orchids growing on tropical tree branches (as epiphytes) gain access to light without parasitising the tree. True commensalism is rare — on closer examination, most apparent commensal relationships turn out to involve slight costs or benefits to the "neutral" partner. Cattle egrets following herds to catch disturbed insects were once thought commensal; the cattle lose some insects they could have eaten.' },
  parasitism: { body:'One species benefits at the expense of another. Parasites are the most species-rich ecological guild on Earth — likely 40–50% of all species are parasites of some kind. They are also the most ecologically important population regulators. The bacterium Yersinia pestis (bubonic plague) killed ~30–60% of Europe\'s population in the 14th century. Parasites drive coevolution (host-parasite arms races), maintain genetic diversity in host populations (Red Queen hypothesis), and can act as keystone species controlling host abundance.' },
  predation: { body:'One species kills and consumes another. Predation differs from parasitism in the immediacy of harm and typically in scale — predators are usually larger than prey. Predation creates trophic cascades: when wolves were reintroduced to Yellowstone (1995), elk behaviour changed (avoiding riparian zones), allowing willows and aspens to regenerate, beavers to return, and stream hydrology to shift. This "landscape of fear" effect means predators shape ecosystems through behaviour modification as much as direct killing.' },
  competition: { body:'Both species are harmed. Interspecific competition for the same limited resource. Gause\'s competitive exclusion principle: two species cannot occupy exactly the same ecological niche indefinitely — one will outcompete and exclude the other. In practice, species partition resources (character displacement), enabling coexistence. Darwin\'s finches on the Galapagos show bill size divergence driven by competition for different seed sizes on the same island. Competition shapes community composition and drives ecological specialisation.' },
  amensalism: { body:'One species is harmed; the other is unaffected. Black walnut trees (Juglans nigra) produce juglone, a chemical that inhibits growth of nearby plants. This allelopathy clears competition without the walnut gaining any direct benefit (it would grow the same without the toxic secretion). Trampling by large mammals damages smaller organisms underfoot; the mammals are indifferent. Amensalism is less studied than other interaction types but may be more common than ecologists once thought, particularly in microbiomes.' }
};

function showInteract(key, btn) {
  document.querySelectorAll('.interact-card').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('interact-display').innerHTML = interactData[key].body;
}
showInteract('mutualism', document.querySelector('[onclick="showInteract(\'mutualism\',this)"]'));

// ── CARRYING CAPACITY SLIDER ───────────────────────────────────────────────────
function updateKSlider(v) {
  v = parseInt(v);
  let status, color, growth, detail;
  if (v < 25) { status='Far below K'; color='#1D9E75'; growth='Rapid exponential growth. Resources abundant. Birth rate >> death rate. Population doubling time: weeks to months for fast-reproducing species.'; detail='This is the "J-curve" phase of logistic growth. In nature: colonisation of a new habitat, population recovery after disturbance, plague species at the start of an outbreak.'; }
  else if (v < 75) { status='Approaching K — healthy zone'; color='#185FA5'; growth='Growth rate is positive but decelerating. Resources becoming limiting. Competition intensifying. Most wild populations spend most of their time in this zone.'; detail='The inflection point of the logistic curve is at K/2 — maximum growth rate per unit time occurs at half the carrying capacity. This is why fisheries management aims to maintain fish stocks at ~K/2 (Maximum Sustainable Yield).'; }
  else if (v < 100) { status='Near K — resource-limited'; color='#ef9f27'; growth='Growth nearly zero. High density stress: disease spreads more easily, food per individual drops, territorial conflict increases. Birth rate ≈ death rate.'; detail='Many regulated populations oscillate around K with cycles of overshoot and decline. Predator-prey cycles (Lotka-Volterra model) emerge from this dynamic. Human populations in pre-industrial Europe were largely K-limited by food, disease, and land.'; }
  else { status='Overshoot — above K'; color='#791F1F'; growth='Population exceeds carrying capacity. Resources being depleted faster than they regenerate. Death rate rising. Crash incoming unless carrying capacity increases or population declines rapidly.'; detail='Classic example: St Matthew Island reindeer (Alaska). 29 reindeer introduced in 1944. By 1963: 6,000. By 1966: 42 survivors after population crash, with lichen pastures permanently degraded. Relevance to human systems: aquifer depletion, soil exhaustion, and fisheries collapse all represent carrying capacity overshoot.'; }
  document.getElementById('k-output').innerHTML = '<div class="slider-output" style="color:'+color+'">'+v+'% of K</div><div class="slider-sub" style="margin-bottom:6px;">Status: '+status+'</div><div class="muted-copy">'+growth+'</div><div class="muted-copy u-mt-sm">'+detail+'</div>';
}
updateKSlider(50);

// ── BIOGEOCHEMICAL CYCLES ─────────────────────────────────────────────────────
const cycleData = {
  carbon: { title:'Carbon cycle', body:'Carbon cycles between atmosphere (~870 GtC), oceans (~38,000 GtC), land biosphere (~2,600 GtC), and geological stores (~10,000+ GtC in fossil fuels). Natural fluxes are roughly balanced. Human disruption: burning ~10 GtC/year of fossil fuels, plus ~1.5 GtC/year from deforestation. Natural sinks absorb ~5–6 GtC/year; the remaining 5+ GtC/year accumulates in the atmosphere. Atmospheric CO2 is now 422 ppm — higher than at any point in the last 3 million years. A critical asymmetry: CO2 emitted today will remain in the atmosphere for centuries to millennia. There is no rapid natural "undo" mechanism.' },
  nitrogen: { title:'Nitrogen cycle', body:'Nitrogen is essential for amino acids (protein) and nucleic acids (DNA). Atmospheric N2 (78% of air) is unavailable to most organisms; it must be "fixed" by specialised bacteria (Rhizobium in legume root nodules, Azotobacter in soil) or by lightning. The Haber-Bosch process (1913) — industrial nitrogen fixation — enabled the "Green Revolution" and feeds roughly 4 billion people alive today. The problem: anthropogenic nitrogen fixation now exceeds all natural terrestrial fixation combined. Excess nitrogen causes eutrophication of water bodies, creates oxygen-depleted dead zones (Gulf of Mexico dead zone: ~22,000 km²), emits N2O (nitrous oxide — 298x CO2 warming potential over 100 years), and acidifies soils.' },
  phosphorus: { title:'Phosphorus cycle', body:'Uniquely, phosphorus has no atmospheric form — all cycling is through rock, soil, water, and organisms. It is the primary limiting nutrient in most aquatic ecosystems and many soils. Unlike carbon and nitrogen, there is no way to "fix" phosphorus from an infinite reservoir. Global phosphate rock reserves (mostly in Morocco) could be depleted within 50–200 years at current extraction rates. This would be a civilisation-level crisis: no phosphorus, no fertiliser, no food at current population levels. We flush phosphorus to the sea in wastewater at massive rates; recovery from sewage and struvite precipitation are promising but underdeployed.' },
  water: { title:'Water cycle (hydrological cycle)', body:'1.386 billion km³ of water on Earth; only 2.5% is fresh; of that, 70% is locked in glaciers. Solar energy drives evaporation (~500,000 km³/year), which falls as precipitation (~119,000 km³/year on land). Groundwater recharge is agonisingly slow: major aquifers like the Ogallala (US High Plains) took 10,000–20,000 years to fill and are being depleted in decades. Climate change intensifies the water cycle — "wet regions get wetter, dry regions drier" — increasing flood and drought frequency simultaneously. Virtual water trade (water embedded in traded commodities) transfers vast quantities invisibly: a kg of beef embeds ~15,000 litres; the Middle East imports its water primarily through food imports.' },
  oxygen: { title:'Oxygen cycle', body:'Almost all of Earth\'s atmospheric oxygen (21%) was produced by photosynthesis, primarily by ancient cyanobacteria over 2.5 billion years (the Great Oxygenation Event ~2.4 Gya). Today, oxygen is maintained by the balance between photosynthesis (producing O2) and respiration/decomposition (consuming it). The ocean produces roughly half of global O2, predominantly by phytoplankton. A common misconception: "Amazon as the lungs of the Earth" is misleading — a mature tropical forest\'s respiration roughly balances its photosynthesis, so net O2 production is near zero. Deforestation matters for carbon, not oxygen. Stratospheric ozone (O3) absorbs UV radiation; the Montreal Protocol (1987) has largely reversed ozone hole damage — a rare international environmental success.' }
};

function showCycle(key, btn) {
