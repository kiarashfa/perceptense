        </svg>

        <!-- Comparison table -->
        <div class="chrom-table-wrap">
          <div class="chrom-comparison">
            <div class="chrom-cell chrom-head"></div>
            <div class="chrom-cell chrom-x-head">X</div>
            <div class="chrom-cell chrom-y-head">Y</div>
            <div class="chrom-cell chrom-label">Size</div>
            <div class="chrom-cell chrom-value">~155 Mbp</div>
