            <text x="25" y="178" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" fill="var(--color-text-secondary)">~155 Mbp</text>
            <text x="25" y="189" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" fill="var(--color-text-secondary)">~800–900 genes</text>
          </g>
          <!-- Y chromosome (smaller) -->
          <g transform="translate(120,42)">
            <rect x="16" y="0"  width="14" height="38" rx="7" fill="#97C459" opacity="0.85"/>
            <rect x="16" y="46" width="14" height="20" rx="7" fill="#97C459" opacity="0.85"/>
