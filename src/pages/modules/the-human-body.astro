    // Re-run when theme changes (shared.js fires this by mutating data-theme attr)
    var observer = new MutationObserver(setTlColors);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', setTlColors);
  })();

  /* ─── Heart Rate Zone Explorer ─── */
  var hrZoneData = [
    { name: 'Zone 1: Rest / Recovery', pct: [0.50, 0.60], barClass: 'hr-zone-recovery', label: '50–60%' },
    { name: 'Zone 2: Aerobic base',    pct: [0.60, 0.70], barClass: 'hr-zone-base', label: '60–70%' },
    { name: 'Zone 3: Aerobic',         pct: [0.70, 0.80], barClass: 'hr-zone-aerobic', label: '70–80%' },
    { name: 'Zone 4: Threshold',       pct: [0.80, 0.90], barClass: 'hr-zone-threshold', label: '80–90%' },
    { name: 'Zone 5: Max effort',      pct: [0.90, 1.00], barClass: 'hr-zone-max', label: '90–100%' }
  ];

  function renderHrZones() {
    var age = parseInt(document.getElementById('hrAge').value, 10);
    var maxHr = 220 - age;
    document.getElementById('hrAgeVal').textContent = age;
    document.getElementById('hrMax').textContent = maxHr;
    var container = document.getElementById('hrZoneRows');
    container.innerHTML = '';
    hrZoneData.forEach(function(z) {
      var lo = Math.round(z.pct[0] * maxHr);
      var hi = Math.round(z.pct[1] * maxHr);
      var row = document.createElement('div');
      row.className = 'hr-zone-row';
      row.innerHTML =
        '<span class="hr-zone-lbl">' + z.label + '</span>' +
        '<div class="hr-zone-bar hr-zone-scaled ' + z.barClass + '">' +
        '<span class="bv hr-zone-light-text">' + lo + '–' + hi + ' bpm: ' + z.name + '</span>' +
        '</div>';
      container.appendChild(row);
    });
  }
  document.getElementById('hrAge').addEventListener('input', renderHrZones);
  renderHrZones();

  /* ─── Bone Region Explorer ─── */
  var boneRegions = {
    skull:  { count: '28', detail: 'The skull consists of 8 cranial bones (forming the braincase) and 14 facial bones, plus 6 ossicles (3 tiny bones in each ear that transmit sound vibrations: the malleus, incus, and stapes). The stapes is the smallest bone in the body at about 3 mm.', note: 'Cranium: 8 · Facial: 14 · Ear ossicles: 6' },
    spine:  { count: '26', detail: 'The adult spine has 26 bones: 7 cervical (neck), 12 thoracic (mid-back), 5 lumbar (lower back), 1 sacrum (5 fused), and 1 coccyx (3–5 fused). Intervertebral discs sit between each vertebra but are cartilage, not bone.', note: 'Cervical: 7 · Thoracic: 12 · Lumbar: 5 · Sacrum: 1 · Coccyx: 1' },
    thorax: { count: '25', detail: 'The thorax (chest) has 24 ribs in 12 pairs, plus the sternum (breastbone). Ribs 1–7 are "true ribs" connecting directly to the sternum. Ribs 8–10 are "false ribs" connecting via cartilage. Ribs 11–12 are "floating ribs" with no anterior attachment.', note: 'Ribs: 24 (12 pairs) · Sternum: 1' },
    arms:   { count: '64', detail: 'Each arm has 32 bones: 1 clavicle (collarbone) + 1 scapula (shoulder blade) + 1 humerus (upper arm) + 1 radius + 1 ulna (forearm) + 8 carpal (wrist) + 5 metacarpal (palm) + 14 phalanges (fingers, 3 per finger, 2 for thumb). The hands alone account for 54 of these 64.', note: 'Per arm: 32 · Total both arms: 64' },
    pelvis: { count: '62', detail: 'Each leg has 31 bones: 1 hip bone (ilium/ischium/pubis: 3 fused) + 1 femur (thigh) + 1 patella (kneecap) + 1 tibia + 1 fibula (lower leg) + 7 tarsal (ankle/heel) + 5 metatarsal + 14 phalanges (toes). The femur is the longest, strongest bone in the body.', note: 'Per leg: 31 · Both legs: 62 · Note: pelvis bones counted with legs' },
    feet:   { count: '52', detail: 'The two feet together contain 52 bones, over a quarter of all bones in the body. Each foot: 7 tarsals (including the calcaneus/heel bone), 5 metatarsals, and 14 phalanges. The high bone count gives feet the flexibility to adapt to uneven terrain. Flat feet occur when the arch ligaments loosen.', note: 'Per foot: 26 · Both feet: 52 (within the 62-bone leg count above)' }
  };

  function showBoneRegion(key) {
    document.querySelectorAll('.bone-tab').forEach(function(t) { t.classList.remove('active'); });
    event.target.classList.add('active');
    var r = boneRegions[key];
    document.getElementById('boneCount').textContent = r.count + ' bones';
    document.getElementById('boneDetail').textContent = r.detail;
    document.getElementById('boneNote').textContent = r.note;
  }
  // Init with skull
  document.getElementById('boneCount').textContent = '28 bones';
  document.getElementById('boneDetail').textContent = boneRegions.skull.detail;
  document.getElementById('boneNote').textContent = boneRegions.skull.note;

  /* ─── Blood Compatibility Matrix ─── */
  (function() {
    var types = ['O−','O+','A−','A+','B−','B+','AB−','AB+'];
    // compatMatrix[donor][recipient] = true/false
    // Rules: Rh-neg can donate to same and Rh-pos. ABO must be compatible.
    // ABO donor must be subset of recipient antigens.
    // Simplified: O gives to all; A gives to A,AB; B gives to B,AB; AB gives to AB only.
    // Rh−: can give to − and +. Rh+: can only give to +.
    var aboCompat = {
      'O':  ['O','A','B','AB'],
      'A':  ['A','AB'],
      'B':  ['B','AB'],
      'AB': ['AB']
    };
    function aboOf(t) { return t.replace('−','').replace('+',''); }
    function rhOf(t)  { return t.includes('+') ? '+' : '−'; }
    function canDonate(donor, recip) {
      var aboOk = aboCompat[aboOf(donor)].indexOf(aboOf(recip)) !== -1;
      var rhOk  = rhOf(donor) === '−' || rhOf(recip) === '+';
      return aboOk && rhOk;
    }

    var selectedDonor = null;
    var selectedRecip = null;

    function buildButtons() {
      var dCont = document.getElementById('compatDonorBtns');
      var rCont = document.getElementById('compatRecipBtns');
      types.forEach(function(t) {
        var db = document.createElement('button');
        db.textContent = t;
        db.id = 'db-' + t.replace('+','pos').replace('−','neg');
        db.style.cssText = 'font-size:12px; padding:3px 10px; border-radius:6px; border: 0.5px solid var(--color-border-secondary); background:none; cursor:pointer; color:var(--color-text-secondary); transition:all 0.15s;';
        db.onclick = function() { selectedDonor = (selectedDonor === t) ? null : t; render(); };
        dCont.appendChild(db);

        var rb = document.createElement('button');
        rb.textContent = t;
        rb.id = 'rb-' + t.replace('+','pos').replace('−','neg');
        rb.style.cssText = db.style.cssText;
        rb.onclick = function() { selectedRecip = (selectedRecip === t) ? null : t; render(); };
        rCont.appendChild(rb);
      });
    }

    function buildTable() {
      var tbody = document.getElementById('compatTbody');
      tbody.innerHTML = '';
      types.forEach(function(donor, di) {
        var tr = document.createElement('tr');
        tr.id = 'crow-' + di;
        // Row header
        var th = document.createElement('td');
        th.className = 'compat-row-hdr';
        th.textContent = donor;
        tr.appendChild(th);
        types.forEach(function(recip, ri) {
          var td = document.createElement('td');
          td.id = 'cell-' + di + '-' + ri;
          if (donor === recip) {
            td.className = 'compat-self';
            td.textContent = '✓';
            td.title = donor + ' → ' + recip + ': same type';
          } else if (canDonate(donor, recip)) {
            td.className = 'compat-yes';
            td.textContent = '✓';
            td.title = donor + ' can donate to ' + recip;
          } else {
            td.className = 'compat-no';
            td.textContent = '✗';
            td.title = donor + ' cannot donate to ' + recip;
          }
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
    }

    function render() {
      // Update donor buttons style
      types.forEach(function(t, i) {
        var key = t.replace('+','pos').replace('−','neg');
        var db = document.getElementById('db-' + key);
        var rb = document.getElementById('rb-' + key);
        if (db) db.style.background = (selectedDonor === t) ? 'var(--color-background-warning)' : '';
        if (db) db.style.color      = (selectedDonor === t) ? 'var(--color-text-warning)'    : 'var(--color-text-secondary)';
        if (rb) rb.style.background = (selectedRecip === t) ? 'var(--color-background-info)'  : '';
        if (rb) rb.style.color      = (selectedRecip === t) ? 'var(--color-text-info)'        : 'var(--color-text-secondary)';
      });

      // Highlight cells
      types.forEach(function(donor, di) {
        types.forEach(function(recip, ri) {
          var cell = document.getElementById('cell-' + di + '-' + ri);
          if (!cell) return;
          var donorMatch = selectedDonor === donor;
          var recipMatch = selectedRecip === recip;
          if (donorMatch || recipMatch) {
            cell.style.outline = '2px solid var(--color-border-warning)';
            cell.style.outlineOffset = '-1px';
          } else {
            cell.style.outline = '';
          }
        });
      });

      // Result message
      var res = document.getElementById('compatResult');
      if (selectedDonor && selectedRecip) {
        var ok = canDonate(selectedDonor, selectedRecip);
        if (selectedDonor === selectedRecip) {
          res.textContent = '✓ ' + selectedDonor + ' → ' + selectedRecip + ': Same blood type: always compatible.';
          res.style.color = 'var(--color-text-info)';
        } else if (ok) {
          res.textContent = '✓ ' + selectedDonor + ' can donate to ' + selectedRecip + ', compatible.';
          res.style.color = 'var(--color-text-success)';
        } else {
          res.textContent = '✗ ' + selectedDonor + ' cannot donate to ' + selectedRecip + ', incompatible.';
          res.style.color = 'var(--color-text-danger)';
        }
      } else if (selectedDonor) {
        var canReceive = types.filter(function(r) { return canDonate(selectedDonor, r); });
        res.textContent = selectedDonor + ' can donate to: ' + canReceive.join(', ');
        res.style.color = 'var(--color-text-primary)';
      } else if (selectedRecip) {
        var canGive = types.filter(function(d) { return canDonate(d, selectedRecip); });
        res.textContent = selectedRecip + ' can receive from: ' + canGive.join(', ');
        res.style.color = 'var(--color-text-primary)';
      } else {
        res.textContent = '';
      }
    }

    buildButtons();
    buildTable();
    render();
  })();

  /* ─── Reaction Time Game ─── */
  var rtState = 'idle'; // idle | waiting | go | done
  var rtTimer = null;
  var rtStart = 0;
  var rtResults = [];

  function handleRtClick() {
    var screen = document.getElementById('rtScreen');
    if (rtState === 'idle' || rtState === 'done') {
      // Start waiting phase
      rtState = 'waiting';
      screen.className = 'rt-screen rt-ready';
      screen.textContent = 'Wait for green…';
      var delay = 1500 + Math.random() * 3000;
      rtTimer = setTimeout(function() {
        rtState = 'go';
        screen.className = 'rt-screen rt-go';
        screen.textContent = 'CLICK NOW!';
        rtStart = performance.now();
      }, delay);
    } else if (rtState === 'waiting') {
      // Clicked too early
      clearTimeout(rtTimer);
      rtState = 'done';
      screen.className = 'rt-screen rt-wait';
      screen.textContent = 'Too early! Click to try again.';
    } else if (rtState === 'go') {
      var elapsed = Math.round(performance.now() - rtStart);
      rtResults.push(elapsed);
      rtState = 'done';
      screen.className = 'rt-screen rt-done';
      screen.textContent = elapsed + ' ms, click to go again';
      // Update stats
      document.getElementById('rtLast').textContent = elapsed;
      var best = Math.min.apply(null, rtResults);
      document.getElementById('rtBest').textContent = best;
      var avg = Math.round(rtResults.reduce(function(a,b){return a+b;},0) / rtResults.length);
      document.getElementById('rtAvg').textContent = avg;
      document.getElementById('rtCount').textContent = rtResults.length;
    }
  }
  
</script>
