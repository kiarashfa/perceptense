/* ---- ELECTION SIMULATOR ---- */
function updateElection() {
  const pa = parseInt(document.getElementById('pa-votes').value);
  const pb = parseInt(document.getElementById('pb-votes').value);
  const pc = Math.max(0, 100 - pa - pb);
  document.getElementById('pa-out').textContent = pa + '%';
  document.getElementById('pb-out').textContent = pb + '%';
  document.getElementById('pc-out').textContent = pc + '%';

  const totalSeats = 100;
  const fptp_a = pa > pb && pa > pc ? Math.round(totalSeats * (pa > 40 ? 0.65 : 0.55)) : (pa > pb ? Math.round(totalSeats * 0.52) : Math.round(totalSeats * 0.35));
  const fptp_b = Math.round(totalSeats * (pb / (pa + pb) * (pa > pb ? 0.35 : 0.55)));
  const fptp_c = totalSeats - fptp_a - fptp_b;
  const pr_a = pa, pr_b = pb, pr_c = pc;

  document.getElementById('election-results').innerHTML = `
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
      <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:10px 12px;">
        <div style="font-size:12px; font-weight:500; color:var(--color-text-primary); margin-bottom:8px;">First Past the Post (FPTP) — seats out of 100</div>
        <div style="display:flex; flex-direction:column; gap:4px;">
          <div style="display:flex; align-items:center; gap:8px;"><div style="width:80px; font-size:12px; color:#185FA5; flex-shrink:0;">Party A (${pa}%)</div><div style="flex:${fptp_a}; height:14px; background:#378ADD; border-radius:2px; position:relative; min-width:4px;"><span style="font-size:10px; color:#fff; position:absolute; right:4px; top:2px;">${fptp_a}</span></div></div>
          <div style="display:flex; align-items:center; gap:8px;"><div style="width:80px; font-size:12px; color:#A32D2D; flex-shrink:0;">Party B (${pb}%)</div><div style="flex:${Math.max(fptp_b,1)}; height:14px; background:#E24B4A; border-radius:2px; position:relative; min-width:4px;"><span style="font-size:10px; color:#fff; position:absolute; right:4px; top:2px;">${fptp_b}</span></div></div>
          <div style="display:flex; align-items:center; gap:8px;"><div style="width:80px; font-size:12px; color:#27500A; flex-shrink:0;">Party C (${pc}%)</div><div style="flex:${Math.max(fptp_c,1)}; height:14px; background:#639922; border-radius:2px; position:relative; min-width:4px;"><span style="font-size:10px; color:#fff; position:absolute; right:4px; top:2px;">${fptp_c}</span></div></div>
        </div>
        <div style="font-size:11px; color:var(--color-text-secondary); margin-top:6px;">${fptp_a > 50 ? 'Party A majority government.' : 'No majority — hung parliament.'} Third party squeezed.</div>
      </div>
      <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:10px 12px;">
        <div style="font-size:12px; font-weight:500; color:var(--color-text-primary); margin-bottom:8px;">Proportional Representation (PR) — seats out of 100</div>
        <div style="display:flex; flex-direction:column; gap:4px;">
          <div style="display:flex; align-items:center; gap:8px;"><div style="width:80px; font-size:12px; color:#185FA5; flex-shrink:0;">Party A (${pa}%)</div><div style="flex:${pr_a}; height:14px; background:#378ADD; border-radius:2px; position:relative; min-width:4px;"><span style="font-size:10px; color:#fff; position:absolute; right:4px; top:2px;">${pr_a}</span></div></div>
          <div style="display:flex; align-items:center; gap:8px;"><div style="width:80px; font-size:12px; color:#A32D2D; flex-shrink:0;">Party B (${pb}%)</div><div style="flex:${Math.max(pr_b,1)}; height:14px; background:#E24B4A; border-radius:2px; position:relative; min-width:4px;"><span style="font-size:10px; color:#fff; position:absolute; right:4px; top:2px;">${pr_b}</span></div></div>
          <div style="display:flex; align-items:center; gap:8px;"><div style="width:80px; font-size:12px; color:#27500A; flex-shrink:0;">Party C (${pc}%)</div><div style="flex:${Math.max(pr_c,1)}; height:14px; background:#639922; border-radius:2px; position:relative; min-width:4px;"><span style="font-size:10px; color:#fff; position:absolute; right:4px; top:2px;">${pr_c}</span></div></div>
        </div>
        <div style="font-size:11px; color:var(--color-text-secondary); margin-top:6px;">Seats mirror vote share. Coalition needed: ${pa > pb ? 'A+C' : 'B+C'} or A+B.</div>
      </div>
    </div>
    <div style="font-size:12px; color:var(--color-text-secondary); line-height:1.6; background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:9px 11px;">
      <strong style="color:var(--color-text-primary);">The key insight:</strong> FPTP tends to manufacture majorities — turning a plurality (most votes, not 50%+) into a parliamentary majority. PR reflects actual voter preference but usually requires coalition-building. The UK 2019 election: Conservatives won 43.6% of votes → 56% of seats. Germany 2021: no party above 26%, coalition took 3 months to form.
    </div>`;
}

document.getElementById('pa-votes').addEventListener('input', updateElection);
document.getElementById('pb-votes').addEventListener('input', updateElection);

/* ---- FRAMING EXPLORER ---- */
const framings = {
  protest: {
    title: 'A large protest march in the capital',
    left: '"Tens of thousands take to the streets to demand climate action, as citizens make their voices heard against government inaction."',
