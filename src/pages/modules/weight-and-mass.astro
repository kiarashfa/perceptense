---
import ModuleLayout from '../../layouts/ModuleLayout.astro';
import modules from '../../data/modules.json';
import '../../styles/modules/weight-and-mass.css';
import '../../styles/icons/weight-and-mass.css';

const mod = modules.find((m) => m.id === 1)!;
---

<ModuleLayout mod={mod}>

  

    <div class="module-header">
      <i class="fa-solid fa-weight-hanging module-header-icon"></i>
      <h1 class="module-title module-heading">Module 1: Weight & Mass</h1>
    </div>
    <p class="module-subtitle">How much things weigh — from paperclips to cars</p>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-a-weight-of-everyday-objects">Part A · weight of everyday objects</h2>

    <div class="cgrid">
      <div class="card">
        <p class="clabel">Small car (4-door)</p>
        <p class="cval">~1,400 kg</p>
        <p class="cnote">Think: 1.4 tonnes. A large SUV reaches 2,500 kg.</p>
      </div>
      <div class="card">
        <p class="clabel">Adult human</p>
        <p class="cval">~70 kg</p>
        <p class="cnote">A car weighs about 18–20 average people.</p>
      </div>
      <div class="card">
        <p class="clabel">1 litre of water</p>
        <p class="cval">exactly 1 kg</p>
        <p class="cnote">The anchor for all weight intuition.</p>
      </div>
      <div class="card">
        <p class="clabel">A4 sheet of paper</p>
        <p class="cval">~5 g</p>
        <p class="cnote">200 sheets = 1 kg. A ream (500 sheets) = 2.5 kg.</p>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-b-anchor-numbers-to-memorize">Part B · anchor numbers to memorize</h2>

    <div class="content-panel">
      <div class="anchor-row">
        <span class="pill p-blue">1 g</span>
        <div><div class="atext">A paperclip · a raisin · a small pill</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">10 g</span>
        <div><div class="atext">2–3 teaspoons of sugar · a 2-euro coin (8.5 g)</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">25 g</span>
        <div><div class="atext">A large egg (without shell) · a matchbox full of coins</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">100 g</span>
        <div><div class="atext">A small apple · a deck of cards · a small yogurt</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">200 g</span>
        <div><div class="atext">A standard bar of chocolate · a glass of water · a medium orange</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">500 g</span>
        <div><div class="atext">A standard bag of pasta · a thick hardcover book</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">1 kg</span>
        <div><div class="atext">1 litre of water · a bag of sugar · a light ultrabook</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">2 kg</span>
        <div><div class="atext">A large bag of flour · a standard house brick · a small newborn baby</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">10 kg</span>
        <div><div class="atext">A large bag of rice · a full carry-on suitcase · a toddler</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">25 kg</span>
        <div><div class="atext">A bag of cement · a medium-sized dog · a large microwave oven</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">70 kg</span>
        <div><div class="atext">An average adult human</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">150 kg</span>
        <div><div class="atext">A large motorbike · a heavy upright piano · two average adults</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">300 kg</span>
        <div><div class="atext">A full wine barrel (225 L Bordeaux barrique) · a grand piano</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">1,400 kg</span>
        <div><div class="atext">A standard 4-door car (about 20 people)</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">10,000 kg</span>
        <div><div class="atext">A London double-decker bus · a small loaded aircraft (Cessna 208)</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-blue">100,000 kg</span>
        <div><div class="atext">A blue whale calf at birth · a fully laden freight locomotive</div></div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-c-the-weight-scale">Part C · the weight scale</h2>

    <p class="section-intro">
      A logarithmic scale from 1 g to 100,000 kg — each column step is 10× heavier than the one before. Every item gets its own row so nothing overlaps.
    </p>

    <div class="scale-wrap">
      <canvas id="weightScaleCanvas" class="scale-canvas"></canvas>
      <p class="scale-caption">Each step rightward is ×10. Items are sorted lightest → heaviest top to bottom.</p>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-d-unit-converter">Part D · unit converter</h2>

    <p class="section-intro">
      Enter any weight to convert between the four most common units. Use the slider to step through the anchor values from Part B.
    </p>

    <div class="conv-wrap">
      <div class="conv-row">
        <label for="convInput">Input</label>
        <input type="number" id="convInput" class="conv-input" value="1" min="0" step="any">
        <button class="conv-unit-btn active" data-unit="kg"  onclick="setUnit('kg')">kg</button>
        <button class="conv-unit-btn"        data-unit="g"   onclick="setUnit('g')">g</button>
        <button class="conv-unit-btn"        data-unit="lb"  onclick="setUnit('lb')">lb</button>
        <button class="conv-unit-btn"        data-unit="oz"  onclick="setUnit('oz')">oz</button>
      </div>
      <div class="conv-results" id="convResults"></div>
      <div class="slider-section">
        <div class="slider-label-row">
          <span>Anchor explorer</span>
          <span id="sliderValLabel">1 kg</span>
        </div>
        <input type="range" id="anchorSlider" min="0" max="7" step="1" value="4">
        <div class="slider-context" id="sliderContext"></div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-e-which-is-heavier-game">Part E · which is heavier? (game)</h2>

    <p class="section-intro">
      5 rounds. Pick the heavier object. Build your weight intuition — no looking things up!
    </p>

    <div class="game-wrap" id="gameWrap"></div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-f-the-wider-world-of-weight">Part F · the wider world of weight</h2>

    <p class="section-intro">
      Once you're fluent in everyday weights, it's worth knowing the extremes — both to calibrate your intuition and because these numbers come up in science, news, and conversation.
    </p>

    <div class="world-grid">
      <div class="world-card">
        <div class="world-icon">💉</div>
        <p class="world-label">Human red blood cell</p>
        <p class="world-val">~27 picograms</p>
        <p class="world-note">You have ~25 trillion of them — totalling ~2 kg of cells.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🪨</div>
        <p class="world-label">Grain of sand</p>
        <p class="world-val">~0.00003 g</p>
        <p class="world-note">30 micrograms. About 33,000 grains per gram.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🍚</div>
        <p class="world-label">Grain of rice</p>
        <p class="world-val">~25 mg</p>
        <p class="world-note">About 800× heavier than a grain of sand, but still only 1/40 of a gram.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🔋</div>
        <p class="world-label">AA battery</p>
        <p class="world-val">~24 g</p>
        <p class="world-note">A familiar pocket weight: about 1,000 grains of rice.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🛞</div>
        <p class="world-label">Car tyre</p>
        <p class="world-val">~9 kg</p>
        <p class="world-note">The tyre alone, without the metal wheel. Heavier than it looks when you lift it.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🍷</div>
        <p class="world-label">Full wine barrel</p>
        <p class="world-val">~300 kg</p>
        <p class="world-note">A 225 L Bordeaux barrique: ~170 kg wine + ~45 kg oak + sediment.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🦛</div>
        <p class="world-label">Adult hippopotamus</p>
        <p class="world-val">~2,000 kg</p>
        <p class="world-note">The third-heaviest land animal. Despite bulk, they can run at ~30 km/h.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🐘</div>
        <p class="world-label">African elephant (bull)</p>
        <p class="world-val">~5,500 kg</p>
        <p class="world-note">The heaviest land animal alive. About 4 cars, or 75 adult humans.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🚛</div>
        <p class="world-label">Loaded garbage truck</p>
        <p class="world-val">~30,000 kg</p>
        <p class="world-note">A full refuse truck. About 20 cars, or more than 400 adult humans.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🚀</div>
        <p class="world-label">Space Shuttle orbiter (empty)</p>
        <p class="world-val">~68,000 kg</p>
        <p class="world-note">The orbiter alone. At launch with external tank and boosters: ~2,000,000 kg.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🐋</div>
        <p class="world-label">Blue whale</p>
        <p class="world-val">~150,000 kg</p>
        <p class="world-note">~100 cars. The heaviest animal known to have ever existed.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">✈️</div>
        <p class="world-label">Boeing 747 (max takeoff)</p>
        <p class="world-val">~412,000 kg</p>
        <p class="world-note">Empty weight ~178,000 kg. The rest is fuel, cargo, and passengers.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🚀</div>
        <p class="world-label">Space Shuttle at launch</p>
        <p class="world-val">~2,000,000 kg</p>
        <p class="world-note">Orbiter + external tank + boosters. Most of the mass is fuel.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🚀</div>
        <p class="world-label">Saturn V rocket (fuelled)</p>
        <p class="world-val">~2,950,000 kg</p>
        <p class="world-note">~96% of that weight is propellant. Payload to the Moon: ~48,000 kg.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🗼</div>
        <p class="world-label">Eiffel Tower</p>
        <p class="world-val">~10,100,000 kg</p>
        <p class="world-note">~7,300 t of iron structure + ~2,800 t of other materials. Repainted every 7 years.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">☁️</div>
        <p class="world-label">Typical cumulus cloud</p>
        <p class="world-val">~500,000,000 kg</p>
        <p class="world-note">Half a billion kg of water droplets — yet so diffuse they float.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🏛️</div>
        <p class="world-label">Great Pyramid of Giza</p>
        <p class="world-val">~6,000,000,000 kg</p>
        <p class="world-note">~6 billion kg — about 2.3 million stone blocks averaging ~2,500 kg each.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🧑‍🤝‍🧑</div>
        <p class="world-label">All humans on Earth</p>
        <p class="world-val">~6 × 10¹¹ kg</p>
        <p class="world-note">~8 billion people × ~70 kg = 560 billion kg. A rounding error vs. the oceans.</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🏔️</div>
        <p class="world-label">Mount Everest</p>
        <p class="world-val">~8 × 10¹⁴ kg</p>
        <p class="world-note">800 trillion kg. Dwarfed by Earth's oceans (~1.4 × 10²¹ kg).</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🌊</div>
        <p class="world-label">Earth's oceans</p>
        <p class="world-val">~1.4 × 10²¹ kg</p>
        <p class="world-note">About 1.7 million Mount Everests. This is the scale where geology starts to feel small.</p>
      </div>
    </div>

    <div class="content-panel">
      <div class="panel-title">⚖️ Mass vs. Weight — what's the difference?</div>
      <p class="muted-copy-large u-m-0">In everyday speech, "weight" and "mass" are used interchangeably — and that's fine. But technically: <strong>mass</strong> is the amount of matter in an object (measured in kg), while <strong>weight</strong> is the force gravity exerts on that mass (measured in newtons). Your mass is the same on the Moon as on Earth; your weight is about 6× less on the Moon because gravity is weaker there. When you stand on a bathroom scale, it's technically measuring force and displaying it as kg — a convenient convention. In this module and in daily life, "weight" and "mass" mean the same thing.</p>
    </div>

    <div class="content-panel">
      <div class="rules-title">Rules of thumb worth memorising</div>
      <div class="anchor-row">
        <span class="pill p-teal compact-pill">×2.2</span>
        <div><div class="atext">To convert kg → pounds, multiply by 2.2. (1 kg = 2.205 lb)</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-teal compact-pill">÷28</span>
        <div><div class="atext">Grams to ounces: divide by 28. (28.35 g = 1 oz)</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-teal compact-pill">×1000</span>
        <div><div class="atext">1 tonne = 1,000 kg = 1 metric ton. A car ≈ 1.4 tonnes.</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-teal compact-pill">density</span>
        <div><div class="atext">Water = 1 g/ml. Iron = 7.9. Gold = 19.3. Wood floats because it's &lt;1 g/ml.</div></div>
      </div>
      <div class="anchor-row">
        <span class="pill p-teal compact-pill">stones</span>
        <div><div class="atext">UK/Irish body weight: 1 stone = 14 pounds = 6.35 kg. A 70 kg person = 11 stone.</div></div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-g-your-weight-across-the-solar-system">Part G · your weight across the solar system</h2>

    <p class="section-intro">
      Your mass stays the same everywhere, but a scale would show a different number because gravity changes. Try your own mass and watch how the same body feels lighter or heavier.
    </p>

    <div class="content-panel" id="solar-mass">
      <div class="planet-input-row">
        <label for="planetMassInput">Enter your mass:</label>
        <input type="number" id="planetMassInput" class="planet-mass-input" value="70" min="1" max="500" step="1" oninput="renderPlanets()">
        <span class="planet-input-unit">kg on Earth</span>
      </div>
      <div class="planet-grid" id="planetGrid"></div>
      <p class="planet-note">Values shown as equivalent weight on a bathroom scale (mass × planet gravity).</p>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-h-estimate-weight-from-size">Part H · estimate weight from size</h2>

    <p class="section-intro">
      When you meet an unfamiliar object, first guess its volume: one litre, a shoebox, a suitcase. Then ask what it is made of. The shortcut is simple: <strong>weight ≈ volume × density</strong>.
    </p>

    <div class="content-panel">
      <div class="panel-title">The 1-litre test: same size, wildly different weights</div>
      <div class="density-sense-grid">
        <div class="estimate-steps">
          <div class="estimate-step"><strong>Start with water.</strong> One litre of water is exactly 1 kg, so water is the middle of your mental scale.</div>
          <div class="estimate-step"><strong>Airy or floating materials</strong> usually weigh less than water for the same volume: cork, dry wood, many plastics.</div>
          <div class="estimate-step"><strong>Stone, glass, and metal</strong> jump fast. A one-litre block of iron is not "a bit heavier" than water — it is almost 8 kg.</div>
        </div>
        <div class="density-chart" aria-label="Approximate weights of one litre of different materials">
          <div class="density-row"><span class="density-label">Cork</span><div class="density-track"><div class="density-fill" style="--w: 1.2%; --bar: #85B7EB;"></div></div><span class="density-value">0.24 kg</span></div>
          <div class="density-row"><span class="density-label">Pine wood</span><div class="density-track"><div class="density-fill" style="--w: 3.1%; --bar: #97C459;"></div></div><span class="density-value">0.6 kg</span></div>
          <div class="density-row"><span class="density-label">Olive oil</span><div class="density-track"><div class="density-fill" style="--w: 4.7%; --bar: #D4A843;"></div></div><span class="density-value">0.91 kg</span></div>
          <div class="density-row"><span class="density-label">Water</span><div class="density-track"><div class="density-fill" style="--w: 5.2%; --bar: var(--accent);"></div></div><span class="density-value">1.0 kg</span></div>
          <div class="density-row"><span class="density-label">Wet sand</span><div class="density-track"><div class="density-fill" style="--w: 10.4%; --bar: #EF9F27;"></div></div><span class="density-value">2.0 kg</span></div>
          <div class="density-row"><span class="density-label">Glass</span><div class="density-track"><div class="density-fill" style="--w: 13.0%; --bar: #8B73C7;"></div></div><span class="density-value">2.5 kg</span></div>
          <div class="density-row"><span class="density-label">Iron</span><div class="density-track"><div class="density-fill" style="--w: 40.9%; --bar: #5F5E5A;"></div></div><span class="density-value">7.9 kg</span></div>
          <div class="density-row"><span class="density-label">Gold</span><div class="density-track"><div class="density-fill" style="--w: 100%; --bar: #B98A16;"></div></div><span class="density-value">19.3 kg</span></div>
        </div>
      </div>
      <p class="estimate-note">The small bars are intentionally tiny: compared with metal, most everyday materials are basically water-like, woody, or full of air.</p>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <h2 class="sec" id="part-i-q-and-a">Part I · Q&A</h2>

    <div class="qa">
      <p class="qa-q">1. A bag of flour at the supermarket is typically how heavy?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">1 kg. Sometimes also sold in 500g or 2kg bags, but 1kg is the standard. Anchor: same as 1 litre of water.</div>
    </div>

    <div class="qa">
      <p class="qa-q">2. How much does a full 5-person family (2 adults + 3 children) weigh together, roughly?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">Roughly 250–310 kg. Two adults ~70 kg each = 140 kg. Three children (mixed ages, including young ones) can range widely — perhaps 20–50 kg each. A rough middle estimate gives ~110–170 kg for the children, making the family total around 250–310 kg. Less than a quarter of a car's weight.</div>
    </div>

    <div class="qa">
      <p class="qa-q">3. Someone says "this package weighs about 2 pounds." What is that in kg?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">About 0.9 kg — essentially 1 kg. The rule to remember: 1 pound ≈ 0.45 kg, so 2 pounds ≈ 0.9 kg. For rough estimates, "2 pounds ≈ 1 kg" is close enough.</div>
    </div>

    <div class="qa">
      <p class="qa-q">4. A gold bar (the kind held in bank vaults) — how heavy is it?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">The standard "Good Delivery" bar used by central banks weighs 400 troy ounces — about 12.4 kg. That's roughly the weight of a full carry-on suitcase. Gold is extremely dense: the bar is about the size of a large smartphone, yet you cannot lift it with one hand comfortably.</div>
    </div>

    <div class="qa">
      <p class="qa-q">5. You're mailing a letter. The envelope + single page inside weighs roughly how much?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">About 8–12 g total. A standard envelope is ~5–6 g; one A4 page folded inside is ~5 g. This is why postal services often set the cheapest letter rate at "up to 20g" — it comfortably covers a single-sheet letter with room to spare.</div>
    </div>

    <div class="qa">
      <p class="qa-q">6. Which is heavier: a litre of olive oil, or a litre of water?</p>
      <button class="qa-btn" onclick="this.style.display='none';this.nextElementSibling.classList.add('show')">Show answer</button>
      <div class="qa-ans">Water is heavier. Olive oil has a density of ~0.91 g/ml, so a litre weighs about 910 g versus exactly 1,000 g for water. This is why oil floats on water — it's less dense. A litre of honey, by contrast, weighs ~1,400 g — 40% heavier than water.</div>
    </div>

  

  
  
</ModuleLayout>

<script is:inline>

  /* ════════════════════════════════════════════════════
     PART C — logarithmic weight scale (Canvas)
     One item per row — zero overlap by design.
     Items sorted lightest → heaviest.
     Horizontal axis = log scale (1 g to 100,000 kg).
  ════════════════════════════════════════════════════ */
  (function () {

    var ITEMS = [
      { label: 'Paperclip',      kg: 0.001,    emoji: '📎' },
      { label: 'A4 sheet',       kg: 0.005,    emoji: '📄' },
      { label: '2€ coin',        kg: 0.0085,   emoji: '🪙' },
      { label: 'Large egg',      kg: 0.060,    emoji: '🥚' },
      { label: 'Small apple',    kg: 0.100,    emoji: '🍎' },
      { label: 'Chocolate bar',  kg: 0.200,    emoji: '🍫' },
      { label: 'Bag of pasta',   kg: 0.500,    emoji: '🍝' },
      { label: '1 L water',      kg: 1.000,    emoji: '💧' },
      { label: 'Brick',          kg: 2.000,    emoji: '🧱' },
      { label: 'Carry-on bag',   kg: 10.0,     emoji: '🧳' },
      { label: 'Bag of cement',  kg: 25.0,     emoji: '⚙️' },
      { label: 'Adult human',    kg: 70.0,     emoji: '🧑' },
      { label: 'Motorbike',      kg: 150.0,    emoji: '🏍️' },
      { label: 'Wine barrel',    kg: 300.0,    emoji: '🍷' },
      { label: 'Car',            kg: 1400.0,   emoji: '🚗' },
      { label: 'Bus',            kg: 10000.0,  emoji: '🚌' },
      { label: 'Blue whale',     kg: 150000.0, emoji: '🐋' },
    ];

    // x-axis: log10 of grams.  1 g = 0, 100,000 kg = 1e8 g → log=8
    var LOG_MIN = 0;   // 1 g
    var LOG_MAX = 8;   // 100,000 kg = 1e8 g

    var ROW_H    = 36;
    var PAD_TOP  = 12;
    var PAD_BOT  = 46;
    var PAD_L    = 56;
    var PAD_R    = 70;
    var DOT_R    = 4;

    var canvas = document.getElementById('weightScaleCanvas');

    function draw() {
      var wrapStyle = window.getComputedStyle(canvas.parentElement);
      var wrapPad = parseFloat(wrapStyle.paddingLeft) + parseFloat(wrapStyle.paddingRight);
      var cw = canvas.parentElement.clientWidth - wrapPad;
      var W  = Math.max(cw, 560);
      var H  = PAD_TOP + ITEMS.length * ROW_H + PAD_BOT;
      var dpr = window.devicePixelRatio || 1;

      canvas.width  = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width  = W + 'px';
      canvas.style.height = H + 'px';

      var ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      // Theme detection
      var attr = document.documentElement.getAttribute('data-theme');
      var dark = attr === 'dark' || (attr !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);

      var C = {
        textPri : dark ? '#e8e6df' : '#1a1a18',
        textSec : dark ? '#a8a69e' : '#5f5e5a',
        textTer : dark ? '#6e6c65' : '#888780',
        stripe  : dark ? 'rgba(255,255,255,0.025)' : 'rgba(0,0,0,0.025)',
        grid    : dark ? 'rgba(255,255,255,0.07)'  : 'rgba(0,0,0,0.07)',
        axis    : dark ? 'rgba(255,255,255,0.25)'  : 'rgba(0,0,0,0.2)',
        tick    : dark ? 'rgba(255,255,255,0.3)'   : 'rgba(0,0,0,0.22)',
        dot1    : 'var(--accent)',
        dot2    : '#8B73C7',
        dotHuman: '#D4822A',
        stem    : dark ? 'rgba(255,255,255,0.08)'  : 'rgba(0,0,0,0.08)',
      };

      var axisL = PAD_L + 4;
      var axisR = W - PAD_R;
      var axisW = axisR - axisL;
      var axisY = PAD_TOP + ITEMS.length * ROW_H + 10;

      ctx.clearRect(0, 0, W, H);

      // ── Alternating row stripes
      ITEMS.forEach(function (_, i) {
        if (i % 2 === 0) {
          ctx.fillStyle = C.stripe;
          ctx.fillRect(0, PAD_TOP + i * ROW_H, W, ROW_H);
        }
      });

      // ── Vertical grid lines at each power of 10
      var TICK_LABELS = {
        0: '1 g', 1: '10 g', 2: '100 g',
        3: '1 kg', 4: '10 kg', 5: '100 kg',
        6: '1 t', 7: '10 t', 8: '100 t'
      };

      for (var p = LOG_MIN; p <= LOG_MAX; p++) {
        var gx = axisL + ((p - LOG_MIN) / (LOG_MAX - LOG_MIN)) * axisW;

        ctx.strokeStyle = C.grid;
        ctx.lineWidth = 1;
        ctx.setLineDash([]);
        ctx.beginPath();
        ctx.moveTo(gx, PAD_TOP);
        ctx.lineTo(gx, axisY);
        ctx.stroke();

        // Tick
        ctx.strokeStyle = C.tick;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(gx, axisY);
        ctx.lineTo(gx, axisY + 5);
        ctx.stroke();

        // Label
        ctx.font = '10px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillStyle = C.textTer;
        ctx.fillText(TICK_LABELS[p] || '', gx, axisY + 8);
      }

      // ── Axis line
      ctx.strokeStyle = C.axis;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(axisL, axisY);
      ctx.lineTo(axisR, axisY);
      ctx.stroke();

      // ── Items
      ITEMS.forEach(function (item, i) {
        var grams = item.kg * 1000;
        var logG  = Math.log10(grams);
        var dotX  = axisL + ((logG - LOG_MIN) / (LOG_MAX - LOG_MIN)) * axisW;
        var rowY  = PAD_TOP + i * ROW_H;
        var midY  = rowY + ROW_H / 2;

        // Choose dot colour
        var dotCol = (i % 2 === 0) ? C.dot1 : C.dot2;
        if (item.label === 'Adult human') dotCol = C.dotHuman;

        // Dashed vertical stem from dot down to axis
        ctx.strokeStyle = C.stem;
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 3]);
        ctx.beginPath();
        ctx.moveTo(dotX, midY + DOT_R + 2);
        ctx.lineTo(dotX, axisY - 1);
        ctx.stroke();
        ctx.setLineDash([]);

        // Dot
        ctx.beginPath();
        ctx.arc(dotX, midY, DOT_R, 0, Math.PI * 2);
        ctx.fillStyle = dotCol;
        ctx.fill();

        // Emoji — centred on the dot
        ctx.font = '14px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(item.emoji, dotX, midY);

        // Label — prefer right of dot, flip left if near right edge
        ctx.font = '11px system-ui, sans-serif';
        ctx.textBaseline = 'middle';
        var LABEL_GAP = 14;
        var labelW = ctx.measureText(item.label).width;

        if (dotX + LABEL_GAP + labelW <= W - 4) {
          ctx.textAlign = 'left';
          ctx.fillStyle = C.textSec;
          ctx.fillText(item.label, dotX + LABEL_GAP, midY);
        } else {
          ctx.textAlign = 'right';
          ctx.fillStyle = C.textSec;
          ctx.fillText(item.label, dotX - LABEL_GAP, midY);
        }
      });

      // ── Direction hint
      ctx.font = '10px system-ui, sans-serif';
      ctx.textBaseline = 'top';
      ctx.fillStyle = C.textTer;
      ctx.textAlign = 'left';
      ctx.fillText('← lighter', axisL + 8, axisY + 24);
      ctx.textAlign = 'right';
      ctx.fillText('heavier →', axisR - 8, axisY + 24);
    }

    draw();
    window.addEventListener('resize', draw);
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', draw);

  })();


  /* ════════════════════════════════════════════════════
     PART D — unit converter + anchor slider
  ════════════════════════════════════════════════════ */
  var convUnit = 'kg';

  function setUnit(u) {
    convUnit = u;
    document.querySelectorAll('.conv-unit-btn').forEach(function (b) {
      b.classList.toggle('active', b.dataset.unit === u);
    });
    runConvert();
  }

  function toKg(val, unit) {
    if (unit === 'kg') return val;
    if (unit === 'g')  return val / 1000;
    if (unit === 'lb') return val * 0.45359237;
    if (unit === 'oz') return val * 0.028349523;
  }

  function fmt(n) {
    if (n === 0) return '0';
    if (n >= 1000)  return n.toLocaleString(undefined, { maximumFractionDigits: 1 });
    if (n >= 1)     return n.toLocaleString(undefined, { maximumFractionDigits: 3 });
    if (n >= 0.001) return n.toLocaleString(undefined, { maximumFractionDigits: 4 });
    return n.toExponential(3);
  }

  function runConvert() {
    var raw = parseFloat(document.getElementById('convInput').value);
    if (isNaN(raw) || raw < 0) return;
    var kg = toKg(raw, convUnit);
    var results = [
      { unit: 'Kilograms (kg)', val: kg },
      { unit: 'Grams (g)',      val: kg * 1000 },
      { unit: 'Pounds (lb)',    val: kg / 0.45359237 },
      { unit: 'Ounces (oz)',    val: kg / 0.028349523 }
    ];
    document.getElementById('convResults').innerHTML = results.map(function (r) {
      return '<div class="conv-result-card">' +
        '<p class="conv-result-unit">' + r.unit + '</p>' +
        '<p class="conv-result-val">' + fmt(r.val) + '</p>' +
        '</div>';
    }).join('');
  }

  document.getElementById('convInput').addEventListener('input', runConvert);

  var anchorData = [
    { label: '1 g',      kg: 0.001,  context: '<strong>1 g</strong> — a paperclip, a raisin, a small pill.' },
    { label: '10 g',     kg: 0.010,  context: '<strong>10 g</strong> — 2–3 teaspoons of sugar, or a 2-euro coin (8.5 g).' },
    { label: '100 g',    kg: 0.100,  context: '<strong>100 g</strong> — a small apple, a deck of cards, a small yogurt.' },
    { label: '500 g',    kg: 0.500,  context: '<strong>500 g</strong> — a bag of pasta, a thick hardcover book.' },
    { label: '1 kg',     kg: 1,      context: '<strong>1 kg</strong> — 1 litre of water, a bag of sugar, a light ultrabook.' },
    { label: '10 kg',    kg: 10,     context: '<strong>10 kg</strong> — a large bag of rice, a full carry-on suitcase, a toddler.' },
    { label: '70 kg',    kg: 70,     context: '<strong>70 kg</strong> — an average adult human.' },
    { label: '1,400 kg', kg: 1400,   context: '<strong>1,400 kg</strong> — a standard 4-door car, roughly 20 people.' },
  ];

  var slider = document.getElementById('anchorSlider');
  slider.max = anchorData.length - 1;
  slider.value = 4;

  function updateSlider() {
    var i = parseInt(slider.value, 10);
    var a = anchorData[i];
    document.getElementById('sliderValLabel').textContent = a.label;
    document.getElementById('sliderContext').innerHTML = a.context;
    document.getElementById('convInput').value = a.kg;
    convUnit = 'kg';
    document.querySelectorAll('.conv-unit-btn').forEach(function (b) {
      b.classList.toggle('active', b.dataset.unit === 'kg');
    });
    runConvert();
  }

  slider.addEventListener('input', updateSlider);
  updateSlider();


  /* ════════════════════════════════════════════════════
     PART E — "Which is heavier?" game
  ════════════════════════════════════════════════════ */
  var gameQuestions = [
    {
      q: 'Which is heavier?',
      a: { label: '🥛 1 litre of full-fat milk', kg: 1.03,  note: 'Milk is denser than water (~1.03 kg/L) so it weighs slightly more.' },
      b: { label: '💧 1 litre of water',          kg: 1.00,  note: 'Water is almost as heavy as milk, but just slightly less dense.' }
    },
    {
      q: 'Which is heavier?',
      a: { label: '🧱 1 litre of wet sand',   kg: 2.0,  note: 'Wet sand is very dense — around 1.9–2.1 kg per litre.' },
      b: { label: '🥩 1 litre of lean beef',  kg: 1.05, note: 'Meat is mostly water; it weighs roughly the same as water per volume.' }
    },
    {
      q: 'Which is heavier?',
      a: { label: '🪶 1 kg of feathers',  kg: 1.0, note: 'Exactly 1 kg — same as the iron. The old trick question.' },
      b: { label: '🔩 1 kg of iron bolts', kg: 1.0, note: 'Also exactly 1 kg. Weight is weight, regardless of density.' }
    },
    {
      q: 'You have a full 355 ml can of cola and a standard hardcover novel (~400 pages). Which is heavier?',
      a: { label: '🥤 Can of cola (355 ml)',     kg: 0.385, note: 'A 355 ml can weighs about 375–385 g including the aluminium can (~15 g).' },
      b: { label: '📚 400-page hardcover novel', kg: 0.55,  note: 'A typical hardcover novel of this length weighs ~500–600 g.' }
    },
    {
      q: 'Which weighs more?',
      a: { label: '🧴 A full 500 ml bottle of shampoo', kg: 0.54, note: 'Shampoo is slightly denser than water (~1.03–1.08 g/ml), so 500 ml ≈ 530–540 g.' },
      b: { label: '🥖 A standard baguette (65 cm)',     kg: 0.25, note: 'A traditional French baguette weighs 250 g by law in France.' }
    },
    {
      q: 'Which is heavier in your bag?',
      a: { label: '💻 A 15" MacBook Pro (M3)',           kg: 2.14, note: 'Apple\'s 15" MacBook Pro weighs 2.14 kg — noticeably heavier than it looks.' },
      b: { label: '📱 20 iPhones (latest, ~170 g each)', kg: 3.4,  note: '20 × 170 g = 3,400 g = 3.4 kg. Surprising — 20 phones outweigh a laptop.' }
    },
    {
      q: 'Which is heavier?',
      a: { label: '☁️ A typical cumulus cloud',                  kg: 500000000, note: 'A cumulus cloud holds ~0.5 billion kg of water droplets — but spread so thin they float.' },
      b: { label: '🛳️ MS Symphony of the Seas (cruise ship)',    kg: 228000000, note: 'Gross tonnage ~228,000 GT. The cloud is actually heavier — just incredibly diffuse.' }
    },
    {
      q: 'Which is heavier per cubic centimetre (cm³)?',
      a: { label: '🦴 Human bone',   kg: 0.00185, note: 'Cortical bone has a density of ~1.85 g/cm³ — denser than most body tissues.' },
      b: { label: '🧠 Brain tissue', kg: 0.00104, note: 'Brain tissue is ~1.04 g/cm³, just barely denser than water.' }
    },
  ];

  var gameState = { round: 0, score: 0, total: 5, answered: false };
  var gameRounds = [];

  function shuffleArr(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }

  function startGame() {
    gameRounds = shuffleArr(gameQuestions).slice(0, gameState.total);
    gameState.round = 0; gameState.score = 0; gameState.answered = false;
    renderGameRound();
  }

  function renderGameRound() {
    var wrap = document.getElementById('gameWrap');
    if (gameState.round >= gameState.total) { renderGameResult(); return; }
    var q = gameRounds[gameState.round];
    gameState.answered = false;
    wrap.innerHTML =
      '<div class="game-score-row">' +
        '<span class="game-score">Round <span>' + (gameState.round + 1) + '</span> of ' + gameState.total + '</span>' +
        '<span class="game-score">Score: <span>' + gameState.score + '</span></span>' +
      '</div>' +
      '<div class="game-question">' + q.q + '</div>' +
      '<div class="game-choices">' +
        '<button class="game-choice" id="gcA" onclick="pickAnswer(\'a\')">' + q.a.label + '</button>' +
        '<button class="game-choice" id="gcB" onclick="pickAnswer(\'b\')">' + q.b.label + '</button>' +
      '</div>' +
      '<div class="game-feedback" id="gameFeedback"></div>' +
      '<button class="game-next-btn is-hidden" id="gameNextBtn" onclick="nextRound()">Next question →</button>';
  }

  function pickAnswer(pick) {
    if (gameState.answered) return;
    gameState.answered = true;
    var q = gameRounds[gameState.round];
    var tied = (q.a.kg === q.b.kg);
    var correctPick = tied ? null : (q.a.kg > q.b.kg ? 'a' : 'b');
    var isCorrect = tied || (pick === correctPick);

    var btnA = document.getElementById('gcA');
    var btnB = document.getElementById('gcB');
    btnA.disabled = true; btnB.disabled = true;

    if (tied) {
      btnA.classList.add('correct'); btnB.classList.add('correct');
      gameState.score++;
    } else if (pick === 'a') {
      btnA.classList.add(isCorrect ? 'correct' : 'wrong');
      if (!isCorrect) btnB.classList.add('reveal');
    } else {
      btnB.classList.add(isCorrect ? 'correct' : 'wrong');
      if (!isCorrect) btnA.classList.add('reveal');
    }
    if (isCorrect && !tied) gameState.score++;

    var fb = document.getElementById('gameFeedback');
    if (tied) {
      fb.innerHTML = '<strong>Trick question — they\'re equal!</strong> ' + q.a.note;
    } else if (isCorrect) {
      fb.innerHTML = '<strong>Correct! ✓</strong> ' + (pick === 'a' ? q.a.note : q.b.note);
    } else {
      fb.innerHTML = '<strong>Not quite.</strong> ' + (correctPick === 'a' ? q.a.note : q.b.note);
    }
    document.getElementById('gameNextBtn').classList.remove('is-hidden');
  }

  function nextRound() { gameState.round++; renderGameRound(); }

  function renderGameResult() {
    var s = gameState.score, t = gameState.total;
    var msg = s === t ? 'Perfect score! Your weight intuition is sharp.' :
              s >= 4  ? 'Great work — you have a solid sense of weight.' :
              s >= 3  ? 'Good start. Revisit the anchors in Part B to sharpen your intuition.' :
                        'Keep going — weight intuition takes practice. Review Parts A–B and try again.';
    document.getElementById('gameWrap').innerHTML =
      '<div class="game-result">' +
        '<div class="game-result-score">' + s + ' / ' + t + '</div>' +
        '<div class="game-result-msg">' + msg + '</div>' +
        '<button class="game-restart-btn" onclick="startGame()">Play again</button>' +
      '</div>';
  }

  startGame();


  /* ════════════════════════════════════════════════════
     PART G — planet weight calculator
  ════════════════════════════════════════════════════ */
  var planetMassUnit = 'kg';

  const PLANETS = [
    { name: 'Mercury', g: 0.38,  color: '#9E9E9E', note: '38% of Earth gravity' },
    { name: 'Venus',   g: 0.91,  color: '#D4A843', note: '91% of Earth gravity' },
    { name: 'Earth',   g: 1.00,  color: 'var(--accent)', note: 'Your reference' },
    { name: 'Moon',    g: 0.165, color: '#D3D3D3', note: '16.5% of Earth gravity' },
    { name: 'Mars',    g: 0.38,  color: '#C1440E', note: '38% of Earth gravity' },
    { name: 'Jupiter', g: 2.53,  color: '#C88B3A', note: '2.53× Earth gravity' },
    { name: 'Saturn',  g: 1.07,  color: '#B5A26A', note: '107% of Earth gravity' },
    { name: 'Uranus',  g: 0.89,  color: '#7DE8E8', note: '89% of Earth gravity' },
    { name: 'Neptune', g: 1.14,  color: '#5B6FE4', note: '114% of Earth gravity' },
    { name: 'Pluto',   g: 0.063, color: '#6B6B6B', note: '6.3% of Earth gravity' }
  ];

  function setPlanetUnit(u) {
    planetMassUnit = u;
    document.getElementById('pUnitKg').classList.toggle('active', u === 'kg');
    document.getElementById('pUnitLb').classList.toggle('active', u === 'lb');
    renderPlanets();
  }

  function renderPlanets() {
    const mass = parseFloat(document.getElementById('planetMassInput').value);
    if (isNaN(mass) || mass <= 0) return;
    const grid = document.getElementById('planetGrid');
    let html = '';
    PLANETS.forEach(p => {
      const wt = mass * p.g;
      const display = wt >= 1 ? wt.toFixed(1) + ' kg' : (wt * 1000).toFixed(0) + ' g';
      html += `<div class="planet-card">
        <div class="planet-color-bar planet-color-${p.name.toLowerCase()}"></div>
        <div class="planet-card-name">${p.name}</div>
        <div class="planet-card-val">${display}</div>
        <div class="planet-card-sub">${p.note}</div>
      </div>`;
    });
    grid.innerHTML = html;
  }
  renderPlanets();   // initial render

  
</script>
