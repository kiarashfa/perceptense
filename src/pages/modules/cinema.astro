    }

    function buildShotGrid() {
      const grid = document.getElementById('shotGrid');
      shots.forEach((s, i) => {
        const card = document.createElement('div');
        card.className = 'shot-card' + (i === 0 ? ' active' : '');
        const diag = makeShotDiagram(s.diagram);
        card.innerHTML = `<div class="shot-diagram">${diag}</div><div class="shot-label-inner"><div class="shot-name">${s.name}</div><div class="shot-abbr">${s.abbr}</div></div>`;
