        <text x="520" y="150" text-anchor="middle" font-size="10" font-weight="600" fill="var(--color-text-primary)">What's in the frame?</text>
        <text x="520" y="164" text-anchor="middle" font-size="9" fill="var(--color-text-secondary)">Light, colour, staging</text>
        <line x1="460" y1="152" x2="355" y2="168" stroke="var(--color-border-secondary)" stroke-width="1" stroke-dasharray="4,3"/>

        <!-- Node 6: Meaning -->
        <rect x="460" y="240" width="120" height="44" rx="7" fill="var(--color-background-primary)" stroke="var(--color-border-secondary)" stroke-width="1"/>
        <text x="520" y="260" text-anchor="middle" font-size="10" font-weight="600" fill="var(--color-text-primary)">What does it mean?</text>
        <text x="520" y="274" text-anchor="middle" font-size="9" fill="var(--color-text-secondary)">Theme, symbol, subtext</text>
        <line x1="460" y1="262" x2="352" y2="185" stroke="var(--color-border-secondary)" stroke-width="1" stroke-dasharray="4,3"/>

