    const watchLayers = [
      { icon:'fa-cut', label:'Editing', sub:'Pace, rhythm, transitions',
        detail:'Track every cut. Ask: was that cut motivated by movement, eyeline, or emotion? Was it a match cut? A jump cut? Does the editing rhythm change when the scene\'s tension changes? In a dialogue scene, when does the editor choose to cut from the speaker to the listener? That choice is almost never neutral.' },
      { icon:'fa-video', label:'Camera', sub:'Position, movement, lens',
        detail:'Ask: is the camera at eye level, low (making the subject powerful), or high (making the subject small)? Is it moving? How? What lens is being used — a long telephoto lens flattening the space, or a wide-angle lens creating depth and distortion? Every camera position is a point of view and a judgment.' },
      { icon:'fa-sun', label:'Lighting', sub:'Direction, quality, intensity',
        detail:'Where is the light coming from? Is it soft (flattering, naturalistic) or hard (creating strong shadows, chiaroscuro)? Is the light motivated by a source within the scene — a lamp, a window — or is it clearly "film lighting" with no natural source? The ratio between key and fill light determines whether a face reads as warm, natural, or sinister.' },
      { icon:'fa-music', label:'Sound', sub:'Score, effects, silence',
        detail:'Close your eyes for ten seconds of a scene and just listen. What is the sound design telling you that the images are not? When does the music enter — exactly on a cut, or before it? Is there a moment of silence, and what does the silence mean? The scene where Eli Wallach hears his name in the climax of The Good, the Bad and the Ugly is silent for 30 seconds before the music enters. That silence is the scene.' },
      { icon:'fa-palette', label:'Colour', sub:'Palette, saturation, tone',
        detail:'What is the dominant colour palette of this film? Cold blues (isolation, technology, modernity — Fincher\'s films)? Warm ambers (nostalgia, danger, intimacy — Kubrick\'s Barry Lyndon)? Desaturated earth tones (realism, poverty — Dardenne Brothers)? Does the colour change when the scene\'s emotional register changes? Wong Kar-wai uses colour as the primary emotional language of his films.' },
      { icon:'fa-people-arrows', label:'Performance', sub:'Body, face, voice',
        detail:'What is the actor doing with their body — not just their face? Where are their hands? Are they still or in constant motion? Does their voice match what their face is doing? Some of the most powerful acting in cinema history is what actors do NOT do: Paul Newman in The Verdict (1982) barely moves during his closing argument, but the stillness is devastating. Watch for micro-expressions — the brief emotion that crosses a face and disappears.' },
      { icon:'fa-layer-group', label:'Mise-en-scène', sub:'Setting, costume, props',
        detail:'Everything in the frame has been chosen. The production designer decided what the room looks like; the costume designer decided what the character wears; the props master decided what is on the table. Ask: what does this environment say about the character who inhabits it? Why is that specific object in that specific position? Is the frame cluttered (Altman, Gilliam) or spare (Bresson, Haneke)? The density of the mise-en-scène is itself a statement.' },
    ];

    function buildWatchGrid() {
      const grid = document.getElementById('watchGrid');
      watchLayers.forEach((w) => {
        const card = document.createElement('div');
        card.className = 'elem-card';
        card.innerHTML = `<div class="elem-card-icon"><i class="fa-solid ${w.icon}"></i></div><div class="elem-card-label">${w.label}</div><div class="elem-card-sub">${w.sub}</div>`;
        card.onclick = function() {
          const detail = document.getElementById('watchDetail');
          const wasActive = card.classList.contains('active');
          document.querySelectorAll('#watchGrid .elem-card').forEach(c => c.classList.remove('active'));
          if (wasActive) { detail.classList.remove('show'); detail.innerHTML = ''; return; }
          card.classList.add('active');
          detail.innerHTML = `<div style="font-size:13px; font-weight:600; color:var(--color-text-primary); margin-bottom:6px;">${w.label}</div><div style="font-size:12px; color:var(--color-text-secondary); line-height:1.6;">${w.detail}</div>`;
          detail.classList.add('show');
        };
        grid.appendChild(card);
      });
    }

    /* ════════════════════════════════════
       DIFFICULTY CALCULATOR (Part G)
    ════════════════════════════════════ */
    function calcDifficulty() {
      const pace = parseInt(document.getElementById('calcPace').value) || 5;
      const narr = parseInt(document.getElementById('calcNarr').value) || 7;
      const dial = parseInt(document.getElementById('calcDial').value) || 5;
      const p = Math.max(1, Math.min(10, pace));
      const n = Math.max(1, Math.min(10, narr));
      const d = Math.max(1, Math.min(10, dial));
      // Slow editing + fragmented narrative + visual focus = more demanding
      const demandscore = (11 - p) * 0.4 + (11 - n) * 0.4 + (11 - d) * 0.2;
      let label, note;
      if (demandscore < 3.5) {
        label = 'Accessible';
        note = 'Fast pace, clear narrative, and dialogue-driven. This is likely a conventional genre film or mainstream drama. You can follow it without prior film knowledge. Examples at this level: The Dark Knight, The Godfather, Parasite.';
      } else if (demandscore < 5.5) {
        label = 'Moderately demanding';
        note = 'Some unconventional elements — possibly non-linear structure, limited dialogue, or slower editing. Requires attention but not specialist film knowledge. Examples: Eternal Sunshine of the Spotless Mind, 2001: A Space Odyssey, Apocalypse Now.';
      } else if (demandscore < 7.5) {
        label = 'Demanding';
        note = 'Slow pace, complex or fragmented narrative, and a primarily visual language. Rewards patience and active attention. Best approached knowing something about the director\'s style. Examples: Bergman\'s Persona, Tarkovsky\'s Stalker, Kubrick\'s 2001.';
      } else {
        label = 'Very demanding';
        note = 'Extremely slow, highly fragmented or non-narrative, and almost entirely visual. May feel incomprehensible on a first watch without context. Best approached after reading about the film. Examples: Godard\'s Week End, Sokurov\'s Russian Ark, Akerman\'s Jeanne Dielman.';
      }
      document.getElementById('calcOut').innerHTML = `<span style="font-weight:600; color:var(--color-text-primary);">${label}</span> — ${note}`;
    }

    /* ════════════════════════════════════
       REWATCH SLIDER (Part G)
    ════════════════════════════════════ */
    const rewatchData = {
      1: 'First watch: you are tracking the plot, learning who the characters are, and having your first emotional responses. This is the experience the filmmaker primarily designs for. Most of the formal choices are invisible — you are aware only of the story. You experience the film as the filmmaker wants you to, which means you are probably not noticing how it does what it does.',
      2: 'Second watch: knowing how it ends, you can now see the whole film differently. The early scenes look different — foreshadowing becomes visible, red herrings are recognisable, the structure becomes clear. You begin to notice performances on a micro level. You may catch a detail that changes the meaning of an earlier scene. This is the watch on which most films start to become fully comprehensible.',
      3: 'Third watch: you can now start paying attention to specific formal elements — the editing, the camera work, the sound design — because you are no longer following the plot. You will notice a specific cut that you missed before, or a piece of music that you did not consciously register. This is where film literacy begins to develop rapidly.',
      4: 'Fourth watch: formal details become transparent. You may find yourself watching single scenes multiple times (using pause/rewind). You can track the blocking of a long take, note the colour temperature changing across a scene, or follow a piece of background action that the editing never calls attention to. The film becomes richer the more you know it.',
      5: 'Fifth watch and beyond: at this level you are watching a film the way a musician listens to a piece of music they know well — for specific pleasures and details, to trace the logic of choices, to test interpretations. Directors and cinematographers typically do this with films they admire. It is how film criticism is written at its best. Very few films repay this level of scrutiny; the ones that do are the ones that earn the designation "masterpiece."',
    };

    function updateRewatchSlider(val) {
      document.getElementById('rewatchOut').textContent = rewatchData[val];
    }

    /* ════════════════════════════════════
       WATCHLIST (Part G)
    ════════════════════════════════════ */
    function buildWatchlist() {
      const films = [
        { title:'The Godfather', year:1972, dir:'Coppola', diff:1, note:'The most accessible masterpiece — classical narrative, towering performances, invisible technique.' },
        { title:'Rear Window', year:1954, dir:'Hitchcock', diff:1, note:'Pure cinema: one room, one window, pure suspense. Studies how cinema controls attention.' },
        { title:'Tokyo Story', year:1953, dir:'Ozu', diff:2, note:'The most heartbreaking film ever made, using the most restrained means. Requires patience.' },
        { title:'GoodFellas', year:1990, dir:'Scorsese', diff:1, note:'Scorsese\'s formal virtuosity most visible: editing, music, camera movement as argument.' },
        { title:'The Seventh Seal', year:1957, dir:'Bergman', diff:2, note:'Bergman\'s most accessible film — allegory on death, meaning, and faith.' },
        { title:'Bicycle Thieves', year:1948, dir:'De Sica', diff:1, note:'The founding Neorealist text. Devastating simplicity. 93 minutes.' },
        { title:'2001: A Space Odyssey', year:1968, dir:'Kubrick', diff:3, note:'Rewards patience absolutely. The last 20 minutes require surrender, not analysis.' },
        { title:'Breathless', year:1960, dir:'Godard', diff:2, note:'The film that broke Hollywood grammar. Watch it twice.' },
        { title:'Chinatown', year:1974, dir:'Polanski', diff:1, note:'Perfect genre film and perfect genre deconstruction simultaneously.' },
        { title:'In the Mood for Love', year:2000, dir:'Wong Kar-wai', diff:2, note:'Almost entirely constructed from mood, colour, and what is not said.' },
        { title:'Stalker', year:1979, dir:'Tarkovsky', diff:4, note:'160 minutes. Almost no plot. Requires a prepared mind. Rewards it completely.' },
        { title:'Persona', year:1966, dir:'Bergman', diff:3, note:'Psychologically dissolving. The opening sequence alone is a film course.' },
        { title:'Battleship Potemkin', year:1925, dir:'Eisenstein', diff:2, note:'The Odessa Steps sequence is the greatest editing exercise in film history.' },
        { title:'Parasite', year:2019, dir:'Bong Joon-ho', diff:1, note:'The most precise piece of genre screenwriting in decades. Accessible and profound.' },
        { title:'Close-Up', year:1990, dir:'Kiarostami', diff:3, note:'Documentary and fiction simultaneously. The most ethical film about cinema ever made.' },
      ];
      const colors = { 1: '#E1F5EE', 2: '#FAEEDA', 3: '#E6F1FB', 4: '#FCEBEB' };
      const textColors = { 1: '#085041', 2: '#633806', 3: '#0C447C', 4: '#791F1F' };
      const diffLabels = { 1: 'Accessible', 2: 'Moderate', 3: 'Demanding', 4: 'Very demanding' };
      const grid = document.getElementById('watchlistGrid');
      films.forEach(f => {
        const card = document.createElement('div');
        card.style.cssText = `background:var(--color-background-primary); border:0.5px solid var(--color-border-tertiary); border-radius:var(--border-radius-lg); padding:11px 13px; display:flex; flex-direction:column; gap:4px;`;
        card.innerHTML = `
          <div style="font-size:12px; font-weight:600; color:var(--color-text-primary);">${f.title}</div>
          <div style="font-size:11px; color:var(--color-text-tertiary);">${f.year} · ${f.dir}</div>
          <div style="font-size:10px; font-weight:600; background:${colors[f.diff]}; color:${textColors[f.diff]}; border-radius:99px; padding:1px 7px; display:inline-block; width:fit-content;">${diffLabels[f.diff]}</div>
          <div style="font-size:11px; color:var(--color-text-secondary); line-height:1.4; margin-top:2px;">${f.note}</div>`;
        grid.appendChild(card);
      });
    }

    /* ════════════════════════════════════
       INIT
    ════════════════════════════════════ */
    window.addEventListener('DOMContentLoaded', function() {
      buildShotGrid();
