        <text x="300" y="167" text-anchor="middle" font-size="10" font-weight="700" fill="var(--accent)">THE FILM</text>
        <text x="300" y="180" text-anchor="middle" font-size="9" fill="var(--accent)">any scene</text>

        <!-- Node 1: What did you feel -->
        <rect x="20" y="20" width="120" height="44" rx="7" fill="var(--color-background-primary)" stroke="var(--color-border-secondary)" stroke-width="1"/>
        <text x="80" y="40" text-anchor="middle" font-size="10" font-weight="600" fill="var(--color-text-primary)">What did you feel?</text>
        <text x="80" y="54" text-anchor="middle" font-size="9" fill="var(--color-text-secondary)">Start with the emotion</text>
        <line x1="140" y1="42" x2="247" y2="152" stroke="var(--color-border-secondary)" stroke-width="1" stroke-dasharray="4,3"/>

