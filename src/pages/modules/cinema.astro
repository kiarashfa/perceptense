        card.onclick = function() {
          const detail = document.getElementById('genreDetail');
          const wasActive = card.classList.contains('active');
          document.querySelectorAll('#genreGrid .elem-card').forEach(c => c.classList.remove('active'));
          if (wasActive) { detail.classList.remove('show'); detail.innerHTML = ''; return; }
          card.classList.add('active');
          detail.innerHTML = `<div style="font-size:13px; font-weight:600; color:var(--color-text-primary); margin-bottom:6px;">${g.label}</div><div style="font-size:12px; color:var(--color-text-secondary); line-height:1.6;">${g.detail}</div>`;
          detail.classList.add('show');
        };
        grid.appendChild(card);
      });
    }

