          <div style="font-size:11px; font-weight:500; background:${s.bg}; color:${s.col}; border-radius:99px; padding:2px 9px;">shot type</div>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); gap:10px;">
          <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:9px 11px;"><div style="font-size:11px; color:var(--color-text-secondary); margin-bottom:2px;">What it is</div><div style="font-size:12px; color:var(--color-text-primary); line-height:1.5;">${s.what}</div></div>
          <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:9px 11px;"><div style="font-size:11px; color:var(--color-text-secondary); margin-bottom:2px;">When to use it</div><div style="font-size:12px; color:var(--color-text-primary); line-height:1.5;">${s.when}</div></div>
          <div style="background:var(--color-background-secondary); border-radius:var(--border-radius-md); padding:9px 11px;"><div style="font-size:11px; color:var(--color-text-secondary); margin-bottom:2px;">Examples</div><div style="font-size:12px; color:var(--color-text-primary); line-height:1.5;">${s.examples}</div></div>
