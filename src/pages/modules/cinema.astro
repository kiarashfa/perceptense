    /* ════════════════════════════════════
       ASPECT RATIO VISUALISER (Part A)
    ════════════════════════════════════ */
    const aspectRatios = [
      { label:'1.33:1 (4:3)', w:133, h:100, ratio:'4:3 (Academy)',
        desc:'The original film ratio from the silent era, standardised by the Academy in 1932. Also the ratio of television until widescreen. Roughly square — feels intimate, theatrical. Still used deliberately (The Artist, Beau Is Afraid) for nostalgic or claustrophobic effect.' },
      { label:'1.66:1', w:166, h:100, ratio:'1.66:1 (European wide)',
        desc:'A mild widescreen used commonly in European cinema. Slightly wider than the Academy ratio. Used by many French New Wave films and Italian features. Feels cinematic without the panoramic quality of wider ratios.' },
      { label:'1.85:1', w:185, h:100, ratio:'1.85:1 (US flat wide)',
        desc:'The standard American theatrical widescreen format since the 1950s. The most common film ratio in Hollywood. Wide enough to feel cinematic, not so extreme it demands a truly panoramic image. The "normal" cinema experience.' },
      { label:'2.39:1', w:239, h:100, ratio:'2.39:1 (CinemaScope)',
        desc:'The "Scope" format — extremely wide, requiring an anamorphic lens. Used for epics, Westerns, and science fiction where landscape is as important as characters. Lawrence of Arabia, 2001, Once Upon a Time in Hollywood. The widest mainstream theatrical format.' },
      { label:'2.76:1 (Ultra Panavision)', w:276, h:100, ratio:'2.76:1 (Ultra Panavision)',
        desc:'The widest mainstream commercial format, used for truly panoramic images. Ben-Hur (1959), The Hateful Eight (Tarantino, 2015 — a deliberate anachronism). The image is so wide that close-ups fill the entire frame with the subject\'s head, creating a radically different sense of scale.' },
    ];

    function buildARButtons() {
      const wrap = document.getElementById('arButtons');
      aspectRatios.forEach((ar, i) => {
        const btn = document.createElement('button');
        btn.textContent = ar.ratio;
        btn.style.cssText = 'font-size:11px; padding:3px 10px;';
        btn.onclick = (e) => renderAR(i, e.currentTarget);
        wrap.appendChild(btn);
      });
    }

    function renderAR(idx, btn) {
      document.querySelectorAll('#arButtons button').forEach(b => {
        b.style.background = '';
        b.style.fontWeight = 'normal';
      });
      if (btn) { btn.style.background = 'var(--color-background-secondary)'; btn.style.fontWeight = '600'; }
      const ar = aspectRatios[idx];
      const maxW = 260;
      const scale = maxW / ar.w;
      const dW = Math.round(ar.w * scale);
      const dH = Math.round(ar.h * scale);
      document.getElementById('arFrame').style.width = dW + 'px';
      document.getElementById('arFrame').style.height = dH + 'px';
      document.getElementById('arLabel').textContent = ar.ratio;
      document.getElementById('arDesc').textContent = ar.desc;
    }

    /* ════════════════════════════════════
       EDITING TYPES EXPLORER (Part B)
    ════════════════════════════════════ */
    const editTypes = {
      'Continuity': { title:'Continuity editing', body:'The dominant Hollywood system. Its goal is invisibility: the viewer should not notice cuts because each cut is motivated by character eyeline, movement, or spatial logic. The 180-degree rule, match cuts, and shot/reverse-shot patterns all serve continuity. Developed by D.W. Griffith (1910-1920) and codified by the studio system. The great classical Hollywood editors — Margaret Booth, Dede Allen, Thelma Schoonmaker — are practitioners of continuity. The cut should feel inevitable.' },
      'Montage': { title:'Soviet montage', body:'Developed by Eisenstein, Pudovkin, and Kuleshov in the 1920s. The Kuleshov effect: if you cut from a close-up of a man\'s expressionless face to an image of food, a corpse, or a child, viewers project hunger, grief, or tenderness onto the face — demonstrating that meaning is created between shots, not within them. Eisenstein\'s Battleship Potemkin (1925) is the canonical example: the Odessa Steps sequence creates violent rhythm through non-continuous, conflicting edits.' },
      'Jump cut': { title:'Jump cut', body:'A cut between two shots of the same subject at slightly different angles or framings, creating a visual "jump." Violates the 30-degree rule (cuts must change the angle by at least 30 degrees or the shot size significantly). Felt as jarring when continuity editing is the norm. Godard used it deliberately in À bout de souffle (1960) to create a fragmentary, unsettled feel. Since then it has become acceptable as a stylistic choice, though it still signals self-consciousness.' },
      'Cross-cutting': { title:'Cross-cutting (parallel editing)', body:'Cutting between two or more spatially separate actions to imply they are occurring simultaneously. Griffith developed this technique to build suspense — cutting between a woman in danger and her rescuers racing to reach her. The Last Minute Rescue. Modern action cinema depends entirely on cross-cutting; the climax of virtually every superhero film is three parallel events being intercut toward a single resolution. Time is elastic under cross-cutting: the audience accepts that "simultaneous" events take wildly different screen durations.' },
      'Match cut': { title:'Match cut', body:'A cut that connects two different images by matching a visual element — shape, movement, or sound — creating a graphic or conceptual rhyme. The most famous is Kubrick\'s bone-to-satellite cut in 2001: A Space Odyssey: a bone thrown into the air dissolves to an orbiting spacecraft, compressing 4 million years of human evolution into a single edit. Nicolas Roeg and Terrence Malick built entire films around associative match cuts. The technique can connect wildly disparate spaces and times through a shared visual logic.' },
      'Graphic match': { title:'Graphic match', body:'A match cut based purely on visual shape or colour rather than narrative connection. Eisenstein theorised this as part of "overtonal" montage — the cut produces an aesthetic resonance. A spinning coin cuts to a spinning wheel; a red dress in one scene cuts to a red car in another. Wes Anderson is a contemporary master: his symmetrical compositions create graphic matches across entire films. The graphic match is a signature of formally conscious cinema.' },
    };

    function buildEditTabs() {
      const wrap = document.getElementById('editTabs');
      let first = true;
      for (const key in editTypes) {
        const btn = document.createElement('button');
        btn.className = 'mov-tab' + (first ? ' active' : '');
        btn.textContent = key;
        btn.onclick = function() {
          document.querySelectorAll('#editTabs .mov-tab').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          showEditPanel(key);
        };
        wrap.appendChild(btn);
        if (first) { showEditPanel(key); first = false; }
      }
    }

    function showEditPanel(key) {
      const d = editTypes[key];
      document.getElementById('editPanel').innerHTML = `<div style="font-size:13px; font-weight:600; color:var(--color-text-primary); margin-bottom:6px;">${d.title}</div><div style="font-size:12px; color:var(--color-text-secondary); line-height:1.6;">${d.body}</div>`;
    }

    /* ════════════════════════════════════
       CAMERA MOVEMENT GRID (Part B)
    ════════════════════════════════════ */
    const camMoves = [
      { icon:'fa-arrows-up-down', label:'Tilt', sub:'Up/down on vertical axis',
        detail:'The camera rotates vertically on its mount. Tilt up to reveal height (a skyscraper, a giant); tilt down to show a character\'s diminishment or reveal something on the ground. The slow tilt up Spielberg uses to reveal the shark in Jaws. The tilt creates a feeling of vertical discovery — revealing what was previously outside the frame.' },
      { icon:'fa-arrows-left-right', label:'Pan', sub:'Left/right on horizontal axis',
        detail:'The camera rotates horizontally on its mount. A pan follows a moving subject (a person walking) or reveals a space. The "whip pan" — an extremely fast pan that blurs the image — is used as an energetic transition. Edgar Wright (Hot Fuzz, Scott Pilgrim) uses whip pans as punctuation. The pan is perhaps the most natural camera movement — like turning your head to follow something.' },
      { icon:'fa-right-long', label:'Track/Dolly', sub:'Camera moves through space',
        detail:'The camera is mounted on a dolly (wheeled cart) and physically moves along a track. This creates parallax — the sense that you are moving through three-dimensional space, not just rotating. The "dolly-in" advances toward a subject to increase intensity; the "dolly-out" pulls back to create distance or isolation. Max Ophüls and Stanley Kubrick are masters of the tracking shot. The opening of Touch of Evil (Welles, 1958) is a single three-minute tracking shot.' },
      { icon:'fa-up-long', label:'Crane', sub:'Camera rises through space',
        detail:'The camera is mounted on a crane arm and moves vertically through space. A crane shot lifts away from a scene to reframe it in a wider context — or descends from wide to intimate. The "God\'s-eye" view from a crane above a character signals fate or surveillance. Hitchcock used crane shots in Vertigo and Psycho; the final shot of The Third Man (Reed, 1949) ends with a long wait and a walk toward camera that is intensified by the slight high angle.' },
      { icon:'fa-circle', label:'Steadicam', sub:'Smooth handheld movement',
        detail:'A stabilised camera system (invented by Garrett Brown in 1975) that allows smooth movement without a dolly track. Kubrick used it for the long tracking shots through the Overlook Hotel corridors in The Shining. Scorsese used it for the Copa shot in Goodfellas (1990) — a three-minute tracking shot following Ray Liotta through the back entrance of a nightclub. The Steadicam feels more fluid and immersive than dolly, less jittery than handheld.' },
      { icon:'fa-hand', label:'Handheld', sub:'Unsteadied, kinetic',
        detail:'The camera is held on the shoulder or in the operator\'s hands, creating organic, unplanned movement. In its raw form (cinéma vérité, documentary), handheld signals authenticity, immediacy, and instability. Cassavetes used handheld for intimate drama. The Dardenne Brothers (Rosetta, L\'Enfant) use close handheld pursuit to create intense identification with characters. The Bourne Identity popularised a chaotic action-handheld that has since become cinematically clichéd.' },
      { icon:'fa-video', label:'Zoom', sub:'Optical, not physical movement',
        detail:'Unlike a dolly, a zoom changes the focal length of the lens rather than moving the camera body. The zoom-in does not create parallax — it magnifies a flat image, producing a distinctly different feeling from a dolly: more surveillance-like, more analytical. Robert Altman used zoom extensively in his 1970s films (Nashville, McCabe and Mrs Miller) to create an observational, anthropological distance. The "reverse zoom" (Hitchcock zoom or dolly zoom) — pulling the camera back while zooming in — was developed for Vertigo to create a physical sensation of dizziness.' },
    ];

    function buildCamGrid() {
      const grid = document.getElementById('camGrid');
      camMoves.forEach((m, i) => {
        const card = document.createElement('div');
        card.className = 'elem-card';
        card.innerHTML = `<div class="elem-card-icon"><i class="fa-solid ${m.icon}"></i></div><div class="elem-card-label">${m.label}</div><div class="elem-card-sub">${m.sub}</div>`;
        card.onclick = function() {
          const detail = document.getElementById('camDetail');
          const wasActive = card.classList.contains('active');
          document.querySelectorAll('#camGrid .elem-card').forEach(c => c.classList.remove('active'));
          if (wasActive) { detail.classList.remove('show'); detail.innerHTML = ''; return; }
          card.classList.add('active');
          detail.innerHTML = `<div style="font-size:13px; font-weight:600; color:var(--color-text-primary); margin-bottom:6px;">${m.label}</div><div style="font-size:12px; color:var(--color-text-secondary); line-height:1.6;">${m.detail}</div>`;
          detail.classList.add('show');
        };
        grid.appendChild(card);
      });
    }

    /* ════════════════════════════════════
       SOUND SLIDER (Part B)
    ════════════════════════════════════ */
    const soundLevels = {
      1: { label:'Fully diegetic', text:'Sound that exists within the world of the film — dialogue, footsteps, ambient noise, a radio playing in the scene. Characters can hear it. When Walter Neff\'s voice-over narrates in Double Indemnity, the background traffic is diegetic. The rain on a window. A door slamming. Diegetic sound anchors us in the physical reality of the film\'s world.' },
      2: { label:'Internal diegetic', text:'Sound that is heard by a character but not physically present — a memory, an imagined sound, a ringing in the ears. Apocalypse Now uses internal diegetic when Willard hears voices and music during his breakdown in Saigon. Tinnitus after the gunshot. This blurs the line between character psychology and objective reality.' },
      3: { label:'Ambient / transitional', text:'Environmental sound that is clearly from the scene\'s world but processed, heightened, or extended beyond realism. The Coen Brothers use this constantly — wind, insects, silence that is unnaturally still. Nino Rota\'s approach to ambient music in Fellini films. Sound that is technically diegetic but has been made aesthetically expressive by the sound designer.' },
      4: { label:'Score (leitmotif)', text:'Non-diegetic music — characters cannot hear it; only the audience can. Used to signal emotions, foreshadow events, or identify characters (a leitmotif). Bernard Herrmann\'s strings in Psycho, John Williams\'s shark theme in Jaws. The score tells you how to feel. Bresson famously refused all non-diegetic music — he considered it manipulative. Kubrick used existing classical recordings as score to avoid that manipulated feeling.' },
      5: { label:'Fully non-diegetic', text:'Sound that belongs entirely to the cinematic apparatus — the audience\'s experience — and has no presence in the film\'s world. A voice-over narration that is clearly retrospective. A sound bridge that carries over from the previous scene as comment. The scored silence of a Tarkovsky sequence where the absence of music is as expressive as its presence would be.' },
    };

    function updateSoundSlider(val) {
      const d = soundLevels[val];
      document.getElementById('soundOut').innerHTML = `<span style="font-weight:600; color:var(--color-text-primary);">${d.label}:</span> ${d.text}`;
    }

    /* ════════════════════════════════════
       MOVEMENTS EXPLORER (Part C)
    ════════════════════════════════════ */
    const movements = {
      'Silent': { title:'Silent Cinema (1895-1927)',
        body:'Cinema without synchronised sound was not simply a technological limitation — it developed a visual language of extraordinary sophistication that sound cinema partly abandoned. Griffith invented the grammar of continuity editing (Birth of a Nation, 1915; Intolerance, 1916). Chaplin and Keaton refined physical performance. German Expressionism (The Cabinet of Dr Caligari, Nosferatu) used distorted sets and extreme shadows to externalise psychological states. The Soviet avant-garde (Eisenstein, Vertov) treated the frame as a unit of political argument. The arrival of sound in The Jazz Singer (1927) was technologically irreversible but aesthetically regressive — early talkies were static, theatre-bound, because microphones could not move.' },
      'Neorealism': { title:'Italian Neorealism (1944-1952)',
        body:'Born from the wreckage of Fascist spectacle cinema and World War II, Italian Neorealism was a deliberate counter-programme: non-professional actors (often people playing versions of themselves), real locations (bombed streets, actual slums) instead of studio sets, and stories about the poverty and dislocation of ordinary Italians. Rossellini\'s Rome, Open City (1945) was partly funded by black-market money and shot in the streets of occupied Rome. De Sica\'s Bicycle Thieves (1948) used a real factory worker as its lead and cost almost nothing. The movement established the aesthetic vocabulary of "realism" in cinema that influenced everything from the French New Wave to contemporary social cinema.' },
      'New Wave': { title:'French New Wave (1958-1968)',
        body:'The Cahiers du Cinéma critics — Truffaut, Godard, Chabrol, Rivette, Rohmer — became filmmakers, armed with cheap cameras, small crews, location sound, and a theoretical framework. They violated Hollywood grammar deliberately: jump cuts (Breathless), direct address (characters look at the camera), discontinuous narrative (Last Year at Marienbad), documentary intrusion into fiction. Their films were cheap enough to make that failure was survivable. Godard\'s Week End (1967) ends with text reading "End of Cinema." The New Wave established that a film could be simultaneously a commercial release and a philosophical argument about cinema itself.' },
      'New Hollywood': { title:'New Hollywood (1967-1980)',
        body:'The collapse of the studio system\'s contract model, the death of the Hays Code (replaced by the MPAA rating system in 1968), and a film-school generation that had studied the Europeans created a brief window in which the major studios funded deeply personal, formally ambitious, commercially unpredictable films. Bonnie and Clyde (1967), Easy Rider (1969), The Godfather (1972), Chinatown (1974), Taxi Driver (1976), Apocalypse Now (1979). Directors were given creative control they would not see again after 1980. The movement ended when Heaven\'s Gate (1980) bankrupted United Artists and demonstrated the financial risk of auteur filmmaking at scale.' },
      'Dogme 95': { title:'Dogme 95 (1995-2005)',
        body:'Lars von Trier and Thomas Vinterberg\'s 1995 "Vow of Chastity" manifesto demanded filmmaking stripped of all artifice: no added music, location sound only, handheld camera only, no genre films, no superficial action. The rules were more provocation than programme — von Trier himself violated most of them in his own films — but Vinterberg\'s Festen (The Celebration, 1998), shot on a consumer digital camera, was a genuine masterpiece. Dogme forced the industry to confront the aesthetic possibilities of cheap digital video at a moment when Hollywood was becoming ever more expensive and spectacular.' },
      'Digital / Global': { title:'Contemporary digital and global cinema (2000-now)',
        body:'Digital cinema dissolved many of the economic barriers to production. A film like Tangerine (Sean Baker, 2015), shot on an iPhone, cost $100,000 and played Sundance. Streaming has created new exhibition contexts and funding models. South Korean cinema broke into global awareness (Parasite, 2019). Romanian New Wave (Cristian Mungiu, Cristi Puiu) produced some of the most formally rigorous films in contemporary cinema. The boundary between documentary and fiction has dissolved — Joshua Oppenheimer\'s The Act of Killing (2012) is categorically unclassifiable. The dominant tendency is fragmentation: there is no single movement, only dozens of simultaneous and distinct practices.' },
    };

    function buildMovTabs() {
      const wrap = document.getElementById('movTabs');
      let first = true;
      for (const key in movements) {
        const btn = document.createElement('button');
        btn.className = 'mov-tab' + (first ? ' active' : '');
        btn.textContent = key;
        btn.onclick = function() {
          document.querySelectorAll('#movTabs .mov-tab').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          showMovPanel(key);
        };
        wrap.appendChild(btn);
        if (first) { showMovPanel(key); first = false; }
      }
    }

    function showMovPanel(key) {
      const d = movements[key];
      document.getElementById('movPanel').innerHTML = `<div style="font-size:13px; font-weight:600; color:var(--color-text-primary); margin-bottom:6px;">${d.title}</div><div style="font-size:12px; color:var(--color-text-secondary); line-height:1.6;">${d.body}</div>`;
    }

    /* ════════════════════════════════════
       AUTEUR CAREER TIMELINE (Part C)
    ════════════════════════════════════ */
    function buildAuteurTimeline() {
      const auteurs = [
        { label:'Chaplin', start:1914, end:1967, col:'#F1EFE8', text:'#444' },
        { label:'Hitchcock', start:1925, end:1976, col:'#FAEEDA', text:'#633806' },
        { label:'Bergman', start:1946, end:2003, col:'#FCEBEB', text:'#791F1F' },
        { label:'Kubrick', start:1953, end:1999, col:'#E6F1FB', text:'#0C447C' },
        { label:'Godard', start:1960, end:2018, col:'#EEEDFE', text:'#533489' },
        { label:'Tarkovsky', start:1962, end:1986, col:'#E1F5EE', text:'#085041' },
        { label:'Scorsese', start:1967, end:2024, col:'#EAF3DE', text:'#27500A' },
        { label:'Wong Kar-wai', start:1988, end:2024, col:'#FAEEDA', text:'#633806' },
      ];
      const minY = 1910, maxY = 2025, range = maxY - minY;
      const axisDiv = document.createElement('div');
      axisDiv.className = 'pc-axis';
      [1910,1940,1960,1980,2000,2025].forEach(y => {
        const span = document.createElement('span');
        span.className = 'pc-axis-mark';
        span.style.left = ((y - minY) / range * 100) + '%';
        span.textContent = y;
        axisDiv.appendChild(span);
      });
      const wrap = document.getElementById('auteurTimeline');
      wrap.appendChild(axisDiv);
      auteurs.forEach(a => {
        const row = document.createElement('div');
        row.className = 'pc-row';
        const lbl = document.createElement('div');
        lbl.className = 'pc-label';
        lbl.textContent = a.label;
        const track = document.createElement('div');
        track.className = 'pc-track';
        const fill = document.createElement('div');
        fill.className = 'pc-fill';
        fill.style.left = ((a.start - minY) / range * 100) + '%';
        fill.style.width = ((a.end - a.start) / range * 100) + '%';
        fill.style.background = a.col;
        const flabel = document.createElement('span');
        flabel.className = 'pc-fill-label';
        flabel.style.color = a.text;
        flabel.textContent = a.start + '-' + a.end;
        fill.appendChild(flabel);
        track.appendChild(fill);
        row.appendChild(lbl);
        row.appendChild(track);
        wrap.appendChild(row);
      });
    }

    /* ════════════════════════════════════
       GENRE EXPLORER (Part D)
    ════════════════════════════════════ */
    const genres = [
      { icon:'fa-gun', label:'Western', sub:'1900-present',
        detail:'The Western is America\'s mythological form — the founding narrative of conquest, civilisation, and frontier violence. Its iconography (the lone gunslinger, the frontier town, Monument Valley) was standardised by John Ford in the 1930s-1950s. Its conventions include the confrontation between individual honour and institutional corruption, and the ambiguous relationship between violence and justice. The "revisionist Western" (McCabe and Mrs Miller, Unforgiven, No Country for Old Men) systematically dismantles the classical Western\'s moral universe. The Western is also where genre ideology is most visible: classic Westerns consistently encode the extermination of Native Americans as civilisational progress.' },
      { icon:'fa-moon', label:'Noir / Neo-noir', sub:'1940s-present',
        detail:'Film noir (named by French critics retrospectively) is a visual style and moral universe before it is a genre: low-key lighting, deep shadows, night settings, morally compromised protagonists, and femmes fatales. It emerged from German Expressionist cinematographers (Billy Wilder\'s Double Indemnity, 1944) working in Hollywood after fleeing Nazism. Its formal signature — chiaroscuro, rain-soaked streets, venetian-blind shadows across faces — expressed post-war American anxiety about masculinity, sexuality, and institutional corruption. Neo-noir (Chinatown, Blade Runner, Mulholland Drive) extends the visual grammar to new moral territories.' },
      { icon:'fa-skull', label:'Horror', sub:'1920s-present',
        detail:'Horror is the genre most directly linked to the social unconscious of its moment. Expressionist horror (Nosferatu, 1922; Frankenstein, 1931) processed fears of technology and the irrational. 1950s horror encoded Cold War nuclear anxiety. Slasher films (Halloween, 1978; A Nightmare on Elm Street, 1984) emerged from post-Vietnam anxieties about violence in the suburban home. "Elevated horror" (Hereditary, Midsommar, Get Out) uses horror vocabulary for psychological and social themes that cannot be approached frontally. Horror is uniquely efficient: it costs little, targets specific demographic anxieties, and can achieve intense emotional effects with formal simplicity.' },
      { icon:'fa-rocket', label:'Science Fiction', sub:'1902-present',
        detail:'Science fiction begins with Méliès\'s A Trip to the Moon (1902) and reaches its peak sophistication in Kubrick\'s 2001: A Space Odyssey (1968) and the work of directors like Ridley Scott (Blade Runner, 1982), Denis Villeneuve (Arrival, 2016), and Andrei Tarkovsky (Solaris, 1972). The genre\'s primary function is estrangement: using technological or cosmic speculation to defamiliarise the present. Blade Runner is about 1982 Los Angeles (capitalism, immigration, authenticity) dressed as 2019 Los Angeles. The best science fiction films are always about now.' },
      { icon:'fa-masks-theater', label:'Melodrama', sub:'1910s-present',
        detail:'Melodrama — "drama with music," exaggerated emotional expression, clearly delineated moral stakes — was long dismissed as a low form. Rainer Werner Fassbinder and Douglas Sirk (All That Heaven Allows, 1955; Written on the Wind, 1956) elevated it into critical respectability by using its conventions self-consciously to expose class, race, and gender ideology. Todd Haynes\'s Far from Heaven (2002) is a Sirkian melodrama that is simultaneously an analysis of 1950s repression. Melodrama\'s emotional excess is not a failure of realism; it is a different representational mode with its own logic.' },
      { icon:'fa-person-falling', label:'Action / Thriller', sub:'1960s-present',
        detail:'Action cinema is the dominant commercial genre of contemporary Hollywood: spectacle, kinesis, physical consequences, and a protagonist who solves problems through physical agency. At its best (The Raid, 2011; Mad Max: Fury Road, 2015; John Wick, 2014), action cinema achieves genuine formal virtuosity in choreographing bodies through space and time. At its worst it is incoherent rapid-cut spectacle that provides stimulation without sensation. The distinction is almost always a function of spatial clarity: can the viewer follow where bodies are in space? Christopher Nolan and Paul Greengrass represent opposite answers.' },
      { icon:'fa-baby', label:'Animation', sub:'1908-present',
        detail:'Animation is not a genre but a technique — and arguably the most formally free category in cinema, since it is not constrained by the physics of the real world. The Disney studio defined the "classical" animation aesthetic (Snow White, 1937; Bambi, 1942). Japanese animation (Studio Ghibli, Miyazaki) achieved a different aesthetic tradition. Contemporary animation ranges from the photorealist CGI of Pixar to the hand-drawn lyricism of Isao Takahata\'s The Tale of Princess Kaguya (2013). The best animated films for adults — Waltz with Bashir (2008), Persepolis (2007) — use the technique\'s expressive freedom for subject matter that live action would handle differently.' },
      { icon:'fa-music', label:'Musical', sub:'1927-present',
        detail:'The musical is cinema\'s most overtly unrealistic genre: characters spontaneously sing and dance in situations where real people would not. Its foundational convention — the "number," a self-contained song-and-dance sequence — requires audiences to suspend narrative plausibility for aesthetic pleasure. The MGM musical (Singin\' in the Rain, 1952; An American in Paris, 1951) treated numbers as total cinema: Gene Kelly\'s choreography, Vincente Minnelli\'s colour cinematography, and Freed Unit production design created integrated spectacles. The recent revival (La La Land, 2016; Tick, Tick... Boom!, 2021) treats the genre\'s artifice self-consciously.' },
    ];

