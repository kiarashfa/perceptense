    <!-- Film analysis schematic / decision tree SVG -->
    <div class="scroll-panel">
      <div class="panel-title">The analyst's loop — a framework for reading any film</div>
      <svg class="cinema-media" viewBox="0 0 600 340" xmlns="http://www.w3.org/2000/svg">
