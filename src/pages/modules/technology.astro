        var left = ((row.start - minYear) / span) * 100;
        var width = ((row.end - row.start) / span) * 100;
        var tiny = width < 3;
        return '<div class="period-row"><div class="pc-label">' + row.label + '</div>'
          + '<div class="pc-track"><div class="pc-fill' + (tiny ? ' pc-fill-tiny' : '') + '" style="left:' + left.toFixed(2) + '%; width:' + width.toFixed(2) + '%; background:' + row.bg + '; color:' + row.col + ';">'
