    /* CYBERSECURITY EXPLORER */
    var secData = {
      phishing:   { title: 'Phishing', body: 'An attacker sends a convincing fake email to trick recipients into clicking a malicious link or entering credentials. Spear phishing targets specific individuals with personalised detail. Over 80% of cyberattacks begin with a phishing email. The 2020 Twitter hack, which compromised Barack Obama and Elon Musk\'s accounts, began with a phone call to a Twitter employee pretending to be IT support. The strongest defence is phishing-resistant authentication such as passkeys or hardware security keys.', tag: 'Social Engineering' },
      ransomware: { title: 'Ransomware', body: 'Malware that encrypts a victim\'s files and demands payment in cryptocurrency for the decryption key. WannaCry (2017) spread via a stolen NSA exploit and encrypted 230,000 computers in 150 countries in four days, including a third of NHS trusts in the UK. The Colonial Pipeline attack (2021) shut down fuel supply to the US East Coast for six days. Backups help only if they are offline, tested, and restorable. Ransomware-as-a-Service platforms allow non-technical criminals to deploy sophisticated attacks for a revenue share.', tag: 'Malware' },
      ddos:       { title: 'DDoS — overwhelm capacity', body: 'A distributed denial-of-service attack floods a service with traffic from many machines, often compromised devices. It does not need to break in; it just needs to make legitimate access impossible. The 2016 Mirai botnet attack used 600,000 compromised IoT devices (security cameras, routers) to knock offline major websites including Twitter, Netflix, and Reddit by targeting DNS provider Dyn. Defence uses filtering, rate limits, anycast networks, traffic scrubbing, and enough spare capacity that the flood becomes expensive for the attacker.', tag: 'Attack' },
      supply:     { title: 'Supply chain attacks — compromise trust upstream', body: 'Modern software imports thousands of packages, containers, build tools, and vendor services. A supply chain attack poisons something trusted so many downstream targets install the problem themselves. The SolarWinds breach (2020) showed how a signed software update could become a delivery vehicle for espionage, compromising US Treasury, State Department, and NSA networks. The npm/PyPI ecosystems are attacked hundreds of times per year through typosquatting and malicious package uploads.', tag: 'Attack' },
      sqli:       { title: 'SQL Injection', body: 'A technique that manipulates database queries by injecting SQL code through user input fields. If a login form constructs the query "SELECT * FROM users WHERE username=\'[input]\'" without sanitisation, entering username: \' OR \'1\'=\'1 bypasses authentication entirely. SQL injection caused the 2009 Heartland Payment Systems breach (130 million credit cards), one of the largest data breaches in history. Parameterised queries prevent it entirely — this vulnerability should not exist in new code.', tag: 'Code Injection' },
      tls:        { title: 'TLS Encryption (HTTPS)', body: 'Transport Layer Security uses asymmetric cryptography (RSA or elliptic curve) to establish a shared secret, then switches to symmetric encryption (AES) for speed. Your browser gets the server\'s public key from its certificate, verifies the certificate was signed by a trusted authority, generates a random session key, encrypts it with the server\'s public key, and sends it. Only the server can decrypt it. All subsequent traffic is encrypted and authenticated. TLS 1.3 (2018) made this faster and eliminated several historical vulnerabilities.', tag: 'Defence' },
      mfa:        { title: 'Multi-factor authentication', body: 'Authentication factors are something you know (password), something you have (phone), and something you are (biometric). Adding a second factor makes credential theft useless: even if an attacker has your password, they can\'t log in without your phone. TOTP apps generate 6-digit codes that change every 30 seconds via a shared secret. Hardware keys (YubiKey, FIDO2) are phishing-resistant because they cryptographically bind authentication to the specific website domain. Google\'s mandatory TOTP rollout reduced account takeovers by 99.7%.', tag: 'Defence' }
    };
    var secBtnsEl = document.getElementById('sec-btns');
    secBtnsEl.innerHTML = Object.keys(secData).map(function(k) {
      var labels = { phishing:'Phishing', ransomware:'Ransomware', ddos:'DDoS', supply:'Supply Chain', sqli:'SQL Injection', tls:'TLS / HTTPS', mfa:'MFA' };
      return '<button class="explorer-btn" id="sec-btn-' + k + '" onclick="showSec(\'' + k + '\',this)">' + labels[k] + '</button>';
    }).join('');

    window.showSec = function(key, btn) {
      document.querySelectorAll('#sec-btns .explorer-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      var d = secData[key];
      var tagClass = (d.tag === 'Defence') ? 'p-green' : (d.tag === 'Social Engineering') ? 'p-amber' : 'p-red';
      document.getElementById('sec-panel').innerHTML =
        '<span class="pill ' + tagClass + '" style="margin-bottom:8px; display:inline-block;">' + d.tag + '</span>'
        + '<div class="result-title">' + d.title + '</div><div class="body-text-relaxed">' + d.body + '</div>';
    };
    document.getElementById('sec-btn-phishing').click();

    /* NETWORK EFFECTS SCALE */
    var netfxItems = [
      { label: 'PayPal', pos: 55 }, { label: 'Uber / Lyft', pos: 62 },
      { label: 'Facebook / Instagram', pos: 82 }, { label: 'WhatsApp / iMessage', pos: 90 },
      { label: 'Google Search', pos: 75 }, { label: 'TikTok (algorithm)', pos: 88 },
      { label: 'AWS / Azure', pos: 48 }, { label: 'Email (SMTP)', pos: 35 }
    ];
    document.getElementById('netfx-scale').innerHTML = netfxItems.map(function(d) {
      return '<div class="value-row-loose"><div class="cscale-name">' + d.label + '</div>'
        + '<div class="range-track"><div class="cscale-dot" style="left:' + d.pos + '%;"></div></div></div>';
    }).join('');

    /* ══════════════════════════════════════════════
       PART E · DATA + METADATA CALCULATOR
    ══════════════════════════════════════════════ */
    function calcMetadata() {
      var messages = Number(document.getElementById('messagesInput').value) || 0;
      var locations = Number(document.getElementById('locationsInput').value) || 0;
      var days = Number(document.getElementById('daysInput').value) || 365;
      if (days < 1) { document.getElementById('metadataOutput').textContent = 'Use at least one retained day.'; return; }
      var msgRecs = messages * days;
      var locRecs = locations * days;
      var total = msgRecs + locRecs;
      document.getElementById('metadataOutput').innerHTML =
        'Over ' + days.toLocaleString() + ' days, that creates about <strong>' + total.toLocaleString() + '</strong> metadata records: '
        + msgRecs.toLocaleString() + ' message events and ' + locRecs.toLocaleString() + ' location events.<br><br>'
        + 'Even without message contents, timing, contacts, and movement patterns reveal routines, relationships, sleep schedules, medical visits, and stress. '
        + 'A 2014 Stanford study found that phone metadata alone could identify medical conditions, legal issues, and religious affiliations with high accuracy.';
    }
    window.calcMetadata = calcMetadata;
    calcMetadata();

    /* ══════════════════════════════════════════════
       PART F · AI
    ══════════════════════════════════════════════ */
    var aiTypeData = [
      { icon: 'fa-solid fa-filter', label: 'Rule-based AI', detail: 'Expert systems encode human knowledge as explicit if-then rules. IBM\'s Deep Blue (1997) beat Garry Kasparov using a tree search over chess positions evaluated by handwritten rules. Rule-based systems are transparent and predictable but brittle — they fail on inputs their designers didn\'t anticipate. They still matter in planning, theorem proving, compilers, and business rules.', tag: 'Narrow AI' },
      { icon: 'fa-solid fa-chart-line', label: 'Machine Learning', detail: 'Systems that learn patterns from data rather than following explicit rules. Classical ML includes decision trees, random forests, SVMs, and gradient boosting — these dominated data science before 2015 and remain widely used. The danger is that a model can learn the shortcut in the dataset rather than the truth in the world: if all healthy patients in training data happen to be photographed with good lighting, the model may learn to diagnose health from lighting.', tag: 'Narrow AI' },
      { icon: 'fa-solid fa-brain', label: 'Deep Learning', detail: 'Neural networks with many layers, trained end-to-end on large datasets. Deep learning powers image recognition (CNNs), speech recognition, and most modern AI applications. It took off when data, GPUs, better algorithms, and large benchmarks converged. It is powerful because it learns features rather than requiring engineers to specify them — the same architecture that classifies images can, with different training data, detect cancer, play Go, or generate code.', tag: 'Narrow AI' },
      { icon: 'fa-solid fa-comment-dots', label: 'Large Language Models', detail: 'Transformer-based models trained on internet-scale text to predict tokens. GPT-4, Claude, Gemini. Exhibit emergent capabilities — abilities not explicitly trained for, like multi-step reasoning and code generation — that appeared at sufficient scale. Pre-training builds broad capability; instruction tuning and RLHF shapes behaviour. Not yet AGI; excellent at interpolation, poor at genuine novel reasoning, and prone to hallucination.', tag: 'Narrow AI' },
      { icon: 'fa-solid fa-image', label: 'Generative AI', detail: 'Models that create new content: text (LLMs), images (DALL-E, Midjourney, Stable Diffusion), audio (Suno, ElevenLabs), video (Sora). Diffusion models dominate image generation — they learn to reverse a process of adding Gaussian noise to images. A single Stable Diffusion model generates images that would have required a skilled artist hours of work. Training data rights are a serious unresolved legal question.', tag: 'Narrow AI' },
      { icon: 'fa-solid fa-infinity', label: 'AGI (hypothetical)', detail: 'Artificial General Intelligence — a system that can learn any intellectual task a human can, with comparable flexibility and generalisation. Does not yet exist. Definitions vary: some researchers argue frontier LLMs already exhibit proto-AGI behaviour; others require genuine world-modelling, causal reasoning, and continuous learning. OpenAI, Anthropic, and DeepMind explicitly name AGI development as their stated goal. Whether current scaling approaches can get there is genuinely contested.', tag: 'Not yet built' }
    ];
    document.getElementById('ai-type-grid').innerHTML = aiTypeData.map(function(d, i) {
      return '<div class="elem-card" id="atc-' + i + '" onclick="showAIType(' + i + ')">'
        + '<div class="elem-card-icon"><i class="' + d.icon + '"></i></div>'
        + '<div class="card-label">' + d.label + '</div></div>';
    }).join('');

    window.showAIType = function(i) {
      document.querySelectorAll('#ai-type-grid .elem-card').forEach(function(c){ c.classList.remove('active'); });
      document.getElementById('atc-' + i).classList.add('active');
      var d = aiTypeData[i];
      var tagClass = d.tag === 'Not yet built' ? 'p-amber' : 'p-teal';
      document.getElementById('ai-type-detail').innerHTML =
        '<span class="pill ' + tagClass + '" style="margin-bottom:8px; display:inline-block;">' + d.tag + '</span>'
        + '<div class="inline-card-title">' + d.label + '</div>'
        + '<div class="muted-copy">' + d.detail + '</div>';
      document.getElementById('ai-type-detail').classList.add('show');
    };

    /* ML DATA SCALE SLIDER */
    var mlLevels = [
      { count: '1,000', unit: 'examples', cap: 'Toy datasets — enough to classify MNIST digits with basic accuracy. Research demos, student projects.' },
      { count: '10,000', unit: 'examples', cap: 'Fine-tuning territory — sufficient to adapt a pretrained model for a narrow task (e.g. classifying medical images).' },
      { count: '100,000', unit: 'examples', cap: 'Industrial applications — enough to train reliable CV systems for quality control, fraud detection.' },
      { count: '1 million', unit: 'examples', cap: 'ImageNet scale. The benchmark that defined modern deep learning. AlexNet (2012) trained on 1.2M images.' },
      { count: '10 million', unit: 'examples', cap: 'Large-scale vision models — Google Brain and Facebook\'s JFT-300M era. Accuracy improves substantially at this scale.' },
      { count: '1 billion', unit: 'words', cap: 'Early language models (GPT-1, 2018) trained at this scale. Basic text generation, simple question answering.' },
      { count: '100 billion', unit: 'tokens', cap: 'GPT-3 (2020) trained on ~300B tokens. Emergence of few-shot learning — models solve tasks from examples alone.' },
      { count: '1 trillion', unit: 'tokens', cap: 'GPT-4 / Claude / Gemini territory. Essentially all indexed text humanity has produced. Strong reasoning, coding, multilinguality.' },
      { count: '~10 trillion', unit: 'tokens', cap: 'Approaching the limit of available high-quality human text. Synthetic data generation and curated corpora become essential.' },
      { count: '100 trillion+', unit: 'tokens (synthetic)', cap: 'Frontier models (2025+) supplement human text with AI-generated synthetic data and agent-generated experience.' }
    ];
    window.updateMLSlider = function(val) {
      val = parseInt(val) - 1;
      var d = mlLevels[Math.min(val, mlLevels.length - 1)];
      document.getElementById('ml-val').textContent = d.count + ' ' + d.unit;
      document.getElementById('ml-sub').textContent = d.cap;
    };
    window.updateMLSlider(4);

    /* CONTEXT WINDOW SLIDER */
    function updateTokens(val) {
      val = Number(val);
      document.getElementById('tokenValue').textContent = val.toLocaleString();
      var words = Math.round(val * 0.75);
      var note = 'Roughly ' + words.toLocaleString() + ' English words fit in that context. ';
      if (val < 10000)       note += 'Enough for a long conversation or short document, but details from earlier may be lost.';
      else if (val < 60000)  note += 'Can hold reports, code files, or several chapters. Retrieval inside large contexts is still imperfect.';
      else                   note += 'Book-scale context. The challenge shifts from "can it fit?" to "can the model reliably use the right part?"';
      document.getElementById('tokenNote').textContent = note;
    }
    window.updateTokens = updateTokens;
    updateTokens(8000);

    /* AI RISK SCALE */
    var aiRiskItems = [
      { label: 'AGI existential risk', pos: 15 }, { label: 'Autonomous weapons', pos: 42 },
      { label: 'Mass unemployment', pos: 55 }, { label: 'Deepfake disinformation', pos: 70 },
      { label: 'Algorithmic bias', pos: 85 }, { label: 'Copyright / IP issues', pos: 80 },
      { label: 'Data privacy violations', pos: 88 }
    ];
    document.getElementById('ai-risk-scale').innerHTML = aiRiskItems.map(function(d) {
      return '<div class="value-row-loose"><div class="cscale-name">' + d.label + '</div>'
        + '<div class="range-track"><div class="cscale-dot" style="left:' + d.pos + '%;"></div></div></div>';
    }).join('');

    /* AI MODALITY DIST BAR */
    var aiMod = [
      { label: 'Natural language (text)', pct: 40, bg: '#2E9E6B', text: '#000' },
      { label: 'Image generation', pct: 20, bg: 'var(--accent)', text: '#000' },
      { label: 'Computer vision', pct: 15, bg: '#3C8FD4', text: '#000' },
      { label: 'Speech / audio', pct: 12, bg: '#7F77DD', text: '#000' },
      { label: 'Code generation', pct: 8, bg: '#D4A843', text: '#000' },
      { label: 'Video generation', pct: 5, bg: '#C88B3A', text: '#000' }
    ];
    document.getElementById('ai-modality-dist').innerHTML = aiMod.map(function(s) {
      return '<div class="dist-seg" style="width:' + s.pct + '%; background:' + s.bg + '; color:' + s.text + ';">' + (s.pct >= 10 ? s.pct + '%' : '') + '</div>';
    }).join('');
    document.getElementById('ai-modality-legend').innerHTML = aiMod.map(function(s) {
      return '<div class="legend-item-large"><div class="key-dot" style="background:' + s.bg + ';"></div>' + s.label + ' (' + s.pct + '%)</div>';
    }).join('');

    /* ══════════════════════════════════════════════
       PART G · FRONTIER TECHNOLOGIES
    ══════════════════════════════════════════════ */

    /* QUANTUM SLIDER */
    var qubitLevels = [
      { val: 50,      year: '2019',       note: 'Google\'s Sycamore — "quantum supremacy" demo on a contrived sampling problem. No practical application.' },
      { val: 127,     year: '2021',       note: 'IBM Eagle — first to break the 100 qubit barrier. Error rates remain too high for useful computation without correction.' },
      { val: 433,     year: '2022',       note: 'IBM Osprey — 433 qubits. Physical qubit count rising; logical qubit count remains tiny.' },
      { val: 1000,    year: '2023',       note: 'IBM Condor — 1,121 qubits, first to exceed 1,000. Physical milestone; logical usefulness still limited.' },
      { val: 10000,   year: '~2026 est.', note: 'Target for early error-corrected logical qubits. First potential practical applications: chemistry simulation.' },
      { val: 100000,  year: '~2030 est.', note: 'Required for meaningful quantum advantage in optimisation and drug discovery.' },
      { val: 1000000, year: '~2035 est.', note: 'Lower bound for breaking RSA-2048. Post-quantum cryptography standards are being finalised now (NIST 2024).' },
      { val: 4000000, year: 'uncertain',  note: 'Full cryptographic relevance. Google estimated 4M physical qubits to break Bitcoin\'s elliptic curve in 1 hour. Most experts: 15–20 years minimum.' }
    ];
    window.updateQubit = function(val) {
      val = parseInt(val) - 1;
      var d = qubitLevels[Math.min(val, qubitLevels.length - 1)];
      var display = d.val >= 1000000 ? (d.val/1000000).toFixed(1) + 'M' : d.val >= 1000 ? (d.val/1000).toFixed(0) + 'K' : d.val;
      document.getElementById('qubit-val').textContent = display + ' qubits';
      document.getElementById('qubit-sub').textContent = d.year + ' — ' + d.note;
    };
    window.updateQubit(3);

    /* FRONTIER ELEM-CARD GRID — now includes energy, space, spatial computing */
    var frontierData = [
      { icon: 'fa-solid fa-dna', label: 'Biotechnology', sub: 'editing life', key: 'bio' },
      { icon: 'fa-solid fa-robot', label: 'Robotics', sub: 'AI in the world', key: 'robotics' },
      { icon: 'fa-solid fa-bolt', label: 'Energy tech', sub: 'batteries and grids', key: 'energy' },
      { icon: 'fa-solid fa-satellite', label: 'Space systems', sub: 'cheap launch, big data', key: 'space' },
      { icon: 'fa-solid fa-glasses', label: 'Spatial computing', sub: 'interfaces in 3D', key: 'ar' }
    ];
    var frontierDetails = {
      bio: { title: 'Biotechnology — code meets cells', body: 'CRISPR-Cas9 (developed 2012, Nobel Prize 2020) allows targeted editing of DNA sequences at specific locations with unprecedented precision and cost. The first CRISPR therapy was approved by the FDA in 2023 for sickle cell disease. More transformative still is AI\'s impact on biology: AlphaFold 2 (DeepMind, 2020) predicted the 3D structure of essentially all known proteins — a problem that had occupied structural biologists for 50 years. The EMBL-EBI database now holds predicted structures for over 200 million proteins. Biology is harder than software because cells are noisy, evolved systems with side effects, but sequencing, synthesis, AI protein models, and lab automation are making it increasingly engineerable.', tag: 'Here now' },
      robotics: { title: 'Robotics — intelligence must survive contact with physics', body: 'Industrial robots have been in factories since 1961 (Unimate, GM). What\'s new is software intelligence. Industrial robots succeeded first because factories constrain the environment. Humanoid robots (Figure AI, Tesla Optimus) are targeting general-purpose warehouse tasks by 2026. Waymo now operates commercial robotaxi services in San Francisco, Phoenix, and Los Angeles. The fundamental challenge of physical AI is the "sim-to-real gap": systems trained in simulation often fail in messy physical reality. Atoms are less forgiving than pixels.', tag: 'Emerging' },
      energy: { title: 'Energy technology — the hidden constraint on everything', body: 'Batteries, solar panels, power electronics, grid software, and transmission lines shape what other technologies can do. Lithium-ion battery pack prices fell by roughly 90% from 2010 to the early 2020s, enabling modern electric vehicles and grid storage. But grids are built slowly, and storage must handle not only daily cycles but weather, seasons, regulation, and public acceptance. The AI compute boom has made energy the primary constraint on frontier AI development: Google, Microsoft, and Amazon have all signed nuclear power deals specifically to power data centres.', tag: 'Here now' },
      space: { title: 'Space systems — launch cost changes the business model', body: 'SpaceX\'s Falcon 9 reusable first stage reduced launch costs from ~$50,000/kg to ~$2,700/kg, making large satellite constellations economically viable. The result is less a romantic space age than a data infrastructure age: Starlink provides broadband to 3+ million users in 100 countries, while Planet Labs\' 200+ satellites photograph every point on Earth daily. Military and intelligence applications are equally transformative. Space is still harsh, regulated, and expensive, but cheaper launch changes what can be deployed, replaced, and scaled.', tag: 'Here now' },
      ar: { title: 'Spatial computing — interfaces leave the rectangle', body: 'Augmented and mixed reality try to place digital objects into the physical world. The challenge is not drawing a floating window; it is latency (must be under 20ms to avoid nausea), optics (enough field of view without weight), battery life, social acceptability, input, privacy, and making tasks genuinely better. Apple Vision Pro (2024) established a premium benchmark but at $3,500 and 600g, it is not a mass-market device. The most useful near-term applications are industrial training, surgery planning, design review, and remote assistance — rather than all-day consumer glasses.', tag: 'Emerging' }
    };
    document.getElementById('frontier-grid').innerHTML = frontierData.map(function(d, i) {
      return '<div class="elem-card" id="ftc-' + i + '" onclick="showFrontierCard(\'' + d.key + '\',' + i + ')">'
        + '<div class="elem-card-icon"><i class="' + d.icon + '"></i></div>'
        + '<div class="card-label">' + d.label + '</div>'
        + '<div class="card-sub-muted">' + d.sub + '</div></div>';
    }).join('');

    window.showFrontierCard = function(key, i) {
      document.querySelectorAll('#frontier-grid .elem-card').forEach(function(c){ c.classList.remove('active'); });
      document.getElementById('ftc-' + i).classList.add('active');
      var d = frontierDetails[key];
      var tagClass = d.tag === 'Here now' ? 'p-green' : 'p-amber';
      document.getElementById('frontier-detail').innerHTML =
        '<span class="pill ' + tagClass + '" style="margin-bottom:8px; display:inline-block;">' + d.tag + '</span>'
        + '<div class="inline-card-title">' + d.title + '</div>'
        + '<div class="muted-copy">' + d.body + '</div>';
      document.getElementById('frontier-detail').classList.add('show');
    };
    // Auto-open biotech
    showFrontierCard('bio', 0);

    /* HYPE VS DEPLOYED IMPACT SCALE */
    var hypeItems = [
      { label: 'Quantum computers', pos: 20 },
      { label: 'AGI', pos: 15 },
      { label: 'Spatial computing/AR', pos: 30 },
      { label: 'Humanoid robots', pos: 28 },
      { label: 'CRISPR therapies', pos: 65 },
      { label: 'Autonomous vehicles', pos: 50 },
      { label: 'AI in software dev', pos: 80 },
      { label: 'Cloud computing', pos: 88 },
      { label: 'Lithium batteries', pos: 85 },
      { label: 'Narrow AI (vision/NLP)', pos: 90 }
    ];
    document.getElementById('hype-scale').innerHTML = hypeItems.map(function(d) {
      return '<div class="value-row-loose"><div class="cscale-name">' + d.label + '</div>'
        + '<div class="range-track"><div class="cscale-dot" style="left:' + d.pos + '%;"></div></div></div>';
    }).join('');

    /* Q&A TOGGLE */
    window.toggleQA = function(btn) {
      var ans = btn.nextElementSibling;
      var showing = ans.classList.toggle('show');
      btn.textContent = showing ? 'hide' : 'show answer';
    };

  }); // end DOMContentLoaded
  
</script>
