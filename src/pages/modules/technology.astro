    var layerData = [
      { icon: 'fa-solid fa-bolt', label: 'Machine Code', detail: 'Raw binary instructions executed directly by the CPU. A single instruction like "add two registers" is encoded as a specific bit pattern. Nobody writes machine code by hand — assemblers and compilers generate it. The hidden achievement of computing is that one programmer can write "sort this list" and a stack of tools turns it into thousands of precise instructions.', tag: 'Layer 0' },
      { icon: 'fa-solid fa-code', label: 'Assembly', detail: 'Human-readable mnemonics for machine instructions: MOV, ADD, JMP. Assembly is CPU-specific — x86 assembly won\'t run on ARM. Used for performance-critical code (bootloaders, device drivers, cryptographic kernels) and for understanding malware.', tag: 'Layer 1' },
      { icon: 'fa-solid fa-terminal', label: 'C / C++', detail: 'High-level languages that compile down to near-machine-code performance. C (1972) is the language of operating systems, databases, and embedded systems. Linux, Windows, macOS kernels, PostgreSQL, and Chrome\'s V8 JS engine are all written in C/C++.', tag: 'Layer 2' },
      { icon: 'fa-solid fa-server', label: 'Operating System', detail: 'The OS manages hardware resources — CPU scheduling, memory allocation, file systems, networking — and creates illusions: every program feels like it has its own machine, even though many processes share hardware. It also provides a stable API so applications don\'t need to know which specific hardware they\'re running on.', tag: 'Layer 3' },
      { icon: 'fa-brands fa-python', label: 'Python / JS', detail: 'Interpreted high-level languages that trade performance for productivity. Python dominates data science and AI due to libraries like NumPy, PyTorch, and pandas. JavaScript is the only programming language that runs natively in browsers — every interactive website runs on it. A runtime (Node.js, V8) provides memory management, standard libraries, and portability.', tag: 'Layer 4' },
      { icon: 'fa-solid fa-window-maximize', label: 'Applications', detail: 'The programs users interact with: browsers, word processors, games. A modern web app might use JavaScript in the browser, Python on the server, PostgreSQL for data, Redis for caching, and Kubernetes to orchestrate containers — each layer abstracting the one below. A wrong data model here causes real-world harm: systems that can\'t represent refunds, time zones, or edge cases injure reality until reality pushes back.', tag: 'Layer 5' }
