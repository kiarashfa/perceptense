    /* MOORE'S LAW SLIDER */
    function updateMoore(val) {
      val = parseInt(val);
      var count = 2300 * Math.pow(2, val);
      var year = Math.min(2025, 1971 + val * 2);
      var display;
      if (count >= 1e9) display = (count / 1e9).toFixed(1) + ' billion';
      else if (count >= 1e6) display = (count / 1e6).toFixed(1) + ' million';
      else display = Math.round(count).toLocaleString();
      document.getElementById('moore-val').textContent = display + ' transistors';
      var milestones = {
        0: 'Intel 4004 (1971) — first commercial microprocessor; powered calculators.',
        4: 'Intel 8086 (1978) — the chip IBM chose for the PC, launching the Wintel era.',
        8: 'Intel 486 (1989) — 1M transistors; first chip capable of running Windows.',
        10: 'Pentium III (1999) — multimedia PCs, early internet browsing.',
        14: 'Intel Core 2 Duo (2006) — dual-core era; performance per watt improves sharply.',
        18: 'AMD Ryzen (2017) — 5B transistors; competitive with Intel for the first time in years.',
        22: 'Apple M1 (2020) — 16B transistors on ARM; beats Intel x86 in performance per watt.',
        25: 'Apple M2 Ultra / NVIDIA H100 (2023) — 134B+ transistors; powers ChatGPT infrastructure.'
      };
      var keys = Object.keys(milestones).map(Number).sort(function(a,b){return a-b;});
      var best = keys[0];
      keys.forEach(function(k) { if (k <= val) best = k; });
      document.getElementById('moore-sub').textContent = 'After ' + val + ' doublings (approx. year ' + year + '). ' + milestones[best];
    }
    window.updateMoore = updateMoore;
    updateMoore(10);

    /* BINARY CONVERTER */
    function updateBinary() {
      var n = parseInt(document.getElementById('bin-input').value);
      if (isNaN(n) || n < 0 || n > 255) {
        document.getElementById('bin-output').innerHTML = 'Enter a number 0–255.'; return;
      }
      var bin = n.toString(2).padStart(8, '0');
      var hex = n.toString(16).toUpperCase().padStart(2, '0');
      var ch = (n >= 32 && n <= 126) ? String.fromCharCode(n) : '(non-printable)';
      document.getElementById('bin-output').innerHTML =
        n + ' in one byte: <strong>' + bin + '</strong> &nbsp;|&nbsp; Hex: 0x' + hex + ' &nbsp;|&nbsp; ASCII: ' + ch + '<br>'
        + 'Hex is popular because every hex digit maps cleanly to 4 bits, so two hex digits represent one byte exactly.';
    }
    window.updateBinary = updateBinary;
    updateBinary();

    /* LATENCY SLIDER */
    function updateLatency(val) {
      val = Number(val);
      document.getElementById('latencyValue').textContent = val.toLocaleString();
      var note;
      if (val < 10)        note = 'You are in cache territory. CPUs are designed around keeping useful data this close, because waiting for farther memory wastes cycles.';
      else if (val < 1000) note = 'This is roughly main-memory territory. To a CPU, RAM is already far away, which is why caches matter so much.';
      else if (val < 100000) note = 'You are beyond normal RAM latency. The processor can do enormous amounts of work while waiting this long.';
      else if (val < 1000000) note = 'This is storage or local-network scale. SSDs feel fast to humans and glacially slow to processors.';
      else                 note = 'Now you are in network-request territory. Performance engineering often means avoiding this trip, batching it, or hiding it behind useful work.';
      document.getElementById('latencyNote').textContent = note;
    }
