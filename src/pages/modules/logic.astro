          html += '</button>';
        }
        doors.innerHTML = html;
        document.getElementById('mh-status').textContent = message;
        document.getElementById('mh-stay-wins').textContent = mhStats.stayWins;
        document.getElementById('mh-stay-total').textContent = mhStats.stayTotal;
        document.getElementById('mh-switch-wins').textContent = mhStats.switchWins;
        document.getElementById('mh-switch-total').textContent = mhStats.switchTotal;

        const actions = document.getElementById('mh-actions');
        if (mhState.phase === 'switch') {
          const other = mhRemainingDoor();
          actions.innerHTML = '<button onclick="mhChoose(false)">Stay with Door ' + (mhState.picked + 1) + '</button><button onclick="mhChoose(true)">Switch to Door ' + (other + 1) + '</button>';
        } else if (mhState.phase === 'result') {
          actions.innerHTML = '<button onclick="mhNewGame()">Play again</button>';
        } else {
          actions.innerHTML = '';
        }
      }

      window.mhPickDoor = function(door) {
        if (mhState.phase !== 'pick') return;
        mhState.picked = door;
        mhState.revealed = mhRevealDoor(door);
        mhState.phase = 'switch';
        mhRender('You picked Door ' + (door + 1) + '. The host opens Door ' + (mhState.revealed + 1) + ', which is empty. Stay or switch?');
      };

      window.mhChoose = function(switched) {
        if (mhState.phase !== 'switch') return;
        const finalDoor = switched ? mhRemainingDoor() : mhState.picked;
        const won = finalDoor === mhState.car;
        if (switched) {
          mhStats.switchTotal++;
          if (won) mhStats.switchWins++;
        } else {
          mhStats.stayTotal++;
          if (won) mhStats.stayWins++;
        }
        mhState.phase = 'result';
        const choice = switched ? 'switched to Door ' + (finalDoor + 1) : 'stayed with Door ' + (finalDoor + 1);
        mhRender('You ' + choice + '. The prize was behind Door ' + (mhState.car + 1) + '. ' + (won ? 'You won.' : 'You lost.'));
      };

      window.mhRunMany = function(rounds) {
        for (let i = 0; i < rounds; i++) {
          const car = Math.floor(Math.random() * 3);
          const picked = Math.floor(Math.random() * 3);
          const revealable = [0, 1, 2].filter(function(door) {
            return door !== picked && door !== car;
          });
          const revealed = revealable[Math.floor(Math.random() * revealable.length)];
          const switchedTo = [0, 1, 2].filter(function(door) {
            return door !== picked && door !== revealed;
          })[0];
          mhStats.stayTotal++;
          mhStats.switchTotal++;
          if (picked === car) mhStats.stayWins++;
          if (switchedTo === car) mhStats.switchWins++;
        }
        mhNewGame();
        const stayRate = mhStats.stayTotal ? formatPct(mhStats.stayWins / mhStats.stayTotal) : '0%';
        const switchRate = mhStats.switchTotal ? formatPct(mhStats.switchWins / mhStats.switchTotal) : '0%';
        document.getElementById('mh-status').textContent = 'Auto-played ' + rounds + ' setups. Stay win rate: ' + stayRate + '. Switch win rate: ' + switchRate + '.';
      };

      window.mhReset = function() {
        mhStats = { stayWins: 0, stayTotal: 0, switchWins: 0, switchTotal: 0 };
        mhNewGame();
      };

      function renderPanel(item) {
        let html = '<div class="panel-title">' + item.title + '</div><div class="panel-body">' + item.body + '</div>';
        if (item.meta) {
          html += '<div class="panel-meta">' + item.meta.map(function(m) {
            return '<div class="panel-chip">' + m + '</div>';
          }).join('') + '</div>';
        }
        return html;
      }

      function setActive(el) {
        if (!el || !el.parentElement) return;
        Array.prototype.forEach.call(el.parentElement.children, function(child) {
          child.classList.remove('active');
        });
        el.classList.add('active');
      }

      function readPercent(id) {
        const value = Number(document.getElementById(id).value);
        if (!Number.isFinite(value) || value <= 0 || value >= 100) return null;
        return value / 100;
      }

      function formatPct(x) {
        return (x * 100).toFixed(x < 0.1 ? 2 : 1) + '%';
      }

      function formatMoney(x) {
        const sign = x < 0 ? '-' : '';
        return sign + '$' + Math.abs(x).toLocaleString(undefined, { maximumFractionDigits: 2 });
      }

      function buildTimeline() {
        const min = -400;
        const max = 1950;
        const axis = [-400, 0, 500, 1000, 1500, 1900];
        const chart = document.getElementById('logic-timeline');
        let html = '<div class="chart-title">A compressed history of formal logic</div><div class="pc-inner"><div class="pc-axis">';
        axis.forEach(function(mark) {
          const left = ((mark - min) / (max - min)) * 100;
          const label = mark < 0 ? Math.abs(mark) + ' BCE' : mark;
          html += '<span class="pc-axis-mark" style="left:' + left + '%">' + label + '</span>';
        });
        html += '</div>';
        timelineItems.forEach(function(item) {
          const start = Math.max(item.start, min);
          const end = Math.min(item.end, max);
          const left = ((start - min) / (max - min)) * 100;
          const width = Math.max(((end - start) / (max - min)) * 100, 1.6);
          html += '<div class="pc-row"><div class="pc-label">' + item.label + '</div><div class="pc-track"><div class="pc-fill" style="left:' + left + '%;width:' + width + '%;background:' + item.bg + ';color:' + item.text + '"><span class="pc-fill-label">' + item.start + '</span></div></div></div>';
        });
        html += '</div><div class="chart-note">Bars mark active periods or publication moments. Single-year breakthroughs are widened so they remain visible on small screens.</div>';
        chart.innerHTML = html;
      }

      function updateSelfReference() {
        const value = Number(document.getElementById('selfref-slider').value);
        document.getElementById('selfref-value').textContent = value;
        const stages = [
          'At 0, a language talks only about outside objects: numbers, people, doors, sets.',
          'Low risk: the language can name statements but does not assign truth or provability to itself.',
          'Medium risk: it starts encoding its own syntax, which is powerful enough for metamathematics.',
          'High risk: truth, definability, or provability are allowed to apply without level restrictions.',
          'At 10, expect liar-style loops, Russell-style comprehension failures, or Godel-style self-reference.'
        ];
        const index = value <= 1 ? 0 : value <= 3 ? 1 : value <= 6 ? 2 : value <= 8 ? 3 : 4;
        document.getElementById('selfref-output').textContent = stages[index];
      }

      function updateBirthday() {
        const n = Number(document.getElementById('birthday-slider').value);
        document.getElementById('birthday-count').textContent = n;
        let pNoMatch = 1;
        for (let i = 0; i < n; i++) {
          pNoMatch *= (365 - i) / 365;
        }
        const p = 1 - pNoMatch;
        const pairs = n * (n - 1) / 2;
        document.getElementById('birthday-output').textContent = n + ' people create ' + pairs.toLocaleString() + ' pairs. The chance of at least one shared birthday is about ' + formatPct(p) + ', ignoring leap days and seasonal birth patterns.';
      }

      function applyDynamicStyles() {
        document.querySelectorAll('.cscale-dot').forEach(function(dot) {
          dot.style.left = dot.dataset.left + '%';
        });
        document.querySelectorAll('.bar-fill').forEach(function(fill) {
          fill.style.width = fill.dataset.width + '%';
          fill.style.background = fill.dataset.color;
        });
        document.querySelectorAll('.dist-seg').forEach(function(seg) {
          seg.style.width = seg.dataset.width + '%';
          seg.style.background = seg.dataset.color;
        });
        document.querySelectorAll('.legend-swatch').forEach(function(swatch) {
          swatch.style.background = swatch.dataset.color;
        });
      }

      function initialiseQA() {
        document.querySelectorAll('.qa-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            const answer = btn.nextElementSibling;
            const isOpen = answer.classList.toggle('show');
            btn.textContent = isOpen ? 'hide' : 'show answer';
          });
        });
      }

      buildTimeline();
      applyDynamicStyles();
      initialiseQA();
      document.getElementById('selfref-slider').addEventListener('input', updateSelfReference);
      document.getElementById('birthday-slider').addEventListener('input', updateBirthday);
      updateSelfReference();
      updateBirthday();
      calculateBayes();
      calculateEV();
      mhNewGame();

      /* ---- Cognitive biases ---- */
      const biasData = {
        anchoring: {
          title: 'Anchoring bias',
          body: 'The first number or framing you encounter disproportionately influences all subsequent estimates. In salary negotiation, legal damages, and retail pricing, the anchor drags the final figure toward it even when the anchor is arbitrary. Tversky and Kahneman demonstrated this in 1974: people asked whether the percentage of African nations in the UN was above or below 65 gave higher estimates than those anchored at 10, across every subsequent question.',
          meta: ['Stage: framing and evaluation', 'Antidote: generate your own estimate before seeing a number', 'Domain: negotiation, finance, medicine']
        },
        availability: {
          title: 'Availability heuristic',
          body: 'People estimate probability by how easily an example comes to mind. Plane crashes feel more likely than car crashes after a crash is in the news, despite statistics running the other way. Availability is a useful shortcut in stable environments, but media coverage, personal experience, and emotional salience all distort it systematically.',
          meta: ['Stage: option generation', 'Antidote: look up base rates', 'Domain: risk perception, policy, medical diagnosis']
        },
        overconfidence: {
          title: 'Overconfidence bias',
          body: 'People systematically overestimate the accuracy of their beliefs and the precision of their predictions. Calibration studies consistently find that events assigned 90% confidence happen only about 70 to 75% of the time. Experts are often more overconfident than novices in their domains of expertise, partly because expertise increases fluency without eliminating hard limits.',
          meta: ['Stage: evaluation', 'Antidote: consider base rates and track your predictions', 'Domain: forecasting, investment, project planning']
        },
        framing: {
          title: 'Framing effect',
          body: 'Logically equivalent information presented differently triggers different choices. "A 10% chance of dying" and "a 90% chance of surviving" describe the same situation; people consistently prefer the survival frame. Politicians, marketers, and lawyers exploit this: "estate tax" and "death tax" refer to the same policy but activate different intuitions.',
          meta: ['Stage: framing', 'Antidote: rephrase the options in multiple frames before deciding', 'Domain: public policy, medicine, marketing']
        },
        hindsight: {
          title: 'Hindsight bias',
          body: 'After an event has occurred, people believe they knew it was coming more than they actually did. This "I knew it all along" effect distorts learning: if you misremember being confident before a success, you credit skill; if you misremember being confident before a failure, you search for external blame. Decision journals directly counter this.',
          meta: ['Stage: post-decision review', 'Antidote: write predictions before outcomes are known', 'Domain: history, finance, medicine, management']
        },
        planning: {
          title: 'Planning fallacy',
          body: 'People consistently underestimate the time, cost, and risk of future projects while overestimating the benefits. The Sydney Opera House was budgeted for completion in 1963 at 7 million dollars; it finished in 1973 at 102 million. Reference class forecasting, developed by Daniel Kahneman and Amos Tversky, combats this by asking: how long did similar projects actually take?',
          meta: ['Stage: option generation and evaluation', 'Antidote: reference class forecasting, add a pessimism buffer', 'Domain: construction, software, policy, research']
        }
      };

      /* ---- Critical thinking tools ---- */
      const ctTools = {
        premortem: {
          title: 'Pre-mortem',
          body: 'Before committing to a plan, imagine it is one year in the future and the plan has failed badly. Now write down all the reasons it failed. This technique, developed by psychologist Gary Klein, breaks the groupthink that suppresses concern before a project begins. The pre-mortem is not pessimism; it is a structured search for overlooked failure modes. Teams using it identify more distinct risks than those using post-mortem only.'
        },
        steelman: {
          title: 'Steelmanning',
          body: 'Reconstruct the opposing view in its strongest, most charitable form, not the version easiest to defeat. This is the opposite of a straw man. A steelman is complete when the position\'s actual proponents would agree it represents their view fairly. The discipline produces three benefits: your critique becomes more useful, your own position becomes more robust, and the conversation becomes less adversarial because the other person is less defensive.'
        },
        outside: {
          title: 'Outside view (reference class forecasting)',
          body: 'The inside view uses the details of this specific project to estimate duration and cost. The outside view asks: what happened to the last 50 projects similar to this one? The outside view routinely outperforms expert judgment on novel projects because it ignores the special pleading of "but this time is different." The technique was developed by Kahneman and Tversky and formalized by Bent Flyvbjerg in infrastructure planning.'
        },
        ferminest: {
          title: 'Fermi estimation',
          body: 'A Fermi estimate breaks an unknown quantity into smaller, more estimable sub-questions and multiplies the results. Enrico Fermi famously estimated the explosive yield of the Trinity nuclear test by dropping torn paper scraps and watching how far they drifted. Fermi estimation is not about precision; it is about calibration. An order-of-magnitude check catches the wildly wrong answer before commitment. "Is this ten dollars or ten million dollars?" is often answerable even when the exact figure is not.'
        },
        'five-whys': {
          title: 'Five Whys',
          body: 'Ask "why?" five times in sequence to move from symptom to root cause. The technique was developed by Sakichi Toyoda and used extensively in the Toyota Production System. "The server went down" is a symptom. "Why?" leads to the trigger. Repeating the question usually passes through the proximate causes and arrives at a systemic one. The number five is a heuristic, not a law; some problems require three iterations and some require eight.'
        },
        null: {
          title: 'Null hypothesis discipline',
          body: 'The null hypothesis is the claim that nothing interesting is happening, that the effect observed is due to chance, that the two groups are the same. Science defaults to the null until evidence overturns it. In everyday reasoning, the discipline of asking "what would this look like if the null were true?" catches many excited claims that are actually noise. P-hacking and publication bias both exploit failures to hold this question steady.'
        }
      };

      /* ---- Argument reconstruction examples ---- */
      const argReconstructData = {
        policy: {
          raw: '"We should raise the minimum wage because workers deserve a living wage."',
          p1: 'Workers who work full-time should be able to afford basic necessities.',
          p2: 'The current minimum wage does not allow full-time workers to afford basic necessities in most regions.',
          p3: 'Raising the minimum wage would close that gap without unacceptable side effects. (contested)',
          conclusion: 'The minimum wage should be raised.',
          note: 'The third premise is the empirical battleground. Economists dispute the magnitude of employment effects. Logic alone cannot settle this; it clarifies that the dispute is empirical, not moral.'
        },
        science: {
          raw: '"Coffee causes cancer, according to a new study."',
          p1: 'This study found a statistically significant association between coffee consumption and cancer incidence.',
          p2: 'Statistically significant associations imply causal relationships. (hidden premise -- usually false)',
          conclusion: 'Coffee causes cancer.',
          note: 'The hidden second premise is the failure point. The study may show correlation in one population under one design. Causation requires replication, dose-response, mechanism, and ruling out confounders like smoking or socioeconomic status.'
        },
        legal: {
          raw: '"My client cannot be guilty because he was at home that evening."',
          p1: 'If the defendant was at home at the time of the crime, he could not have committed it at the scene.',
          p2: 'The defendant was at home at the time of the crime.',
          conclusion: 'The defendant did not commit the crime.',
          note: 'The argument is valid. The dispute will be entirely over the second premise: alibi evidence, witness reliability, and whether "at home" is consistent with remote involvement. Logic hands the case to factual investigation.'
        },
        ad: {
          raw: '"Four out of five dentists recommend our toothpaste."',
          p1: 'Dentists have professional expertise on dental product quality.',
          p2: 'Four out of five surveyed dentists recommend this toothpaste over competing products. (unstated: who was surveyed, what was the question, what did the fifth say)',
          conclusion: 'This toothpaste is superior.',
          note: 'Hidden premises include: the sample is representative, the recommendation reflects quality not incentive, the fifth dentist\'s objection is not material. Each can be contested. Reconstructing the argument exposes what "four out of five" is actually doing rhetorically.'
        }
      };

      window.showBias = function(key, btn) {
        setActive(btn);
        document.getElementById('bias-display').innerHTML = renderPanel(biasData[key]);
      };

      window.showCTTool = function(key, card) {
        setActive(card);
        const item = ctTools[key];
        const detail = document.getElementById('ct-tool-detail');
        detail.classList.add('show');
        detail.innerHTML = '<div class="panel-title">' + item.title + '</div><div class="panel-body">' + item.body + '</div>';
      };

      window.showArgReconstruct = function(key, btn) {
        setActive(btn);
        const d = argReconstructData[key];
        let html = '<div class="u-mb-sm"><span class="mini-label">Original claim</span><div class="muted-copy-large u-mt-sm" style="font-style:italic">' + d.raw + '</div></div>';
        html += '<div class="u-mb-sm"><span class="mini-label">Reconstructed premises</span>';
        html += '<div class="u-mt-sm muted-copy">P1: ' + d.p1 + '</div>';
        html += '<div class="muted-copy">P2: ' + d.p2 + '</div>';
        if (d.p3) html += '<div class="muted-copy">P3: ' + d.p3 + '</div>';
        html += '</div>';
        html += '<div class="u-mb-sm"><span class="mini-label">Conclusion</span><div class="muted-copy u-mt-sm">' + d.conclusion + '</div></div>';
        html += '<div class="logic-note" style="margin-bottom:0"><strong>Analysis: </strong>' + d.note + '</div>';
        document.getElementById('arg-reconstruct-output').innerHTML = html;
      };

      function updateConfidence() {
        const v = Number(document.getElementById('conf-slider').value);
        document.getElementById('conf-value').textContent = v;
        const msgs = [
          [50, 59, 'This is near-ignorance territory. You should probably gather more evidence or acknowledge the question is genuinely open before committing.'],
          [60, 69, 'Moderate lean. You have a directional belief but should actively seek disconfirming evidence and avoid acting as if the conclusion is established.'],
          [70, 79, 'Reasonably confident. Worth checking: is this based on a reference class, multiple independent sources, or just a single vivid story?'],
          [80, 89, 'High confidence. At this level, calibration research suggests you are likely still overestimating accuracy. What would change your mind?'],
          [90, 95, 'Very high. Consider: have you steelmanned the opposite view? Have you accounted for unknown unknowns?'],
          [96, 99, 'Near-certain. Reserve this range for logical and mathematical truths and well-replicated physical constants. Most real-world claims should not reach this level.']
        ];
        const msg = msgs.find(function(m) { return v >= m[0] && v <= m[1]; });
        document.getElementById('conf-output').textContent = msg ? msg[2] : '';
      }

      document.getElementById('conf-slider').addEventListener('input', updateConfidence);
      updateConfidence();
      showBias('anchoring', document.querySelector('[onclick^="showBias"]'));
      showCTTool('premortem', document.querySelector('[onclick^="showCTTool"]'));
      showArgReconstruct('policy', document.querySelector('[onclick^="showArgReconstruct"]'));

      const firstCore = document.querySelector('[onclick^="showLogicCore"]');
      const firstTruth = document.querySelector('[onclick^="showTruthTable"]');
      const firstElement = document.querySelector('[onclick^="showLogicElement"]');
      const firstFallacy = document.querySelector('[onclick^="showFallacy"]');
      const firstParadox = document.querySelector('[onclick^="showParadox"]');
      const firstInfinity = document.querySelector('[onclick^="showInfinity"]');
      const firstProb = document.querySelector('[onclick^="showProbParadox"]');
      const firstPhil = document.querySelector('[onclick^="showPhilParadox"]');
      showLogicCore('validity', firstCore);
      showTruthTable('and', firstTruth);
      showLogicElement('connectives', firstElement);
      showFallacy('consequent', firstFallacy);
      showParadox('liar', firstParadox);
      showInfinity('zeno', firstInfinity);
      showProbParadox('monty', firstProb);
      showPhilParadox('trolley', firstPhil);
    });
  
</script>
