        if (!Number.isFinite(gain) || !Number.isFinite(prob) || !Number.isFinite(cost) || prob < 0 || prob > 1) {
          out.textContent = 'Enter a gain, a success chance from 0 to 100, and a failure cost.';
          return;
        }
        const ev = prob * gain - (1 - prob) * cost;
        const verdict = ev >= 0 ? 'positive' : 'negative';
        out.textContent = 'Expected value: ' + formatMoney(ev) + ' per attempt, which is ' + verdict + ' before risk tolerance, cash limits, and strategic effects are considered.';
