        if (!prior || !sens || !fp) {
          out.textContent = 'Enter percentages greater than 0 and less than 100.';
          return;
        }
        const numerator = sens * prior;
        const denominator = numerator + fp * (1 - prior);
        const posterior = numerator / denominator;
        out.textContent = 'After a positive result, the probability is about ' + formatPct(posterior) + '. In natural frequencies: out of 10,000 people, expect about ' + Math.round(prior * 10000 * sens).toLocaleString() + ' true positives and ' + Math.round((1 - prior) * 10000 * fp).toLocaleString() + ' false positives.';
