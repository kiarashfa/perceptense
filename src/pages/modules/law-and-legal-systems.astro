          <!-- annotations -->
          <line x1="430" y1="38" x2="520" y2="22" stroke="var(--color-border-secondary)" stroke-width="1"/>
          <text x="525" y="20" font-size="10" fill="var(--color-text-secondary)">highest authority</text>
          <line x1="465" y1="90" x2="520" y2="78" stroke="var(--color-border-secondary)" stroke-width="1"/>
          <text x="525" y="76" font-size="10" fill="var(--color-text-secondary)">parliament or congress</text>
          <line x1="505" y1="142" x2="520" y2="134" stroke="var(--color-border-secondary)" stroke-width="1"/>
          <text x="525" y="132" font-size="10" fill="var(--color-text-secondary)">agencies and ministries</text>
