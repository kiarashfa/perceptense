          <line x1="140" y1="63" x2="190" y2="63" stroke="var(--accent)" stroke-width="2" marker-end="url(#arrow)"></line>
          <rect x="190" y="34" width="120" height="58" rx="8" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)"></rect>
