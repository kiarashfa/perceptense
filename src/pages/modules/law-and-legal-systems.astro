          <text x="245" y="38" text-anchor="middle" font-size="10" font-weight="600" fill="var(--color-text-primary)">Charge</text>
          <text x="245" y="52" text-anchor="middle" font-size="9" fill="var(--color-text-secondary)">prosecution</text>
