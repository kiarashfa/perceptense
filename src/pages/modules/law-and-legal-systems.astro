          <text x="250" y="76" text-anchor="middle" font-size="10" fill="var(--color-text-secondary)">legal theory</text>
          <line x1="310" y1="63" x2="360" y2="63" stroke="var(--accent)" stroke-width="2" marker-end="url(#arrow)"></line>
