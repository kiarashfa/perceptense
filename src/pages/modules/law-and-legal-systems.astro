          <text x="49" y="52" text-anchor="middle" font-size="9" fill="var(--color-text-secondary)">investigate</text>
          <line x1="90" y1="40" x2="104" y2="40" stroke="var(--color-text-secondary)" stroke-width="1.5" marker-end="url(#arrow2)"/>

          <rect x="106" y="20" width="82" height="40" rx="6" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)"/>
          <text x="147" y="38" text-anchor="middle" font-size="10" font-weight="600" fill="var(--color-text-primary)">Arrest</text>
          <text x="147" y="52" text-anchor="middle" font-size="9" fill="var(--color-text-secondary)">custody</text>
          <line x1="188" y1="40" x2="202" y2="40" stroke="var(--color-text-secondary)" stroke-width="1.5" marker-end="url(#arrow2)"/>

