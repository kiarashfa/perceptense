      };

      document.querySelectorAll('#readingButtons button').forEach(function(button) {
        button.addEventListener('click', function() {
          showExplorer(readingMoves, button.dataset.key, button, 'readingDisplay');
        });
      });

      function buildScale() {
        const items = [
          { name: 'Strict textualism', pos: 12 },
          { name: 'Original public meaning', pos: 24 },
          { name: 'Precedent-first common law', pos: 43 },
          { name: 'Purposive statutory reading', pos: 64 },
          { name: 'Proportionality review', pos: 78 },
          { name: 'Equitable discretion', pos: 90 }
        ];
        const container = document.getElementById('interpretScale');
        container.innerHTML = '';
        items.forEach(function(item) {
          const row = document.createElement('div');
          row.className = 'cscale-row';
          row.innerHTML = '<div class="cscale-name">' + item.name + '</div><div class="cscale-track"><div class="cscale-dot"></div></div>';
          row.querySelector('.cscale-dot').style.left = item.pos + '%';
          container.appendChild(row);
        });
      }

      function buildSentenceScale() {
        const items = [
          { name: 'U.S. mandatory minimums', pos: 15 },
          { name: 'English sentencing guidelines', pos: 35 },
          { name: 'Nordic suspended sentences', pos: 72 },
          { name: 'Restorative justice circles', pos: 88 }
        ];
        const container = document.getElementById('sentenceScale');
        if (!container) return;
        container.innerHTML = '';
        items.forEach(function(item) {
          const row = document.createElement('div');
          row.className = 'cscale-row';
          row.innerHTML = '<div class="cscale-name">' + item.name + '</div><div class="cscale-track"><div class="cscale-dot"></div></div>';
          row.querySelector('.cscale-dot').style.background = 'var(--accent)';
          row.querySelector('.cscale-dot').style.left = item.pos + '%';
          container.appendChild(row);
        });
      }

      function buildTradeSpectrum() {
        const items = [
          { name: 'WTO most-favoured-nation', pos: 14 },
          { name: 'NAFTA / USMCA', pos: 22 },
          { name: 'EU single market', pos: 10 },
          { name: 'Selective industrial policy', pos: 55 },
          { name: 'Retaliatory tariff regimes', pos: 72 },
          { name: 'Import substitution', pos: 84 }
        ];
        const container = document.getElementById('tradeSpectrum');
        if (!container) return;
        container.innerHTML = '';
        items.forEach(function(item) {
          const row = document.createElement('div');
          row.className = 'cscale-row';
          row.innerHTML = '<div class="cscale-name">' + item.name + '</div><div class="cscale-track"><div class="cscale-dot"></div></div>';
          row.querySelector('.cscale-dot').style.background = 'var(--tax-accent)';
          row.querySelector('.cscale-dot').style.left = item.pos + '%';
          container.appendChild(row);
        });
      }

      function setupQa() {
        document.querySelectorAll('.qa').forEach(function(box) {
          const button = box.querySelector('.qa-btn');
          const answer = box.querySelector('.qa-ans');
          button.addEventListener('click', function() {
            const show = !answer.classList.contains('show');
            answer.classList.toggle('show', show);
            button.textContent = show ? 'hide' : 'show answer';
          });
        });
      }

      // ---- Tax type explorer ----
      const taxTypes = {
        income: {
          title: 'Personal income tax',
          body: 'Income tax taxes earnings from labour, pensions, interest, rents, and sometimes dividends. Progressive rate structures impose higher rates on higher slices of income. Modern systems are fiendishly complex: allowances, deductions, credits, phase-outs, and separate treatment of different income sources can make the effective rate very different from the stated marginal rate. Withholding at source by employers collects most income tax without self-assessment.'
        },
        corporate: {
          title: 'Corporate tax',
          body: 'Corporate tax is levied on company profits after allowable deductions. The legal incidence falls on the company, but the economic incidence may fall on shareholders through lower dividends, on workers through lower wages, or on consumers through higher prices. Economists disagree sharply about the split. Depreciation rules, loss carry-forwards, research credits, and thin capitalisation rules make corporate tax one of the most technically complex areas of tax law.'
        },
        vat: {
          title: 'Value added tax (VAT) and goods-and-services tax (GST)',
          body: 'VAT is collected at each stage of production on the value added at that stage, with businesses reclaiming tax paid on their inputs. The end consumer bears the full rate. Because it is collected throughout the supply chain, VAT is administratively robust against evasion compared to single-stage sales taxes. Reduced rates, zero rates, and exemptions for essentials, medical services, education, and finance create substantial complexity and political battles over which goods deserve which treatment.'
        },
        capital: {
          title: 'Capital gains tax',
          body: 'Capital gains arise when assets are sold for more than their cost. Many systems tax gains at lower rates than ordinary income, on the theory that investment should be encouraged and that gains include an inflation component. Critics argue this preferential treatment mainly benefits the wealthy and distorts investment toward appreciating assets. The lock-in effect is real: high capital gains rates discourage asset sales, reducing market liquidity and tax revenue simultaneously.'
        },
        wealth: {
          title: 'Wealth and estate taxes',
          body: 'Wealth taxes are levied annually on net assets above a threshold. Estate or inheritance taxes are levied on transfer at death. Both are politically contentious and administratively demanding: valuing illiquid assets such as private businesses and artworks is genuinely hard, and capital can move across borders. Several European countries abandoned wealth taxes after finding they raised little revenue relative to administrative cost. Estate taxes remain in many jurisdictions but are widely avoided through trusts and gifting strategies.'
        },
        carbon: {
          title: 'Carbon and environmental taxes',
          body: 'Carbon taxes price greenhouse gas emissions, internalising an externality that markets otherwise ignore. The revenue can be recycled as dividends to citizens, cuts in other taxes, or climate investment. Carbon border adjustment mechanisms tax imports from countries without equivalent carbon pricing, aiming to prevent "carbon leakage" where production moves to unregulated jurisdictions. The EU Carbon Border Adjustment Mechanism, introduced in 2023, is the most significant example to date.'
        }
      };

      document.querySelectorAll('#taxTypeButtons button').forEach(function(button) {
        button.addEventListener('click', function() {
          showExplorer(taxTypes, button.dataset.key, button, 'taxTypeDisplay');
        });
      });

      // ---- Bracket simulator ----
      const brackets = [
        { label: 'Up to $11,000 (10%)', rate: 0.10, ceiling: 11000, color: 'var(--tax-accent)' },
        { label: '$11k-$44k (12%)', rate: 0.12, ceiling: 44725, color: '#4CAF72' },
        { label: '$44k-$95k (22%)', rate: 0.22, ceiling: 95375, color: '#E6A817' },
        { label: '$95k-$182k (24%)', rate: 0.24, ceiling: 182050, color: '#E07020' },
        { label: 'Above $182k (32%)', rate: 0.32, ceiling: 600000, color: '#C03060' }
      ];

      function updateBracketSim() {
        const income = Number(document.getElementById('bracketSlider').value);
        document.getElementById('bracketIncomeDisplay').textContent = '$' + income.toLocaleString();
        const stack = document.getElementById('bracketStack');
        stack.innerHTML = '';
        let totalTax = 0;
        let prev = 0;
        const maxIncome = 600000;

        brackets.forEach(function(br) {
          const taxableInBracket = Math.min(Math.max(income - prev, 0), br.ceiling - prev);
          const taxInBracket = taxableInBracket * br.rate;
          totalTax += taxInBracket;
          const bracketWidth = (br.ceiling - prev) / maxIncome;
          const filledWidth = taxableInBracket / (br.ceiling - prev);

          const row = document.createElement('div');
          row.className = 'bracket-row';
          row.innerHTML =
            '<div class="bracket-label">' + br.label + '</div>' +
            '<div class="bracket-track"><div class="bracket-fill"></div></div>' +
            '<div class="bracket-amount">' + (taxInBracket > 0 ? '$' + Math.round(taxInBracket).toLocaleString() : '--') + '</div>';
          const fill = row.querySelector('.bracket-fill');
          fill.style.width = (filledWidth * 100) + '%';
          fill.style.background = br.color;
          fill.style.opacity = taxableInBracket > 0 ? '0.85' : '0.2';
          stack.appendChild(row);
          prev = br.ceiling;
        });

        const effectiveRate = income > 0 ? (totalTax / income * 100).toFixed(1) : 0;
        const topMarginal = brackets.findLast(function(br) { return income > (brackets.indexOf(br) === 0 ? 0 : brackets[brackets.indexOf(br)-1].ceiling); });
        const marginalRate = topMarginal ? (topMarginal.rate * 100).toFixed(0) : 10;

        document.getElementById('bracketSummary').innerHTML =
          'Total tax: <strong>$' + Math.round(totalTax).toLocaleString() + '</strong>' +
          ' &nbsp;|&nbsp; Effective rate: <strong>' + effectiveRate + '%</strong>' +
          ' &nbsp;|&nbsp; Top marginal rate: <strong>' + marginalRate + '%</strong>' +
          '<br><span style="color:var(--color-text-secondary);font-size:11px">Note: effective rate is always lower than top marginal rate because only income above each threshold is taxed at the higher rate.</span>';
      }

      document.getElementById('bracketSlider').addEventListener('input', updateBracketSim);
      updateBracketSim();

      // ---- Tariff type explorer ----
      const tariffTypes = {
        protective: {
          title: 'Protective tariffs: shielding domestic industry',
          body: 'A protective tariff raises the price of competing imports, giving domestic producers a cost advantage in their home market. Classic examples include steel, automobiles, and agricultural goods. The intended benefit is saving jobs in sheltered industries. The costs, often diffuse and less visible, fall on downstream industries that pay more for inputs and on consumers who pay higher prices. The Infant Industry Argument holds that temporary protection is justified while a strategic sector builds scale and competitiveness.'
        },
        retaliatory: {
          title: 'Retaliatory tariffs: tit-for-tat trade disputes',
          body: 'Retaliatory tariffs respond to tariffs or other trade restrictions imposed by a trading partner. The WTO dispute settlement system authorises retaliation after a finding of WTO violation. Unilateral retaliation outside that process is legally contested but politically common. Tit-for-tat escalation can become a trade war where both sides raise costs on each other; the economic literature suggests both parties lose welfare in most such cycles, though politically concentrated domestic winners may outweigh diffuse losers.'
        },
        antidumping: {
          title: 'Anti-dumping duties: responding to below-cost imports',
          body: 'Dumping occurs when a company exports goods at below-cost or below-home-market prices to gain market share abroad. Anti-dumping duties are WTO-permissible tariffs that offset the price advantage. In practice, anti-dumping investigations are frequently used as protectionist tools: the definitions of "normal value" and "material injury" give significant discretion to investigating authorities. The U.S. and EU use anti-dumping measures extensively; China has been the most frequent target.'
        },
        strategic: {
          title: 'Strategic tariffs: industrial and security policy',
          body: 'Strategic tariffs target sectors with national security, technological leadership, or supply chain resilience rationale. Semiconductors, electric vehicles, batteries, and pharmaceutical precursors are recent examples. The argument is that market outcomes may not reflect national strategic interests: a foreign monopoly in a critical sector is a vulnerability even if it is economically efficient. Strategic tariffs are WTO-contested but politically resilient because the security exception in Article XXI GATT is broadly worded.'
        },
        revenue: {
          title: 'Revenue tariffs: historical fiscal tools',
          body: 'Before income taxes, customs duties were the primary revenue source for many governments. The U.S. federal government funded most of its operations through tariffs in the 19th century, which partly explains the political resistance to income taxation. Revenue tariffs aim for broad coverage at moderate rates to maximise collection without destroying trade. Modern tariffs are rarely designed primarily for revenue; that role has been taken over by VAT and income taxes, which are more efficient and harder to evade.'
        }
      };

      document.querySelectorAll('#tariffButtons button').forEach(function(button) {
        button.addEventListener('click', function() {
          showExplorer(tariffTypes, button.dataset.key, button, 'tariffDisplay');
        });
      });

      // ---- Views on taxation ----
      const taxViews = {
        benefits: {
          title: 'Benefits view: paying for what you receive',
          body: 'The benefits principle holds that taxes should correspond to the public services each taxpayer receives. Petrol taxes funding roads, aviation taxes funding air traffic control, and social insurance contributions tied to retirement benefits all follow this logic. The main limit is that many public goods, such as defence, courts, and clean air, are non-excludable and difficult to price per user. The benefits view tends to favour lower taxes on the wealthy if they use fewer public services, which conflicts with redistribution goals.'
        },
        ability: {
          title: 'Ability to pay: progressive contribution',
          body: 'The ability-to-pay principle holds that tax burden should increase with capacity to pay. It underlies progressive income taxes and graduated estate taxes. The argument from marginal utility adds that an extra dollar matters less to a rich person than a poor one, so equal sacrifice requires higher rates at higher incomes. This view is the dominant justification for progressive systems in most OECD democracies, though debates continue about how steeply rates should progress and whether wealth, not just income, should be the base.'
        },
        libertarian: {
          title: 'Libertarian critique: coercion and property rights',
          body: 'Libertarian critics, associated with thinkers like Robert Nozick, argue that taxation of earnings is a form of forced labour: it takes what a person has rightfully earned. On this view, only taxes for minimal state functions such as courts, police, and defence are justifiable; redistribution through taxation violates individual rights regardless of the democratic majority behind it. This position is politically influential in debates about marginal rates, estate taxes, and welfare programmes, even among those who do not endorse the full libertarian framework.'
        },
        pigouvian: {
          title: 'Pigouvian taxes: correcting market failures',
          body: 'Arthur Pigou argued that activities generating negative externalities, such as pollution, should be taxed to align private and social costs. A carbon tax, a sugar tax, a congestion charge, and alcohol and tobacco levies all draw on this logic. Unlike most taxes, Pigouvian taxes aim to reduce the taxed activity rather than merely raise revenue. The revenue is a side effect; the policy goal is internalising costs that markets impose on others. Carbon pricing is the most contested contemporary application.'
        },
        mmt: {
          title: 'Modern monetary theory: taxes are not funding',
          body: 'Modern monetary theory argues that a currency-issuing government does not need tax revenue to fund spending: it creates money by spending and destroys it by taxing. On this view, the role of taxes is not to raise money but to control inflation (by withdrawing spending power), to redistribute wealth, to price externalities, and to enforce demand for the currency. Critics argue this reasoning applies only to currency-issuing sovereigns and ignores inflation constraints; proponents say it clarifies that fiscal space is wider than conventional accounting implies.'
        }
      };

      document.querySelectorAll('#viewsTabs button').forEach(function(button) {
        button.addEventListener('click', function() {
          showExplorer(taxViews, button.dataset.key, button, 'viewsDisplay');
        });
      });

      // ---- Initial triggers ----
      buildPeriodChart(timelineItems, 'lawTimelineAxis', 'lawTimelineRows', 1215, 2026, [1215, 1500, 1700, 1800, 1900, 1950, 2026]);
      document.querySelector('#traditionButtons button[data-key="common"]').click();
      document.getElementById('rightsSlider').addEventListener('input', updateRightsSlider);
      updateRightsSlider();
      document.querySelector('#privateCards .elem-card[data-key="contract"]').click();
      document.getElementById('calcClaim').addEventListener('click', calculateClaim);
      calculateClaim();
      document.querySelector('#businessButtons button[data-key="company"]').click();
      buildBars();
      buildDistribution('corpDist', 'corpLegend', [
        { label: 'shareholders', value: 25, color: 'var(--accent)' },
        { label: 'creditors', value: 20, color: 'var(--color-text-info)' },
        { label: 'employees', value: 18, color: 'var(--color-text-success)' },
        { label: 'customers', value: 14, color: 'var(--color-text-warning)' },
        { label: 'regulators', value: 13, color: 'var(--color-text-danger)' },
        { label: 'public trust', value: 10, color: 'var(--color-border-secondary)' }
      ]);
      document.querySelector('#tribunalButtons button[data-key="icj"]').click();
      buildDistribution('intlDist', 'intlLegend', [
        { label: 'reciprocity', value: 28, color: 'var(--accent)' },
        { label: 'domestic law', value: 22, color: 'var(--color-text-info)' },
        { label: 'reputation', value: 20, color: 'var(--color-text-success)' },
        { label: 'markets and aid', value: 16, color: 'var(--color-text-warning)' },
        { label: 'courts and sanctions', value: 14, color: 'var(--color-text-danger)' }
      ]);
      document.querySelector('#readingButtons button[data-key="statute"]').click();
      buildScale();
      buildSentenceScale();
      buildTradeSpectrum();
      setupQa();

      // Tax section initialisation
      document.querySelector('#taxTypeButtons button[data-key="income"]').click();
      document.querySelector('#tariffButtons button[data-key="protective"]').click();
      document.querySelector('#viewsTabs button[data-key="benefits"]').click();
      buildDistribution('taxRevDist', 'taxRevLegend', [
        { label: 'personal income tax', value: 24, color: 'var(--tax-accent)' },
        { label: 'social contributions', value: 22, color: '#4CAF72' },
        { label: 'VAT / consumption', value: 20, color: '#E6A817' },
        { label: 'corporate tax', value: 10, color: '#E07020' },
        { label: 'property taxes', value: 6, color: '#9C5AA0' },
        { label: 'customs and tariffs', value: 4, color: '#C03060' },
        { label: 'other taxes', value: 14, color: 'var(--color-border-secondary)' }
      ]);
    });
  
</script>
