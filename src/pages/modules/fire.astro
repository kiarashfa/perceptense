      function monthlyPayment(principal, annualRate, years) {
        const months = years * 12;
        const monthlyRate = annualRate / 100 / 12;
        if (monthlyRate === 0) {
          return principal / months;
        }
        return principal * monthlyRate * Math.pow(1 + monthlyRate, months) / (Math.pow(1 + monthlyRate, months) - 1);
      }

      function formatMoney(value) {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(value);
      }

      function updateRateSlider() {
        const rate = Number(document.getElementById('rate-slider').value);
        const principal = 400000;
        const payment = monthlyPayment(principal, rate, 30);
        const lowPayment = monthlyPayment(principal, 3, 30);
        document.getElementById('rate-output').textContent = rate.toFixed(2) + '%';
        document.getElementById('rate-payment').innerHTML = `
          <div class="detail-title">${formatMoney(payment)} per month</div>
          <div class="muted-copy-large">At ${rate.toFixed(2)}%, principal and interest on $400,000 is ${formatMoney(payment)}. Compared with a 3.00% loan at ${formatMoney(lowPayment)}, the monthly difference is ${formatMoney(payment - lowPayment)}. Taxes, insurance, HOA fees, and repairs are not included.</div>
        `;
      }

      window.calculateMortgage = function() {
        const price = Number(document.getElementById('home-price').value);
        const down = Number(document.getElementById('down-payment').value);
        const rate = Number(document.getElementById('mortgage-rate').value);
        const years = Number(document.getElementById('mortgage-years').value);
        const output = document.getElementById('mortgage-output');

        if (!price || price <= 0 || down < 0 || down >= price || rate < 0 || !years || years <= 0) {
          output.textContent = 'Enter a positive price, a down payment below the price, a non-negative rate, and a loan term above zero.';
          return;
        }

        const principal = price - down;
        const payment = monthlyPayment(principal, rate, years);
        const total = payment * years * 12;
        const interest = total - principal;
        const ltv = principal / price * 100;
        output.innerHTML = `
          <div class="detail-title">${formatMoney(payment)} monthly principal and interest</div>
          <div class="muted-copy-large">Loan amount: ${formatMoney(principal)}. Loan-to-value: ${ltv.toFixed(1)}%. Total interest over ${years} years: ${formatMoney(interest)}. This excludes taxes, insurance, mortgage insurance, repairs, and closing costs, which are often the numbers that surprise first-time buyers.</div>
        `;
      };

