          { label: 'Great Moderation credit boom', start: 1990, end: 2007, col: 'var(--accent-border)', bg: 'var(--accent-bg)', text: 'var(--color-text-primary)' },
          { label: 'Housing bubble peak and break', start: 2003, end: 2008, col: 'var(--color-border-danger)', bg: 'var(--color-background-danger)', text: 'var(--color-text-danger)' },
          { label: 'Global financial crisis', start: 2007, end: 2009, col: 'var(--color-border-danger)', bg: 'var(--color-background-danger)', text: 'var(--color-text-danger)' },
          { label: 'Dodd-Frank implementation', start: 2010, end: 2018, col: 'var(--color-border-success)', bg: 'var(--color-background-success)', text: 'var(--color-text-success)' },
          { label: 'Basel III phase-in', start: 2013, end: 2023, col: 'var(--color-border-info)', bg: 'var(--color-background-info)', text: 'var(--color-text-info)' },
          { label: 'Regional bank stress', start: 2023, end: 2024, col: 'var(--color-border-warning)', bg: 'var(--color-background-warning)', text: 'var(--color-text-warning)' }
        ];
        const min = 1930;
        const max = 2025;
        const range = max - min;
        const rows = document.getElementById('pc-rows');
        rows.innerHTML = items.map(item => {
          const left = ((item.start - min) / range * 100).toFixed(2);
          const width = ((item.end - item.start) / range * 100).toFixed(2);
          return `
            <div class="pc-row">
              <div class="pc-label">${item.label}</div>
              <div class="pc-track">
                <div class="pc-fill" style="left:${left}%; width:${width}%; background:${item.bg}; border:0.5px solid ${item.col};">
                  <span class="pc-fill-label" style="color:${item.text};">${item.start}-${item.end}</span>
                </div>
              </div>
            </div>
          `;
        }).join('');

        const marks = [1930, 1950, 1970, 1990, 2010, 2025];
        document.getElementById('pc-axis').innerHTML = marks.map(mark => {
          const left = ((mark - min) / range * 100).toFixed(2);
          return `<span class="pc-axis-mark" style="left:${left}%;">${mark}</span>`;
        }).join('');
      }

      document.querySelectorAll('.qa').forEach(function(box) {
        const btn = box.querySelector('.qa-btn');
        const answer = box.querySelector('.qa-ans');
        btn.addEventListener('click', function() {
          const showing = answer.classList.toggle('show');
          btn.textContent = showing ? 'hide' : 'show answer';
        });
      });

      document.getElementById('rate-slider').addEventListener('input', updateRateSlider);

      buildGdpChart();
      buildWealthDistribution();
      buildConflictScale();
      buildCrisisChart();
      updateRateSlider();
      window.calculateMortgage();

      document.querySelector('[onclick="showSector(\'finance\', this)"]').click();
      document.querySelector('[onclick="showFinance(\'banks\', this)"]').click();
      document.querySelector('[onclick="showInsurance(\'pooling\', this)"]').click();
      document.querySelector('[onclick="showBroker(\'commission\', this)"]').click();
      document.querySelector('[onclick="showRegulator(\'prudential\', this)"]').click();
    });
  
</script>
