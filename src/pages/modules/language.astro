      english: {
        title: 'English — the accidental world language',
        body: 'English is a West Germanic language that has borrowed so extensively from French, Latin, and Greek that its vocabulary is only about 26% Germanic by root count. The Norman Conquest (1066) imposed French as the language of power for 300 years, which is why English has pairs like "ask/question," "begin/commence," "kingly/royal" — Germanic word for the informal register, Latin/French word for the formal. English has no official global regulating body (unlike French with the Académie française), which means it changes and borrows more freely than most. There are now more non-native English speakers (about 1 billion) than native speakers (about 400 million), and many varieties — Indian English, Nigerian English, Singaporean English — are fully fledged dialects with their own grammars, not just "accented" versions of British or American English.'
      },
      arabic: {
        title: 'Arabic — language of the Quran and 400 million speakers',
        body: 'Arabic is the liturgical language of 1.8 billion Muslims and the official language of 22 states. Its diglossia — the gap between Modern Standard Arabic (MSA, the written and formal spoken language) and regional dialects — is more extreme than in almost any other language. Moroccan Darija and Gulf Arabic are mutually unintelligible in everyday speech; both communities shift to MSA in formal contexts. The Quran\'s status has preserved Classical Arabic in a way with no parallel in other languages: the 7th-century text remains comprehensible to modern educated Arabic readers without translation. Arabic script reads right to left, is abjadic (consonants only, vowels optional), and has no capital letters; instead, letters take four different forms depending on their position in a word.'
      },
      spanish: {
        title: 'Spanish — the Americas\' first European language',
        body: 'Spanish has more native speakers than English (approximately 490 million L1 speakers) and is the official language of 20 countries on three continents. It spread through the Americas via Spanish colonisation from 1492, and Latin America now has far more Spanish speakers than Spain. The Real Academia Española, established in 1713, coordinates the standard across all Spanish-speaking countries — a notable example of successful language standardisation across political borders. Spanish spelling is among the most phonetically regular of any major language. The vocabulary is predominantly Latin, with a significant layer of Arabic loan words from the Moorish period (711-1492): words beginning with "al-" — algebra, almohada, alcalde, alcohol — are typically Arabic in origin.'
      },
      hindi: {
        title: 'Hindi-Urdu — one language, two identities',
        body: 'Hindi and Urdu are linguistically the same spoken language — Hindustani — with mutually intelligible grammar and everyday vocabulary. The division is political and religious: Hindi is written in Devanagari script and associated with Hindu identity; Urdu is written in a modified Arabic-Persian script and associated with Muslim identity and Pakistan. The formal registers diverge dramatically: formal Hindi draws vocabulary from Sanskrit, while formal Urdu draws from Persian and Arabic. A conversation between a Hindi and Urdu speaker works fine in bazaar language; a newspaper editorial in one is nearly unreadable to a reader of the other. The partition of India and Pakistan in 1947 hardened what had been a gradient into an apparent dichotomy. Together, Hindi-Urdu has roughly 600 million native speakers.'
      },
      swahili: {
        title: 'Swahili — the language that unified East Africa',
        body: 'Swahili (Kiswahili) is the only sub-Saharan African language that has achieved the status of a major international lingua franca without being tied to a colonial power. It is the official language of Tanzania, Kenya, Uganda, and the DRC, and is spoken by up to 200 million people as an L1 or L2. Swahili is a Bantu language enriched by centuries of Arab Indian Ocean trade: roughly 40% of its vocabulary is Arabic in origin ("kitabu" = book, "serikali" = government). Its noun class system — a hallmark of Bantu languages — assigns every noun to one of 15-18 classes that affect agreement throughout the sentence. Swahili was promoted by Julius Nyerere in Tanzania as a national language specifically to avoid privileging one ethnic group\'s tongue over others — one of the more successful examples of language policy as nation-building.'
      },
      japanese: {
        title: 'Japanese — the world\'s most complex writing system',
        body: 'Japanese uses three writing systems simultaneously: Hiragana (46 syllables, for native Japanese words and grammar), Katakana (46 syllables, for foreign loan words), and Kanji (Chinese-derived characters, of which 2,136 are required for full literacy). A single newspaper sentence may switch between all three in one line. Despite this apparent complexity, Japanese children are literate in hiragana by age 6 and largely kanji-literate by the end of primary school. Japanese is agglutinative, verb-final (SOV), and has an elaborate honorific system (keigo) with distinct vocabulary, verb forms, and even pronouns depending on the social relationship between speaker and listener. Japanese has no grammatical gender and marks politeness obligatorily — features that make it typologically unusual even by global standards.'
      }
    };

    window.showLang = function(key, btn) {
      document.querySelectorAll('#lang-btns button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      var d = langData[key];
      document.getElementById('lang-panel').innerHTML =
        '<h4>' + d.title + '</h4><p>' + d.body + '</p>';
    };

    // ── Endangered languages by region bar ──
    var regions = [
      { name: 'Americas', pct: 32, col: '#C4587D' },
      { name: 'Pacific', pct: 22, col: '#D4884A' },
      { name: 'Africa', pct: 18, col: '#5BAD7A' },
      { name: 'Asia', pct: 15, col: '#3A96B0' },
      { name: 'Europe', pct: 8, col: '#8B6BB8' },
      { name: 'Middle East', pct: 5, col: '#B0A090' }
    ];
    var rBar = document.getElementById('region-bar');
    var rLeg = document.getElementById('region-legend');
    regions.forEach(function(r) {
      var seg = document.createElement('div');
      seg.className = 'dist-seg';
      seg.style.width = r.pct + '%';
      seg.style.background = r.col;
      seg.textContent = r.pct >= 8 ? r.pct + '%' : '';
      rBar.appendChild(seg);
      var li = document.createElement('div');
      li.className = 'dist-legend-item';
      li.innerHTML = '<div class="dist-legend-dot" style="background:' + r.col + '"></div>' + r.name + ' (' + r.pct + '%)';
      rLeg.appendChild(li);
    });

    // ── Endangerment calculator ──
    window.calcEndangerment = function() {
      var speakers = parseFloat(document.getElementById('calc-speakers').value);
      var decline = parseFloat(document.getElementById('calc-decline').value) / 100;
      var result = document.getElementById('calc-result');
      if (isNaN(speakers) || isNaN(decline) || speakers <= 50 || decline <= 0) {
        result.innerHTML = 'Please enter valid values: speaker count above 50, decline rate above 0%.';
        return;
      }
      var years = Math.log(50 / speakers) / Math.log(1 - decline);
      years = Math.ceil(years);
      var urgency, color;
      if (years < 20) { urgency = 'critically endangered — immediate documentation is essential'; color = 'var(--color-text-danger)'; }
      else if (years < 50) { urgency = 'severely endangered — active revitalisation programmes may help'; color = 'var(--color-text-warning)'; }
      else if (years < 100) { urgency = 'endangered — decline is significant but revitalisation is feasible'; color = 'var(--color-text-warning)'; }
      else { urgency = 'at risk — monitoring needed'; color = 'var(--color-text-secondary)'; }
      var currentYear = 2024;
      result.innerHTML = 'Starting from <strong>' + Math.round(speakers) + ' speakers</strong> declining at <strong>' + (decline * 100).toFixed(1) + '%</strong> per year:<br><br>' +
        'Reaches 50 speakers (UNESCO "critically endangered" threshold) in approximately <strong>' + years + ' years</strong> — around <strong>' + (currentYear + years) + '</strong>.<br><br>' +
        '<span style="color:' + color + ';">Status: ' + urgency + '</span>';
    };

  });
  
</script>
