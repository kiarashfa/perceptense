    function buildPeriodChart(axisId, rowsId, data, minY, maxY, unit) {
      var range = maxY - minY;
      var axisDiv = document.getElementById(axisId);
      var rowsDiv = document.getElementById(rowsId);
      var axisMarks = 5;
      for (var i = 0; i <= axisMarks; i++) {
        var val = Math.round(minY + (range * i / axisMarks));
        var mark = document.createElement('div');
        mark.className = 'pc-axis-mark';
        mark.style.left = (i / axisMarks * 100) + '%';
        mark.textContent = val + (unit === 'months' ? 'm' : '');
        axisDiv.appendChild(mark);
      }
      data.forEach(function(d) {
        var row = document.createElement('div');
        row.className = 'pc-row';
        var lbl = document.createElement('div');
        lbl.className = 'pc-label';
        lbl.textContent = d.label;
        var track = document.createElement('div');
        track.className = 'pc-track';
        var left = ((d.start - minY) / range * 100).toFixed(1);
        var width = ((d.end - d.start) / range * 100).toFixed(1);
        var fill = document.createElement('div');
        fill.className = 'pc-fill';
        fill.style.left = left + '%';
        fill.style.width = width + '%';
        fill.style.background = d.col;
        var span = document.createElement('span');
        span.className = 'pc-fill-label';
        span.textContent = d.start + (unit === 'months' ? 'm' : '') + '-' + d.end + (unit === 'months' ? 'm' : '');
        fill.appendChild(span);
        track.appendChild(fill);
        row.appendChild(lbl);
        row.appendChild(track);
        rowsDiv.appendChild(row);
      });
