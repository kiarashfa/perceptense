      <svg class="language-svg-style" viewBox="0 0 780 260" xmlns="http://www.w3.org/2000/svg">
        <!-- Root -->
        <rect x="310" y="10" width="160" height="30" rx="6" fill="var(--accent)" stroke="none"/>
        <text x="390" y="30" text-anchor="middle" font-size="12" font-weight="600" fill="#fff">Proto-Indo-European</text>
        <!-- Branch lines from root -->
