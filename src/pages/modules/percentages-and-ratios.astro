<script is:inline>

/* ── Part A: % vs pp slider ── */
function updatePP() {
  const start  = parseInt(document.getElementById('starting-rate').value);
  const change = parseInt(document.getElementById('change-rate').value);
  document.getElementById('start-out').textContent  = start + '%';
  document.getElementById('change-out').textContent = '+' + change;

  const pp_new = start + change;
  document.getElementById('pp-result').textContent = start + '% → ' + pp_new + '%';
  document.getElementById('pp-desc').textContent   = 'Added ' + change + ' percentage points. The rate went from ' + start + '% to ' + pp_new + '%.';

  const pct_new = +(start * (1 + change / 100)).toFixed(1);
  document.getElementById('pct-result').textContent = start + '% → ' + pct_new + '%';
  document.getElementById('pct-desc').textContent   = 'A ' + change + '% increase on ' + start + '% = ×' + (1 + change / 100).toFixed(2) + ' = ' + pct_new + '%.';
}
document.getElementById('starting-rate').addEventListener('input', updatePP);
document.getElementById('change-rate').addEventListener('input', updatePP);
updatePP();

/* ── Part C: percentage calculator ── */
function setCalc(type) {
  const opSel  = document.getElementById('calc-op');
  const bInput = document.getElementById('calc-b');
  if (type === 'tip')   { document.getElementById('calc-base').value = 85;     document.getElementById('calc-pct').value = 15; opSel.value = 'of'; }
  if (type === 'disc')  { document.getElementById('calc-base').value = 120;    document.getElementById('calc-pct').value = 30; opSel.value = 'sub'; }
  if (type === 'tax')   { document.getElementById('calc-base').value = 200;    document.getElementById('calc-pct').value = 20; opSel.value = 'add'; }
  if (type === 'raise') { document.getElementById('calc-base').value = 42000;  document.getElementById('calc-pct').value = 8;  opSel.value = 'add'; }
  if (type === 'gdp')   { document.getElementById('calc-base').value = 1000;   document.getElementById('calc-pct').value = 3;  document.getElementById('calc-b').value = 1030; opSel.value = 'change'; }
  bInput.style.display = opSel.value === 'change' ? 'block' : 'none';
  runCalc();
}

function runCalc() {
  const base   = parseFloat(document.getElementById('calc-base').value);
  const pct    = parseFloat(document.getElementById('calc-pct').value);
  const op     = document.getElementById('calc-op').value;
  const b      = parseFloat(document.getElementById('calc-b').value);
  const bInput = document.getElementById('calc-b');
  bInput.style.display = op === 'change' ? 'inline-block' : 'none';
  if (isNaN(base) || isNaN(pct)) return;
  const fmt = v => v >= 1000 ? v.toLocaleString('en', {maximumFractionDigits: 0}) : +v.toFixed(2) + '';
  let html = '';
  if (op === 'of') {
    const res = base * pct / 100;
    html = `<strong>${pct}% of ${fmt(base)}</strong> = <strong style="color:var(--color-text-info);">${fmt(res)}</strong><br>` +
      `<span style="color:var(--color-text-secondary); font-size:12px;">Mental shortcut: 1% = ${fmt(base / 100)}, × ${pct} = ${fmt(res)}.</span>`;
  } else if (op === 'add') {
    const res = base * (1 + pct / 100);
    html = `<strong>${fmt(base)} + ${pct}%</strong> = <strong style="color:var(--color-text-success);">${fmt(res)}</strong><br>` +
      `<span style="color:var(--color-text-secondary); font-size:12px;">You are paying/getting ${fmt(res - base)} more.</span>`;
  } else if (op === 'sub') {
    const res = base * (1 - pct / 100);
    html = `<strong>${fmt(base)} − ${pct}%</strong> = <strong style="color:var(--color-text-danger);">${fmt(res)}</strong><br>` +
      `<span style="color:var(--color-text-secondary); font-size:12px;">Saving ${fmt(base - res)}. You pay ${fmt(res)}.</span>`;
  } else if (op === 'change') {
    if (isNaN(b)) return;
    const change = (b - base) / base * 100;
    const pp     = b - base;
    html = `<strong>${fmt(base)} → ${fmt(b)}</strong><br>` +
      `Percent change: <strong style="color:${change >= 0 ? '#27500A' : '#791F1F'};">${change >= 0 ? '+' : ''}${change.toFixed(1)}%</strong><br>` +
      `Absolute change: <strong>${pp >= 0 ? '+' : ''}${fmt(pp)}</strong>`;
  }
  document.getElementById('calc-result').innerHTML = html;
}
document.getElementById('calc-op').addEventListener('change', runCalc);
document.getElementById('calc-base').addEventListener('input', runCalc);
document.getElementById('calc-pct').addEventListener('input', runCalc);
document.getElementById('calc-b').addEventListener('input', runCalc);
runCalc();

/* ── Part C: stacked discount explorer ── */
function runDiscount() {
  const price = parseFloat(document.getElementById('disc-price').value) || 0;
  const d1    = parseFloat(document.getElementById('disc1').value) || 0;
  const d2    = parseFloat(document.getElementById('disc2').value) || 0;
  const d3    = parseFloat(document.getElementById('disc3').value) || 0;
  if (price <= 0) return;
  const naiveSum = d1 + d2 + (d3 || 0);
  const rem      = (1 - d1 / 100) * (1 - d2 / 100) * (1 - (d3 || 0) / 100);
  const finalPrice = price * rem;
  const realDisc   = (1 - rem) * 100;
  const saved      = price - finalPrice;
  const fmt = v => v.toLocaleString('en', {minimumFractionDigits: 2, maximumFractionDigits: 2});
  let note = '';
  if (Math.abs(naiveSum - realDisc) > 0.5) {
    note = `<span style="color:var(--color-text-danger);">⚠ "Looks like ${naiveSum.toFixed(0)}% off" but actually <strong>${realDisc.toFixed(1)}% off</strong> — a ${(naiveSum - realDisc).toFixed(1)} pp difference.</span>`;
  } else {
    note = `<span style="color:var(--color-text-success);">✓ The naive sum and real discount match closely.</span>`;
  }
  document.getElementById('disc-result').innerHTML =
    `Original: <strong>€${fmt(price)}</strong> → After discounts: <strong style="color:var(--color-text-success);">€${fmt(finalPrice)}</strong><br>` +
    `You save: <strong>€${fmt(saved)}</strong> — real total discount: <strong>${realDisc.toFixed(1)}%</strong><br>${note}<br>` +
    `<span style="color:var(--color-text-secondary); font-size:12px;">Maths: (1−${d1/100}) × (1−${d2/100}) × (1−${(d3||0)/100}) = ${rem.toFixed(4)} → pay ${(rem*100).toFixed(1)}%</span>`;
}
['disc-price','disc1','disc2','disc3'].forEach(id => document.getElementById(id).addEventListener('input', runDiscount));
runDiscount();

