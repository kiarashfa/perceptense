  ).join('') + (pe > 100 ? ` <span style="font-size:12px; color:var(--color-text-secondary);">…+${pe-100} more</span>` : '');
  document.getElementById('pe-desc').textContent = peDescriptions[pe];
}
showPE(10, document.querySelector('#pe-explorer .sense-tab'));

/* ── Part E: compound growth slider ── */
function updateGrowth() {
  const r = parseInt(document.getElementById('growth-slider').value);
  document.getElementById('growth-out').textContent = r + '%/yr';
  const doubleYrs = Math.round(72 / r * 10) / 10;
  const tenYrs    = +(Math.log(10) / Math.log(1 + r / 100)).toFixed(1);
  const future    = Math.round(1000 * Math.pow(1 + r / 100, 30));
  document.getElementById('double-years').textContent = doubleYrs + ' yrs';
  document.getElementById('ten-years').textContent    = tenYrs + ' yrs';
  document.getElementById('future-val').textContent   = '€' + future.toLocaleString();

  const examples = {
    1:  'Inflation in a stable economy. Savings account in a low-rate period. Barely keeps pace.',
    2:  'Typical developed-world GDP growth. Moderate inflation. Pension fund minimum target.',
    3:  'Good GDP growth. Typical global stock market above inflation. Solid savings target.',
    5:  'Strong economy / emerging market growth. Reasonable investment portfolio return.',
    7:  'Historical average real stock return (S&P 500, inflation-adjusted). Warren Buffett\'s rule of thumb for equity returns.',
    10: 'Strong bull market returns. Tech sector growth. High-risk investment territory.',
    15: 'Exceptional investment performance. Roughly Berkshire Hathaway\'s historical long-run average.',
    20: 'Venture capital target return. Very few portfolios sustain this long-term.',
    25: 'Extreme growth. Startups, crypto bull runs. Highly unsustainable over decades.',
  };
  const closest = Object.keys(examples).reduce((a, b) => Math.abs(b - r) < Math.abs(a - r) ? b : a);
  document.getElementById('growth-examples').textContent = examples[closest];
}
document.getElementById('growth-slider').addEventListener('input', updateGrowth);
updateGrowth();

/* ── Part E: compound growth bar chart ── */
function drawGrowthChart(rate, btn) {
  document.querySelectorAll('#growth-chart-wrap').forEach(() => {});
  document.querySelectorAll('.sense-tab').forEach(b => {
    if (b.closest('[id]') && b.closest('[id]').id === 'growth-chart-wrap') b.classList.remove('active');
  });
  // update active button in growth chart section
  btn.parentElement.querySelectorAll('.sense-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  const milestones = [0, 5, 10, 15, 20, 25, 30];
  const values     = milestones.map(y => Math.round(1000 * Math.pow(1 + rate / 100, y)));
  const maxVal     = values[values.length - 1];
  const svgH       = 200;
  const barW       = 60;
  const gap        = 20;
  const leftPad    = 55;
  const topPad     = 20;
  const bottomPad  = 40;
  const availH     = svgH - topPad - bottomPad;
  const svgW       = leftPad + milestones.length * (barW + gap) + 20;

  let bars = '';
  milestones.forEach((yr, i) => {
    const v    = values[i];
    const barH = Math.max(4, (v / maxVal) * availH);
    const x    = leftPad + i * (barW + gap);
    const y    = topPad + availH - barH;
    const col  = yr === 0 ? 'currentColor' : 'var(--accent)';
    const op   = yr === 0 ? '0.18' : '0.7';
    bars += `<rect x="${x}" y="${y}" width="${barW}" height="${barH}" rx="3" fill="${col}" opacity="${op}"/>`;
    bars += `<text x="${x + barW / 2}" y="${y - 5}" text-anchor="middle" font-size="10.5" fill="currentColor" opacity="0.75" font-weight="500">€${v >= 1000 ? (v / 1000).toFixed(0) + 'k' : v}</text>`;
    bars += `<text x="${x + barW / 2}" y="${svgH - bottomPad + 16}" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.5">Yr ${yr}</text>`;
  });

  const svg = `<svg viewBox="0 0 ${svgW} ${svgH}" xmlns="http://www.w3.org/2000/svg" style="font-family:system-ui,sans-serif; width:100%; max-width:${svgW}px;">
    <line x1="${leftPad-10}" y1="${topPad + availH}" x2="${svgW - 10}" y2="${topPad + availH}" stroke="currentColor" stroke-opacity="0.15" stroke-width="1"/>
    ${bars}
    <text x="14" y="${topPad + availH / 2}" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.4" transform="rotate(-90 14,${topPad + availH / 2})">€ value</text>
    <text x="${svgW / 2}" y="${svgH - 2}" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.45">At ${rate}%/yr — €1,000 starting value</text>
  </svg>`;
  document.getElementById('growth-chart-wrap').innerHTML = svg;
}
drawGrowthChart(3, document.querySelector('[onclick="drawGrowthChart(3, this)"]'));

/* ── Part E: loss-recovery table ── */
(function buildRecTable() {
  const losses = [10, 20, 30, 40, 50, 60, 70, 75, 80, 90];
  const body   = document.getElementById('rec-table-body');
  losses.forEach(l => {
    const needed  = (l / (100 - l) * 100).toFixed(1);
    const start   = 10000;
    const after   = start * (1 - l / 100);
    const recover = (after * (1 + parseFloat(needed) / 100)).toFixed(0);
    const tr = document.createElement('tr');
    tr.innerHTML = `<td class="td-loss">−${l}%</td><td class="td-need">+${needed}%</td><td style="font-size:12px; color:var(--color-text-secondary);">€10,000 → €${after.toLocaleString()} → €${parseFloat(recover).toLocaleString()}</td>`;
    body.appendChild(tr);
  });
})();

/* ── Part F: income distribution bar chart (animated) ── */
(function buildIncomeChart() {
  const shares  = [3.1, 8.3, 14.2, 23.0, 51.5];
  const maxH    = 155; // height for 51.5%
  const scale   = maxH / 51.5;
  const ids     = ['iq1','iq2','iq3','iq4','iq5'];
  const valIds  = ['iv1','iv2','iv3','iv4','iv5'];
  const colours = ['var(--accent)','var(--accent)','var(--accent)','var(--accent)','#F09595'];
  ids.forEach((id, i) => {
    const el = document.getElementById(id);
    if (!el) return;
    const h = shares[i] * scale;
    el.setAttribute('y', 170 - h);
    el.setAttribute('height', h);
    el.setAttribute('fill', colours[i]);
    const vEl = document.getElementById(valIds[i]);
    if (vEl) {
      vEl.setAttribute('y', 170 - h - 5);
      vEl.textContent = shares[i] + '%';
    }
  });
})();

