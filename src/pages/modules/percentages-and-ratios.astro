/* ── Part I: fee drag calculator ── */
function showFee(fee, btn) {
  if (btn) {
    btn.closest('.content-panel').querySelectorAll('.sense-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }
  const start = 50000;
  const gross = 0.07;
  const years = 40;
  const net   = gross - fee / 100;
  const withFee = start * Math.pow(1 + net, years);
  const noFee   = start * Math.pow(1 + gross, years);
  const cost    = noFee - withFee;
  const pctCost = (cost / noFee * 100).toFixed(1);
  const fmt     = v => '€' + Math.round(v).toLocaleString('en');
  document.getElementById('fee-result').innerHTML =
    `At <strong>${fee}% annual fee</strong> on 7% gross returns, €50,000 over 40 years:<br>` +
    `Without fee: <strong style="color:var(--color-text-success);">${fmt(noFee)}</strong> &nbsp;|&nbsp; ` +
    `After ${fee}% fee: <strong style="color:var(--color-text-danger);">${fmt(withFee)}</strong><br>` +
    `Fee cost over 40 years: <strong style="color:var(--color-text-danger);">${fmt(cost)}</strong> — that's <strong>${pctCost}%</strong> of your final pot.`;
}
showFee(0.1, null);
document.querySelectorAll('[onclick^="showFee"]').forEach(btn => {
  const m = btn.getAttribute('onclick').match(/showFee\(([\d.]+)/);
  if (m) btn.addEventListener('click', () => showFee(parseFloat(m[1]), btn));
});

/* ── Part I: mortgage calculator ── */
function updateMortgage() {
  const rate = parseFloat(document.getElementById('mortgage-rate').value);
  const loan = parseInt(document.getElementById('mortgage-loan').value);
  document.getElementById('mortgage-rate-out').textContent = rate + '%';
  document.getElementById('mortgage-loan-out').textContent = '€' + loan.toLocaleString();

  const months = 25 * 12; // 25-year mortgage
  const r      = rate / 100 / 12;
  const monthly = r === 0 ? loan / months : loan * r * Math.pow(1 + r, months) / (Math.pow(1 + r, months) - 1);
  const totalPaid  = monthly * months;
  const totalInterest = totalPaid - loan;
  const interestPct   = (totalInterest / loan * 100).toFixed(0);
  const fmt = v => '€' + Math.round(v).toLocaleString('en');

  // compare with 1pp lower
  const rLow    = Math.max(0.01, rate - 1) / 100 / 12;
  const mLow    = loan * rLow * Math.pow(1 + rLow, months) / (Math.pow(1 + rLow, months) - 1);
  const totalLow = mLow * months;
  const saving   = totalPaid - totalLow;

  document.getElementById('mortgage-result').innerHTML =
    `Monthly payment: <strong style="color:var(--color-text-primary);">${fmt(monthly)}</strong> &nbsp;|&nbsp; ` +
    `Total over 25 yrs: <strong>${fmt(totalPaid)}</strong><br>` +
    `Total interest: <strong style="color:var(--color-text-danger);">${fmt(totalInterest)}</strong> — that's <strong>${interestPct}%</strong> extra on top of your loan.<br>` +
    (rate > 1 ? `<span style="color:var(--color-text-secondary); font-size:12px;">If the rate were 1 pp lower (${(rate-1).toFixed(1)}%), total interest would be ${fmt(totalPaid - totalLow)} less over the life of the loan.</span>` : '');
}
document.getElementById('mortgage-rate').addEventListener('input', updateMortgage);
document.getElementById('mortgage-loan').addEventListener('input', updateMortgage);
updateMortgage();
    
