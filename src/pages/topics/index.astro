---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, path, pageTitle, counts, spelled } from '../../lib/site';
import modules from '../../data/modules.json';
import categories from '../../data/categories.json';
import '../../styles/icons/topics-index.css';

const pathname = path('topics');
const grouped = categories.map((c) => ({
  ...c,
  modules: modules.filter((m) => m.category === c.id),
}));

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Topics | ${site.brand}`,
  url: new URL(pathname, Astro.site).href,
  hasPart: grouped.map((g) => ({
    '@type': 'CollectionPage',
    name: g.label,
    url: new URL(path('topics', g.id), Astro.site).href,
  })),
}];
---
<BaseLayout
  title={pageTitle('Topics', `the ${spelled(counts.categories)} areas the course covers`)}
  description={`Browse all ${counts.modules} ${site.brand} modules by topic, from numbers and scale to culture, mind and environment.`}
  pathname={pathname}
  structuredData={structuredData}
>
  <div class="page-wrap">
    <h1>Browse by topic</h1>
    <p class="lede">Every module, grouped into the {spelled(counts.categories)} areas the course covers.</p>

    {grouped.map((g) => (
      <section class="topic-block">
        <h2><a href={path('topics', g.id)}>{g.label}</a> <span class="topic-count">{g.modules.length}</span></h2>
        <ul class="topic-list">
          {g.modules.map((m) => (
            <li><a href={path('modules', m.slug)}>{m.name}</a> — {m.blurb}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
