---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplitMark from '../../components/SplitMark.astro';
import LedgerRow from '../../components/LedgerRow.astro';
import { site, path, pageTitle, counts, spelled, roman } from '../../lib/site';
import modules from '../../data/modules.json';
import categories from '../../data/categories.json';
import '../../styles/ledger.css';
import '../../styles/icons/topics-index.css';

const pathname = path('topics');
const grouped = categories.map((c) => ({
  ...c,
  modules: modules.filter((m) => m.category === c.id),
}));

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Topics | ${site.brand}`,
  url: new URL(pathname, Astro.site).href,
  hasPart: grouped.map((g) => ({
    '@type': 'CollectionPage',
    name: g.label,
    url: new URL(path('topics', g.id), Astro.site).href,
  })),
}];
---
<BaseLayout
  title={pageTitle('Topics', `the ${spelled(counts.categories)} areas the course covers`)}
  description={`Browse all ${counts.modules} ${site.brand} modules by topic, from numbers and scale to culture, mind and environment.`}
  pathname={pathname}
  bodyClass="listing"
  structuredData={structuredData}
>
  <div class="listing-wrap">
    <div class="hero split-hero">
      <SplitMark />
    </div>

    <div class="index-head">
      <h1 class="index-title">Topics</h1>
      <span class="index-count">{counts.categories} subjects &middot; {counts.modules} modules</span>
    </div>

    <ul class="toc">
      {grouped.map((g, k) => (
        <li><a href={`#${g.id}`}><span>{roman(k + 1)}</span>{g.label}</a></li>
      ))}
    </ul>

    {grouped.map((g, k) => (
      <section class="chapter" id={g.id}>
        <header class="ch-head">
          <span class="ch-no">Chapter {roman(k + 1)}</span>
          <h2 class="ch-title"><i class="dot" data-cat={g.id}></i><a href={path('topics', g.id)}>{g.label}</a></h2>
          <p class="ch-desc">{g.description}</p>
          <span class="ch-count">{g.modules.length} modules</span>
        </header>
        <ol class="lg-rows">
          {g.modules.map((m) => <li><LedgerRow module={m} topic={g.label} icon={m.faIcon} /></li>)}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
