---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LedgerRow from '../../components/LedgerRow.astro';
import { site, path, pageTitle, roman } from '../../lib/site';
import modules from '../../data/modules.json';
import categories from '../../data/categories.json';
import '../../styles/ledger.css';
import '../../styles/icons/[category].css';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.id }, props: { category: c } }));
}

const { category } = Astro.props;
const list = modules.filter((m) => m.category === category.id);
const chapter = categories.findIndex((c) => c.id === category.id) + 1;
const pathname = path('topics', category.id);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${category.label} | ${site.brand}`,
    url: new URL(pathname, Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: list.length,
      itemListElement: list.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.name,
        url: new URL(path('modules', m.slug), Astro.site).href,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.brand, item: new URL(path(), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Topics', item: new URL(path('topics'), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: category.label, item: new URL(pathname, Astro.site).href },
    ],
  },
];
---
<BaseLayout
  title={pageTitle(category.label, `${list.length} modules`)}
  description={`${list.length} Perceptense modules on ${category.label.toLowerCase()}: ${list.map((m) => m.name).join(', ')}.`.slice(0, 165)}
  pathname={pathname}
  bodyClass="listing"
  structuredData={structuredData}
>
  <nav class="crumbs" aria-label="Breadcrumb" slot="before-main">
    <ol>
      <li><a href={path()}>Home</a></li>
      <li><a href={path('topics')}>Topics</a></li>
      <li aria-current="page">{category.label}</li>
    </ol>
  </nav>

  <div class="listing-wrap">
    <section class="chapter chapter-page">
      <header class="ch-head">
        <span class="ch-no">Chapter {roman(chapter)}</span>
        <h1 class="ch-title"><i class="dot" data-cat={category.id}></i>{category.label}</h1>
        <p class="ch-desc">{category.description}</p>
        <span class="ch-count">{list.length} modules</span>
      </header>
      <ol class="lg-rows">
        {list.map((m) => <li><LedgerRow module={m} topic={category.label} /></li>)}
      </ol>
    </section>

    <nav class="more-subjects" aria-label="Subjects">
      <div class="index-head">
        <h2 class="index-title">All subjects</h2>
        <a class="index-count" href={path('modules')}>All {modules.length} modules &rarr;</a>
      </div>
      <ul class="toc">
        {categories.map((c, k) => (
          <li>
            <a href={path('topics', c.id)} aria-current={c.id === category.id ? 'page' : undefined}>
              <span>{roman(k + 1)}</span>{c.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
