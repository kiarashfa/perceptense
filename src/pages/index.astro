---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitMark from '../components/SplitMark.astro';
import LedgerRow from '../components/LedgerRow.astro';
import { site, path, counts, spelled, roman } from '../lib/site';
import modules from '../data/modules.json';
import categories from '../data/categories.json';
import '../styles/ledger.css';
import '../styles/home.css';
import '../styles/icons/home.css';

const pathname = path();
const home = new URL(pathname, Astro.site).href;
const label = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const countIn = (id: string) => modules.filter((m) => m.category === id).length;
const pad = (n: number) => String(n).padStart(2, '0');

/** Spotlight order. Each module's animation is src/assets/featured/<slug>.svg. */
const SPOTLIGHT = [12, 26, 8, 49, 7, 33, 3, 48, 25];
const art = import.meta.glob<string>('../assets/featured/*.svg', { query: '?raw', import: 'default', eager: true });
const spotlight = SPOTLIGHT.map((id) => {
  const m = modules.find((x) => x.id === id)!;
  return { ...m, svg: art[`../assets/featured/${m.slug}.svg`] };
});

const subjects = spelled(counts.categories);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.brand,
    alternateName: site.tagline,
    url: home,
    description: site.description,
    inLanguage: site.locale,
    author: { '@type': 'Person', name: site.author },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: `${site.brand} — ${site.tagline}`,
    description: site.description,
    url: home,
    provider: { '@type': 'Person', name: site.author },
    isAccessibleForFree: true,
    inLanguage: site.locale,
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: 'PT2H',
    },
    syllabusSections: modules.map((m, i) => ({
      '@type': 'Syllabus',
      position: i + 1,
      name: m.name,
      description: m.blurb,
      url: new URL(path('modules', m.slug), Astro.site).href,
    })),
  },
];
---
<BaseLayout
  title={`${site.brand} — ${site.tagline}`}
  description={site.description}
  pathname={pathname}
  bodyClass="home"
  structuredData={structuredData}
>
  <div class="home-wrap">
    <section class="stage">
      <div class="hero">
        <SplitMark>
          <h1 class="etym-sub">{site.tagline}</h1>
        </SplitMark>
      </div>

      <div class="rx-wrap spot" data-rx="spot">
        <div class="rx rx-spot" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Featured modules">
          {spotlight.map((m) => (
            <a class="plate rx-item" href={path('modules', m.slug)}>
              <div class="plate-art" set:html={m.svg} />
              <div class="plate-cap">
                <span class="plate-no">N&ordm; {pad(m.id)} &middot; {label[m.category]}</span>
                <span class="plate-name">{m.name}</span>
                <span class="plate-blurb">{m.blurb}</span>
              </div>
            </a>
          ))}
        </div>
        <div class="rx-ctrl center">
          <button type="button" data-step="-1" aria-label="Previous featured module">&larr;</button>
          <span class="rx-count"><b>01</b> / {pad(spotlight.length)}</span>
          <button type="button" data-step="1" aria-label="Next featured module">&rarr;</button>
        </div>
      </div>
    </section>

    <div class="flow">
      <section class="door door-left" aria-labelledby="door-index">
        <div class="door-copy">
          <span class="big-num" aria-hidden="true">{pad(counts.modules)}</span>
          <span class="eyebrow">The index</span>
          <h2 class="door-title" id="door-index">Every module, on one page.</h2>
          <p class="door-text">
            Search by keyword, filter by subject, sort by number or name. Every module stands on its own, so
            start wherever your curiosity is loudest. Inside each one you will find anchor numbers to hold on to,
            calculators that take your own figures, side by side comparisons, small games, and questions that ask
            for a guess before they show the answer.
          </p>
          <a class="door-link" href={path('modules')}>Open the index <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="door-art">
          <div class="rx-wrap" data-rx="list">
            <div class="rx rx-list" tabindex="0" aria-label="All modules">
              <div class="rx-lens"></div>
              {modules.map((m) => <LedgerRow module={m} topic={label[m.category]} class="rx-item" />)}
            </div>
            <div class="rx-ctrl end">
              <button type="button" data-step="-1" aria-label="Previous module">&uarr;</button>
              <span class="rx-count"><b>01</b> / {pad(counts.modules)}</span>
              <button type="button" data-step="1" aria-label="Next module">&darr;</button>
            </div>
          </div>
        </div>
      </section>

      <section class="door door-right" aria-labelledby="door-topics">
        <div class="door-art">
          <div class="rx-wrap" data-rx="list">
            <div class="rx rx-list" tabindex="0" aria-label="Subjects">
              <div class="rx-lens"></div>
              {categories.map((c, k) => (
                <a class="lg-row rx-item" href={path('topics', c.id)}>
                  <span class="lg-num">{roman(k + 1)}</span>
                  <span class="lg-main">
                    <span class="lg-name"><i class="dot" data-cat={c.id}></i>{c.label}</span>
                    <span class="lg-blurb">{c.description}</span>
                  </span>
                  <span class="lg-count">{countIn(c.id)}</span>
                </a>
              ))}
            </div>
            <div class="rx-ctrl">
              <button type="button" data-step="-1" aria-label="Previous subject">&uarr;</button>
              <span class="rx-count"><b>01</b> / {pad(counts.categories)}</span>
              <button type="button" data-step="1" aria-label="Next subject">&darr;</button>
            </div>
          </div>
        </div>
        <div class="door-copy">
          <span class="big-num" aria-hidden="true">{pad(counts.categories)}</span>
          <span class="eyebrow">By subject</span>
          <h2 class="door-title" id="door-topics">{subjects[0].toUpperCase() + subjects.slice(1)} subjects, each its own chapter.</h2>
          <p class="door-text">
            From numbers and scale to mind and meaning. Each subject gathers its modules in one place, with a line
            on what ties them together. Read a whole chapter and the ideas start leaning on each other: money makes
            more sense beside percentages and probability, sleep beside fitness and health. Or wander across
            subjects, since every module still works on its own.
          </p>
          <a class="door-link" href={path('topics')}>Browse topics <span aria-hidden="true">&rarr;</span></a>
        </div>
      </section>
    </div>

    <section class="coda" aria-labelledby="coda-title">
      <span class="coda-node" aria-hidden="true"></span>
      <span class="eyebrow">About</span>
      <h2 class="door-title" id="coda-title">Built for the numbers we nod along to.</h2>
      <p class="door-text">
        Gigatons of CO<sub>2</sub>, light-years, basis points: the internet is good at facts and bad at feel.
        {site.brand} is a small antidote, short and playful modules you can poke at instead of long articles you
        skim. Every one is hand built and free, and the story of why it exists is a short read.
      </p>
      <a class="door-link" href={path('about')}>Read the story <span aria-hidden="true">&rarr;</span></a>
    </section>
  </div>
</BaseLayout>

<script>
  import { rolodex, spotPlace, listPlace } from '../scripts/rolodex';

  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const spot = document.querySelector<HTMLElement>('.rx-wrap[data-rx="spot"]');

  if (spot) {
    const art = Array.from(spot.querySelectorAll<SVGSVGElement>('.plate-art svg'));
    const n = art.length;
    let front = 0;
    let onScreen = true;

    // Only the front card and its two neighbours animate, and only while the
    // spotlight is on screen.
    const sync = () => {
      art.forEach((svg, i) => {
        const d = Math.abs(i - front);
        const near = Math.min(d, n - d) <= 1;
        if (!still && onScreen && near) svg.unpauseAnimations();
        else svg.pauseAnimations();
      });
    };
    if (still) art.forEach((svg) => svg.setCurrentTime(3));

    rolodex(spot, {
      place: spotPlace,
      horizontal: true,
      dragPx: 140,
      wheelOnFrontOnly: true,
      onFront: (k) => {
        front = k;
        sync();
      },
    });
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(spot);
  }

  document.querySelectorAll<HTMLElement>('.rx-wrap[data-rx="list"]').forEach((wrap) => {
    rolodex(wrap, { place: listPlace(84), horizontal: false, dragPx: 84 });
  });
</script>
