---
import { site, base, path } from '../lib/site';
import ThemeScript from '../components/ThemeScript.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sharedCssHash } from '../lib/assets';
import { GA_MEASUREMENT_ID } from 'astro:env/server';

interface Props {
  title: string;
  description: string;
  /** Site-root-relative pathname for this page, e.g. "/perceptense/modules/x/". */
  pathname: string;
  ogType?: 'website' | 'article';
  /** Structured data objects; each is emitted as its own ld+json script. */
  structuredData?: unknown[];
  bodyClass?: string;
  moduleId?: number;
  /** Site-root-relative path of the 1200x630 social card; defaults to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Keep the page out of search results and omit its canonical. */
  noindex?: boolean;
}

const {
  title,
  description,
  pathname,
  ogType = 'website',
  structuredData = [],
  bodyClass,
  moduleId,
  ogImage = `${base}/og/site.png`,
  ogImageAlt = `${site.brand} — ${site.tagline}`,
  noindex = false,
} = Astro.props;

const canonical = new URL(pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const analyticsId = GA_MEASUREMENT_ID;
---
<!doctype html>
<html lang={site.locale} data-theme="auto" data-module={moduleId ? String(moduleId) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Precedes ThemeScript, which sets it to the resolved theme's background. -->
    <meta name="theme-color" content="#ffffff" />
    <ThemeScript />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.author} />

    <meta property="og:site_name" content={site.brand} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href={`${base}/assets/favicons/favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicons/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/assets/favicons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <!-- Linked rather than imported so it precedes every bundled module
         stylesheet; module rules are written to win ties against it. -->
    <link rel="stylesheet" href={`${base}/styles/shared.css?v=${sharedCssHash}`} />

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    {analyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <slot name="before-main" />
    <main id="main">
      <slot />
    </main>
    <slot name="after-main" />
    <SiteFooter />
  </body>
</html>
