---
import BaseLayout from './BaseLayout.astro';
import RelatedModules from '../components/RelatedModules.astro';
import { site, base, path, pageTitle } from '../lib/site';
import modules from '../data/modules.json';
import categories from '../data/categories.json';

interface Module {
  id: number;
  slug: string;
  name: string;
  subtitle: string;
  blurb: string;
  description: string;
  category: string;
  keywords: string[];
  sections: { label: string; slug: string }[];
  qa: { q: string; a: string }[];
}

const { mod } = Astro.props as { mod: Module };

const index = modules.findIndex((m) => m.id === mod.id);
const prev = index > 0 ? modules[index - 1] : null;
const next = index < modules.length - 1 ? modules[index + 1] : null;
const category = categories.find((c) => c.id === mod.category)!;

const pathname = path('modules', mod.slug);
const url = new URL(pathname, Astro.site).href;
const origin = Astro.site!.origin;

const structuredData: unknown[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: mod.name,
    headline: mod.name,
    description: mod.description,
    url,
    learningResourceType: 'Interactive module',
    educationalLevel: 'Beginner',
    inLanguage: site.locale,
    isAccessibleForFree: true,
    keywords: mod.keywords.join(', '),
    author: { '@type': 'Person', name: site.author },
    isPartOf: {
      '@type': 'Course',
      name: `${site.brand} — ${site.tagline}`,
      url: new URL(path(), Astro.site).href,
    },
    hasPart: mod.sections.map((s) => ({
      '@type': 'WebPageElement',
      name: s.label,
      url: `${url}#${s.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.brand, item: new URL(path(), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: category.label, item: new URL(path('topics', category.id), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: mod.name, item: url },
    ],
  },
];

if (mod.qa.length > 0) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: mod.qa.map((pair) => ({
      '@type': 'Question',
      name: pair.q,
      acceptedAnswer: { '@type': 'Answer', text: pair.a },
    })),
  });
}
---
<BaseLayout
  title={pageTitle(mod.name, mod.subtitle)}
  description={mod.description}
  pathname={pathname}
  ogType="article"
  ogImage={`${base}/og/${mod.slug}.png`}
  ogImageAlt={`Module ${mod.id}: ${mod.name}`}
  moduleId={mod.id}
  structuredData={structuredData}
>
  <nav class="crumbs" aria-label="Breadcrumb" slot="before-main">
    <ol>
      <li><a href={path()}>Home</a></li>
      <li><a href={path('topics', category.id)}>{category.label}</a></li>
      <li aria-current="page">{mod.name}</li>
    </ol>
  </nav>

  <article class={`page-wrap m-${mod.slug}`}>
    <slot />
  </article>

  <nav class="module-pager" aria-label="Module navigation" slot="after-main">
    {prev ? (
      <a class="pager-prev" rel="prev" href={path('modules', prev.slug)}>
        <span class="pager-dir">Previous</span>
        <span class="pager-name">{prev.name}</span>
      </a>
    ) : <span />}
    {next ? (
      <a class="pager-next" rel="next" href={path('modules', next.slug)}>
        <span class="pager-dir">Next</span>
        <span class="pager-name">{next.name}</span>
      </a>
    ) : <span />}
  </nav>

  <RelatedModules slot="after-main" module={mod} category={category} />
</BaseLayout>
