---
/**
 * Applies the saved theme before first paint.
 *
 * Must stay `is:inline` and must sit in <head> ahead of any stylesheet: a
 * bundled or deferred script would run after the first paint and the page would
 * flash the wrong theme.
 */
---
<script is:inline>
  (function () {
    var saved = null;
    try {
      saved = localStorage.getItem('perceptense-theme');
    } catch (e) {}
    var theme = saved || 'auto';
    document.documentElement.setAttribute('data-theme', theme);

    var dark = theme === 'dark' ||
      (theme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', dark ? '#1c1c1a' : '#ffffff');
  })();
</script>
