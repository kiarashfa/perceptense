---
import { site, path } from '../lib/site';
---
<footer class="site-foot">
  <div class="foot-bar">
    <nav class="foot-links" aria-label="Site">
      <a class="foot-brand" href={path()}>{site.brand}</a>
      <ul>
        <li><a href={path()}>Home</a></li>
        <li><a href={path('modules')}>All modules</a></li>
        <li><a href={path('topics')}>Browse by topic</a></li>
        <li><a href={path('about')}>About</a></li>
      </ul>
    </nav>
    <p class="foot-copy">&copy; 2025&ndash;2026 {site.author}.</p>
  </div>

  <p class="foot-disclaimer">
    This content is provided for educational and informational purposes only. It does not
    constitute professional, medical, legal, political, or psychological advice. The author
    makes no representations or warranties regarding the accuracy, completeness, or
    applicability of the information presented. Views on sensitive or debated topics reflect
    general educational summaries, not personal advocacy.
  </p>
</footer>
